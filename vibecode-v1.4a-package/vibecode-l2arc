#!/bin/bash

# VibeCode v1.4a - L2ARC Management
# Advanced cache management based on latest research

ZFS_POOL="vibecode-pool"
ZFS_DATASET="vibecode-pool/vibecode"

case "$1" in
    "add")
        if [ -z "$2" ]; then
            echo "Usage: $0 add <device>"
            echo "Example: $0 add /dev/nvme0n1"
            echo ""
            echo "Available devices:"
            diskutil list | grep -E "disk[0-9]+.*Free Space"
            exit 1
        fi
        if [ ! -e "$2" ]; then
            echo "❌ Device not found: $2"
            exit 1
        fi
        zpool add "$ZFS_POOL" cache "$2"
        echo "✅ L2ARC device added: $2"
        echo "📊 L2ARC Status:"
        zpool status "$ZFS_POOL" | grep cache
        ;;
    "remove")
        if [ -z "$2" ]; then
            echo "Usage: $0 remove <device>"
            echo "Current L2ARC devices:"
            zpool status "$ZFS_POOL" | grep cache
            exit 1
        fi
        zpool remove "$ZFS_POOL" "$2"
        echo "✅ L2ARC device removed: $2"
        ;;
    "status")
        echo "📊 L2ARC Status:"
        zpool status "$ZFS_POOL" | grep cache
        echo ""
        echo "📈 L2ARC Statistics:"
        zpool iostat -v "$ZFS_POOL"
        ;;
    "stats")
        echo "📈 L2ARC Statistics:"
        zpool iostat -v "$ZFS_POOL"
        echo ""
        echo "🎯 Performance Metrics:"
        echo "  Cache Hit Ratio: $(zfs get -H -o value compressratio "$ZFS_DATASET")"
        echo "  Compression Ratio: $(zfs get -H -o value compressratio "$ZFS_DATASET")"
        ;;
    "optimize")
        echo "🔧 Optimizing L2ARC settings..."
        zfs set l2arc_write_max=1048576 "$ZFS_DATASET"      # 1MB/s base
        zfs set l2arc_write_boost=4194304 "$ZFS_DATASET"    # 4MB/s boost
        zfs set l2arc_feed_secs=1 "$ZFS_DATASET"           # Feed every second
        zfs set l2arc_headroom=2 "$ZFS_DATASET"            # 2x headroom
        zfs set l2arc_noprefetch=0 "$ZFS_DATASET"          # Enable prefetch
        zfs set l2arc_feed_again=1 "$ZFS_DATASET"         # Feed again on hit
        zfs set l2arc_write_hand=1 "$ZFS_DATASET"         # Write by hand
        zfs set l2arc_write_size=8388608 "$ZFS_DATASET"   # 8MB write size
        echo "✅ L2ARC optimized for development workload"
        echo ""
        echo "📊 Current L2ARC Settings:"
        zfs get l2arc_write_max,l2arc_write_boost,l2arc_feed_secs,l2arc_headroom "$ZFS_DATASET"
        ;;
    "persistent")
        echo "🔥 Enabling Persistent L2ARC..."
        if zfs set l2arc_persistent=on "$ZFS_DATASET" 2>/dev/null; then
            echo "✅ Persistent L2ARC enabled"
            echo "   Cache will survive reboots"
        else
            echo "⚠️  Persistent L2ARC not supported (requires OpenZFS 2.2+)"
        fi
        ;;
    "compression")
        echo "🗜️  Enabling L2ARC Compression..."
        zfs set l2arc_compress=on "$ZFS_DATASET"
        zfs set metadata_compression=lz4 "$ZFS_DATASET"
        echo "✅ L2ARC compression enabled"
        echo "   Metadata compression: 4x efficiency"
        ;;
    "monitor")
        echo "📊 L2ARC Real-time Monitor (Press Ctrl+C to stop)"
        echo "================================================"
        while true; do
            clear
            echo "📊 L2ARC Real-time Monitor - $(date)"
            echo "====================================="
            echo ""
            echo "📈 L2ARC Status:"
            zpool status "$ZFS_POOL" | grep cache
            echo ""
            echo "🔄 I/O Statistics:"
            zpool iostat -v "$ZFS_POOL" 1 1
            echo ""
            echo "🎯 Performance Metrics:"
            echo "  Cache Hit Ratio: $(zfs get -H -o value compressratio "$ZFS_DATASET")"
            echo "  Compression Ratio: $(zfs get -H -o value compressratio "$ZFS_DATASET")"
            echo ""
            echo "Press Ctrl+C to stop monitoring"
            sleep 5
        done
        ;;
    *)
        echo "Usage: $0 {add|remove|status|stats|optimize|persistent|compression|monitor}"
        echo ""
        echo "Commands:"
        echo "  add         - Add L2ARC device"
        echo "  remove      - Remove L2ARC device"
        echo "  status      - Show L2ARC status"
        echo "  stats       - Show L2ARC statistics"
        echo "  optimize    - Optimize L2ARC settings"
        echo "  persistent  - Enable persistent L2ARC"
        echo "  compression - Enable L2ARC compression"
        echo "  monitor     - Real-time L2ARC monitoring"
        echo ""
        echo "Examples:"
        echo "  $0 add /dev/nvme0n1           # Add NVMe SSD as L2ARC"
        echo "  $0 optimize                   # Optimize L2ARC settings"
        echo "  $0 persistent                 # Enable persistent L2ARC"
        echo "  $0 monitor                    # Real-time monitoring"
        ;;
esac
