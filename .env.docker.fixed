# Docker Environment Configuration (Sanitized)
# Enhanced with values from .env.local for better compatibility

# Application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=vibecode-development-secret-key-change-in-production
NODE_ENV=development
DOCKER=true
PORT=3000
WS_PORT=3001

# Database (Docker service names)
DATABASE_URL=postgresql://vibecode:vibecode123@postgres:5432/vibecode_dev
POSTGRES_PASSWORD=vibecode123

# Redis (Docker service name)
REDIS_URL=redis://redis:6379

# Code Server
CODE_SERVER_PASSWORD=vibecode123

# AI Configuration (from .env.local)
OPENROUTER_API_KEY=your-openrouter-api-key
CLAUDE_API_KEY=your-claude-api-key
OPENAI_API_KEY=your-openai-api-key

# OAuth Providers
GITHUB_ID=placeholder-github-oauth-id
GITHUB_SECRET=placeholder-github-oauth-secret
GOOGLE_CLIENT_ID=placeholder-google-oauth-id
GOOGLE_CLIENT_SECRET=placeholder-google-oauth-secret

# Datadog Configuration (using .env.local values)
DATADOG_API_KEY=datadog-api-key
DD_API_KEY=datadog-api-key
DD_APP_KEY=datadog-app-key
DD_SITE=datadoghq.com
DD_ENV=development
DD_SERVICE=vibecode-webgui
DD_VERSION=1.0.0

# Frontend Datadog Configuration (preferred)
NEXT_PUBLIC_DD_APPLICATION_ID=datadog-rum-app-id
NEXT_PUBLIC_DD_CLIENT_TOKEN=datadog-rum-client-token
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_ENABLE_RUM_IN_DEV=false

# Legacy fallback env vars retained for compatibility
NEXT_PUBLIC_DATADOG_APPLICATION_ID=datadog-rum-app-id
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=datadog-rum-client-token
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com
NEXT_PUBLIC_DATADOG_RUM_APPLICATION_ID=datadog-rum-app-id
NEXT_PUBLIC_DATADOG_RUM_CLIENT_TOKEN=datadog-rum-client-token

# LLM Observability
DD_LLMOBS_ENABLED=0
DD_LLMOBS_AGENTLESS_ENABLED=0
DD_LLMOBS_ML_APP=vibecode-ai

# Monitoring
ENABLE_DATADOG_INTEGRATION_TESTS=false
MONITORING_HEALTH_CHECK_TIMEOUT=5000
PERFORMANCE_MONITORING_ENABLED=true
