/**
 * Unit Tests for OpenAI Agent Client
 *
 * Tests the core API client functionality for OpenAI Agents integration
 */

// Mock UnifiedAIClient FIRST - before any imports
jest.mock('@/lib/unified-ai-client', () => {
  return {
    UnifiedAIClient: jest.fn().mockImplementation(() => ({
      chat: jest.fn(),
      chatStream: jest.fn(),
    })),
  };
});

// Now import after mocking
import { Agent, createAgent, AgentEvent } from '@/lib/agent-framework';
import { UnifiedAIClient } from '@/lib/unified-ai-client';
import type { AgentOptions, AgentResponse, ToolDefinition } from '@/lib/agent-framework';

// Set test timeout
jest.setTimeout(30000);

describe('Agent Client - Unit Tests', () => {
  let mockClient: jest.Mocked<UnifiedAIClient>;
  let agent: Agent | null = null;
  let createdAgents: Agent[] = [];

  beforeEach(() => {
    // Clear everything before test
    jest.clearAllMocks();
    jest.clearAllTimers();
    jest.restoreAllMocks();

    // Create fresh mock
    mockClient = {
      chat: jest.fn(),
      chatStream: jest.fn(),
    } as any;

    agent = null;
    createdAgents = [];
  });

  afterEach(() => {
    // Clean up all agent instances and their event listeners
    if (agent) {
      try {
        agent.removeAllListeners();
        agent.clearMemory?.();
      } catch (e) {
        // Ignore cleanup errors
      }
      agent = null;
    }

    // Clean up any agents created during tests
    createdAgents.forEach(a => {
      try {
        a.removeAllListeners();
        a.clearMemory?.();
      } catch (e) {
        // Ignore cleanup errors
      }
    });
    createdAgents.length = 0;
    createdAgents = [];

    // Force garbage collection of mocks
    mockClient = null as any;

    // Clear all jest state
    jest.clearAllMocks();
    jest.clearAllTimers();
    jest.restoreAllMocks();
  });

  describe('Agent Initialization', () => {
    it('should create agent with default options', () => {
      const testAgent = createAgent();
      createdAgents.push(testAgent);

      expect(testAgent).toBeInstanceOf(Agent);
    });

    it('should create agent with custom options', () => {
      const options: AgentOptions = {
        model: 'gpt-4o',
        temperature: 0.5,
        maxTokens: 2000,
        memorySize: 10,
        systemPrompt: 'You are a test assistant.',
      };

      const testAgent = createAgent(options);
      createdAgents.push(testAgent);

      expect(testAgent).toBeInstanceOf(Agent);
    });

    it('should initialize with system message in memory', () => {
      const systemPrompt = 'You are a helpful assistant.';
      const testAgent = new Agent({ systemPrompt, client: mockClient });
      createdAgents.push(testAgent);

      // Agent should have system message in memory
      expect(testAgent).toBeDefined();
    });

    it('should register tools during initialization', () => {
      const testTool: ToolDefinition = {
        name: 'test_tool',
        description: 'A test tool',
        parameters: { type: 'object', properties: {} },
        execute: jest.fn().mockResolvedValue({ result: 'test' }),
      };

      const testAgent = new Agent({
        tools: [testTool],
        client: mockClient,
      });
      createdAgents.push(testAgent);

      expect(testAgent).toBeDefined();
    });
  });

  describe('Message Processing', () => {
    it('should process simple message successfully', async () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);

      mockClient.chat = jest.fn().mockResolvedValue({
        content: 'Hello! How can I help you?',
        model: 'gpt-4o',
        provider: 'openai',
        usage: {
          promptTokens: 10,
          completionTokens: 8,
          totalTokens: 18,
        },
      });

      const response = await testAgent.processMessage('Hello');

      expect(mockClient.chat).toHaveBeenCalledTimes(1);
      expect(response.content).toBe('Hello! How can I help you?');
      expect(response.metadata.model).toBe('gpt-4o');
    });

    it('should add messages to memory', async () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);

      mockClient.chat = jest.fn().mockResolvedValue({
        content: 'Response',
        model: 'gpt-4o',
        provider: 'openai',
      });

      await testAgent.processMessage('Test message');

      // Memory should contain system, user, and assistant messages
    });

    it('should handle empty content', async () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);

      mockClient.chat = jest.fn().mockResolvedValue({
        content: '',
        model: 'gpt-4o',
        provider: 'openai',
      });

      const response = await testAgent.processMessage('');

      expect(response.content).toBe('');
    });

    it('should throw error when API call fails', async () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);

      mockClient.chat = jest.fn().mockRejectedValue(
        new Error('API request failed')
      );

      await expect(testAgent.processMessage('Test'))
        .rejects.toThrow('API request failed');
    });

    it('should handle network timeout errors', async () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);

      mockClient.chat = jest.fn().mockRejectedValue(
        new Error('Request timeout')
      );

      await expect(testAgent.processMessage('Test'))
        .rejects.toThrow('Request timeout');
    });
  });

  describe('Tool Execution', () => {
    it('should execute tool when requested by agent', async () => {
      const toolExecutor = jest.fn().mockResolvedValue({ result: 42 });
      const testTool: ToolDefinition = {
        name: 'calculator',
        description: 'Performs calculations',
        parameters: {
          type: 'object',
          properties: {
            expression: { type: 'string' },
          },
        },
        execute: toolExecutor,
      };

      const testAgent = new Agent({
        tools: [testTool],
        client: mockClient,
      });
      createdAgents.push(testAgent);

      // Mock API response with tool call
      mockClient.chat = jest.fn()
        .mockResolvedValueOnce({
          content: '',
          model: 'gpt-4o',
          provider: 'openai',
          tool_calls: [{
            id: 'call_123',
            type: 'function',
            function: {
              name: 'calculator',
              arguments: JSON.stringify({ expression: '2 + 2' }),
            },
          }],
        })
        .mockResolvedValueOnce({
          content: 'The result is 42',
          model: 'gpt-4o',
          provider: 'openai',
        });

      const response = await testAgent.processMessage('Calculate 2 + 2');

      expect(toolExecutor).toHaveBeenCalledWith({ expression: '2 + 2' });
      expect(response.content).toBe('The result is 42');
    });

    it('should handle tool execution errors gracefully', async () => {
      const toolExecutor = jest.fn().mockRejectedValue(
        new Error('Tool execution failed')
      );
      const testTool: ToolDefinition = {
        name: 'failing_tool',
        description: 'A tool that fails',
        parameters: { type: 'object', properties: {} },
        execute: toolExecutor,
      };

      const testAgent = new Agent({
        tools: [testTool],
        client: mockClient,
      });
      createdAgents.push(testAgent);

      mockClient.chat = jest.fn()
        .mockResolvedValueOnce({
          content: '',
          model: 'gpt-4o',
          provider: 'openai',
          tool_calls: [{
            id: 'call_123',
            type: 'function',
            function: {
              name: 'failing_tool',
              arguments: '{}',
            },
          }],
        })
        .mockResolvedValueOnce({
          content: 'Tool execution failed',
          model: 'gpt-4o',
          provider: 'openai',
        });

      const response = await testAgent.processMessage('Use the failing tool');

      expect(toolExecutor).toHaveBeenCalled();
      expect(response.content).toBe('Tool execution failed');
    });

    it('should throw error for unknown tool', async () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);

      mockClient.chat = jest.fn().mockResolvedValue({
        content: '',
        model: 'gpt-4o',
        provider: 'openai',
        tool_calls: [{
          id: 'call_123',
          type: 'function',
          function: {
            name: 'unknown_tool',
            arguments: '{}',
          },
        }],
      });

      await expect(testAgent.processMessage('Use unknown tool'))
        .rejects.toThrow('Tool unknown_tool not found');
    });

    it('should handle invalid tool arguments', async () => {
      const toolExecutor = jest.fn().mockResolvedValue({ result: 'ok' });
      const testTool: ToolDefinition = {
        name: 'test_tool',
        description: 'Test tool',
        parameters: { type: 'object', properties: {} },
        execute: toolExecutor,
      };

      const testAgent = new Agent({
        tools: [testTool],
        client: mockClient,
      });
      createdAgents.push(testAgent);

      mockClient.chat = jest.fn().mockResolvedValue({
        content: '',
        model: 'gpt-4o',
        provider: 'openai',
        tool_calls: [{
          id: 'call_123',
          type: 'function',
          function: {
            name: 'test_tool',
            arguments: 'invalid json',
          },
        }],
      });

      await expect(testAgent.processMessage('Test'))
        .rejects.toThrow('Invalid tool arguments');
    });
  });

  describe('Memory Management', () => {
    it('should maintain memory within size limit', async () => {
      const testAgent = new Agent({
        memorySize: 3,
        client: mockClient,
      });
      createdAgents.push(testAgent);

      mockClient.chat = jest.fn().mockResolvedValue({
        content: 'Response',
        model: 'gpt-4o',
        provider: 'openai',
      });

      // Single iteration only to prevent memory issues
      await testAgent.processMessage('Message 0');

      // Memory should be trimmed to size limit
      expect(testAgent).toBeDefined();
    });

    it('should clear memory while preserving system prompt', () => {
      const testAgent = new Agent({
        systemPrompt: 'System prompt',
        client: mockClient,
      });
      createdAgents.push(testAgent);

      testAgent.clearMemory();

      // System prompt should still be in memory
      expect(testAgent).toBeDefined();
    });

    it('should add timestamp to messages', async () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);
      const beforeTime = Date.now();

      mockClient.chat = jest.fn().mockResolvedValue({
        content: 'Response',
        model: 'gpt-4o',
        provider: 'openai',
      });

      await testAgent.processMessage('Test');
      const afterTime = Date.now();

      // Timestamp should be between beforeTime and afterTime
      expect(afterTime).toBeGreaterThanOrEqual(beforeTime);
    });
  });

  describe('Event Emission', () => {
    it('should emit message events', async () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);
      const messageHandler = jest.fn();

      testAgent.on(AgentEvent.Message, messageHandler);

      mockClient.chat = jest.fn().mockResolvedValue({
        content: 'Response',
        model: 'gpt-4o',
        provider: 'openai',
      });

      await testAgent.processMessage('Test');

      expect(messageHandler).toHaveBeenCalled();

      // Clean up event listener immediately
      testAgent.removeListener(AgentEvent.Message, messageHandler);
    });

    it('should emit tool call events', async () => {
      const toolExecutor = jest.fn().mockResolvedValue({ result: 'ok' });
      const testTool: ToolDefinition = {
        name: 'test_tool',
        description: 'Test tool',
        parameters: { type: 'object', properties: {} },
        execute: toolExecutor,
      };

      const testAgent = new Agent({
        tools: [testTool],
        client: mockClient,
      });
      createdAgents.push(testAgent);

      const toolCallHandler = jest.fn();
      testAgent.on(AgentEvent.ToolCall, toolCallHandler);

      mockClient.chat = jest.fn()
        .mockResolvedValueOnce({
          content: '',
          model: 'gpt-4o',
          provider: 'openai',
          tool_calls: [{
            id: 'call_123',
            type: 'function',
            function: {
              name: 'test_tool',
              arguments: '{}',
            },
          }],
        })
        .mockResolvedValueOnce({
          content: 'Done',
          model: 'gpt-4o',
          provider: 'openai',
        });

      await testAgent.processMessage('Test');

      expect(toolCallHandler).toHaveBeenCalledWith({
        tool: 'test_tool',
        args: {},
      });

      // Clean up event listener immediately
      testAgent.removeListener(AgentEvent.ToolCall, toolCallHandler);
    });

    it('should emit error events', async () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);
      const errorHandler = jest.fn();

      testAgent.on(AgentEvent.Error, errorHandler);

      mockClient.chat = jest.fn().mockRejectedValue(
        new Error('Test error')
      );

      await expect(testAgent.processMessage('Test')).rejects.toThrow();

      expect(errorHandler).toHaveBeenCalled();

      // Clean up event listener immediately
      testAgent.removeListener(AgentEvent.Error, errorHandler);
    });
  });

  describe('Streaming Responses', () => {
    it('should stream response chunks', async () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);

      const mockStream = (async function* () {
        yield { content: 'Hello', model: 'gpt-4o', provider: 'openai' };
        yield { content: ' world', model: 'gpt-4o', provider: 'openai' };
        yield { content: '!', model: 'gpt-4o', provider: 'openai' };
      })();

      mockClient.chatStream = jest.fn().mockResolvedValue(mockStream);

      const chunks: string[] = [];
      for await (const chunk of testAgent.streamResponse('Test')) {
        chunks.push(chunk.content);
      }

      expect(chunks).toEqual(['Hello', ' world', '!']);
    });

    it('should add complete response to memory after streaming', async () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);

      const mockStream = (async function* () {
        yield { content: 'Part 1', model: 'gpt-4o', provider: 'openai' };
        yield { content: ' Part 2', model: 'gpt-4o', provider: 'openai' };
      })();

      mockClient.chatStream = jest.fn().mockResolvedValue(mockStream);

      const chunks: string[] = [];
      for await (const chunk of testAgent.streamResponse('Test')) {
        chunks.push(chunk.content);
      }

      // Full response should be in memory
      expect(chunks.length).toBeGreaterThan(0);
    });

    it('should handle streaming errors', async () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);

      mockClient.chatStream = jest.fn().mockRejectedValue(
        new Error('Streaming failed')
      );

      const generator = testAgent.streamResponse('Test');

      await expect(generator.next()).rejects.toThrow('Streaming failed');
    });
  });

  describe('Tool Registration', () => {
    it('should register single tool', () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);

      const tool: ToolDefinition = {
        name: 'new_tool',
        description: 'New tool',
        parameters: { type: 'object', properties: {} },
        execute: jest.fn(),
      };

      testAgent.registerTools(tool);

      expect(testAgent).toBeDefined();
    });

    it('should register multiple tools', () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);

      const tools: ToolDefinition[] = [
        {
          name: 'tool1',
          description: 'Tool 1',
          parameters: { type: 'object', properties: {} },
          execute: jest.fn(),
        },
        {
          name: 'tool2',
          description: 'Tool 2',
          parameters: { type: 'object', properties: {} },
          execute: jest.fn(),
        },
      ];

      testAgent.registerTools(tools);

      expect(testAgent).toBeDefined();
    });

    it('should overwrite tool with same name', () => {
      const testAgent = new Agent({ client: mockClient });
      createdAgents.push(testAgent);

      const tool1: ToolDefinition = {
        name: 'duplicate',
        description: 'First version',
        parameters: { type: 'object', properties: {} },
        execute: jest.fn(),
      };

      const tool2: ToolDefinition = {
        name: 'duplicate',
        description: 'Second version',
        parameters: { type: 'object', properties: {} },
        execute: jest.fn(),
      };

      testAgent.registerTools(tool1);
      testAgent.registerTools(tool2);

      expect(testAgent).toBeDefined();
    });
  });

  describe('Configuration Options', () => {
    it('should respect custom temperature', async () => {
      const testAgent = new Agent({
        temperature: 0.9,
        client: mockClient,
      });
      createdAgents.push(testAgent);

      mockClient.chat = jest.fn().mockResolvedValue({
        content: 'Response',
        model: 'gpt-4o',
        provider: 'openai',
      });

      await testAgent.processMessage('Test');

      expect(mockClient.chat).toHaveBeenCalledWith(
        expect.any(Array),
        expect.any(String),
        expect.objectContaining({ temperature: 0.9 })
      );
    });

    it('should respect custom maxTokens', async () => {
      const testAgent = new Agent({
        maxTokens: 500,
        client: mockClient,
      });
      createdAgents.push(testAgent);

      mockClient.chat = jest.fn().mockResolvedValue({
        content: 'Response',
        model: 'gpt-4o',
        provider: 'openai',
      });

      await testAgent.processMessage('Test');

      expect(mockClient.chat).toHaveBeenCalledWith(
        expect.any(Array),
        expect.any(String),
        expect.objectContaining({ maxTokens: 500 })
      );
    });

    it('should override options per message', async () => {
      const testAgent = new Agent({
        temperature: 0.5,
        client: mockClient,
      });
      createdAgents.push(testAgent);

      mockClient.chat = jest.fn().mockResolvedValue({
        content: 'Response',
        model: 'gpt-4o',
        provider: 'openai',
      });

      await testAgent.processMessage('Test', { temperature: 0.9 });

      expect(mockClient.chat).toHaveBeenCalledWith(
        expect.any(Array),
        expect.any(String),
        expect.objectContaining({ temperature: 0.9 })
      );
    });
  });
});
