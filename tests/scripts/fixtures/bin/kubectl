#!/usr/bin/env bash
set -euo pipefail

STATE_DIR=${MOCK_KUBECTL_STATE_DIR:-${BATS_TEST_TMPDIR:-/tmp}}
mkdir -p "$STATE_DIR"

if [[ "${MOCK_KUBECTL_FATAL:-0}" -eq 1 ]]; then
  echo "kubectl: fatal error" >&2
  exit 1
fi

subcommand=${1:-}
case "$subcommand" in
  wait)
    if [[ "${MOCK_KUBECTL_WAIT_FAIL:-0}" -eq 1 ]]; then
      echo "kubectl wait simulated failure" >&2
      exit ${MOCK_KUBECTL_WAIT_CODE:-1}
    fi
    exit 0
    ;;
  get)
    shift
    resource=${1:-}
    if [[ "$resource" == "pods" ]]; then
      if [[ "${MOCK_KUBECTL_GET_EMPTY:-0}" -eq 1 ]]; then
        exit 0
      fi
      if [[ -n ${MOCK_KUBECTL_GET_SEQUENCE:-} ]]; then
        state_file="$STATE_DIR/mock_kubectl_get_index"
        idx=0
        if [[ -f "$state_file" ]]; then
          idx=$(cat "$state_file")
        fi
        IFS='|' read -r -a sequences <<< "${MOCK_KUBECTL_GET_SEQUENCE}"
        entry="${sequences[$idx]:-}"
        if (( idx < ${#sequences[@]} - 1 )); then
          printf '%d' $((idx + 1)) >"$state_file"
        else
          printf '%d' $idx >"$state_file"
        fi
        if [[ -n "$entry" ]]; then
          IFS=',' read -r -a pods <<< "$entry"
          for pod in "${pods[@]}"; do
            [[ -n "$pod" ]] && printf '%s
' "$pod"
          done
        fi
        exit 0
      fi
      echo "pod-code-server-0"
      exit 0
    fi
    ;;
  exec)
    shift
    pod=${1:-}
    shift
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --)
          shift
          break
          ;;
        *)
          shift
          ;;
      esac
    done
    cmd="$*"
    if [[ $cmd == sh\ -lc* ]]; then
      cmd=${cmd#sh -lc }
    fi
    if [[ "${MOCK_KUBECTL_EXEC_TIMEOUT:-0}" -eq 1 ]]; then
      sleep 5
      exit 1
    fi
    if [[ -n ${MOCK_KUBECTL_EXEC_FAIL_ONCE:-} && "$pod" == "$MOCK_KUBECTL_EXEC_FAIL_ONCE" ]]; then
      state_file="$STATE_DIR/mock_exec_once_${pod}"
      if [[ ! -f "$state_file" ]]; then
        echo used >"$state_file"
        echo "${MOCK_KUBECTL_EXEC_FAIL_MSG:-simulated exec failure}" >&2
        exit 2
      fi
    fi
    if [[ "${MOCK_KUBECTL_EXEC_FAIL:-0}" -eq 1 ]]; then
      echo "${MOCK_KUBECTL_EXEC_FAIL_MSG:-simulated exec failure}" >&2
      exit 2
    fi
    if [[ "$cmd" == command\ -v* ]]; then
      tool=$(printf '%s' "$cmd" | awk '{print $3}')
      if [[ "${MOCK_TOOL_MISSING:-}" == "$tool" ]]; then
        echo "$tool: not found" >&2
        exit 127
      fi
      exit 0
    fi
    if [[ "$cmd" == *"--version"* || "$cmd" == *"--help"* ]]; then
      tool=$(printf '%s' "$cmd" | awk '{print $1}')
      echo "$tool version v1.2.3"
      exit 0
    fi
    exit 0
    ;;
  *)
    echo "unsupported kubectl mock command: $subcommand" >&2
    exit 1
    ;;
esac
