DD_SERVICE=gastown-kafka-consumer-bridge
DD_ENV=local
DD_VERSION=0.1.0
DD_DATA_STREAMS_ENABLED=true
DD_TRACE_ENABLED=true
KAFKAJS_NO_PARTITIONER_WARNING=1
KAFKA_BROKERS=your-kafka-host:9092
KAFKA_TOPIC=tundra-beads-created
KAFKA_TOPICS=tundra-beads-created,tundra-beads-in-progress,tundra-beads-completed,tundra-beads-escalated,tundra-beads-failed,tundra-mayor-commands,tundra-deacon-commands,tundra-polecat-commands,tundra-reaper-commands,tundra-witness-commands,tundra-overseer-commands,tundra-audit-actions,tundra-nudges,tundra-whispers,tundra-mail-outbox,tundra-mail-inbox,tundra-work-intake
KAFKA_GROUP_ID=tundra-bridge
KAFKA_CONSUME_LOG=/path/to/logs/kafka-gt-consumer.jsonl
GT_CMD=/path/to/gt
GT_NUDGE_TARGET=mayor
GT_BEAD_NUDGE_TARGET=witness
GT_ESCALATE_SOURCE=kafka:bridge:tundra
GT_BRIDGE_DRY_RUN=false
GT_ROUTE_CRITICAL=mayor
GT_ROUTE_STANDARD=deacon
GT_ROUTE_EXPERIMENTAL=deacon
GT_ROUTE_DEFAULT=mayor
OPENCLAW_WEBHOOK=
OPENCLAW_CMD=/path/to/openclaw
OPENCLAW_MESSAGE_TARGET=
DD_TAGS=rig:your-rig,role:observer,lane:standard

DD_TRACE_REMOVE_INTEGRATION_SERVICE_NAMES_ENABLED=true
