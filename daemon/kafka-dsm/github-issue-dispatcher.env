KAFKA_BROKERS=localhost:9092
GITHUB_OWNER=ryanmaclean
GITHUB_REPO=vibecode-webgui
# GitHub CLI (gh) is preferred - uses `gh auth login` credentials
# Set GITHUB_USE_GH_CLI=false to use GITHUB_TOKEN instead
GITHUB_USE_GH_CLI=true
GH_CMD=/opt/homebrew/bin/gh
GITHUB_TOKEN=
GITHUB_API=https://api.github.com
GITHUB_DRY_RUN=true
GITHUB_SINCE_DAYS=7
GITHUB_LABEL_LANE_CRITICAL=critical,sev1,p0
GITHUB_LABEL_LANE_STANDARD=standard,sev2,p1
GITHUB_LABEL_LANE_EXPERIMENTAL=experimental,spike,idea
GITHUB_PRIORITY_MAP=p0:0,p1:1,p2:2,p3:3,p4:4,critical:0,high:1,medium:2,low:3
GITHUB_STATE_PATH=/Users/studio/gt/logs/github-issues.state.json
BD_CMD=/Users/studio/go/bin/bd
GT_CMD=/Users/studio/go/bin/gt
GT_AUTO_SLING=false
GT_AUTO_SLING_TARGET=mayor
DD_SERVICE=gastown-github-dispatcher
KAFKAJS_NO_PARTITIONER_WARNING=1
DD_TAGS=rig:mbp_m1,role:infra,lane:standard

DD_TRACE_REMOVE_INTEGRATION_SERVICE_NAMES_ENABLED=true
DD_DATA_STREAMS_ENABLED=true
