DD_SERVICE=gastown-kafka-bead-emitter
DD_ENV=local
KAFKAJS_NO_PARTITIONER_WARNING=1
DD_VERSION=0.1.0
DD_DATA_STREAMS_ENABLED=true
DD_TRACE_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=tundra-beads-created
GT_EVENTS_PATH=/Users/studio/gt/.events.jsonl
GT_EVENTS_STATE=/Users/studio/gt/daemon/gt-kafka-emitter.state.json
EMIT_SERVICES=tundra,openclaw
EMIT_SCHEMA_NAME=tundra.beads
EMIT_SCHEMA_VERSION=1
EMIT_SCHEMA_STATUS=ok
DD_TAGS=rig:mbp_m1,role:infra,lane:standard

DD_TRACE_REMOVE_INTEGRATION_SERVICE_NAMES_ENABLED=true
