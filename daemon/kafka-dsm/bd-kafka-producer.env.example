DD_SERVICE=gastown-bd-producer
DD_ENV=local
KAFKAJS_NO_PARTITIONER_WARNING=1
DD_VERSION=0.1.0
DD_DATA_STREAMS_ENABLED=true
DD_TRACE_ENABLED=true
KAFKA_BROKERS=your-kafka-host:9092
KAFKA_TOPIC=tundra-beads-created
BEADS_DIR=/path/to/gt/.beads
BD_SYNC_STATE=/path/to/daemon/bd-kafka-producer.state.json
DD_TAGS=rig:your-rig,role:infra,lane:standard

DD_TRACE_REMOVE_INTEGRATION_SERVICE_NAMES_ENABLED=true
