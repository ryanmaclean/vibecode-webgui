{
  "title": "VibeCode Test Monitoring Dashboard",
  "description": "Comprehensive test execution monitoring for VibeCode WebGUI",
  "widgets": [
    {
      "id": "test-execution-overview",
      "definition": {
        "title": "Test Execution Overview",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:test.execution.duration{service:vibecode-webgui} by {test.category}",
            "display_type": "line"
          }
        ],
        "yaxis": {
          "label": "Duration (ms)"
        }
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 24,
        "height": 8
      }
    },
    {
      "id": "test-pass-rate",
      "definition": {
        "title": "Test Pass Rate by Category",
        "type": "query_value",
        "requests": [
          {
            "q": "avg:test.result.pass_rate{service:vibecode-webgui} by {test.category}",
            "aggregator": "avg"
          }
        ],
        "conditional_formats": [
          {
            "comparator": ">",
            "value": 90,
            "palette": "green_on_white"
          },
          {
            "comparator": ">",
            "value": 80,
            "palette": "yellow_on_white"
          },
          {
            "comparator": "<=",
            "value": 80,
            "palette": "red_on_white"
          }
        ]
      },
      "layout": {
        "x": 24,
        "y": 0,
        "width": 24,
        "height": 8
      }
    },
    {
      "id": "test-failures",
      "definition": {
        "title": "Test Failures",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:test.result.failure_count{service:vibecode-webgui} by {test.category}",
            "display_type": "bars"
          }
        ],
        "yaxis": {
          "label": "Failure Count"
        }
      },
      "layout": {
        "x": 0,
        "y": 8,
        "width": 24,
        "height": 8
      }
    },
    {
      "id": "test-category-success",
      "definition": {
        "title": "Success Rate by Test Category",
        "type": "sunburst",
        "requests": [
          {
            "q": "avg:test.category.success_rate{service:vibecode-webgui} by {test.category}"
          }
        ]
      },
      "layout": {
        "x": 24,
        "y": 8,
        "width": 24,
        "height": 8
      }
    },
    {
      "id": "test-logs",
      "definition": {
        "title": "Recent Test Results",
        "type": "log_stream",
        "query": "source:next-js service:vibecode-webgui [DD_TEST_RESULT]",
        "columns": [
          "timestamp",
          "test_name",
          "test_category", 
          "status",
          "duration_ms"
        ]
      },
      "layout": {
        "x": 0,
        "y": 16,
        "width": 48,
        "height": 12
      }
    }
  ],
  "template_variables": [
    {
      "name": "service",
      "default": "vibecode-webgui",
      "prefix": "service"
    },
    {
      "name": "env",
      "default": "test",
      "prefix": "env"
    },
    {
      "name": "test_category",
      "default": "*",
      "prefix": "test.category"
    }
  ],
  "notify_list": [],
  "tags": [
    "service:vibecode-webgui",
    "env:test",
    "monitoring:test"
  ]
}
