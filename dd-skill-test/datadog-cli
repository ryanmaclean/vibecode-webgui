#!/bin/bash
# Datadog Skill - Unified CLI Wrapper
# Thin bash wrapper that delegates to Python CLI

set -e

# Check if Python 3 is available
if ! command -v python3 &> /dev/null; then
    echo "Error: python3 not found. Install Python 3.7+ to use Datadog skill." >&2
    exit 1
fi

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_CLI="$SCRIPT_DIR/python/dd.py"

# Check if Python CLI exists
if [ ! -f "$PYTHON_CLI" ]; then
    echo "Error: Python CLI not found at $PYTHON_CLI" >&2
    exit 1
fi

# Check dependencies on first run
if [ ! -f "$HOME/.dd-skill-test-deps-checked" ]; then
    if ! python3 -c "import requests" 2>/dev/null; then
        echo "Warning: Python dependencies not installed." >&2
        echo "Run: pip3 install -r $SCRIPT_DIR/requirements.txt" >&2
        echo "" >&2
    fi
    touch "$HOME/.dd-skill-test-deps-checked"
fi

# Execute Python CLI with all arguments
exec python3 "$PYTHON_CLI" "$@"
