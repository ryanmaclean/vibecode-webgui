# Production Environment Configuration for Vector Performance Optimizations

# Database Configuration
DATABASE_URL="postgresql://user:password@host:5432/database?connection_limit=20&pool_timeout=30"
DB_CONNECTION_LIMIT=20

# Connection Pool Optimization
CONNECTION_POOL_MIN_CONNECTIONS=2
CONNECTION_POOL_MAX_CONNECTIONS=20
CONNECTION_POOL_ACQUIRE_TIMEOUT=30000
CONNECTION_POOL_IDLE_TIMEOUT=300000

# Vector Database Performance
USE_CONNECTION_POOL=true
VECTOR_CACHE_ENABLED=true
VECTOR_CACHE_TTL=300000

# API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
AZURE_OPENAI_API_KEY=your_azure_api_key_here

# Application Configuration
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NODE_ENV=production

# Monitoring and Performance
DATADOG_API_KEY=your_datadog_api_key_here
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_METRICS_INTERVAL=60000

# Redis Configuration (if using Redis for caching)
REDIS_URL=redis://localhost:6379

# Prisma Configuration
PRISMA_QUERY_ENGINE_BINARY=query-engine
PRISMA_MIGRATION_ENGINE_BINARY=migration-engine