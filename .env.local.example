# VibeCode WebGUI Environment Variables
# =================================================================
# Copy this file to .env.local and fill in your actual values
# See documentation: docs/wiki-archive/ENV_VARIABLES.md
# =================================================================

# ================================
# CORE APPLICATION SETTINGS
# ================================
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ================================
# AUTHENTICATION (REQUIRED)
# ================================
# NextAuth.js configuration - REQUIRED for authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-min-32-characters-long

# OAuth Providers (Optional - enables social login)
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-app-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ================================
# DATABASE CONFIGURATION (REQUIRED)
# ================================
# PostgreSQL with pgvector support
DATABASE_URL=postgresql://vibecode:password@localhost:5432/vibecode

# Alternative MongoDB URL for chat features
MONGODB_URL=mongodb://localhost:27017/vibecode_chat

# Database Pool Configuration (Optional)
DB_POOL_MIN=2
DB_POOL_MAX=10

# ================================
# REDIS/VALKEY CACHE (REQUIRED)
# ================================
# We use Valkey (BSD-licensed Redis fork) for caching
VALKEY_URL=redis://localhost:6379
# Legacy Redis support (deprecated - use VALKEY_URL)
REDIS_URL=redis://localhost:6379

# ================================
# AI SERVICE CONFIGURATION (REQUIRED)
# ================================
# OpenRouter API for multi-model AI access
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Additional AI Provider APIs (Optional)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_API_KEY=your-claude-api-key-here

# Azure OpenAI (Optional)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4-turbo

# AI Model Configuration
DEFAULT_LLM_MODEL=anthropic/claude-3-sonnet
AI_REQUEST_TIMEOUT=30000
AI_MAX_TOKENS=4096

# Vector Database
CHROMA_DB_URL=http://localhost:8000

# ================================
# DATADOG MONITORING (REQUIRED)
# ================================
# Get your API key from: https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=your-datadog-api-key-here
DD_APP_KEY=your-datadog-app-key-here
DD_SITE=datadoghq.com
DD_ENV=development
DD_SERVICE=vibecode-webgui
DD_VERSION=1.0.0

# Frontend RUM Configuration (Browser monitoring)
NEXT_PUBLIC_DD_APPLICATION_ID=your-rum-application-id
NEXT_PUBLIC_DD_CLIENT_TOKEN=your-rum-client-token
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_APP_VERSION=1.0.0

# Database Monitoring (DBM)
DD_DATABASE_MONITORING_ENABLED=true
DD_POSTGRES_USER=datadog
DD_POSTGRES_PASSWORD=your-datadog-db-password

# ================================
# DEVELOPMENT TOOLS
# ================================
# Code Server Integration
CODE_SERVER_BASE_URL=http://localhost:8080
CODE_SERVER_PASSWORD=vibecode123
WORKSPACE_BASE_PATH=/workspace

# MCP Server Configuration
MCP_SERVER_PORT=3001
AVAILABLE_MODELS=ai/smollm2:360M-Q4_K_M,ai/llama3.2:1b-Q4_K_M

# ================================
# SECURITY & RATE LIMITING
# ================================
# JWT secret for API authentication
JWT_SECRET=your-jwt-secret-here-min-32-chars

# Session encryption
SESSION_SECRET=your-session-secret-here

# Rate Limiting (Upstash Redis for production)
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ================================
# MONITORING & OBSERVABILITY
# ================================
# Performance Monitoring
ENABLE_MONITORING=true
ENABLE_PERFORMANCE_TRACKING=true
ENABLE_ERROR_TRACKING=true

# OpenTelemetry Configuration (Optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000

# ================================
# DEPLOYMENT CONFIGURATION
# ================================
# Kubernetes (Optional)
KUBECONFIG=/path/to/your/kubeconfig
KUBERNETES_NAMESPACE=vibecode-platform
PLATFORM_DOMAIN=vibecode.dev

# Docker Model Runner (Optional)
DOCKER_MODEL_RUNNER_URL=http://model-runner:8080/v1
MODEL_RUNNER_ENDPOINT=http://model-runner:8080/v1

# ================================
# FEATURE FLAGS (OPTIONAL)
# ================================
# AI Project Generation
AI_PROJECT_GENERATION_ENABLED=true

# Voice Processing
SPEECH_MODEL=ai/whisper:base-Q4_K_M
ENABLE_VOICE_FEATURES=false

# Debug Logging
ENABLE_DEBUG_LOGGING=true
ENABLE_DATADOG_INTEGRATION_TESTS=false

# RUM in Development
NEXT_PUBLIC_ENABLE_RUM_IN_DEV=false