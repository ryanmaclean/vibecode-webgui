# VibeCode Environment Variables
# Copy this to .env and update with your values

# ================================
# CORE APPLICATION SETTINGS
# ================================
NODE_ENV=development
NEXTAUTH_SECRET=your-nextauth-secret-here-min-32-chars
NEXTAUTH_URL=http://localhost:3000
ENVIRONMENT=local

# ================================
# DATADOG MONITORING (REQUIRED)
# Dev/Stg/Prd Parity Configuration
# ================================

# Datadog API Keys
# For local development, use dummy keys or real keys for testing
DATADOG_API_KEY=dummy-key-for-local-dev
DATADOG_APP_KEY=dummy-app-key-for-local-dev
DATADOG_SITE=datadoghq.com

# Datadog Real User Monitoring (RUM) - Frontend monitoring
NEXT_PUBLIC_DATADOG_APPLICATION_ID=your-rum-app-id
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=your-rum-client-token
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com

# Datadog Logging Level (DEBUG, INFO, WARN, ERROR)
DD_LOG_LEVEL=INFO

# ================================
# DATABASE CONFIGURATION
# ================================
DATABASE_URL=postgresql://vibecode:password@localhost:5432/vibecode
POSTGRES_DB=vibecode
POSTGRES_USER=vibecode
POSTGRES_PASSWORD=password

# ================================
# AI SERVICE CONFIGURATION
# ================================
AI_COMPLETION_PROVIDER=openai
AI_COMPLETION_MODEL=gpt-4o-mini
AI_COMPLETION_MAX_TOKENS=512
AI_COMPLETION_TEMPERATURE=0.2
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=http://localhost:12434/engines/v1
# Optional: legacy Codex override
CODEX_API_KEY=
CODEX_MODEL=gpt-4o-mini

# Google Gemini (provider "gemini")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro-latest
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# OpenCode via OpenRouter (provider "opencode")
OPENCODE_API_KEY=
OPENCODE_MODEL=anthropic/claude-3.5-sonnet
OPENCODE_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://vibecode.ai
OPENROUTER_APP_TITLE=VibeCode WebGUI

# Claude Code (provider "claude")
CLAUDE_CODE_API_KEY=
CLAUDE_CODE_MODEL=claude-3.5-sonnet-20240620
CLAUDE_API_BASE=https://api.anthropic.com/v1/messages
CLAUDE_API_VERSION=2023-06-01

# Azure OpenAI (if using)
AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4-turbo

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_URL=redis://localhost:6379

# ================================
# DEVELOPMENT TOOLS
# ================================
# Code Server Password
CODE_SERVER_PASSWORD=vibecode123

# MCP Server Configuration
MCP_SERVER_PORT=3001
WORKSPACE_PATH=/workspace
AVAILABLE_MODELS=ai/smollm2:360M-Q4_K_M,ai/llama3.2:1b-Q4_K_M,ai/qwen2.5-coder:1.5b-Q4_K_M

# ================================
# MONITORING & OBSERVABILITY
# ================================
# Application Performance Monitoring
DD_APM_ENABLED=true
DD_PROFILING_ENABLED=true
DD_LOGS_INJECTION=true
DD_DATABASE_MONITORING_ENABLED=true

# Infrastructure Monitoring
DD_PROCESS_AGENT_ENABLED=true
DD_DOCKER_ENABLED=true

# Custom Tags (comma-separated)
DD_TAGS=project:vibecode,team:engineering,version:1.0.0

# ================================
# DEPLOYMENT CONFIGURATION
# ================================
# Docker Model Runner Integration
DOCKER_MODEL_RUNNER_URL=http://model-runner.docker.internal/engines/v1
MODEL_RUNNER_ENDPOINT=http://model-runner.docker.internal/engines/v1

# Voice Processing
SPEECH_MODEL=ai/whisper:base-Q4_K_M
