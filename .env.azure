# Azure OpenAI configuration shared across scripts
# Copy to your local env file and replace placeholders with real values from Azure Key Vault or `az openai` outputs.

# Required secrets
AZURE_OPENAI_API_KEY=__REPLACE_WITH_AZURE_OPENAI_KEY__
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Deployment aliases (keep these in sync for backwards compatibility)
AZURE_OPENAI_DEPLOYMENT_NAME=text-embedding-3-small
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_COMPLETION_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENTS='{"embedding":"text-embedding-3-small","chat":"gpt-4o","completion":"gpt-4o-mini"}'

# Feature toggles
USE_AZURE_OPENAI=false
