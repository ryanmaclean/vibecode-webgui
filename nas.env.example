# Example environment file for NAS deployments
# Copy to nas.env and supply real values before running docker compose

# Code-Server credentials
CODE_SERVER_PASSWORD=change-me

# AI provider API keys (leave blank if not used)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_CODE_API_KEY=
OPENROUTER_API_KEY=
CODEIUM_API_KEY=

# Datadog observability
DD_API_KEY=
DATADOG_API_KEY=
DD_APP_KEY=
DATADOG_APP_KEY=
DD_SITE=datadoghq.com
DATADOG_SITE=datadoghq.com
DD_ENV=production
DD_SERVICE=vibecode-code-server

# VibeCode web app environment
DATABASE_URL=postgres://user:pass@postgres:5432/vibecode
NODE_ENV=production
