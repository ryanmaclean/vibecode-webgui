{
  "name": "vibecode-ai-assistant",
  "displayName": "VibeCode AI Assistant",
  "description": "Multi-provider AI coding assistant with OpenRouter integration",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "assistant",
    "coding",
    "openai",
    "claude",
    "openrouter",
    "code-generation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibecode.generateCode",
        "title": "Generate Code with AI",
        "category": "VibeCode",
        "icon": "$(code)"
      },
      {
        "command": "vibecode.explainCode",
        "title": "Explain Code",
        "category": "VibeCode",
        "icon": "$(question)"
      },
      {
        "command": "vibecode.optimizeCode",
        "title": "Optimize Code",
        "category": "VibeCode",
        "icon": "$(zap)"
      },
      {
        "command": "vibecode.fixCode",
        "title": "Fix Code Issues",
        "category": "VibeCode",
        "icon": "$(tools)"
      },
      {
        "command": "vibecode.generateTests",
        "title": "Generate Tests",
        "category": "VibeCode",
        "icon": "$(beaker)"
      },
      {
        "command": "vibecode.generateProject",
        "title": "Generate Project from Template",
        "category": "VibeCode",
        "icon": "$(folder-library)"
      },
      {
        "command": "vibecode.chatWithCode",
        "title": "Chat with AI about Code",
        "category": "VibeCode",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vibecode.selectAIModel",
        "title": "Select AI Model",
        "category": "VibeCode",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vibecode.templates.refresh",
        "title": "Refresh Templates",
        "category": "VibeCode",
        "icon": "$(refresh)"
      },
      {
        "command": "vibecode.templates.browse",
        "title": "Browse Template Marketplace",
        "category": "VibeCode",
        "icon": "$(extensions)"
      },
      {
        "command": "vibecode.templates.create",
        "title": "Create Project from Template",
        "category": "VibeCode",
        "icon": "$(add)"
      },
      {
        "command": "vibecode.deployment.deploy",
        "title": "Deploy to Cloud",
        "category": "VibeCode",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "vibecode.deployment.status",
        "title": "Check Deployment Status",
        "category": "VibeCode",
        "icon": "$(pulse)"
      },
      {
        "command": "vibecode.github.createRepo",
        "title": "Create GitHub Repository",
        "category": "VibeCode",
        "icon": "$(github)"
      },
      {
        "command": "vibecode.github.setupWorkflow",
        "title": "Setup CI/CD Workflow",
        "category": "VibeCode",
        "icon": "$(gear)"
      },
      {
        "command": "vibecode.collaboration.start",
        "title": "Start Collaborative Session",
        "category": "VibeCode",
        "icon": "$(live-share)"
      },
      {
        "command": "vibecode.collaboration.join",
        "title": "Join Collaborative Session",
        "category": "VibeCode",
        "icon": "$(person-add)"
      },
      {
        "command": "vibecode.collaboration.showPanel",
        "title": "Show Collaboration Panel",
        "category": "VibeCode",
        "icon": "$(live-share)"
      },
      {
        "command": "vibecode.collaboration.shareFile",
        "title": "Share Current File",
        "category": "VibeCode",
        "icon": "$(share)"
      },
      {
        "command": "vibecode.monitoring.dashboard",
        "title": "Open Monitoring Dashboard",
        "category": "VibeCode",
        "icon": "$(dashboard)"
      },
      {
        "command": "vibecode.monitoring.refresh",
        "title": "Refresh Monitoring Metrics",
        "category": "VibeCode",
        "icon": "$(refresh)"
      },
      {
        "command": "vibecode.monitoring.export",
        "title": "Export Monitoring Data",
        "category": "VibeCode",
        "icon": "$(export)"
      },
      {
        "command": "vibecode.ai.orchestration",
        "title": "AI Model Orchestration",
        "category": "VibeCode",
        "icon": "$(organization)"
      },
      {
        "command": "vibecode.ai.models.refresh",
        "title": "Refresh AI Models",
        "category": "VibeCode",
        "icon": "$(refresh)"
      },
      {
        "command": "vibecode.ai.models.test",
        "title": "Test AI Model",
        "category": "VibeCode",
        "icon": "$(play)"
      },
      {
        "command": "vibecode.ai.models.configure",
        "title": "Configure AI Model",
        "category": "VibeCode",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vibecode.ai.usage.details",
        "title": "Show Usage Details",
        "category": "VibeCode",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vibecode.generateCode",
          "when": "editorTextFocus",
          "group": "vibecode@1"
        },
        {
          "command": "vibecode.explainCode",
          "when": "editorHasSelection",
          "group": "vibecode@2"
        },
        {
          "command": "vibecode.optimizeCode",
          "when": "editorHasSelection",
          "group": "vibecode@3"
        },
        {
          "command": "vibecode.fixCode",
          "when": "editorHasSelection",
          "group": "vibecode@4"
        },
        {
          "command": "vibecode.generateTests",
          "when": "editorHasSelection",
          "group": "vibecode@5"
        },
        {
          "command": "vibecode.collaboration.shareFile",
          "when": "editorTextFocus",
          "group": "vibecode@6"
        }
      ],
      "commandPalette": [
        {
          "command": "vibecode.generateCode",
          "when": "editorTextFocus"
        },
        {
          "command": "vibecode.explainCode",
          "when": "editorHasSelection"
        },
        {
          "command": "vibecode.optimizeCode",
          "when": "editorHasSelection"
        },
        {
          "command": "vibecode.fixCode",
          "when": "editorHasSelection"
        },
        {
          "command": "vibecode.generateTests",
          "when": "editorHasSelection"
        },
        {
          "command": "vibecode.generateProject"
        },
        {
          "command": "vibecode.chatWithCode"
        },
        {
          "command": "vibecode.selectAIModel"
        }
      ],
      "view/item/context": [
        {
          "command": "vibecode.ai.models.test",
          "when": "view == vibeCodeAIModels && viewItem == available-model",
          "group": "inline"
        },
        {
          "command": "vibecode.ai.models.configure",
          "when": "view == vibeCodeAIModels && viewItem == available-model",
          "group": "inline"
        },
        {
          "command": "vibecode.ai.usage.details",
          "when": "view == vibeCodeAIModels && viewItem == usage-item",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "vibecode.ai.models.refresh",
          "when": "view == vibeCodeAIModels",
          "group": "navigation"
        },
        {
          "command": "vibecode.ai.orchestration",
          "when": "view == vibeCodeAIModels",
          "group": "navigation"
        },
        {
          "command": "vibecode.monitoring.refresh",
          "when": "view == vibeCodeMonitoring",
          "group": "navigation"
        },
        {
          "command": "vibecode.monitoring.export",
          "when": "view == vibeCodeMonitoring",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vibecode.generateCode",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus"
      },
      {
        "command": "vibecode.explainCode",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorHasSelection"
      },
      {
        "command": "vibecode.chatWithCode",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c"
      }
    ],
    "views": {
      "vibecode-ai": [
        {
          "id": "vibeCodeChat",
          "name": "AI Chat",
          "type": "webview",
          "icon": "$(comment-discussion)",
          "when": "vibeCodeEnabled"
        },
        {
          "id": "vibeCodeTemplates",
          "name": "Templates & Marketplace",
          "type": "tree",
          "icon": "$(extensions)",
          "when": "vibeCodeEnabled"
        },
        {
          "id": "vibeCodeDeployment",
          "name": "Cloud Deployment",
          "type": "webview",
          "icon": "$(cloud-upload)",
          "when": "vibeCodeEnabled"
        },
        {
          "id": "vibeCodeGitHub",
          "name": "GitHub Integration",
          "type": "tree",
          "icon": "$(github)",
          "when": "vibeCodeEnabled"
        },
        {
          "id": "vibeCodeCollaboration",
          "name": "Collaboration",
          "type": "webview",
          "icon": "$(live-share)",
          "when": "vibeCodeEnabled"
        },
        {
          "id": "vibeCodeAIModels",
          "name": "AI Models",
          "type": "tree",
          "icon": "$(organization)",
          "when": "vibeCodeEnabled"
        },
        {
          "id": "vibeCodeMonitoring",
          "name": "Monitoring",
          "type": "webview",
          "icon": "$(dashboard)",
          "when": "vibeCodeEnabled"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibecode-ai",
          "title": "VibeCode AI",
          "icon": "$(robot)"
        }
      ]
    },
    "configuration": {
      "title": "VibeCode AI Assistant",
      "properties": {
        "vibecode.openRouterApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenRouter API key for multi-provider AI access",
          "scope": "window"
        },
        "vibecode.defaultModel": {
          "type": "string",
          "default": "anthropic/claude-3-sonnet-20240229",
          "description": "Default AI model to use",
          "enum": [
            "anthropic/claude-3-sonnet-20240229",
            "anthropic/claude-3-haiku-20240307",
            "openai/gpt-4-turbo-preview",
            "openai/gpt-3.5-turbo",
            "google/gemini-pro",
            "mistral/mistral-large",
            "meta-llama/llama-3-70b-instruct"
          ],
          "scope": "window"
        },
        "vibecode.maxTokens": {
          "type": "number",
          "default": 4000,
          "description": "Maximum tokens for AI responses",
          "scope": "window"
        },
        "vibecode.temperature": {
          "type": "number",
          "default": 0.7,
          "description": "Temperature for AI responses (0.0-1.0)",
          "minimum": 0,
          "maximum": 1,
          "scope": "window"
        },
        "vibecode.enableTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "Enable anonymous usage telemetry",
          "scope": "window"
        },
        "vibecode.enableStreaming": {
          "type": "boolean",
          "default": true,
          "description": "Enable streaming responses for faster feedback",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src/**/*.ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.20.0",
    "eslint": "^8.50.0",
    "glob": "^12.0.0",
    "mocha": "^11.7.1",
    "sinon": "^21.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.12.2"
  },
  "overrides": {
    "tmp": "^0.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vibecode/vibecode-webgui"
  },
  "author": {
    "name": "VibeCode Team",
    "email": "team@vibecode.dev"
  },
  "license": "MIT",
  "publisher": "vibecode"
}
