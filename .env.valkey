# ValKey URL Configuration
# Defines ValKey connection URLs for different environments

# Development environment - local workstation
VALKEY_URL=valkey://localhost:6379

# Docker Compose environment
VALKEY_DOCKER_URL=valkey://valkey:6379

# Kubernetes environment (main cluster)
VALKEY_K8S_URL=valkey://valkey-service.vibecode-platform.svc.cluster.local:6379

# Kubernetes environment (secure ValKey with auth)
VALKEY_K8S_SECURE_URL=valkey://:${VALKEY_PASSWORD}@valkey-secure-service.vibecode-platform.svc.cluster.local:6379

# KIND local Kubernetes environment
VALKEY_KIND_URL=valkey://valkey-service:6379

# Production environment (use secure connection)
VALKEY_PRODUCTION_URL=valkey://:${VALKEY_PASSWORD}@valkey-secure-service.vibecode-platform.svc.cluster.local:6379

# Configure for existing Redis URL environment variables
# These maintain backward compatibility with the codebase
REDIS_URL=${VALKEY_URL}
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Configure for Docker environment
REDIS_DOCKER_URL=${VALKEY_DOCKER_URL}

# Configure for Kubernetes environment
REDIS_K8S_URL=${VALKEY_K8S_URL}
REDIS_K8S_SECURE_URL=${VALKEY_K8S_SECURE_URL}

# Configure for Upstash Redis compatibility (if needed)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=