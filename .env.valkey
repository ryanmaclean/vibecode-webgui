# ValKey / Redis URL configuration across environments

# Development environment - local workstation
VALKEY_URL=valkey://localhost:6379

# Docker Compose environment
VALKEY_DOCKER_URL=valkey://redis:6379

# Kubernetes environment (main cluster)
VALKEY_K8S_URL=valkey://valkey.default:6379

# Kubernetes environment (secure ValKey with auth)
VALKEY_K8S_SECURE_URL=valkey://:change-me@valkey.default:6379

# KIND local Kubernetes environment
VALKEY_KIND_URL=valkey://valkey.kind:6379

# Production environment (use secure connection)
VALKEY_PRODUCTION_URL=valkey://:change-me@valkey.prod:6379

# Backward-compatible Redis aliases
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Additional context-specific aliases
REDIS_DOCKER_URL=redis://redis:6379
REDIS_K8S_URL=redis://redis.default:6379
REDIS_K8S_SECURE_URL=redis://:change-me@redis.default:6379

# Optional Upstash compatibility
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
