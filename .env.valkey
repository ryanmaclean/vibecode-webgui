# ValKey / Redis URL configuration across environments

# Shared credentials (store real values in Azure Key Vault / Kubernetes Secret)
VALKEY_PASSWORD=__REPLACE_WITH_VALKEY_PASSWORD__
VALKEY_DB=0

# Development environment - local workstation
VALKEY_URL=redis://localhost:6379

# Docker Compose environment (service name `valkey`)
VALKEY_DOCKER_URL=redis://valkey:6379

# Kubernetes environment (main cluster)
VALKEY_K8S_URL=redis://valkey-service:6379

# Kubernetes environment (secure ValKey with auth)
VALKEY_K8S_SECURE_URL=redis://:__REPLACE_WITH_VALKEY_PASSWORD__@valkey-service:6379

# KIND local Kubernetes environment (vibecode-platform namespace)
VALKEY_KIND_URL=redis://valkey-service.vibecode-platform.svc.cluster.local:6379

# Production environment (require credentials / TLS if provisioned)
VALKEY_PRODUCTION_URL=redis://:__REPLACE_WITH_VALKEY_PASSWORD__@valkey-prod:6379

# Host/port fallbacks for clients that do not support URL syntax
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Backward-compatible Redis aliases (mirror ValKey values)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__REPLACE_WITH_VALKEY_PASSWORD__
REDIS_DB=0

# Additional context-specific aliases
REDIS_DOCKER_URL=redis://valkey:6379
REDIS_K8S_URL=redis://valkey-service:6379
REDIS_K8S_SECURE_URL=redis://:__REPLACE_WITH_VALKEY_PASSWORD__@valkey-service:6379

# Optional Upstash compatibility
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
