# Development Environment Configuration
# Copy this file to .env.local for local development

# =============================================================================
# DATADOG DBM-APM CONNECTION CONFIGURATION
# =============================================================================

# Core Datadog Configuration (Required for DBM-APM connection)
DD_API_KEY=your-datadog-api-key-here
DD_SITE=datadoghq.com
DD_SERVICE=vibecode-webgui
DD_ENV=development
DD_VERSION=0.1.0-dev

# Database Monitoring Propagation (Required for DBM-APM connection)
# Docs: https://docs.datadoghq.com/database_monitoring/connect_dbm_and_apm/
DD_DBM_PROPAGATION_MODE=full
DD_DBM_TRACE_INJECTION=true

# APM Configuration
DD_TRACE_ENABLED=true
DD_TRACE_SAMPLE_RATE=1.0
DD_TRACE_ANALYTICS_ENABLED=true

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/vibecode
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vibecode
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Application Configuration
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# AI Service Configuration (Optional)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=VibeCode Development

# Redis Configuration
REDIS_URL=redis://localhost:6379

# =============================================================================
# DEVELOPMENT-SPECIFIC SETTINGS
# =============================================================================

# Enable verbose logging for development
DD_TRACE_DEBUG=true
DD_TRACE_STARTUP_LOGS=true
DD_TRACE_LOG_LEVEL=debug

# Enable all monitoring features for development
DD_PROFILING_ENABLED=true
DD_RUNTIME_METRICS_ENABLED=true
DD_LLMOBS_ENABLED=true
DD_LLMOBS_AGENTLESS_ENABLED=true
DD_LLMOBS_ML_APP=vibecode-ai-dev

# Development-specific sampling rates (100% for debugging)
DD_TRACE_SAMPLE_RATE=1.0
DD_DBM_SAMPLE_RATE=1.0

# =============================================================================
# VALIDATION COMMANDS
# =============================================================================

# Test DBM-APM connection:
# curl -X GET "https://api.datadoghq.com/api/v1/validate" \
#   -H "DD-API-KEY: $DD_API_KEY"

# Check database connectivity:
# psql $DATABASE_URL -c "SELECT version();"

# Test Redis connectivity:
# redis-cli -u $REDIS_URL ping
