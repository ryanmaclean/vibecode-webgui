{
  "title": "VibeCode VMs Overview",
  "description": "Complete observability dashboard for VibeCode virtual machines with system metrics, network performance, and application health",
  "layout_type": "ordered",
  "notify_list": [],
  "template_variables": [],
  "widgets": [
    {
      "definition": {
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:system.cpu.user{host:vibecode*} by {host}",
            "display_type": "line",
            "style": {
              "palette": "cool"
            }
          }
        ],
        "title": "CPU User Time by VM",
        "show_legend": true,
        "legend_layout": "vertical",
        "legend_columns": ["avg", "min", "max"]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 4,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:system.mem.used{host:vibecode*} by {host}",
            "display_type": "area",
            "style": {
              "palette": "warm"
            }
          }
        ],
        "title": "Memory Usage by VM",
        "show_legend": true,
        "legend_layout": "vertical",
        "legend_columns": ["avg", "min", "max"]
      },
      "layout": {
        "x": 4,
        "y": 0,
        "width": 4,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "query_value",
        "requests": [
          {
            "q": "count_nonzero(avg:system.uptime{host:vibecode*})"
          }
        ],
        "title": "Active VMs",
        "precision": 0,
        "conditional_formats": [
          {
            "comparator": ">=",
            "value": 1,
            "palette": "green_on_white"
          }
        ]
      },
      "layout": {
        "x": 8,
        "y": 0,
        "width": 2,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "query_value",
        "requests": [
          {
            "q": "avg:system.cpu.user{host:vibecode*}"
          }
        ],
        "title": "Avg CPU %",
        "precision": 1,
        "conditional_formats": [
          {
            "comparator": "<",
            "value": 30,
            "palette": "green_on_white"
          },
          {
            "comparator": ">=",
            "value": 30,
            "comparator": "<",
            "value": 70,
            "palette": "yellow_on_white"
          },
          {
            "comparator": ">=",
            "value": 70,
            "palette": "red_on_white"
          }
        ]
      },
      "layout": {
        "x": 10,
        "y": 0,
        "width": 2,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:system.net.bytes_rcvd{host:vibecode*}.as_rate() by {host}",
            "display_type": "line",
            "style": {
              "palette": "blue"
            }
          },
          {
            "q": "sum:system.net.bytes_sent{host:vibecode*}.as_rate() by {host}",
            "display_type": "line",
            "style": {
              "palette": "purple"
            }
          }
        ],
        "title": "Network Throughput",
        "show_legend": true,
        "legend_layout": "vertical",
        "legend_columns": ["avg", "max"]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 6,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:system.disk.in_use{host:vibecode*} by {host}",
            "display_type": "line",
            "style": {
              "palette": "orange"
            }
          }
        ],
        "title": "Disk Usage %",
        "show_legend": true,
        "legend_layout": "vertical",
        "legend_columns": ["avg", "max"]
      },
      "layout": {
        "x": 6,
        "y": 3,
        "width": 3,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "query_value",
        "requests": [
          {
            "q": "avg:system.processes{host:vibecode*}"
          }
        ],
        "title": "Avg Process Count",
        "precision": 0
      },
      "layout": {
        "x": 9,
        "y": 3,
        "width": 3,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:system.load.1{host:vibecode*} by {host}",
            "display_type": "line",
            "style": {
              "palette": "grey"
            }
          }
        ],
        "title": "Load Average (1min)",
        "show_legend": true,
        "legend_layout": "vertical",
        "legend_columns": ["avg", "max"]
      },
      "layout": {
        "x": 0,
        "y": 6,
        "width": 4,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:system.disk.reads{host:vibecode*}.as_rate() by {host}",
            "display_type": "line",
            "style": {
              "palette": "cool"
            }
          },
          {
            "q": "sum:system.disk.writes{host:vibecode*}.as_rate() by {host}",
            "display_type": "line",
            "style": {
              "palette": "warm"
            }
          }
        ],
        "title": "Disk I/O Operations",
        "show_legend": true,
        "legend_layout": "vertical"
      },
      "layout": {
        "x": 4,
        "y": 6,
        "width": 4,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "query_value",
        "requests": [
          {
            "q": "avg:system.mem.used{host:vibecode*} / avg:system.mem.total{host:vibecode*} * 100"
          }
        ],
        "title": "Memory %",
        "precision": 1,
        "conditional_formats": [
          {
            "comparator": "<",
            "value": 60,
            "palette": "green_on_white"
          },
          {
            "comparator": ">=",
            "value": 60,
            "comparator": "<",
            "value": 80,
            "palette": "yellow_on_white"
          },
          {
            "comparator": ">=",
            "value": 80,
            "palette": "red_on_white"
          }
        ]
      },
      "layout": {
        "x": 8,
        "y": 6,
        "width": 2,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "query_value",
        "requests": [
          {
            "q": "avg:process.up{process_name:datadog-agent, host:vibecode*}"
          }
        ],
        "title": "Datadog Agent Status",
        "precision": 0,
        "conditional_formats": [
          {
            "comparator": "==",
            "value": 1,
            "palette": "green_on_white"
          },
          {
            "comparator": "!=",
            "value": 1,
            "palette": "red_on_white"
          }
        ]
      },
      "layout": {
        "x": 10,
        "y": 6,
        "width": 2,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:system.cpu.system{host:vibecode*} by {host}",
            "display_type": "line",
            "style": {
              "palette": "red"
            }
          }
        ],
        "title": "CPU System Time",
        "show_legend": true,
        "legend_layout": "vertical"
      },
      "layout": {
        "x": 0,
        "y": 9,
        "width": 4,
        "height": 2
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:system.cpu.iowait{host:vibecode*} by {host}",
            "display_type": "line",
            "style": {
              "palette": "orange"
            }
          }
        ],
        "title": "CPU I/O Wait",
        "show_legend": true,
        "legend_layout": "vertical"
      },
      "layout": {
        "x": 4,
        "y": 9,
        "width": 4,
        "height": 2
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:system.mem.free{host:vibecode*} by {host}",
            "display_type": "area",
            "style": {
              "palette": "green"
            }
          }
        ],
        "title": "Free Memory",
        "show_legend": true,
        "legend_layout": "vertical"
      },
      "layout": {
        "x": 8,
        "y": 9,
        "width": 4,
        "height": 2
      }
    }
  ]
}
