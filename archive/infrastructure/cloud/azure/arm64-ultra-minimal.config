CONFIG_CRYPTO_DES=n
CONFIG_CRYPTO_FCRYPT=n
CONFIG_CRYPTO_KHAZAD=n
CONFIG_CRYPTO_SALSA20=n
CONFIG_CRYPTO_CHACHA20=n
CONFIG_CRYPTO_SEED=n
CONFIG_CRYPTO_SERPENT=n
CONFIG_CRYPTO_SM4=n
CONFIG_CRYPTO_TEA=n
CONFIG_CRYPTO_TWOFISH=n
CONFIG_CRYPTO_DEFLATE=n
CONFIG_CRYPTO_LZO=n
CONFIG_CRYPTO_842=n
CONFIG_CRYPTO_LZ4=n
CONFIG_CRYPTO_LZ4HC=n
CONFIG_CRYPTO_ZSTD=n

# Binary formats
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=n
CONFIG_COREDUMP=n

# Essential kernel features
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_FHANDLE=y
CONFIG_USELIB=n

# Initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n

# NO KVM/virtualization
CONFIG_VIRTUALIZATION=n
CONFIG_KVM=n
CONFIG_KVM_ARM_HOST=n

# Essential for userspace
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=n
CONFIG_QUOTA=n
CONFIG_QUOTACTL=n

# NO tracing/profiling
CONFIG_TRACING=n
CONFIG_FTRACE=n
CONFIG_FUNCTION_TRACER=n
CONFIG_STACK_TRACER=n
CONFIG_DYNAMIC_FTRACE=n
CONFIG_FUNCTION_PROFILER=n
CONFIG_KPROBES=n
CONFIG_KRETPROBES=n
CONFIG_UPROBES=n

# NO misc hardware
CONFIG_INPUT=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_MISC=n
CONFIG_SERIO=n
CONFIG_SERIO_SERPORT=n
CONFIG_SERIO_LIBPS2=n
CONFIG_VT=n
CONFIG_HID=n
CONFIG_HID_GENERIC=n
CONFIG_USB_HID=n

# NO PCMCIA/CardBus
CONFIG_PCCARD=n

# NO MTD
CONFIG_MTD=n

# NO IIO
CONFIG_IIO=n

# NO staging drivers
CONFIG_STAGING=n

# NO sample code
CONFIG_SAMPLES=n

# ARM64-specific optimizations
CONFIG_ARM64_CRYPTO=n
CONFIG_CRYPTO_SHA1_ARM64_CE=n
CONFIG_CRYPTO_SHA2_ARM64_CE=n
CONFIG_CRYPTO_GHASH_ARM64_CE=n
CONFIG_CRYPTO_AES_ARM64=n
CONFIG_CRYPTO_AES_ARM64_CE=n
CONFIG_CRYPTO_AES_ARM64_CE_CCM=n
CONFIG_CRYPTO_AES_ARM64_CE_BLK=n
CONFIG_CRYPTO_AES_ARM64_NEON_BLK=n
CONFIG_CRYPTO_CHACHA20_NEON=n
CONFIG_CRYPTO_AES_ARM64_BS=n

# Firmware loading (minimal)
CONFIG_FW_LOADER=n
CONFIG_FIRMWARE_IN_KERNEL=n
CONFIG_EXTRA_FIRMWARE=""

# ARM64 errata (disable for speed)
CONFIG_ARM64_ERRATUM_826319=n
CONFIG_ARM64_ERRATUM_827319=n
CONFIG_ARM64_ERRATUM_824069=n
CONFIG_ARM64_ERRATUM_819472=n
CONFIG_ARM64_ERRATUM_832075=n
