# ARM64 Ultra-Minimal Kernel Config
# Target: 800 KB kernel for Apple Silicon VMs
# OpenVSCode Server only - No modules, virtio only

CONFIG_ARM64=y
CONFIG_64BIT=y

# NO modules - everything built-in
CONFIG_MODULES=n

# Minimal ARM64
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_PAGE_SHIFT=12
CONFIG_ARM64_4K_PAGES=y

# CPU (minimal)
CONFIG_NR_CPUS=4
CONFIG_SMP=y
CONFIG_SCHED_MC=y
CONFIG_PREEMPT_NONE=y

# Memory (simple flat)
CONFIG_FLATMEM=y
CONFIG_FLATMEM_MANUAL=y
CONFIG_HAVE_MEMBLOCK=y
CONFIG_NO_BOOTMEM=y
CONFIG_SPARSEMEM_MANUAL=n

# Optimize for SIZE (critical)
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EMBEDDED=y
CONFIG_EXPERT=y
CONFIG_SLOB=y
CONFIG_PROFILING=n

# Minimal kernel features
CONFIG_IKCONFIG=n
CONFIG_IKCONFIG_PROC=n
CONFIG_KALLSYMS=n
CONFIG_KALLSYMS_ALL=n
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_BASE_FULL=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y

# NO debugging
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_REDUCED=n
CONFIG_DEBUG_FS=n
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_STACK_VALIDATION=n
CONFIG_DEBUG_RODATA=n

# NO security modules
CONFIG_SECURITY=n
CONFIG_SECURITYFS=n
CONFIG_SECURITY_NETWORK=n
CONFIG_AUDIT=n

# NO namespaces/cgroups (VM isolation, not container)
CONFIG_NAMESPACES=n
CONFIG_UTS_NS=n
CONFIG_IPC_NS=n
CONFIG_USER_NS=n
CONFIG_PID_NS=n
CONFIG_NET_NS=n
CONFIG_CGROUPS=n

# Block layer (minimal)
CONFIG_BLOCK=y
CONFIG_BLK_DEV=n
CONFIG_BLK_DEV_LOOP=n
CONFIG_BLK_DEV_NBD=n
CONFIG_BLK_DEV_RAM=n

# Networking (TCP/IP only, minimal)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=n
CONFIG_IP_ADVANCED_ROUTER=n
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=n
CONFIG_IP_PNP_RARP=n
CONFIG_SYN_COOKIES=n

# NO IPv6
CONFIG_IPV6=n
CONFIG_IPV6_ROUTER_PREF=n
CONFIG_IPV6_OPTIMISTIC_DAD=n

# NO netfilter/iptables
CONFIG_NETFILTER=n
CONFIG_NETFILTER_ADVANCED=n
CONFIG_NF_CONNTRACK=n
CONFIG_NF_TABLES=n
CONFIG_NETFILTER_XT_TARGET_LOG=n

# Packet socket (for DHCP)
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=n
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=n

# NO wireless/bluetooth
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n
CONFIG_BT=n
CONFIG_BT_BREDR=n
CONFIG_BT_LE=n

# virtio ONLY (built-in, not modules)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=n
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_BALLOON=n
CONFIG_VIRTIO_INPUT=n
CONFIG_VIRTIO_CRYPTO=n

# NO other device drivers
CONFIG_SCSI=n
CONFIG_ATA=n
CONFIG_MD=n
CONFIG_DM=n
CONFIG_FUSION=n
CONFIG_IEEE1394=n
CONFIG_I2O=n
CONFIG_MACINTOSH_DRIVERS=n
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_MII=n
CONFIG_ETHERNET=n
CONFIG_NET_VENDOR_3COM=n
CONFIG_NET_VENDOR_ADAPTEC=n
CONFIG_NET_VENDOR_ALTEON=n
CONFIG_NET_VENDOR_AMD=n
CONFIG_NET_VENDOR_ARC=n
CONFIG_NET_VENDOR_ATHEROS=n
CONFIG_NET_VENDOR_BROADCOM=n
CONFIG_NET_VENDOR_BROCADE=n
CONFIG_NET_VENDOR_CHELSIO=n
CONFIG_NET_VENDOR_CISCO=n
CONFIG_NET_VENDOR_DEC=n
CONFIG_NET_VENDOR_DLINK=n
CONFIG_NET_VENDOR_EMULEX=n
CONFIG_NET_VENDOR_EXAR=n
CONFIG_NET_VENDOR_HP=n
CONFIG_NET_VENDOR_INTEL=n
CONFIG_NET_VENDOR_MARVELL=n
CONFIG_NET_VENDOR_MELLANOX=n
CONFIG_NET_VENDOR_MICREL=n
CONFIG_NET_VENDOR_MYRI=n
CONFIG_NET_VENDOR_NATSEMI=n
CONFIG_NET_VENDOR_NVIDIA=n
CONFIG_NET_VENDOR_OKI=n
CONFIG_NET_VENDOR_QLOGIC=n
CONFIG_NET_VENDOR_REALTEK=n
CONFIG_NET_VENDOR_RDC=n
CONFIG_NET_VENDOR_SILAN=n
CONFIG_NET_VENDOR_SIS=n
CONFIG_NET_VENDOR_SMSC=n
CONFIG_NET_VENDOR_STMICRO=n
CONFIG_NET_VENDOR_SUN=n
CONFIG_NET_VENDOR_TEHUTI=n
CONFIG_NET_VENDOR_TI=n
CONFIG_NET_VENDOR_VIA=n
CONFIG_NET_VENDOR_WIZNET=n

# Filesystems (tmpfs ONLY - run from RAM)
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=n
CONFIG_TMPFS_XATTR=n
CONFIG_TMPFS_INODE64=y

# Proc/sys (minimal)
CONFIG_PROC_FS=y
CONFIG_PROC_KCORE=n
CONFIG_PROC_SYSCTL=y
CONFIG_PROC_PAGE_MONITOR=n
CONFIG_SYSFS=y

# Devtmpfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# NO other filesystems
CONFIG_EXT4_FS=n
CONFIG_EXT3_FS=n
CONFIG_EXT2_FS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_NTFS_FS=n
CONFIG_FUSE_FS=n
CONFIG_OVERLAY_FS=n
CONFIG_VFAT_FS=n
CONFIG_FAT_FS=n
CONFIG_MSDOS_FS=n
CONFIG_ISO9660_FS=n
CONFIG_UDF_FS=n
CONFIG_SQUASHFS=n
CONFIG_CRAMFS=n
CONFIG_ROMFS_FS=n

# NO USB
CONFIG_USB_SUPPORT=n
CONFIG_USB=n
CONFIG_USB_EHCI_HCD=n
CONFIG_USB_OHCI_HCD=n
CONFIG_USB_UHCI_HCD=n

# NO sound
CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_SND_TIMER=n
CONFIG_SND_PCM=n

# NO graphics/DRM
CONFIG_DRM=n
CONFIG_DRM_FBDEV_EMULATION=n
CONFIG_FB=n
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_VGA_CONSOLE=n
CONFIG_LOGO=n

# Console (serial only for Apple Silicon)
CONFIG_TTY=y
CONFIG_SERIAL_8250=n
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_HVC_DRIVER=y
CONFIG_HVC_DCC=n

# NO power management
CONFIG_PM=n
CONFIG_PM_SLEEP=n
CONFIG_PM_AUTOSLEEP=n
CONFIG_PM_WAKELOCKS=n
CONFIG_PM_RUNTIME=n
CONFIG_ACPI=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_CPU_IDLE=n
CONFIG_CPU_FREQ=n

# NO hardware monitoring
CONFIG_HWMON=n
CONFIG_THERMAL=n
CONFIG_WATCHDOG=n
CONFIG_SENSORS_CORETEMP=n

# NO crypto hardware
CONFIG_CRYPTO_HW=n
CONFIG_CRYPTO_DEV_VIRTIO=n

# Minimal crypto (for TCP/IP)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ALGAPI=y
CONFIG_CRYPTO_ALGAPI2=y
CONFIG_CRYPTO_AEAD=n
CONFIG_CRYPTO_AEAD2=n
CONFIG_CRYPTO_SKCIPHER=n
CONFIG_CRYPTO_SKCIPHER2=n
CONFIG_CRYPTO_HASH=y
CONFIG_CRYPTO_HASH2=y
CONFIG_CRYPTO_RNG=n
CONFIG_CRYPTO_RNG2=n
CONFIG_CRYPTO_AKCIPHER=n
CONFIG_CRYPTO_AKCIPHER2=n
CONFIG_CRYPTO_KPP=n
CONFIG_CRYPTO_KPP2=n
CONFIG_CRYPTO_RSA=n
CONFIG_CRYPTO_DH=n
CONFIG_CRYPTO_ECDH=n
CONFIG_CRYPTO_MANAGER=n
CONFIG_CRYPTO_MANAGER2=n
CONFIG_CRYPTO_USER=n
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
CONFIG_CRYPTO_GF128MUL=n
CONFIG_CRYPTO_NULL=n
CONFIG_CRYPTO_CRYPTD=n
CONFIG_CRYPTO_AUTHENC=n
CONFIG_CRYPTO_TEST=n
CONFIG_CRYPTO_CCM=n
CONFIG_CRYPTO_GCM=n
CONFIG_CRYPTO_CHACHA20POLY1305=n
CONFIG_CRYPTO_SEQIV=n
CONFIG_CRYPTO_ECHAINIV=n
CONFIG_CRYPTO_CBC=n
CONFIG_CRYPTO_CTR=n
CONFIG_CRYPTO_CTS=n
CONFIG_CRYPTO_ECB=n
CONFIG_CRYPTO_LRW=n
CONFIG_CRYPTO_PCBC=n
CONFIG_CRYPTO_XTS=n
CONFIG_CRYPTO_KEYWRAP=n
CONFIG_CRYPTO_ADIANTUM=n
CONFIG_CRYPTO_ESSIV=n
CONFIG_CRYPTO_CMAC=n
CONFIG_CRYPTO_HMAC=n
CONFIG_CRYPTO_XCBC=n
CONFIG_CRYPTO_VMAC=n
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_CRC32=y
CONFIG_CRYPTO_CRC32_ARM64_CE=n
CONFIG_CRYPTO_CRCT10DIF=n
CONFIG_CRYPTO_GHASH=n
CONFIG_CRYPTO_POLY1305=n
CONFIG_CRYPTO_MD4=n
CONFIG_CRYPTO_MD5=n
CONFIG_CRYPTO_MICHAEL_MIC=n
CONFIG_CRYPTO_RMD128=n
CONFIG_CRYPTO_RMD160=n
CONFIG_CRYPTO_RMD256=n
CONFIG_CRYPTO_RMD320=n
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=n
CONFIG_CRYPTO_SHA3=n
CONFIG_CRYPTO_SM3=n
CONFIG_CRYPTO_STREEBOG=n
CONFIG_CRYPTO_WP512=n
CONFIG_CRYPTO_AES=n
CONFIG_CRYPTO_AES_TI=n
CONFIG_CRYPTO_ANUBIS=n
