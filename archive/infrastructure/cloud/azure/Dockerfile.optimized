# Optimized Alpine Dockerfile - Target ~410 MB (down from 480 MB)
# Aggressive optimization while maintaining Alpine base

# Stage 1: Builder
FROM alpine:3.19 AS builder

RUN apk add --no-cache \
    wget \
    curl \
    tar \
    gzip \
    ca-certificates

# Download OpenVSCode Server
WORKDIR /tmp
RUN OPENVSCODE_VERSION="1.95.3" && \
    wget -q "https://github.com/gitpod-io/openvscode-server/releases/download/openvscode-server-v${OPENVSCODE_VERSION}/openvscode-server-v${OPENVSCODE_VERSION}-linux-x64.tar.gz" && \
    tar xzf openvscode-server-v${OPENVSCODE_VERSION}-linux-x64.tar.gz && \
    mv openvscode-server-v${OPENVSCODE_VERSION}-linux-x64 /opt/openvscode-server && \
    # OPTIMIZATION: Remove unnecessary files
    cd /opt/openvscode-server && \
    rm -rf \
        node_modules/typescript/lib/*.d.ts \
        node_modules/@types \
        resources/server/web/callback.html \
        extensions/*/out/**/*.map \
        extensions/*/out/test \
        extensions/*/images \
        extensions/*/syntaxes/*.tmLanguage \
        extensions/markdown-language-features/media/*.gif \
        extensions/markdown-language-features/notebook-out \
        out/**/*.map \
        out/vs/code/node/cli*.js && \
    # Strip binaries
    find . -type f -executable -exec strip --strip-unneeded {} + 2>/dev/null || true

# Download Datadog Agent (minimal)
RUN wget -q -O /tmp/datadog-agent.tar.gz \
    "https://s3.amazonaws.com/dd-agent/datadog-agent-7-latest.x86_64.tar.gz" && \
    mkdir -p /opt/datadog-agent && \
    tar xzf /tmp/datadog-agent.tar.gz -C /opt/datadog-agent && \
    # OPTIMIZATION: Keep only essential Datadog components
    cd /opt/datadog-agent && \
    rm -rf \
        embedded/share/doc \
        embedded/share/man \
        embedded/include \
        embedded/lib/python*/test \
        embedded/lib/python*/site-packages/*/tests

# Stage 2: Runtime (Optimized)
FROM alpine:3.19

# OPTIMIZATION: Install only runtime essentials, no dev packages
RUN apk add --no-cache \
    # Node.js runtime (no npm)
    nodejs \
    # Python runtime (no pip initially)
    python3 \
    # Minimal tooling
    libstdc++ \
    libgcc \
    ca-certificates \
    # Process manager
    tini \
    && \
    # Clean up APK cache aggressively
    rm -rf /var/cache/apk/* \
    /tmp/* \
    /var/tmp/* \
    /usr/share/man/* \
    /usr/share/doc/* \
    /usr/share/info/*

# Create non-root user
RUN addgroup -g 1000 openvscode && \
    adduser -u 1000 -G openvscode -s /bin/sh -D openvscode

# Copy from builder
COPY --from=builder /opt/openvscode-server /opt/openvscode-server
COPY --from=builder /opt/datadog-agent /opt/datadog-agent

# Create minimal directory structure
RUN mkdir -p /workspace /opt/mcp-servers && \
    chown -R openvscode:openvscode /workspace /opt/mcp-servers

# Optimized startup script
COPY <<'EOF' /opt/startup.sh
#!/bin/sh
set -e

# Start Datadog if API key provided
if [ -n "$DATADOG_API_KEY" ]; then
    /opt/datadog-agent/bin/agent/agent run &
fi

# Start OpenVSCode Server
exec /opt/openvscode-server/bin/openvscode-server \
    --host 0.0.0.0 \
    --port 3000 \
    --without-connection-token \
    --accept-server-license-terms
EOF

RUN chmod +x /opt/startup.sh && \
    chown openvscode:openvscode /opt/startup.sh

USER openvscode
WORKDIR /workspace

EXPOSE 3000

# Minimal health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD wget -q --spider http://localhost:3000/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/opt/startup.sh"]

# Build metadata
LABEL org.opencontainers.image.title="OpenVSCode Server (Optimized)" \
      org.opencontainers.image.description="Optimized Alpine-based OpenVSCode Server with Datadog" \
      org.opencontainers.image.version="1.95.3" \
      org.opencontainers.image.base.name="alpine:3.19"
