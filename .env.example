# ===========================================
# VibeCode Web GUI Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control
#
# Generate secrets with: openssl rand -base64 32
# ===========================================

# ===========================================
# Application Configuration
# ===========================================
NODE_ENV=development
PORT=3000
ENVIRONMENT=local

# ===========================================
# Authentication & Security (REQUIRED)
# ===========================================

# NextAuth Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_SECURE_SECRET_MIN_32_CHARS

# JWT Secret for WebSocket Authentication
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_SECURE_SECRET_MIN_32_CHARS

# Cookie Settings (production)
COOKIE_DOMAIN=

# OAuth Providers (optional)
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-app-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# Database Configuration (REQUIRED)
# ===========================================

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:SECURE_PASSWORD@localhost:5432/vibecode
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD_MIN_16_CHARS
POSTGRES_DB=vibecode

# Database Host/Port (alternative to DATABASE_URL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_NAME=vibecode

# Test Database
POSTGRES_TEST_PASSWORD=test_password

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_AGENT_DB=1
REDIS_TLS_ENABLED=false
REDIS_AOF_ENABLED=true
REDIS_AOF_FSYNC=everysec
REDIS_RDB_ENABLED=true
REDIS_REPLICA_ENABLED=false

# ===========================================
# AI Services (Required for AI Chat Features)
# ===========================================

# OpenAI API - Used for AI chat streaming and completions
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_ORGANIZATION=org-your_org_id

# Anthropic Claude API - Alternative AI provider
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# OpenRouter - Unified API for multiple AI providers
# Get your API key from: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Google AI
GOOGLE_AI_API_KEY=your_google_ai_key_here

# Azure OpenAI (if using)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4-turbo
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4-turbo
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-large

# HuggingFace
HUGGINGFACE_API_KEY=hf_your_key_here

# Code Generation Model
CODE_GENERATION_MODEL=claude-3.5-haiku

# AI Provider Configuration
AI_PROVIDER=openai
AI_MODEL=gpt-4-turbo-preview

# ===========================================
# Datadog Monitoring (Server-side)
# ===========================================

# Datadog API Keys
DD_API_KEY=your_datadog_api_key
DD_APP_KEY=your_datadog_app_key
DD_SITE=datadoghq.com

# Service Identification
DD_SERVICE=vibecode-webgui
DD_ENV=development
DD_VERSION=1.0.0

# APM & Tracing
DD_TRACE_ENABLED=false
DD_APM_ENABLED=true
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126
DD_TRACE_SAMPLE_RATE=1.0
DD_TRACE_ANALYTICS_ENABLED=true
DD_TRACE_DEBUG=false
DD_TRACE_STARTUP_LOGS=true

# Profiling & Logs
DD_PROFILING_ENABLED=false
DD_LOGS_INJECTION=false
DD_LOGS_ENABLED=true
DD_LOG_LEVEL=INFO

# Database & Runtime Monitoring
DD_DATABASE_MONITORING_ENABLED=false
DD_RUNTIME_METRICS_ENABLED=true
DD_PROCESS_AGENT_ENABLED=true
DD_DOCKER_ENABLED=true

# Dynamic Instrumentation
DD_DYNAMIC_INSTRUMENTATION_ENABLED=false

# LLM Observability
DD_LLMOBS_ENABLED=false
DD_LLMOBS_AGENTLESS_ENABLED=false
DD_LLMOBS_ML_APP=vibecode-ai

# Custom Tags (comma-separated)
DD_TAGS=project:vibecode,team:engineering

# Git Integration
DD_GIT_REPOSITORY_URL=https://github.com/your-org/vibecode-webgui

# RUM Data
DD_ENABLE_GET_RUM_DATA=false

# ===========================================
# Datadog RUM (Real User Monitoring - Client-side)
# ===========================================
# Get these from: https://app.datadoghq.com/rum/application/create
# NOTE: NEXT_PUBLIC_* vars are exposed to the browser

NEXT_PUBLIC_DD_APPLICATION_ID=your_rum_application_id
NEXT_PUBLIC_DD_CLIENT_TOKEN=your_rum_client_token
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_DD_ENV=development
NEXT_PUBLIC_DD_SERVICE=vibecode-webgui
NEXT_PUBLIC_DD_VERSION=1.0.0

# Legacy RUM variables (fallback)
NEXT_PUBLIC_DATADOG_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=

# ===========================================
# OpenTelemetry
# ===========================================
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=vibecode-webgui
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
NEXT_PUBLIC_OTEL_ENABLED=false
NEXT_PUBLIC_OTEL_EXPORTER_URL=/api/monitoring/traces

# ===========================================
# Vector Databases
# ===========================================

# ChromaDB
CHROMA_URL=http://localhost:8000
CHROMA_DB_URL=http://localhost:8000
CHROMA_DB_PATH=./data/chroma

# Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_PROTOCOL=http
WEAVIATE_API_KEY=
WEAVIATE_CLASS_NAME=VibeCodeDocument
WEAVIATE_MODEL=text-embedding-ada-002

# Supabase (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ===========================================
# Storage Configuration
# ===========================================

# File Upload Storage
UPLOAD_DIR=./data/uploads

# Azure Blob Storage (alternative to local filesystem)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# ===========================================
# Security Settings
# ===========================================

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_WINDOW=100
RATE_LIMIT_WINDOW_MS=900000

# Session Configuration
SESSION_MAX_AGE=3600000

# Production Security
FORCE_HTTPS=false
SECURE_COOKIES=false
HSTS_MAX_AGE=31536000

# ===========================================
# Feature Flags
# ===========================================
ENABLE_AI_FEATURES=true
ENABLE_MONITORING=false
ENABLE_CODE_EXECUTION=false
NEXT_PUBLIC_ENABLE_RUM_IN_DEV=false

# ===========================================
# Development Settings
# ===========================================

# Test Mode (skip auth in development)
MOCK_ORIGINS=false

# Debug Logging
DEBUG=false
LOG_LEVEL=info

# NextAuth Test Secret
NEXTAUTH_SECRET_TEST=test-secret-for-testing

# ===========================================
# Public App Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VibeCode
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_OPENROUTER_API_KEY=

# ===========================================
# MCP Server Configuration
# ===========================================
MCP_SERVER_PORT=3001
MCP_ENABLED=false
MCP_SERVER_URL=http://localhost:3000
WORKSPACE_PATH=/workspace
WORKSPACE_DIR=./workspace
CLI_MCP_WORKING_DIR=
CLI_MCP_SUBAGENTS=codex,cursor,gemini
AVAILABLE_MODELS=ai/smollm2:360M-Q4_K_M,ai/llama3.2:1b-Q4_K_M,ai/qwen2.5-coder:1.5b-Q4_K_M

# ===========================================
# Docker Model Runner
# ===========================================
DOCKER_MODEL_RUNNER_URL=http://model-runner.docker.internal/engines/v1
MODEL_RUNNER_ENDPOINT=http://model-runner.docker.internal/engines/v1
SPEECH_MODEL=ai/whisper:base-Q4_K_M

# ===========================================
# Docker Compose Service Credentials
# ===========================================

# Code Server
CODE_SERVER_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# PgAdmin
PGADMIN_EMAIL=admin@vibecode.dev
PGADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Grafana
GRAFANA_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ===========================================
# LiteLLM Configuration
# ===========================================
LITELLM_POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
LITELLM_REDIS_PASSWORD=
LITELLM_MASTER_KEY=REPLACE_WITH_SECURE_KEY
LITELLM_SALT_KEY=REPLACE_WITH_SECURE_SALT
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_API_KEY=

# ===========================================
# Authelia Authentication
# ===========================================
AUTHELIA_DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
# Generate secrets: openssl rand -base64 64
AUTHELIA_JWT_SECRET=REPLACE_WITH_SECURE_SECRET_MIN_64_CHARS
AUTHELIA_SESSION_SECRET=REPLACE_WITH_SECURE_SECRET_MIN_64_CHARS
AUTHELIA_STORAGE_ENCRYPTION_KEY=REPLACE_WITH_SECURE_KEY_MIN_64_CHARS

# ===========================================
# GitHub Integration
# ===========================================
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_OWNER=your-org
GITHUB_REPO=vibecode-webgui

# ===========================================
# Gastown Webhook Service
# ===========================================
GASTOWN_WEBHOOK_URL=https://gastown.example.com/api/webhooks/github-actions
GASTOWN_WEBHOOK=
GASTOWN_WEBHOOK_TARGET=auto
GASTOWN_WEBHOOK_AGENT=
GASTOWN_WEBHOOK_CREATE=true
GASTOWN_WEBHOOK_CMD_TIMEOUT=15
GASTOWN_WEBHOOK_SYNC_REPOS=false
GASTOWN_WEBHOOK_SYNC_INTERVAL=60
GASTOWN_DEFAULT_PRIORITY=P2
GASTOWN_WORKFLOW_FAILURE_PRIORITY=P1
GASTOWN_HEALER_TARGET=
GASTOWN_HEALER_AGENT=
GASTOWN_RIG=unknown

# ===========================================
# Slack Integration
# ===========================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_ENABLED=false

# ===========================================
# Kafka Configuration (Tundra Dome)
# ===========================================
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=tundra-beads-created

# ===========================================
# Azure Cloud Configuration
# ===========================================
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
AZURE_RESOURCE_GROUP=your_resource_group
AZURE_TEST_LOCATION=eastus
AZURE_TEST_RESOURCE_GROUP=

# ===========================================
# Vercel Deployment
# ===========================================
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_SCOPE=

# ===========================================
# Ansible/VM Configuration
# ===========================================
# Root password hash for VM images
# Generate with: openssl passwd -6 -salt yoursalt yourpassword
ANSIBLE_ROOT_PASSWORD_HASH=

# ===========================================
# Test Configuration
# ===========================================
ENABLE_AKS_E2E_TESTS=false
ENABLE_REAL_DEPLOYMENT=false
ENABLE_PERFORMANCE_TESTS=false
ENABLE_LOAD_TESTS=false
AKS_TEST_ENVIRONMENT=test
AKS_TEST_CLEANUP=true
SKIP_DB_TESTS=false

# Fast OpenVSCode Testing
FAST_OPENVSCODE_HOST=localhost
HANDSHAKE_ATTEMPTS=3
HANDSHAKE_SLEEP=1
HANDSHAKE_LOG_DIR=./artifacts

# ===========================================
# VibeCode SDK/CLI
# ===========================================
VIBECODE_API_URL=http://localhost:3000/api
VIBECODE_TOKEN=your_vibecode_token

# ===========================================
# Security Tool Versions
# ===========================================
KUBECTL_VERSION=v1.31.0
KUBENS_VERSION=v0.10.3
KUBECTX_VERSION=v0.9.5
HELM_VERSION=v3.16.0
BRANCH_PROTECTION_PROFILE=recommended

# ===========================================
# Airflow (Tundra Dome)
# ===========================================
AIRFLOW_HOME=/opt/airflow
