# ═══════════════════════════════════════════════════════════════════════════
# 12. SECURITY & SECRETS
# ═══════════════════════════════════════════════════════════════════════════

# [REQUIRED] JWT secret for token signing
# SECURITY: Generate with: openssl rand -base64 32
# Validation: Minimum 32 characters
JWT_SECRET=your-jwt-secret-min-32-chars

# [REQUIRED] Session secret for session encryption
# SECURITY: Generate with: openssl rand -base64 32
# Validation: Minimum 32 characters
SESSION_SECRET=your-session-secret-min-32-chars

# [OPTIONAL] Error tracking DSN (e.g., Sentry)
ERROR_TRACKING_DSN=

# ═══════════════════════════════════════════════════════════════════════════
# 13. RATE LIMITING & SECURITY
# ═══════════════════════════════════════════════════════════════════════════

# [OPTIONAL] Rate limiting configuration
# Max requests per time window
# Default: 100 requests per 15 minutes (900000ms)
# Adjust based on expected traffic and API usage
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=900000

# ═══════════════════════════════════════════════════════════════════════════
# 14. KUBERNETES & INFRASTRUCTURE
# ═══════════════════════════════════════════════════════════════════════════

# [OPTIONAL] Kubernetes configuration
# Path to kubeconfig file for cluster access
KUBECONFIG=

# [OPTIONAL] Kubernetes namespace
# Default namespace for deployed resources
KUBERNETES_NAMESPACE=vibecode-platform

# [OPTIONAL] Platform domain
# Production domain for the platform
PLATFORM_DOMAIN=vibecode.dev

# ═══════════════════════════════════════════════════════════════════════════
# 15. HEALTH CHECKS & DIAGNOSTICS
# ═══════════════════════════════════════════════════════════════════════════

# [OPTIONAL] Debug logging
# Enable verbose logging for troubleshooting
# CAUTION: May expose sensitive data, disable in production
ENABLE_DEBUG_LOGGING=true

# [OPTIONAL] Health check configuration
# Timeouts in milliseconds
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# ═══════════════════════════════════════════════════════════════════════════
# 16. TESTING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# [OPTIONAL] Test environment flags
# Enable real API calls in tests (usually disabled to avoid costs)
ENABLE_REAL_AI_TESTS=false
ENABLE_REAL_INTEGRATION_TESTS=false
ENABLE_REAL_DATADOG_TESTS=false
PLAYWRIGHT_TEST=false

# ═══════════════════════════════════════════════════════════════════════════
# 17. DEVELOPMENT TOOLS & MCP SERVERS
# ═══════════════════════════════════════════════════════════════════════════

# [OPTIONAL] Code Server (VS Code in browser)
# Password for accessing code-server web interface
CODE_SERVER_PASSWORD=change-me-for-production

# [OPTIONAL] MCP (Model Context Protocol) Server configuration
MCP_SERVER_PORT=3001
WORKSPACE_PATH=/workspace
AVAILABLE_MODELS=ai/smollm2:360M-Q4_K_M,ai/llama3.2:1b-Q4_K_M,ai/qwen2.5-coder:1.5b-Q4_K_M

# [OPTIONAL] Docker Model Runner integration
# Used for local AI model inference
DOCKER_MODEL_RUNNER_URL=http://model-runner.docker.internal/engines/v1
MODEL_RUNNER_ENDPOINT=http://model-runner.docker.internal/engines/v1

# [OPTIONAL] Voice processing model
SPEECH_MODEL=ai/whisper:base-Q4_K_M

# ═══════════════════════════════════════════════════════════════════════════
