# VibeCode WebGUI Environment Variables
# Copy to .env (or the appropriate environment-specific file) and replace placeholders with your real values.
# SECURITY: Never commit actual secrets.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret
PORT=3000
VITE_PORT=5173
DOCKER=false
KIND_CLUSTER=false

# -----------------------------------------------------------------------------
# Database & Caching
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/vibecode_dev
POSTGRES_URL=postgresql://username:password@localhost:5432/vibecode_dev
POSTGRESQL_URL=postgresql://username:password@localhost:5432/vibecode_dev
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_ENABLE_DYNAMIC_SIZING=true
DB_POOL_ENABLE_CONNECTION_VALIDATION=true
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
VALKEY_URL=redis://localhost:6379
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0
CHROMA_DB_URL=http://localhost:8000
COLLABORATION_SERVER_URL=http://localhost:3000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Primary AI Provider Defaults
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_FREE_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key
CLAUDE_API_KEY=your-claude-api-key
DEFAULT_LLM_MODEL=gpt-4-turbo
DEFAULT_AI_MODEL=gpt-4-turbo
MAX_TOKENS=4000
AI_MAX_TOKENS=4000
TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=30000
ENABLE_AI_ANALYTICS=true
ENABLE_AI_USAGE_TRACKING=true
AI_COST_TRACKING=true
ERROR_TRACKING_DSN=

# -----------------------------------------------------------------------------
# Observability & Datadog
# -----------------------------------------------------------------------------
DD_API_KEY=your-datadog-api-key
DATADOG_API_KEY=your-datadog-api-key
DD_APP_KEY=your-datadog-app-key
DATADOG_APP_KEY=your-datadog-app-key
DD_SITE=datadoghq.com
DD_ENV=development
DD_SERVICE=vibecode-webgui
DD_VERSION=1.0.0
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_DD_APPLICATION_ID=your-rum-application-id
NEXT_PUBLIC_DD_CLIENT_TOKEN=your-rum-client-token
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_ENABLE_RUM_IN_DEV=false
# Legacy RUM env vars (fallbacks kept for compatibility)
NEXT_PUBLIC_DATADOG_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com
NEXT_PUBLIC_DATADOG_RUM_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_RUM_CLIENT_TOKEN=
DD_POSTGRES_USER=datadog
DD_POSTGRES_PASSWORD=
DATADOG_DBMON_PASSWORD=
DD_DBM_PROPAGATION_MODE=service
DD_DBM_TRACE_INJECTION=false
DD_TRACE_ENABLED=true
DD_TRACE_SAMPLE_RATE=0.2
DD_TRACE_ANALYTICS_ENABLED=false
DD_RUNTIME_METRICS_ENABLED=true
DD_PROFILING_ENABLED=false
DD_LLMOBS_ENABLED=false
DD_LLMOBS_AGENTLESS_ENABLED=false
DD_LLMOBS_ML_APP=vibecode-ai
ENABLE_MONITORING=true
ENABLE_PERFORMANCE_TRACKING=false
ENABLE_ERROR_TRACKING=true
ENABLE_DATADOG_INTEGRATION_TESTS=false
DD_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Authentication Providers
# -----------------------------------------------------------------------------
GITHUB_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# -----------------------------------------------------------------------------
# Platform & Infrastructure (optional)
# -----------------------------------------------------------------------------
AZURE_PG_HOST=
AZURE_PG_DB=
DEV_POSTGRES_URL=
STAGING_POSTGRES_URL=
DEV_AZURE_POSTGRES_PASSWORD=
STAGING_AZURE_POSTGRES_PASSWORD=
DD_AZURE_POSTGRES_USERNAME=
DD_AZURE_POSTGRES_PASSWORD=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2023-05-15
KUBECONFIG=
KUBERNETES_NAMESPACE=vibecode-platform
PLATFORM_DOMAIN=vibecode.dev

# -----------------------------------------------------------------------------
# Security & Rate Limiting
# -----------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret
SESSION_SECRET=your-session-secret
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# -----------------------------------------------------------------------------
# Diagnostics & Health Checks
# -----------------------------------------------------------------------------
ENABLE_DEBUG_LOGGING=true
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# -----------------------------------------------------------------------------
# Testing Toggles
# -----------------------------------------------------------------------------
ENABLE_REAL_AI_TESTS=false
ENABLE_REAL_INTEGRATION_TESTS=false
ENABLE_REAL_DATADOG_TESTS=false
PLAYWRIGHT_TEST=false

# -----------------------------------------------------------------------------
# Additional AI Gateway Preferences (optional overrides)
# -----------------------------------------------------------------------------
# DEFAULT_AI_MODEL=anthropic/claude-3-sonnet
# AI_REQUEST_TIMEOUT=60000
# AI_MAX_TOKENS=8192

# Legacy toggles (uncomment as needed)
# OTEL_ENABLED=false
# DD_ENABLED=true
# DD_ENABLE_GET_RUM_DATA=false
# SKIP_MONITORING=false
# DOCKER_BUILD=true
