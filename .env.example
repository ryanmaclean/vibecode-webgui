# VibeCode WebGUI Environment Variables
# Copy this file to .env (preferred) and fill in your actual values
# Optionally use .env.local for Next.js local-only overrides
# SECURITY: Never commit actual secrets to version control

# =============================================================================
# DATADOG CONFIGURATION
# =============================================================================
# Get your API key from: https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=your-datadog-api-key-here
DD_SITE=datadoghq.com
DD_ENV=development
DD_SERVICE=vibecode-webgui
DD_VERSION=1.0.0

# Frontend RUM Configuration (exposed to the browser)
NEXT_PUBLIC_DD_APPLICATION_ID=your-rum-application-id
NEXT_PUBLIC_DD_CLIENT_TOKEN=your-rum-client-token
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_APP_VERSION=1.0.0
# Legacy NEXT_PUBLIC_DATADOG_* variables are still recognized as a fallback.
# NEXT_PUBLIC_VERCEL_ENV is set automatically by Vercel, otherwise NODE_ENV is used as a fallback.

# Datadog Database Monitoring (DBM)
# Used to create/read the dedicated monitoring user in Postgres.
# The setup script will default the user to 'datadog' and can auto-generate a strong password.
# You can leave DD_POSTGRES_PASSWORD empty and run:
#   scripts/setup-secrets.sh --write-env
# to generate and persist credentials to .env.local
# Note: Prefer DD_POSTGRES_PASSWORD. Legacy DATADOG_POSTGRES_PASSWORD is supported as a fallback for migration only.
DD_POSTGRES_USER=datadog
DD_POSTGRES_PASSWORD=

# =============================================================================
# AI INTEGRATION
# =============================================================================
# OpenRouter API key for multi-model AI access
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Claude API key (if using direct Claude integration)
CLAUDE_API_KEY=your-claude-api-key-here

# Vector Database
CHROMA_DB_URL=http://localhost:8000

# OpenAI Configuration (used for embeddings and some models)
OPENAI_API_KEY=your-openai-api-key-here

# AI Model Defaults
DEFAULT_LLM_MODEL=gpt-4-turbo
MAX_TOKENS=4000
TEMPERATURE=0.7

# Error Tracking
ERROR_TRACKING_DSN=your-error-tracking-dsn

# AI Analytics
ENABLE_AI_ANALYTICS=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection
DATABASE_URL=postgresql://username:password@localhost:5432/vibecode_dev

