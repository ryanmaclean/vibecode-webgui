# ═══════════════════════════════════════════════════════════════════════════
# VibeCode WebGUI - Consolidated Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to `.env.local` for local development
# 2. Copy to `.env` for environment-specific deployments
# 3. Replace ALL placeholder values (your-*, change-me, dummy-*)
# 4. NEVER commit real secrets to version control
#
# CONFIGURATION PRECEDENCE:
# .env.local > .env > .env.production/.env.development > this file
#
# VALIDATION:
# - Required variables marked with [REQUIRED]
# - Optional variables marked with [OPTIONAL]
# - Validation rules provided in comments
#
# GENERATED: 2025-10-01
# CONSOLIDATES: .env.template, .env.local.example, .env.local.template, .env.azure, .env.valkey
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# 1. RUNTIME ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════

# [REQUIRED] Environment name: development, staging, production, test
# Used for: environment-specific configuration loading, monitoring tags
# Validation: Must be one of: development, staging, production, test
NODE_ENV=development

# [REQUIRED] Base URL for the application (used for OAuth redirects, API calls)
# Must match deployment URL exactly
# Validation: Must be valid HTTP/HTTPS URL
BASE_URL=http://localhost:3000

# [REQUIRED] NextAuth.js authentication URL
# Must match BASE_URL for proper OAuth flow
# Validation: Must be valid HTTP/HTTPS URL
NEXTAUTH_URL=http://localhost:3000

# [REQUIRED] NextAuth.js secret for session encryption
# SECURITY: Generate with: openssl rand -base64 32
# Validation: Minimum 32 characters, alphanumeric + special chars
# DO NOT use placeholder values in production
NEXTAUTH_SECRET=your-nextauth-secret-here-min-32-chars

# [OPTIONAL] Application server port
# Default: 3000
# Validation: 1024-65535
PORT=3000

# [OPTIONAL] Vite development server port (if using Vite)
# Default: 5173
# Validation: 1024-65535
VITE_PORT=5173

# [OPTIONAL] Docker environment flag
# Set to 'true' when running in Docker containers
# Affects service discovery (localhost vs container names)
DOCKER=false

# [OPTIONAL] Kubernetes KIND cluster flag
# Set to 'true' when running in local KIND cluster
# Affects service discovery and networking
KIND_CLUSTER=false

# [OPTIONAL] Environment label for monitoring and logs
# Used in Datadog tags, log context
ENVIRONMENT=local

# [OPTIONAL] WebSocket server port for real-time features
# Default: 3001
# Validation: Must be different from PORT
WS_PORT=3001

# ═══════════════════════════════════════════════════════════════════════════
# 2. DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# [REQUIRED] Primary PostgreSQL connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Validation: Must be valid PostgreSQL connection string
# Local dev: postgresql://vibecode:password@localhost:5432/vibecode_dev
# Docker: postgresql://vibecode:password@postgres:5432/vibecode_dev
# Azure: postgresql://user@server:password@server.postgres.database.azure.com:5432/database
DATABASE_URL=postgresql://vibecode:password@localhost:5432/vibecode_dev

# [OPTIONAL] Alternative PostgreSQL URL aliases (for compatibility)
# Some libraries/tools expect POSTGRES_URL or POSTGRESQL_URL
POSTGRES_URL=postgresql://vibecode:password@localhost:5432/vibecode_dev
POSTGRESQL_URL=postgresql://vibecode:password@localhost:5432/vibecode_dev

# [OPTIONAL] Individual PostgreSQL connection parameters
# Used when DATABASE_URL is not set or for specific tools
POSTGRES_DB=vibecode
POSTGRES_USER=vibecode
POSTGRES_PASSWORD=password

# [OPTIONAL] Connection pool configuration
# Optimize based on deployment size and load
# Small apps: min=2, max=10
# Medium apps: min=5, max=20
# Large apps: min=10, max=30
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_ENABLE_DYNAMIC_SIZING=true
DB_POOL_ENABLE_CONNECTION_VALIDATION=true

# [OPTIONAL] Azure PostgreSQL specific configuration
# Used for Azure-hosted PostgreSQL deployments
AZURE_PG_HOST=
AZURE_PG_DB=
DEV_POSTGRES_URL=
STAGING_POSTGRES_URL=
DEV_AZURE_POSTGRES_PASSWORD=
STAGING_AZURE_POSTGRES_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════
# 3. CACHING & SESSION STORE (Redis/ValKey)
# ═══════════════════════════════════════════════════════════════════════════

# [OPTIONAL] Primary Redis/ValKey connection URL
# Format: redis://[password]@[host]:[port]/[db]
# Local dev: redis://localhost:6379
# Docker: redis://valkey:6379
# Kubernetes: redis://valkey-service:6379
# Production: redis://:password@valkey-prod:6379
REDIS_URL=redis://localhost:6379

# [OPTIONAL] Individual Redis connection parameters
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# [OPTIONAL] ValKey configuration (Redis-compatible fork)
# ValKey is the primary cache implementation, Redis is backward-compatible alias
# Both use identical configuration format
VALKEY_URL=redis://localhost:6379
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0

# [OPTIONAL] Environment-specific ValKey/Redis URLs
# Automatically selected based on DOCKER and KIND_CLUSTER flags
VALKEY_DOCKER_URL=redis://valkey:6379
VALKEY_K8S_URL=redis://valkey-service:6379
VALKEY_K8S_SECURE_URL=redis://:__REPLACE_WITH_VALKEY_PASSWORD__@valkey-service:6379
VALKEY_KIND_URL=redis://valkey-service.vibecode-platform.svc.cluster.local:6379
VALKEY_PRODUCTION_URL=redis://:__REPLACE_WITH_VALKEY_PASSWORD__@valkey-prod:6379

REDIS_DOCKER_URL=redis://valkey:6379
REDIS_K8S_URL=redis://valkey-service:6379
REDIS_K8S_SECURE_URL=redis://:__REPLACE_WITH_VALKEY_PASSWORD__@valkey-service:6379
REDIS_KIND_URL=redis://valkey-service.vibecode-platform.svc.cluster.local:6379
REDIS_PRODUCTION_URL=redis://:__REPLACE_WITH_VALKEY_PASSWORD__@valkey-prod:6379

# [OPTIONAL] Upstash Redis (serverless Redis alternative)
# Used for serverless deployments without self-hosted Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════
# 4. VECTOR DATABASE & COLLABORATION
# ═══════════════════════════════════════════════════════════════════════════

# [OPTIONAL] ChromaDB vector database URL
# Used for: semantic search, embeddings storage, RAG
# Default: http://localhost:8000
CHROMA_DB_URL=http://localhost:8000

# [OPTIONAL] Collaboration server URL
# Used for: real-time collaboration features, WebSocket connections
# Default: matches BASE_URL
COLLABORATION_SERVER_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════
# 5. PRIMARY AI PROVIDERS (Core Functionality)
# ═══════════════════════════════════════════════════════════════════════════

# [REQUIRED] OpenRouter API key (unified AI gateway)
# Get from: https://openrouter.ai/keys
# Used for: multi-model AI access through single API
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_FREE_MODEL=gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://vibecode.ai
OPENROUTER_APP_TITLE=VibeCode WebGUI

# [REQUIRED] OpenAI API key
# Get from: https://platform.openai.com/api-keys
# Used for: GPT models, embeddings, vision
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=http://localhost:12434/engines/v1

# [REQUIRED] Anthropic Claude API key
# Get from: https://console.anthropic.com/
# Used for: Claude models (Sonnet, Opus, Haiku)
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_CODE_API_KEY=
CLAUDE_CODE_MODEL=claude-3.5-sonnet-20240620
CLAUDE_API_BASE=https://api.anthropic.com/v1/messages
CLAUDE_API_VERSION=2023-06-01

# [OPTIONAL] Default AI model configuration
# Controls default behavior across all AI features
DEFAULT_LLM_MODEL=gpt-4-turbo
DEFAULT_AI_MODEL=gpt-4-turbo
MAX_TOKENS=4000
AI_MAX_TOKENS=4000
TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=30000

# [OPTIONAL] AI provider selection and model configuration
AI_COMPLETION_PROVIDER=openai
AI_COMPLETION_MODEL=gpt-4o-mini
AI_COMPLETION_MAX_TOKENS=512
AI_COMPLETION_TEMPERATURE=0.2

# [OPTIONAL] AI analytics and monitoring
ENABLE_AI_ANALYTICS=true
ENABLE_AI_USAGE_TRACKING=true
AI_COST_TRACKING=true

# ═══════════════════════════════════════════════════════════════════════════
# 6. EXTENDED AI PROVIDERS (Optional Integrations)
# ═══════════════════════════════════════════════════════════════════════════

# [OPTIONAL] Google Gemini (provider: "gemini")
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro-latest
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# [OPTIONAL] Google Gemini CLI (provider: "gemini-cli")
GEMINI_CLI_API_KEY=
GEMINI_CLI_MODEL=gemini-1.5-pro-latest
GEMINI_CLI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# [OPTIONAL] OpenCode via OpenRouter (provider: "opencode")
OPENCODE_API_KEY=
OPENCODE_MODEL=anthropic/claude-3.5-sonnet
OPENCODE_API_BASE=https://openrouter.ai/api/v1

# [OPTIONAL] DeepSeek (provider: "deepseek")
# Specialized code generation model
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-coder
DEEPSEEK_API_BASE=https://api.deepseek.com

# [OPTIONAL] Anthropic direct (provider: "anthropic")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3.5-sonnet-20241022

# [OPTIONAL] Aider (provider: "aider")
# AI pair programming tool integration
AIDER_API_KEY=
AIDER_MODEL=gpt-4o-mini
AIDER_API_BASE=

# [OPTIONAL] GooseAI (provider: "goose")
GOOSE_API_KEY=
GOOSE_MODEL=gpt-4o-mini
GOOSE_API_BASE=https://api.goose.ai/v1

# [OPTIONAL] Project4 (provider: "project4")
PROJECT4_API_KEY=
PROJECT4_MODEL=gpt-4o-mini
PROJECT4_API_BASE=https://api.project4.ai/v1

# [OPTIONAL] Google AI Studio (provider: "google")
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro-latest

# [OPTIONAL] Legacy Codex override
CODEX_API_KEY=
CODEX_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════════════════════
# 7. AZURE OPENAI CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# [OPTIONAL] Azure OpenAI service configuration
# Get from: Azure Portal > OpenAI Service
# Format: https://<resource-name>.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_MODEL=gpt-4o-mini

# [OPTIONAL] Azure OpenAI deployment names
# Must match deployments created in Azure OpenAI Studio
AZURE_OPENAI_DEPLOYMENT_NAME=text-embedding-3-small
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_COMPLETION_DEPLOYMENT=gpt-4o-mini

# [OPTIONAL] Azure OpenAI deployment JSON configuration
# Consolidated deployment mapping for multi-model usage
AZURE_OPENAI_DEPLOYMENTS='{"embedding":"text-embedding-3-small","chat":"gpt-4o","completion":"gpt-4o-mini"}'

# [OPTIONAL] Enable Azure OpenAI instead of standard OpenAI
USE_AZURE_OPENAI=false

