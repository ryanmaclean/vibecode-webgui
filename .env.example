# VibeCode Web GUI Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Security (REQUIRED)
# ============================================

# NextAuth Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_SECURE_SECRET_MIN_32_CHARS

# JWT Secret for WebSocket Authentication
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_SECURE_SECRET_MIN_32_CHARS

# ============================================
# Database Configuration (REQUIRED)
# ============================================

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:SECURE_PASSWORD@localhost:5432/vibecode
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD_MIN_16_CHARS
POSTGRES_DB=vibecode

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# AI Services (Optional)
# ============================================

# OpenAI API
OPENAI_API_KEY=sk-...
OPENAI_ORGANIZATION=org-...

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (for multiple providers)
OPENROUTER_API_KEY=sk-or-...

# ============================================
# Monitoring & Observability (Optional)
# ============================================

# Datadog Configuration (Server-side)
DD_API_KEY=
DD_APP_KEY=
DD_SERVICE=vibecode-webgui
DD_ENV=development
DD_VERSION=1.0.0
DD_SITE=datadoghq.com

# Datadog Features
DD_TRACE_ENABLED=false
DD_LOGS_INJECTION=false
DD_PROFILING_ENABLED=false
DD_DYNAMIC_INSTRUMENTATION_ENABLED=false

# Datadog RUM (Real User Monitoring - Client-side)
# Get these from: https://app.datadoghq.com/rum/application/create
# NOTE: These are NEXT_PUBLIC_ vars and will be exposed to the browser
# Used for tracking Core Web Vitals (LCP, FID, CLS) and user performance
NEXT_PUBLIC_DD_APPLICATION_ID=
NEXT_PUBLIC_DD_CLIENT_TOKEN=
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_DD_ENV=development
NEXT_PUBLIC_DD_SERVICE=vibecode-webgui
NEXT_PUBLIC_DD_VERSION=1.5.0
NEXT_PUBLIC_APP_VERSION=1.5.0

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=vibecode-webgui

# ============================================
# Storage (Optional)
# ============================================

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# ============================================
# Feature Flags
# ============================================
ENABLE_AI_FEATURES=true
ENABLE_MONITORING=false
ENABLE_CODE_EXECUTION=false

# ============================================
# Security Settings
# ============================================

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_WINDOW=100
RATE_LIMIT_WINDOW_MS=900000

# Session Configuration
SESSION_MAX_AGE=3600000

# ============================================
# Development Settings
# ============================================

# Test Mode (skip auth in development)
MOCK_ORIGINS=false

# Debug Logging
DEBUG=false
LOG_LEVEL=info

# ============================================
# Production Settings
# ============================================

# Force HTTPS (production only)
FORCE_HTTPS=true

# Secure Cookie Settings (production only)
SECURE_COOKIES=true

# HSTS Max Age (seconds)
HSTS_MAX_AGE=31536000
