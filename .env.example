# VibeCode WebGUI Environment Variables
# Copy to .env.local (development) or .env.production.local (production) and replace placeholders with your real values.
# SECURITY: Never commit actual secrets.

# =============================================================================
# RUNTIME CONFIGURATION
# =============================================================================
NODE_ENV=development
BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-me-in-production
PORT=3000
VITE_PORT=5173
DOCKER=false
KIND_CLUSTER=false

# =============================================================================
# DATABASE & CACHING
# =============================================================================

# PostgreSQL Database
# For local development: postgresql://vibecode:password@localhost:5432/vibecode_dev
# For Docker: postgresql://postgres:5432/vibecode
# Multiple URL formats supported for compatibility
DATABASE_URL=postgresql://username:password@localhost:5432/vibecode_dev
POSTGRES_URL=postgresql://username:password@localhost:5432/vibecode_dev
POSTGRESQL_URL=postgresql://username:password@localhost:5432/vibecode_dev

# Database Connection Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_ENABLE_DYNAMIC_SIZING=true
DB_POOL_ENABLE_CONNECTION_VALIDATION=true

# Redis/Valkey Cache Configuration
# For local development: redis://localhost:6379
# For Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Valkey (Redis alternative) Configuration
VALKEY_URL=redis://localhost:6379
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0

# Vector Database
CHROMA_DB_URL=http://localhost:8000

# Collaboration Server
COLLABORATION_SERVER_URL=http://localhost:3000

# Upstash Redis (Optional cloud Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# AI PROVIDERS & MODELS
# =============================================================================

# OpenRouter (Unified AI Gateway)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_FREE_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Anthropic Claude
CLAUDE_API_KEY=your-claude-api-key

# Azure OpenAI (Optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2023-05-15

# AI Model Configuration
DEFAULT_LLM_MODEL=gpt-4-turbo
DEFAULT_AI_MODEL=gpt-4-turbo
MAX_TOKENS=4000
AI_MAX_TOKENS=4000
TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=30000

# AI Analytics & Tracking
ENABLE_AI_ANALYTICS=true
ENABLE_AI_USAGE_TRACKING=true
AI_COST_TRACKING=true

# =============================================================================
# OBSERVABILITY & DATADOG
# =============================================================================

# Datadog API Keys
# Get from: https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=your-datadog-api-key
DATADOG_API_KEY=your-datadog-api-key
DD_APP_KEY=your-datadog-app-key
DATADOG_APP_KEY=your-datadog-app-key
DD_SITE=datadoghq.com
DATADOG_SITE=datadoghq.com

# Unified Service Tagging (Best Practice)
# https://docs.datadoghq.com/getting_started/tagging/unified_service_tagging/
DD_ENV=development
DD_SERVICE=vibecode-webgui
DD_VERSION=1.0.0
DD_GIT_COMMIT_SHA=
DD_GIT_REPOSITORY_URL=https://github.com/vibecode/vibecode-webgui

# Frontend RUM (Real User Monitoring)
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_DD_APPLICATION_ID=your-rum-application-id
NEXT_PUBLIC_DD_CLIENT_TOKEN=your-rum-client-token
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_ENABLE_RUM_IN_DEV=false

# Legacy RUM Variables (Deprecated - kept for backward compatibility)
NEXT_PUBLIC_DATADOG_APPLICATION_ID=your-rum-application-id
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=your-rum-client-token
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com
NEXT_PUBLIC_DATADOG_RUM_APPLICATION_ID=your-rum-application-id
NEXT_PUBLIC_DATADOG_RUM_CLIENT_TOKEN=your-rum-client-token

# Database Monitoring
DD_POSTGRES_USER=datadog
DD_POSTGRES_PASSWORD=
DATADOG_DBMON_PASSWORD=
DD_DBM_PROPAGATION_MODE=service
DD_DBM_TRACE_INJECTION=false

# APM & Tracing Configuration
DD_TRACE_ENABLED=true
DD_TRACE_SAMPLE_RATE=0.2
DD_TRACE_ANALYTICS_ENABLED=false
DD_RUNTIME_METRICS_ENABLED=true
DD_PROFILING_ENABLED=false

# LLM Observability
DD_LLMOBS_ENABLED=false
DD_LLMOBS_AGENTLESS_ENABLED=false
DD_LLMOBS_ML_APP=vibecode-ai

# General Monitoring Toggles
ENABLE_MONITORING=true
ENABLE_PERFORMANCE_TRACKING=false
ENABLE_ERROR_TRACKING=true
ENABLE_DATADOG_INTEGRATION_TESTS=false
DD_LOG_LEVEL=INFO

# Error Tracking
ERROR_TRACKING_DSN=

# =============================================================================
# AUTHENTICATION PROVIDERS
# =============================================================================

# GitHub OAuth
GITHUB_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret
GITHUB_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================

# Security Secrets (Generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-change-me-in-production
SESSION_SECRET=your-session-secret-change-me-in-production

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# PLATFORM & INFRASTRUCTURE (OPTIONAL)
# =============================================================================

# Azure PostgreSQL
AZURE_PG_HOST=
AZURE_PG_DB=
DEV_POSTGRES_URL=
STAGING_POSTGRES_URL=
DEV_AZURE_POSTGRES_PASSWORD=
STAGING_AZURE_POSTGRES_PASSWORD=
DD_AZURE_POSTGRES_USERNAME=
DD_AZURE_POSTGRES_PASSWORD=

# Kubernetes
KUBECONFIG=
KUBERNETES_NAMESPACE=vibecode-platform
PLATFORM_DOMAIN=vibecode.dev

# =============================================================================
# DIAGNOSTICS & HEALTH CHECKS
# =============================================================================

# Debug Logging
ENABLE_DEBUG_LOGGING=true

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# =============================================================================
# TESTING TOGGLES
# =============================================================================

# Test Configuration
ENABLE_REAL_AI_TESTS=false
ENABLE_REAL_INTEGRATION_TESTS=false
ENABLE_REAL_DATADOG_TESTS=false
PLAYWRIGHT_TEST=false

# =============================================================================
# DEPRECATED VARIABLES (Legacy Compatibility)
# =============================================================================
# The following variables are deprecated and may be removed in future versions.
# Use the recommended alternatives specified in comments.

# DEPRECATED: Use DD_ENABLED instead (if needed)
# OTEL_ENABLED=false

# DEPRECATED: Use ENABLE_MONITORING instead
# DD_ENABLED=true
# DD_ENABLE_GET_RUM_DATA=false
# SKIP_MONITORING=false

# DEPRECATED: Use DOCKER environment variable
# DOCKER_BUILD=true

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
#
# Quick Start for Local Development:
# 1. Copy this file: cp .env.example .env.local
# 2. Start local services:
#    - PostgreSQL: brew install postgresql && brew services start postgresql
#    - Redis: brew install redis && brew services start redis
#    - OR use Docker: docker compose up -d postgres redis
# 3. Update DATABASE_URL and REDIS_URL with your local connection strings
# 4. Set NEXTAUTH_SECRET (generate with: openssl rand -base64 32)
# 5. Add AI provider keys (at least one: OPENAI_API_KEY, CLAUDE_API_KEY, or OPENROUTER_API_KEY)
# 6. Run: npm run dev
#
# For Docker Development:
# 1. Copy this file: cp .env.example .env.local
# 2. Update connection URLs to use Docker service names:
#    DATABASE_URL=postgresql://postgres:password@postgres:5432/vibecode
#    REDIS_URL=redis://redis:6379
# 3. Set DOCKER=true
# 4. Run: docker compose up -d
#
# For Production:
# 1. Copy this file: cp .env.example .env.production.local
# 2. Replace ALL placeholder values with real production secrets
# 3. Enable monitoring: ENABLE_MONITORING=true
# 4. Set DD_ENV=production
# 5. Use secrets manager (AWS Secrets Manager, Azure Key Vault, etc.)
# 6. Never commit .env.production.local to git
#
# Security Best Practices:
# - Never commit files containing real secrets (.env.local, .env.production.local)
# - Use strong, randomly generated secrets for JWT_SECRET, SESSION_SECRET, NEXTAUTH_SECRET
# - Rotate secrets regularly
# - Use different secrets for each environment
# - Enable monitoring and error tracking in production
# - Review .gitignore to ensure secret files are excluded
#
