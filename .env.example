# Valkey/Redis-compatible cache server connection
# IMPORTANT: We use Valkey (https://valkey.io/) for licensing compliance.
# Valkey is the open-source BSD-licensed fork of Redis, avoiding Redis' RSAL/SSPL restrictions.
VALKEY_URL=redis://localhost:6379
# Legacy Redis URL support (will be deprecated - use VALKEY_URL)
REDIS_URL=redis://localhost:6379

# --- Collaboration Features ---
# Real-time collaboration server URL (code-server sessions)
COLLABORATION_SERVER_URL="http://localhost:3000"

# --- Networking ---

# --- AI Features ---

# --- Rate Limiting (Upstash Redis-compatible service) ---
# For production rate limiting using Upstash (Redis-compatible managed service)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------
# --- Database (Optional) -------
# ---------------------------------

# OAuth providers (optional)
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-secret

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# =============================================================================
# KUBERNETES CLUSTER CONFIGURATION
# =============================================================================
# Cluster configuration
KUBECONFIG=/path/to/your/kubeconfig
KUBERNETES_NAMESPACE=vibecode-platform

# Ingress domain
PLATFORM_DOMAIN=vibecode.dev

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3000
VITE_PORT=5173
NEXT_PUBLIC_ENABLE_RUM_IN_DEV=false

# Enable development features
ENABLE_DEBUG_LOGGING=true
ENABLE_DATADOG_INTEGRATION_TESTS=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT secret for API authentication
JWT_SECRET=your-jwt-secret-here

# Session encryption key
SESSION_SECRET=your-session-secret-here

# API rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Enable monitoring features
ENABLE_MONITORING=true
ENABLE_PERFORMANCE_TRACKING=true
ENABLE_ERROR_TRACKING=true

# Optional monitoring toggles (used by server/client gating logic)
# OTEL_ENABLED=false              # enable OpenTelemetry when 'true'
# DD_ENABLED=true                 # disable all Datadog init when 'false'
# DD_ENABLE_GET_RUM_DATA=false    # enable dd-trace experimental getRumData when 'true' or '1'
# SKIP_MONITORING=false           # force-disable monitoring regardless of other flags
# DOCKER_BUILD=true               # set by Dockerfile to disable monitoring during image builds

# Health check configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# =============================================================================
# AI GATEWAY CONFIGURATION
# =============================================================================
# AI model preferences
DEFAULT_AI_MODEL=anthropic/claude-3-sonnet
AI_REQUEST_TIMEOUT=30000
AI_MAX_TOKENS=4096

# Usage tracking
ENABLE_AI_USAGE_TRACKING=true
AI_COST_TRACKING=true
