# =============================================================================
# VibCode .gitignore - Updated 2026-01-07
# =============================================================================
# This file prevents bloat and secret leakage. DO NOT track:
# - Environment files with secrets
# - Large binary files (use GitHub Releases)
# - Build artifacts
# - Kernel/VM images
# =============================================================================

# =============================================================================
# 🔐 SECRETS - NEVER COMMIT THESE
# =============================================================================
.env
.env.*
!.env.example
!.env.*.example
!.env.local.example
!.env.local.template
!.env.otel.example
*.env
config/env/.env.*
!config/env/.env.example
!config/env/.env.*.example

# =============================================================================
# 📦 DEPENDENCIES
# =============================================================================
node_modules/
.pnp
.pnp.js
bun.lockb

# Python
venv/
venv*/
.venv/
demos/venv*/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
.eggs/
*.egg

# =============================================================================
# 🔨 BUILD ARTIFACTS
# =============================================================================
# General
build/
dist/
out/
*.o
*.a
*.so
*.dylib

# JavaScript/TypeScript
.next/
.nuxt/
.output/
*.tsbuildinfo

# Rust/Tauri
**/target/
*.rlib
*.rmeta
Cargo.lock
!src-tauri/Cargo.lock

# Swift
**/.build/
**/ModuleCache/
*.swiftmodule
*.pcm
*.xcworkspace/
xcuserdata/
DerivedData/

# Go
*.exe
*.exe~
*.dll

# =============================================================================
# 🖥️ VM/KERNEL IMAGES - USE GITHUB RELEASES
# =============================================================================
# CPIO archives
*.cpio
*.cpio.gz
*.cpio.xz
*.cpio.gz.pre-*
*.cpio.gz.broken*

# Disk images
*.img
*.img.gz
*.qcow2
*.vmdk
*.vhd
*.vhdx
*.iso
*.ipsw
*.sparseimage
*.dmg
*.dmg.*

# Kernel binaries
vmlinuz*
vmlinux*
bzImage*
*.kernel
initramfs*
initrd*

# Azure VM artifacts
azure/*.cpio*
azure/*.img*
azure/vmlinuz*
azure/vmlinux*
azure/linux-kernel*
azure/nodejs-complete*
azure/bun-openvscode*
azure/ValkeyVibeCodeBinary
azure/PostgreSQLVibeCodeBinary
azure/SwiftUI-Apps/ValkeyVibeCodeBinary
azure/SwiftUI-Apps/PostgreSQLVibeCodeBinary
azure/SwiftUI-Apps/*Binary
azure/SwiftUI-Apps/*App
azure/SwiftUI-Apps/LiquidGlassVibeCodeApp
!azure/SwiftUI-Apps/*.swift
!azure/SwiftUI-Apps/Package.swift

# Benchmark images
bench-images/

# Build artifacts
artifacts/
release-artifacts/
dist-pkg/
pkg-build/

# OpenVSCode server (large)
openvscode-server/
downloads/

# Tauri resources
src-tauri/resources/vfkit*
src-tauri/resources/codeserver/
src-tauri/binaries/
src-tauri/release-artifacts/

# Tarballs
*.tar.gz
*.tar.xz
*.tar.bz2
*.tgz
!package-lock.json
vibecode-vm-*.tar.gz
git-*.tar.gz

# =============================================================================
# 📝 LOGS & TEMPORARY FILES
# =============================================================================
logs/
*.log
tmp/
temp/
*.tmp
*.bak

# Backup files
*.backup
*.backup-*
*.conflict-backup-*

# Cache files
.cache/
*.cache
.pre-commit-cache/

# =============================================================================
# 🧪 TESTING
# =============================================================================
coverage/
.nyc_output/
playwright-report/
tests/playwright-reports/
.playwright-mcp/
tests/performance/
performance-results/
test-results/

# =============================================================================
# 🛠️ IDE & EDITOR
# =============================================================================
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# =============================================================================
# 💻 OS FILES
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================================================
# 📊 PROJECT-SPECIFIC
# =============================================================================
# Astro cache
docs/.astro/

# Datadog artifacts
datadog/*.txt
ops/monitoring/datadog/*.txt

# Serena / Claude
.serena/
.claude/

# Patches (auto-generated)
patches/*.patch

# Demo binaries
bin/apple-container-runtime
scripts/vibecode-demo

# Temporary examples
tmp-codeium-example/

# Releases folder
releases/

# Migration reports
migration-report.txt

# Git archives
git-*/

.pre-commit-cache/

# Test artifacts
test-results/
.test-results/
junit.xml
*.junit.xml

# =============================================================================
# ✅ EXCEPTIONS - Files that SHOULD be tracked
# =============================================================================
!.gitignore
!.gitattributes
!.github/
!.husky/
!.env.example
!.env.local.example
!.env.local.template
!.env.otel.example
!azure/SwiftUI-Apps/*.swift
!azure/SwiftUI-Apps/Package.swift
!azure/SwiftUI-Apps/*.md
