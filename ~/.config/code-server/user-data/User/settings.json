{
  "workbench.colorTheme": "One Dark Pro",
  "workbench.startupEditor": "none",
  "workbench.welcomePage.walkthroughs.openOnInstall": false,
  "workbench.tips.enabled": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editor.enablePreviewFromCodeNavigation": false,
  "workbench.welcome.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.editor.openPositioning": "last",
  "workbench.editor.restoreViewState": false,
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "telemetry.telemetryLevel": "off",
  "update.mode": "none",
  "security.workspace.trust.enabled": false,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "editor.minimap.enabled": true,
  "editor.wordWrap": "on",
  "editor.fontSize": 14,
  "editor.fontFamily": "'Fira Code', 'Cascadia Code', 'JetBrains Mono', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontFamily": "'Fira Code', 'Cascadia Code', 'JetBrains Mono', Consolas, 'Courier New', monospace",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "workbench.colorCustomizations": {
    "activityBar.background": "#21252b",
    "activityBar.foreground": "#c678dd",
    "statusBar.background": "#21252b",
    "statusBar.foreground": "#c678dd",
    "titleBar.activeBackground": "#21252b",
    "titleBar.activeForeground": "#c678dd",
    "sideBar.background": "#282c34",
    "editor.background": "#1e2127",
    "panel.background": "#282c34",
    "editorCursor.foreground": "#528bff",
    "editorLineNumber.foreground": "#5c6370",
    "editorLineNumber.activeForeground": "#c678dd"
  }
}
