# Local Development Environment (No Containers)
# Copy this to .env.local for local development without Docker

# =============================================================================
# ENVIRONMENT DETECTION
# =============================================================================
NODE_ENV=development
DOCKER=false
KIND_CLUSTER=false

# =============================================================================
# LOCAL SERVICE URLS
# =============================================================================
# Start these services locally:
# PostgreSQL: brew install postgresql && brew services start postgresql
# Redis: brew install redis && brew services start redis
# Or use Docker for individual services:
# docker run -p 5432:5432 -e POSTGRES_PASSWORD=password postgres:15
# docker run -p 6379:6379 redis:7-alpine

DATABASE_URL=postgresql://vibecode:password@localhost:5432/vibecode_dev
REDIS_URL=redis://localhost:6379

# Application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local-dev-secret-change-for-production
PORT=3000

# =============================================================================
# AI SERVICES (Required)
# =============================================================================
OPENROUTER_API_KEY=your-openrouter-api-key-here
CLAUDE_API_KEY=your-claude-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# AI Defaults
DEFAULT_LLM_MODEL=gpt-4-turbo
MAX_TOKENS=4000
TEMPERATURE=0.7

# Vector Database (Optional - will skip if not available)
CHROMA_DB_URL=http://localhost:8000

# =============================================================================
# DATADOG MONITORING (Optional for local dev)
# =============================================================================
# Get keys from: https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=dummy-key-for-local-dev
DATADOG_API_KEY=dummy-key-for-local-dev
DD_APP_KEY=dummy-app-key-for-local-dev
DATADOG_APP_KEY=dummy-app-key-for-local-dev
DD_SITE=datadoghq.com
DATADOG_SITE=datadoghq.com
DD_ENV=local
DD_SERVICE=vibecode-webgui
DD_VERSION=0.0.0-dev

# Frontend RUM (Optional)
NEXT_PUBLIC_DD_APPLICATION_ID=dummy-rum-app-id
NEXT_PUBLIC_DATADOG_APPLICATION_ID=dummy-rum-app-id
NEXT_PUBLIC_DD_CLIENT_TOKEN=dummy-rum-client-token
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=dummy-rum-client-token
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com
NEXT_PUBLIC_ENABLE_RUM_IN_DEV=false
# Both NEXT_PUBLIC_DD_* and NEXT_PUBLIC_DATADOG_* variants are kept for compatibility.

# =============================================================================
# OAUTH PROVIDERS (Optional)
# =============================================================================
GITHUB_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# =============================================================================
# SECURITY
# =============================================================================
JWT_SECRET=local-jwt-secret-change-for-production
SESSION_SECRET=local-session-secret-change-for-production

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# DEVELOPMENT FEATURES
# =============================================================================
ENABLE_DEBUG_LOGGING=true
ENABLE_AI_ANALYTICS=true
ENABLE_MONITORING=false
ENABLE_PERFORMANCE_TRACKING=false

# Health Checks
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000
