// PostCSS config - switches between CDN and Docker modes
const isDockerMode = process.env.DOCKER === 'true';

const config = {
  plugins: {
    // Only use @tailwindcss/postcss in Docker mode
    ...(isDockerMode ? { "@tailwindcss/postcss": {} } : {}),
    autoprefixer: {},
  },
};

module.exports = config;