# ===========================================
# Auto-Claude Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control
#
# Security Note: Treat all tokens as sensitive credentials
# ===========================================

# ===========================================
# GitHub Configuration (REQUIRED)
# ===========================================

# GitHub Personal Access Token
# Create a token at: https://github.com/settings/tokens
# Required scopes: repo, workflow (for repository access and GitHub Actions)
# Keep this token secure and never commit it to version control
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

