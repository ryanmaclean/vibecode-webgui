# Multi-architecture Dockerfile optimized for ARM64 and AMD64
# syntax=docker/dockerfile:1.4

# Use ARG for flexible base image selection
ARG NODE_VERSION=20
ARG BASE_OS=alpine

# Build stage - optimized for both architectures
FROM node:${NODE_VERSION}-${BASE_OS} AS builder

# Add build arguments for target platform detection
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG TARGETOS
ARG TARGETARCH

# Set working directory
WORKDIR /app

# Display build information
RUN echo "Building on: $BUILDPLATFORM, targeting: $TARGETPLATFORM"

# Install architecture-specific dependencies
RUN case "${TARGETARCH}" in \
    "amd64") \
        echo "Installing AMD64 specific packages" && \
        apk add --no-cache python3 make g++ && \
        ln -sf python3 /usr/bin/python \
        ;; \
    "arm64") \
        echo "Installing ARM64 specific packages" && \
        apk add --no-cache python3 make g++ && \
        ln -sf python3 /usr/bin/python \
        ;; \
    *) \
        echo "Installing default packages for ${TARGETARCH}" && \
        apk add --no-cache python3 make g++ && \
        ln -sf python3 /usr/bin/python \
        ;; \
    esac

# Copy package files for dependency installation
COPY package.json package-lock.json* ./

# Architecture-aware npm install with caching
RUN --mount=type=cache,target=/root/.npm,id=npm-cache-${TARGETARCH} \
    --mount=type=cache,target=node_modules,id=node_modules-${TARGETARCH} \
    npm ci --only=production --no-audit --prefer-offline --progress=false

# Copy application source
COPY . .

# Build application (skip if no build step needed)
RUN npm run build || echo "No build step configured"

# Production stage - minimal runtime
FROM node:${NODE_VERSION}-${BASE_OS} AS runtime

# Security: Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Set working directory
WORKDIR /app

# Copy built application and dependencies from builder stage
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package*.json ./
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/next.config.js ./

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

# Start the application
CMD ["npm", "start"]

# Development stage for dev container
FROM builder AS development

# Install development dependencies
RUN --mount=type=cache,target=/root/.npm,id=npm-dev-cache-${TARGETARCH} \
    npm ci --include=dev --no-audit --prefer-offline --progress=false

# Install curl for health checks
RUN apk add --no-cache curl

# Create development user
USER node

# Expose development ports
EXPOSE 3000 9229

# Development environment
ENV NODE_ENV=development

# Start in development mode with debugging
CMD ["npm", "run", "dev"]