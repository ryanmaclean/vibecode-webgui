#!/bin/bash
# VibeCode Consolidated Script Manager
# Usage: ./vibecode [command] [subcommand] [options]

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$SCRIPT_DIR/scripts-consolidated"

# Function to print colored output
print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_header() {
    echo -e "${CYAN}$1${NC}"
}

# Function to show usage
show_usage() {
    echo "VibeCode Consolidated Script Manager"
    echo ""
    echo "Usage: $0 [command] [subcommand] [options]"
    echo ""
    echo "Commands:"
    echo "  dev         Development environment management"
    echo "  build       Build and compilation tasks"
    echo "  deploy      Deployment operations"
    echo "  test        Testing and validation"
    echo "  monitor     Monitoring and observability"
    echo "  cleanup     Cleanup and maintenance"
    echo "  docker      Docker operations"
    echo "  k8s         Kubernetes operations"
    echo "  azure       Azure cloud operations"
    echo "  utils       Utility functions"
    echo ""
    echo "Examples:"
    echo "  $0 dev start                    # Start development environment"
    echo "  $0 build prod                   # Build production"
    echo "  $0 deploy aks                   # Deploy to AKS"
    echo "  $0 test all                     # Run all tests"
    echo "  $0 docker build dev             # Build dev Docker image"
    echo "  $0 cleanup old-files            # Clean up old files"
    echo ""
    echo "For detailed help on a command:"
    echo "  $0 [command] --help"
}

# Function to show command help
show_command_help() {
    local command="$1"
    
    case "$command" in
        dev)
            echo "Development Environment Management"
            echo ""
            echo "Subcommands:"
            echo "  start           Start development environment"
            echo "  stop            Stop development environment"
            echo "  restart         Restart development environment"
            echo "  status          Show development status"
            echo "  logs            Show development logs"
            echo "  shell           Open development shell"
            echo ""
            echo "Options:"
            echo "  --with-db       Include database services"
            echo "  --with-redis    Include Redis services"
            echo "  --with-monitoring Include monitoring services"
            ;;
        build)
            echo "Build and Compilation Tasks"
            echo ""
            echo "Subcommands:"
            echo "  dev             Build development version"
            echo "  prod            Build production version"
            echo "  test            Build test version"
            echo "  clean           Clean build artifacts"
            echo "  watch           Build with file watching"
            echo ""
            echo "Options:"
            echo "  --optimize      Enable optimizations"
            echo "  --source-maps   Generate source maps"
            echo "  --analyze       Analyze bundle size"
            ;;
        deploy)
            echo "Deployment Operations"
            echo ""
            echo "Subcommands:"
            echo "  local           Deploy locally"
            echo "  kind            Deploy to KIND cluster"
            echo "  aks             Deploy to AKS"
            echo "  azure           Deploy to Azure"
            echo "  rollback        Rollback deployment"
            echo "  status          Check deployment status"
            echo ""
            echo "Options:"
            echo "  --env ENV       Environment (dev/staging/prod)"
            echo "  --namespace NS  Kubernetes namespace"
            echo "  --registry REG  Container registry"
            echo "  --force         Force deployment"
            ;;
        test)
            echo "Testing and Validation"
            echo ""
            echo "Subcommands:"
            echo "  unit            Run unit tests"
            echo "  integration     Run integration tests"
            echo "  e2e             Run end-to-end tests"
            echo "  all             Run all tests"
            echo "  coverage        Run tests with coverage"
            echo "  performance     Run performance tests"
            echo ""
            echo "Options:"
            echo "  --watch         Watch mode"
            echo "  --verbose       Verbose output"
            echo "  --ci            CI mode"
            ;;
        monitor)
            echo "Monitoring and Observability"
            echo ""
            echo "Subcommands:"
            echo "  logs            Show application logs"
            echo "  metrics         Show metrics"
            echo "  health          Check health status"
            echo "  alerts          Check alerts"
            echo "  dashboard       Open monitoring dashboard"
            echo ""
            echo "Options:"
            echo "  --follow        Follow logs"
            echo "  --tail N        Show last N lines"
            echo "  --service SVC   Filter by service"
            ;;
        cleanup)
            echo "Cleanup and Maintenance"
            echo ""
            echo "Subcommands:"
            echo "  old-files       Remove old files"
            echo "  docker          Clean Docker resources"
            echo "  k8s             Clean Kubernetes resources"
            echo "  logs            Clean old logs"
            echo "  cache           Clean caches"
            echo ""
            echo "Options:"
            echo "  --dry-run       Show what would be cleaned"
            echo "  --force         Force cleanup"
            ;;
        docker)
            echo "Docker Operations"
            echo ""
            echo "Subcommands:"
            echo "  build           Build Docker images"
            echo "  run             Run Docker containers"
            echo "  stop            Stop Docker containers"
            echo "  clean           Clean Docker resources"
            echo "  logs            Show Docker logs"
            echo ""
            echo "Options:"
            echo "  --target TGT     Build target"
            echo "  --tag TAG        Image tag"
            echo "  --push           Push to registry"
            ;;
        k8s)
            echo "Kubernetes Operations"
            echo ""
            echo "Subcommands:"
            echo "  apply           Apply Kubernetes manifests"
            echo "  delete          Delete Kubernetes resources"
            echo "  get             Get Kubernetes resources"
            echo "  logs            Show Kubernetes logs"
            echo "  port-forward    Port forward services"
            echo ""
            echo "Options:"
            echo "  --namespace NS  Kubernetes namespace"
            echo "  --context CTX   Kubernetes context"
            ;;
        azure)
            echo "Azure Cloud Operations"
            echo ""
            echo "Subcommands:"
            echo "  login            Login to Azure"
            echo "  deploy           Deploy to Azure"
            echo "  status           Check Azure status"
            echo "  cleanup          Clean Azure resources"
            echo ""
            echo "Options:"
            echo "  --subscription SUB  Azure subscription"
            echo "  --resource-group RG  Resource group"
            ;;
        utils)
            echo "Utility Functions"
            echo ""
            echo "Subcommands:"
            echo "  validate        Validate configuration"
            echo "  format          Format code"
            echo "  lint            Lint code"
            echo "  docs            Generate documentation"
            echo "  backup          Create backup"
            echo ""
            echo "Options:"
            echo "  --fix            Fix issues automatically"
            echo "  --check          Check only (don't fix)"
            ;;
        *)
            print_error "Unknown command: $command"
            show_usage
            exit 1
            ;;
    esac
}

# Function to execute command
execute_command() {
    local command="$1"
    local subcommand="$2"
    shift 2
    local args="$@"
    
    # Check if subcommand script exists
    local script_path="$SCRIPTS_DIR/$command/$subcommand.sh"
    
    if [ -f "$script_path" ]; then
        print_status "Executing: $command $subcommand $args"
        exec "$script_path" $args
    else
        print_error "Command not found: $command $subcommand"
        print_status "Available subcommands for $command:"
        if [ -d "$SCRIPTS_DIR/$command" ]; then
            ls "$SCRIPTS_DIR/$command"/*.sh 2>/dev/null | sed 's/.*\///' | sed 's/\.sh$//' | sed 's/^/  /'
        else
            print_warning "No subcommands available for $command"
        fi
        exit 1
    fi
}

# Main script logic
main() {
    # Check if help is requested
    if [ "$#" -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        show_usage
        exit 0
    fi
    
    local command="$1"
    
    # Check if command help is requested
    if [ "$#" -eq 2 ] && [ "$2" = "--help" ]; then
        show_command_help "$command"
        exit 0
    fi
    
    # Check if command directory exists
    if [ ! -d "$SCRIPTS_DIR/$command" ]; then
        print_error "Unknown command: $command"
        show_usage
        exit 1
    fi
    
    # Execute the command
    execute_command "$@"
}

# Run main function with all arguments
main "$@"
