FROM alpine:latest

# Install required packages
RUN apk add --no-cache \
    openssh \
    openssh-server \
    neovim \
    nodejs \
    npm \
    git \
    curl \
    wget \
    bash \
    python3 \
    build-base \
    openrc \
    ca-certificates

# Download and install openvscode-server 1.95.3 ARM64
RUN mkdir -p /opt/openvscode-server && \
    cd /opt/openvscode-server && \
    wget -q https://github.com/gitpod-io/openvscode-server/releases/download/openvscode-server-v1.95.3/openvscode-server-v1.95.3-linux-arm64.tar.gz && \
    tar -xzf openvscode-server-v1.95.3-linux-arm64.tar.gz --strip-components=1 && \
    rm openvscode-server-v1.95.3-linux-arm64.tar.gz

# Configure SSH
RUN ssh-keygen -A && \
    sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo 'root:alpine' | chpasswd

# Create startup script
RUN cat > /etc/init.d/openvscode << 'EOF'
#!/sbin/openrc-run

name="openvscode"
description="OpenVSCode Server and SSH"

depend() {
    need net
}

start() {
    ebegin "Starting SSH server"
    /usr/sbin/sshd
    eend $?

    ebegin "Starting OpenVSCode Server"
    cd /opt/openvscode-server
    nohup ./bin/openvscode-server --host 0.0.0.0 --port 3000 --without-connection-token > /var/log/openvscode.log 2>&1 &
    echo $! > /var/run/openvscode.pid
    eend $?
}

stop() {
    ebegin "Stopping OpenVSCode Server"
    if [ -f /var/run/openvscode.pid ]; then
        kill $(cat /var/run/openvscode.pid) 2>/dev/null
        rm /var/run/openvscode.pid
    fi
    eend $?

    ebegin "Stopping SSH server"
    pkill sshd
    eend $?
}
EOF

# Make startup script executable and add to default runlevel
RUN chmod +x /etc/init.d/openvscode && \
    rc-update add openvscode default || true

# Create necessary directories for OpenRC
RUN mkdir -p /run/openrc && \
    touch /run/openrc/softlevel

# Set default command
CMD ["/sbin/init"]
