/**
 * Simple Chat API Endpoint for VibeCode WebGUI
 * Provides basic chat functionality without external dependencies
 */

import type { NextApiRequest, NextApiResponse } from 'next';
import { cache } from '../../../lib/cache/redis-client';
import { CacheKeys, CacheTTL } from '../../../lib/cache/redis-client';

interface Message {
  id: string;
  role: 'user' | 'assistant' | 'system';
  content: string;
}

interface ChatRequest {
  messages: Message[];
  workspaceId?: string;
  userId?: string;
  codeContext?: {
    fileName?: string;
    language?: string;
    selectedCode?: string;
    cursorPosition?: { line: number; column: number };
  };
}

interface ChatResponse {
  id: string;
  role: 'assistant';
  content: string;
}

export default async function handler(
  req: NextApiRequest,
  res: NextApiResponse<ChatResponse | { error: string }>
) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    const { messages, workspaceId, userId, codeContext } = req.body as ChatRequest;

    if (!messages || !Array.isArray(messages) || messages.length === 0) {
      return res.status(400).json({ error: 'Messages are required' });
    }

    // Get the last user message
    const lastMessage = messages[messages.length - 1];
    
    if (lastMessage.role !== 'user') {
      return res.status(400).json({ error: 'Last message must be from a user' });
    }

    // Create a cache key for this conversation
    const conversationHash = Buffer.from(
      JSON.stringify({ messages, workspaceId, codeContext })
    ).toString('base64');
    
    const cacheKey = CacheKeys.aiResponse(conversationHash);
    
    // Check if we have a cached response
    const cachedResponse = await cache.get<ChatResponse>(cacheKey);
    if (cachedResponse) {
      return res.status(200).json(cachedResponse);
    }

    // Generate a response (mock implementation)
    const response: ChatResponse = await generateResponse(lastMessage.content, codeContext);
    
    // Cache the response
    await cache.set(cacheKey, response, CacheTTL.MEDIUM);
    
    return res.status(200).json(response);
  } catch (error) {
    console.error('Chat API error:', error);
    return res.status(500).json({ error: 'Internal server error' });
  }
}

async function generateResponse(
  message: string,
  codeContext?: {
    fileName?: string;
    language?: string;
    selectedCode?: string;
    cursorPosition?: { line: number; column: number };
  }
): Promise<ChatResponse> {
  // In a real implementation, this would call an AI API
  // For now, we'll generate some simple responses based on the user's message
  let responseContent = '';
  
  if (message.toLowerCase().includes('hello') || message.toLowerCase().includes('hi')) {
    responseContent = 'Hello! How can I help you with your code today?';
  } else if (message.toLowerCase().includes('explain') && codeContext?.selectedCode) {
    responseContent = `Here's an explanation of your ${codeContext.language || 'code'}:\n\n`;
    responseContent += `This code ${codeContext.selectedCode.length < 50 ? 'appears to be a simple statement or declaration' : 'implements some functionality'}. `;
    responseContent += 'Without a full context, I can offer a general explanation. The code might be handling data processing, UI rendering, or business logic.';
  } else if (message.toLowerCase().includes('debug') && codeContext?.selectedCode) {
    responseContent = `Here are some debugging tips for your ${codeContext.language || 'code'}:\n\n`;
    responseContent += '1. Check for syntax errors or typos\n';
    responseContent += '2. Verify all variables are properly defined and in scope\n';
    responseContent += '3. Add console logs to trace execution flow\n';
    responseContent += '4. Check for null or undefined values\n';
    responseContent += '5. Consider edge cases in your logic';
  } else if (message.toLowerCase().includes('optimize') && codeContext?.selectedCode) {
    responseContent = `Here are some optimization suggestions for your ${codeContext.language || 'code'}:\n\n`;
    responseContent += '1. Consider caching expensive operations\n';
    responseContent += '2. Minimize DOM manipulations if this is frontend code\n';
    responseContent += '3. Use appropriate data structures for better performance\n';
    responseContent += '4. Consider lazy loading or code splitting where appropriate\n';
    responseContent += '5. Review algorithms for potential optimizations';
  } else if (message.toLowerCase().includes('test') && codeContext?.selectedCode) {
    responseContent = `Here's a testing approach for your ${codeContext.language || 'code'}:\n\n`;
    responseContent += '1. Write unit tests for individual functions\n';
    responseContent += '2. Mock dependencies for isolated testing\n';
    responseContent += '3. Test edge cases and error handling\n';
    responseContent += '4. Consider integration tests for component interactions\n';
    responseContent += '5. Use coverage tools to ensure thorough testing';
  } else {
    responseContent = "I'm your AI coding assistant. I can help explain, debug, optimize, or test your code. " +
      "If you share some code with me or ask a specific question, I'll do my best to assist you!";
  }
  
  return {
    id: 'resp_' + Date.now().toString(),
    role: 'assistant',
    content: responseContent
  };
}