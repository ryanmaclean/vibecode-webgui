<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Virtualization Framework Access -->
    <!-- https://developer.apple.com/documentation/virtualization/adding-the-virtualization-entitlement-to-your-project -->
    <key>com.apple.security.virtualization</key>
    <true/>
    
    <!-- Hypervisor Access for VM Management -->
    <key>com.apple.security.hypervisor</key>
    <true/>
    
    <!-- Network Access for VMs -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    
    <!-- File Access for VM Disks and ISOs -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Temporary Files for VM Operations -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
    <array>
        <string>/Users/</string>
        <string>/tmp/</string>
    </array>
    
    <!-- Inherited from parent (IDE) -->
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>

