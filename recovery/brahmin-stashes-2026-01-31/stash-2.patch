+/**
+ * Fetch upload history for a workspace
+ */
+export async function fetchUploadHistory(
+  workspaceId: string,
+  limit: number = 20
+): Promise<UploadHistoryResponse> {
+  const response = await fetch(`/api/ai/upload?workspaceId=${encodeURIComponent(workspaceId)}&limit=${limit}`, {
+    method: 'GET'
+  });
+
+  if (!response.ok) {
+    const errorResponse = await response.json().catch(() => ({}));
+    throw new Error(errorResponse.error || 'Failed to fetch upload history');
+  }
+
+  return response.json() as Promise<UploadHistoryResponse>;
+}
