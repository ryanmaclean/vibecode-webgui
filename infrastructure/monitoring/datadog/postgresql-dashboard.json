{
  "title": "PostgreSQL GenAI Monitoring",
  "description": "Dashboard for monitoring PostgreSQL performance with GenAI workloads",
  "widgets": [
    {
      "definition": {
        "type": "timeseries",
        "title": "Embedding Generation Performance",
        "requests": [
          {
            "q": "avg:postgresql.queries.avg_time{*}[5m] by {query}",
            "display_type": "line"
          }
        ],
        "yaxis": {
          "scale": "log"
        },
        "markers": []
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Total Embeddings Stored",
        "requests": [
          {
            "q": "sum:postgresql.rows_returned{*}",
            "aggregator": "avg"
          }
        ],
        "autoscale": true
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Query Performance",
        "requests": [
          {
            "q": "avg:postgresql.queries.avg_time{*}[5m] by {query}",
            "display_type": "line"
          }
        ],
        "yaxis": {
          "scale": "log"
        }
      }
    },
    {
      "definition": {
        "type": "toplist",
        "title": "Slowest Queries (avg time)",
        "requests": [
          {
            "q": "top(avg:postgresql.queries.avg_time{*} by {query}, 5, 'mean', 'desc')"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Vector Index Performance",
        "requests": [
          {
            "q": "avg:postgresql.index_scan{*}[5m]",
            "display_type": "line"
          },
          {
            "q": "avg:postgresql.seq_scan{*}[5m]",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Cache Hit Ratio",
        "requests": [
          {
            "q": "100 * (sum:postgresql.cache.hits{*} by {db}) / (sum:postgresql.cache.hits{*} by {db} + sum:postgresql.cache.misses{*} by {db})",
            "display_type": "line"
          }
        ],
        "yaxis": {
          "min": "0",
          "max": "100"
        }
      }
    }
  ],
  "template_variables": [
    {
      "name": "db",
      "prefix": "db",
      "default": "*"
    }
  ],
  "layout_type": "ordered",
  "is_read_only": false,
  "notify_list": [],
  "reflow_type": "fixed",
  "id": ""
}
