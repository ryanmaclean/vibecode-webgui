{
  "config": {
    "assertions": [
      {
        "operator": "is",
        "type": "statusCode",
        "target": 200
      },
      {
        "operator": "lessThan",
        "type": "responseTime",
        "target": 5000
      },
      {
        "operator": "is",
        "property": "content-type",
        "type": "header",
        "target": "application/json; charset=utf-8"
      },
      {
        "operator": "validates",
        "type": "body",
        "target": {
          "jsonPath": "$.providers",
          "operator": "isPresent"
        }
      },
      {
        "operator": "validates",
        "type": "body",
        "target": {
          "jsonPath": "$.csrfToken",
          "operator": "isPresent"
        }
      }
    ],
    "request": {
      "method": "GET",
      "url": "https://app.vibecode.com/api/auth/csrf",
      "headers": {
        "Accept": "application/json"
      }
    }
  },
  "locations": [
    "aws:us-east-1",
    "aws:us-west-2",
    "aws:eu-west-1",
    "aws:ap-southeast-1"
  ],
  "message": "Monitor the OAuth authentication flow endpoint. Alerts @slack-vibecode-alerts if authentication endpoint is unavailable or returns errors, which would block user login.",
  "name": "OAuth Authentication Flow - Health Check",
  "options": {
    "min_failure_duration": 60,
    "min_location_failed": 2,
    "monitor_options": {
      "renotify_interval": 0
    },
    "tick_every": 300
  },
  "public_id": "vib-ecd-auth-flow",
  "subtype": "http",
  "tags": [
    "env:production",
    "team:platform",
    "service:authentication",
    "critical:true"
  ],
  "type": "api"
}
