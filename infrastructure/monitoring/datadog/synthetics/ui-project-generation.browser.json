{
  "config": {
    "assertions": [],
    "configVariables": [
      {
        "example": "user@example.com",
        "name": "VIBECODE_TEST_EMAIL",
        "pattern": ".*",
        "type": "text"
      },
      {
        "example": "test-password",
        "name": "VIBECODE_TEST_PASSWORD",
        "pattern": ".*",
        "type": "secret"
      }
    ],
    "request": {
      "url": "https://app.vibecode.com"
    },
    "setCookie": "",
    "variables": []
  },
  "locations": [
    "aws:us-east-1",
    "aws:us-west-2"
  ],
  "message": "End-to-end browser test for project generation UI flow. Simulates complete user journey from login to project creation. Alerts @slack-vibecode-alerts on critical UI failures.",
  "name": "UI Project Generation - E2E Browser Test",
  "options": {
    "ci": {
      "executionRule": "blocking"
    },
    "device_ids": [
      "laptop_large"
    ],
    "min_failure_duration": 0,
    "min_location_failed": 1,
    "monitor_options": {
      "renotify_interval": 0
    },
    "retry": {
      "count": 2,
      "interval": 300
    },
    "tick_every": 900
  },
  "public_id": "vib-ecd-ui-proj-gen",
  "steps": [
    {
      "allowFailure": false,
      "isCritical": true,
      "name": "Navigate to Login Page",
      "params": {},
      "timeout": 60,
      "type": "goToUrl",
      "value": "https://app.vibecode.com/auth/signin"
    },
    {
      "allowFailure": false,
      "isCritical": true,
      "name": "Enter Email",
      "params": {
        "element": {
          "multiLocator": {
            "ab": "",
            "at": "",
            "cl": "",
            "co": "",
            "cxt": "",
            "ro": "//*[@id=\"email\"]",
            "value": "input[name=\"email\"]"
          },
          "userLocator": {
            "failTestOnCannotLocate": true,
            "value": "input[name=\"email\"]"
          }
        },
        "value": "{{ VIBECODE_TEST_EMAIL }}"
      },
      "timeout": 60,
      "type": "typeText"
    },
    {
      "allowFailure": false,
      "isCritical": true,
      "name": "Enter Password",
      "params": {
        "element": {
          "multiLocator": {
            "ab": "",
            "at": "",
            "cl": "",
            "co": "",
            "cxt": "",
            "ro": "//*[@id=\"password\"]",
            "value": "input[name=\"password\"]"
          },
          "userLocator": {
            "failTestOnCannotLocate": true,
            "value": "input[name=\"password\"]"
          }
        },
        "value": "{{ VIBECODE_TEST_PASSWORD }}"
      },
      "timeout": 60,
      "type": "typeText"
    },
    {
      "allowFailure": false,
      "isCritical": true,
      "name": "Click Sign In Button",
      "params": {
        "element": {
          "multiLocator": {
            "ab": "",
            "at": "",
            "cl": "",
            "co": "",
            "cxt": "",
            "ro": "//button[contains(text(),'Sign in')]",
            "value": "button[type=\"submit\"]"
          },
          "userLocator": {
            "failTestOnCannotLocate": true,
            "value": "button[type=\"submit\"]"
          }
        }
      },
      "timeout": 60,
      "type": "click"
    },
    {
      "allowFailure": false,
      "isCritical": true,
      "name": "Wait for Dashboard to Load",
      "params": {
        "element": {
          "multiLocator": {
            "ab": "",
            "at": "",
            "cl": "",
            "co": "",
            "cxt": "",
            "ro": "//*[contains(text(),'New Project')]",
            "value": "[data-testid=\"new-project-button\"]"
          },
          "userLocator": {
            "failTestOnCannotLocate": true,
            "value": "[data-testid=\"new-project-button\"]"
          }
        },
        "value": 30000
      },
      "timeout": 60,
      "type": "waitForElementPresent"
    },
    {
      "allowFailure": false,
      "isCritical": true,
      "name": "Click New Project Button",
      "params": {
        "element": {
          "multiLocator": {
            "ab": "",
            "at": "",
            "cl": "",
            "co": "",
            "cxt": "",
            "ro": "//*[contains(text(),'New Project')]",
            "value": "[data-testid=\"new-project-button\"]"
          },
          "userLocator": {
            "failTestOnCannotLocate": true,
            "value": "[data-testid=\"new-project-button\"]"
          }
        }
      },
      "timeout": 60,
      "type": "click"
    },
    {
      "allowFailure": false,
      "isCritical": true,
      "name": "Enter Project Prompt",
      "params": {
        "element": {
          "multiLocator": {
            "ab": "",
            "at": "",
            "cl": "",
            "co": "",
            "cxt": "",
            "ro": "//*[@id=\"project-prompt\"]",
            "value": "textarea[name=\"prompt\"]"
          },
          "userLocator": {
            "failTestOnCannotLocate": true,
            "value": "textarea[name=\"prompt\"]"
          }
        },
        "value": "Create a simple React counter app"
      },
      "timeout": 60,
      "type": "typeText"
    },
    {
      "allowFailure": false,
      "isCritical": true,
      "name": "Click Generate Project Button",
      "params": {
        "element": {
          "multiLocator": {
            "ab": "",
            "at": "",
            "cl": "",
            "co": "",
            "cxt": "",
            "ro": "//button[contains(text(),'Generate')]",
            "value": "[data-testid=\"generate-project-button\"]"
          },
          "userLocator": {
            "failTestOnCannotLocate": true,
            "value": "[data-testid=\"generate-project-button\"]"
          }
        }
      },
      "timeout": 60,
      "type": "click"
    },
    {
      "allowFailure": false,
      "isCritical": true,
      "name": "Wait for Project Generation Complete",
      "params": {
        "element": {
          "multiLocator": {
            "ab": "",
            "at": "",
            "cl": "",
            "co": "",
            "cxt": "",
            "ro": "//*[contains(text(),'Open Workspace')]",
            "value": "[data-testid=\"open-workspace-button\"]"
          },
          "userLocator": {
            "failTestOnCannotLocate": true,
            "value": "[data-testid=\"open-workspace-button\"]"
          }
        },
        "value": 60000
      },
      "timeout": 90,
      "type": "waitForElementPresent"
    },
    {
      "allowFailure": false,
      "isCritical": false,
      "name": "Verify Success Message",
      "params": {
        "check": "contains",
        "element": {
          "multiLocator": {
            "ab": "",
            "at": "",
            "cl": "",
            "co": "",
            "cxt": "",
            "ro": "//*[@class=\"success-message\"]",
            "value": ".success-message"
          },
          "userLocator": {
            "failTestOnCannotLocate": false,
            "value": ".success-message"
          }
        },
        "value": "Project created successfully"
      },
      "timeout": 60,
      "type": "assertElementContent"
    }
  ],
  "tags": [
    "env:production",
    "team:platform",
    "service:ui",
    "critical:true",
    "e2e:true"
  ],
  "type": "browser"
}
