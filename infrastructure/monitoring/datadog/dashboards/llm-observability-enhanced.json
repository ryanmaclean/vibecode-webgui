{
  "title": "VibeCode - Enhanced LLM Observability",
  "description": "Comprehensive LLM monitoring dashboard with cost tracking, performance analysis, provider health, and business intelligence metrics for the VibeCode AI Gateway and OpenRouter integration.",
  "layout_type": "ordered",
  "notify_list": [],
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "default": "*",
      "available_values": ["production", "staging", "development"]
    },
    {
      "name": "service",
      "prefix": "service",
      "default": "vibecode-ai-gateway",
      "available_values": ["vibecode-ai-gateway", "vibecode-webgui"]
    },
    {
      "name": "model_provider",
      "prefix": "model_provider",
      "default": "*",
      "available_values": ["anthropic", "openai", "google", "meta"]
    },
    {
      "name": "model_family",
      "prefix": "model_family",
      "default": "*",
      "available_values": ["claude", "gpt", "gemini", "llama"]
    },
    {
      "name": "model",
      "prefix": "model",
      "default": "*"
    },
    {
      "name": "user",
      "prefix": "user",
      "default": "*"
    }
  ],
  "widgets": [
    {
      "id": 0,
      "definition": {
        "type": "note",
        "content": "# Core LLM Metrics\nOverview of token usage, request rates, costs, and latency percentiles across all models and providers.",
        "background_color": "blue",
        "font_size": "14",
        "text_align": "left",
        "vertical_align": "top",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "has_padding": true
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 1
      }
    },
    {
      "id": 1,
      "definition": {
        "title": "Token Usage Trends (Input vs Output)",
        "title_size": "16",
        "title_align": "left",
        "legend_columns": ["avg", "min", "max", "value"],
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.tokens_prompt{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family,model:$model} by {model}.rollup(sum,60)",
            "display_type": "area",
            "style": {
              "palette": "cool",
              "line_type": "solid",
              "line_width": "normal"
            },
            "metadata": [
              {
                "expression": "sum:vibecode.ai_gateway.tokens_prompt{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family,model:$model} by {model}.rollup(sum,60)",
                "alias_name": "Input Tokens"
              }
            ]
          },
          {
            "q": "sum:vibecode.ai_gateway.tokens_completion{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family,model:$model} by {model}.rollup(sum,60)",
            "display_type": "area",
            "style": {
              "palette": "warm",
              "line_type": "solid",
              "line_width": "normal"
            },
            "metadata": [
              {
                "expression": "sum:vibecode.ai_gateway.tokens_completion{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family,model:$model} by {model}.rollup(sum,60)",
                "alias_name": "Output Tokens"
              }
            ]
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true,
          "label": "Tokens",
          "min": "auto",
          "max": "auto"
        },
        "markers": []
      },
      "layout": {
        "x": 0,
        "y": 1,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 2,
      "definition": {
        "title": "Total Token Usage by Model",
        "title_size": "16",
        "title_align": "left",
        "legend_columns": ["avg", "sum", "value"],
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.tokens_total{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family,model:$model} by {model}.rollup(sum,60)",
            "display_type": "bars",
            "style": {
              "palette": "purple",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true,
          "label": "Total Tokens",
          "min": "auto",
          "max": "auto"
        }
      },
      "layout": {
        "x": 6,
        "y": 1,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 3,
      "definition": {
        "title": "Cost Tracking per Model (USD)",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": ["avg", "sum", "max", "value"],
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.cost_usd{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family,model:$model} by {model}.rollup(sum,300)",
            "display_type": "line",
            "style": {
              "palette": "grey",
              "line_type": "solid",
              "line_width": "thick"
            }
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true,
          "label": "Cost (USD)",
          "min": "auto",
          "max": "auto"
        },
        "markers": []
      },
      "layout": {
        "x": 0,
        "y": 4,
        "width": 8,
        "height": 3
      }
    },
    {
      "id": 4,
      "definition": {
        "title": "Total Cost by Provider (24h)",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.cost_usd{service:$service,env:$env,model_provider:$model_provider}.rollup(sum,86400)",
            "aggregator": "sum",
            "conditional_formats": [
              {
                "comparator": ">",
                "value": 100,
                "palette": "white_on_red"
              },
              {
                "comparator": ">",
                "value": 50,
                "palette": "white_on_yellow"
              },
              {
                "comparator": "<=",
                "value": 50,
                "palette": "white_on_green"
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 2,
        "custom_unit": "$"
      },
      "layout": {
        "x": 8,
        "y": 4,
        "width": 2,
        "height": 3
      }
    },
    {
      "id": 5,
      "definition": {
        "title": "Avg Cost per Request",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.cost_usd{service:$service,env:$env}.rollup(sum,3600) / sum:vibecode.ai_gateway.requests{service:$service,env:$env}.as_count().rollup(sum,3600)",
            "aggregator": "avg",
            "conditional_formats": [
              {
                "comparator": ">",
                "value": 0.5,
                "palette": "white_on_red"
              },
              {
                "comparator": ">",
                "value": 0.1,
                "palette": "white_on_yellow"
              },
              {
                "comparator": "<=",
                "value": 0.1,
                "palette": "white_on_green"
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 4,
        "custom_unit": "$"
      },
      "layout": {
        "x": 10,
        "y": 4,
        "width": 2,
        "height": 3
      }
    },
    {
      "id": 6,
      "definition": {
        "title": "Request Latency Percentiles (p50, p95, p99)",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": ["avg", "min", "max", "value"],
        "type": "timeseries",
        "requests": [
          {
            "q": "p50:vibecode.ai_gateway.latency_ms{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family}",
            "display_type": "line",
            "style": {
              "palette": "green",
              "line_type": "solid",
              "line_width": "normal"
            },
            "metadata": [
              {
                "expression": "p50:vibecode.ai_gateway.latency_ms{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family}",
                "alias_name": "p50 Latency"
              }
            ]
          },
          {
            "q": "p95:vibecode.ai_gateway.latency_ms{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family}",
            "display_type": "line",
            "style": {
              "palette": "orange",
              "line_type": "solid",
              "line_width": "normal"
            },
            "metadata": [
              {
                "expression": "p95:vibecode.ai_gateway.latency_ms{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family}",
                "alias_name": "p95 Latency"
              }
            ]
          },
          {
            "q": "p99:vibecode.ai_gateway.latency_ms{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family}",
            "display_type": "line",
            "style": {
              "palette": "red",
              "line_type": "dashed",
              "line_width": "thick"
            },
            "metadata": [
              {
                "expression": "p99:vibecode.ai_gateway.latency_ms{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family}",
                "alias_name": "p99 Latency"
              }
            ]
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": false,
          "label": "Latency (ms)",
          "min": "auto",
          "max": "auto"
        },
        "markers": [
          {
            "value": "y = 5000",
            "display_type": "error dashed",
            "label": "SLA Threshold"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 7,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 7,
      "definition": {
        "title": "Error Rates by Model and Type",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "legend_layout": "auto",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.error{service:$service,env:$env,model_provider:$model_provider,model:$model} by {error_type,model}.rollup(sum,60)",
            "display_type": "bars",
            "style": {
              "palette": "warm",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true,
          "label": "Error Count",
          "min": "auto",
          "max": "auto"
        }
      },
      "layout": {
        "x": 6,
        "y": 7,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 8,
      "definition": {
        "title": "Requests per Minute",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.requests{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family}.as_count().rollup(sum,60)",
            "display_type": "line",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true,
          "label": "Requests/min",
          "min": "auto",
          "max": "auto"
        }
      },
      "layout": {
        "x": 0,
        "y": 10,
        "width": 4,
        "height": 3
      }
    },
    {
      "id": 9,
      "definition": {
        "title": "Error Rate %",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "q": "(sum:vibecode.ai_gateway.error{service:$service,env:$env}.as_count() / sum:vibecode.ai_gateway.requests{service:$service,env:$env}.as_count()) * 100",
            "aggregator": "avg",
            "conditional_formats": [
              {
                "comparator": ">",
                "value": 5,
                "palette": "white_on_red"
              },
              {
                "comparator": ">",
                "value": 1,
                "palette": "white_on_yellow"
              },
              {
                "comparator": "<=",
                "value": 1,
                "palette": "white_on_green"
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 2,
        "custom_unit": "%"
      },
      "layout": {
        "x": 4,
        "y": 10,
        "width": 2,
        "height": 3
      }
    },
    {
      "id": 10,
      "definition": {
        "title": "Avg Response Time (ms)",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "q": "avg:vibecode.ai_gateway.latency_ms{service:$service,env:$env}",
            "aggregator": "avg",
            "conditional_formats": [
              {
                "comparator": ">",
                "value": 10000,
                "palette": "white_on_red"
              },
              {
                "comparator": ">",
                "value": 5000,
                "palette": "white_on_yellow"
              },
              {
                "comparator": "<=",
                "value": 5000,
                "palette": "white_on_green"
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 0,
        "custom_unit": "ms"
      },
      "layout": {
        "x": 6,
        "y": 10,
        "width": 2,
        "height": 3
      }
    },
    {
      "id": 11,
      "definition": {
        "title": "Total Requests (24h)",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.requests{service:$service,env:$env}.as_count().rollup(sum,86400)",
            "aggregator": "sum"
          }
        ],
        "autoscale": true,
        "precision": 0
      },
      "layout": {
        "x": 8,
        "y": 10,
        "width": 2,
        "height": 3
      }
    },
    {
      "id": 12,
      "definition": {
        "title": "Total Tokens (24h)",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.tokens_total{service:$service,env:$env}.rollup(sum,86400)",
            "aggregator": "sum"
          }
        ],
        "autoscale": true,
        "precision": 0,
        "custom_unit": "tokens"
      },
      "layout": {
        "x": 10,
        "y": 10,
        "width": 2,
        "height": 3
      }
    },
    {
      "id": 13,
      "definition": {
        "type": "note",
        "content": "# Model Performance Comparison\nSide-by-side analysis of different models including response time vs cost analysis and quality metrics.",
        "background_color": "green",
        "font_size": "14",
        "text_align": "left",
        "vertical_align": "top",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "has_padding": true
      },
      "layout": {
        "x": 0,
        "y": 13,
        "width": 12,
        "height": 1
      }
    },
    {
      "id": 14,
      "definition": {
        "title": "Response Time vs Cost by Model",
        "title_size": "16",
        "title_align": "left",
        "type": "scatterplot",
        "requests": {
          "x": {
            "q": "avg:vibecode.ai_gateway.latency_ms{service:$service,env:$env} by {model}",
            "aggregator": "avg"
          },
          "y": {
            "q": "avg:vibecode.ai_gateway.cost_usd{service:$service,env:$env} by {model}",
            "aggregator": "avg"
          }
        },
        "xaxis": {
          "scale": "linear",
          "include_zero": false,
          "label": "Avg Latency (ms)",
          "min": "auto",
          "max": "auto"
        },
        "yaxis": {
          "scale": "linear",
          "include_zero": false,
          "label": "Avg Cost (USD)",
          "min": "auto",
          "max": "auto"
        }
      },
      "layout": {
        "x": 0,
        "y": 14,
        "width": 6,
        "height": 4
      }
    },
    {
      "id": 15,
      "definition": {
        "title": "Model Selection Distribution",
        "title_size": "16",
        "title_align": "left",
        "type": "sunburst",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.selection{service:$service,env:$env} by {model_provider,model_family,model}.rollup(sum,3600)",
            "style": {
              "palette": "datadog16"
            }
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 14,
        "width": 6,
        "height": 4
      }
    },
    {
      "id": 16,
      "definition": {
        "title": "Top 10 Models by Request Count",
        "title_size": "16",
        "title_align": "left",
        "type": "toplist",
        "requests": [
          {
            "q": "top(sum:vibecode.ai_gateway.requests{service:$service,env:$env} by {model}.as_count().rollup(sum,3600), 10, 'sum', 'desc')",
            "style": {
              "palette": "dog_classic"
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 18,
        "width": 4,
        "height": 3
      }
    },
    {
      "id": 17,
      "definition": {
        "title": "Top 10 Models by Cost",
        "title_size": "16",
        "title_align": "left",
        "type": "toplist",
        "requests": [
          {
            "q": "top(sum:vibecode.ai_gateway.cost_usd{service:$service,env:$env} by {model}.rollup(sum,3600), 10, 'sum', 'desc')",
            "style": {
              "palette": "warm"
            },
            "conditional_formats": [
              {
                "comparator": ">",
                "value": 10,
                "palette": "white_on_red"
              },
              {
                "comparator": ">",
                "value": 5,
                "palette": "white_on_yellow"
              }
            ]
          }
        ]
      },
      "layout": {
        "x": 4,
        "y": 18,
        "width": 4,
        "height": 3
      }
    },
    {
      "id": 18,
      "definition": {
        "title": "Fastest Models (p50 Latency)",
        "title_size": "16",
        "title_align": "left",
        "type": "toplist",
        "requests": [
          {
            "q": "top(p50:vibecode.ai_gateway.latency_ms{service:$service,env:$env} by {model}, 10, 'mean', 'asc')",
            "style": {
              "palette": "green"
            }
          }
        ]
      },
      "layout": {
        "x": 8,
        "y": 18,
        "width": 4,
        "height": 3
      }
    },
    {
      "id": 19,
      "definition": {
        "type": "note",
        "content": "# Provider Health & Reliability\nOpenRouter API health, rate limits, error patterns, and failover/retry metrics.",
        "background_color": "orange",
        "font_size": "14",
        "text_align": "left",
        "vertical_align": "top",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "has_padding": true
      },
      "layout": {
        "x": 0,
        "y": 21,
        "width": 12,
        "height": 1
      }
    },
    {
      "id": 20,
      "definition": {
        "title": "Provider Availability %",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "type": "timeseries",
        "requests": [
          {
            "q": "(1 - (sum:vibecode.ai_gateway.error{service:$service,env:$env,model_provider:$model_provider} by {model_provider}.as_count() / sum:vibecode.ai_gateway.requests{service:$service,env:$env,model_provider:$model_provider} by {model_provider}.as_count())) * 100",
            "display_type": "line",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": false,
          "label": "Availability %",
          "min": "95",
          "max": "100"
        },
        "markers": [
          {
            "value": "y = 99.9",
            "display_type": "ok dashed",
            "label": "SLA Target"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 22,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 21,
      "definition": {
        "title": "Provider Error Distribution",
        "title_size": "16",
        "title_align": "left",
        "type": "sunburst",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.error{service:$service,env:$env} by {model_provider,error_type}.as_count().rollup(sum,3600)",
            "style": {
              "palette": "warm"
            }
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 22,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 22,
      "definition": {
        "title": "Rate Limit Events",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.rate_limit{service:$service,env:$env,model_provider:$model_provider} by {model_provider}.as_count().rollup(sum,300)",
            "display_type": "bars",
            "style": {
              "palette": "warm",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true,
          "label": "Rate Limit Hits",
          "min": "auto",
          "max": "auto"
        }
      },
      "layout": {
        "x": 0,
        "y": 25,
        "width": 4,
        "height": 3
      }
    },
    {
      "id": 23,
      "definition": {
        "title": "Retry and Fallback Attempts",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "legend_layout": "auto",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.retry{service:$service,env:$env,model_provider:$model_provider} by {model_provider}.as_count().rollup(sum,60)",
            "display_type": "line",
            "style": {
              "palette": "orange",
              "line_type": "solid",
              "line_width": "normal"
            },
            "metadata": [
              {
