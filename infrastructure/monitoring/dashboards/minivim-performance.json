{
  "title": "MiniVim Performance Dashboard",
  "description": "Boot time, kernel size, and CI performance metrics for MiniVim microVM builds",
  "widgets": [
    {
      "id": 1,
      "definition": {
        "title": "MiniVim Boot Time (Cold Start)",
        "title_size": "16",
        "title_align": "left",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:minivim.boot_time{environment:production} by {arch}",
            "display_type": "line",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": {
          "label": "Seconds",
          "scale": "linear",
          "min": "auto",
          "max": "auto"
        },
        "markers": [
          {
            "value": "y = 10",
            "display_type": "error dashed",
            "label": "10s Target"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 2,
      "definition": {
        "title": "Kernel Size by Architecture",
        "type": "query_value",
        "requests": [
          {
            "q": "avg:minivim.kernel_size_bytes{*} by {arch}",
            "aggregator": "last"
          }
        ],
        "custom_unit": "B",
        "precision": 2
      },
      "layout": {
        "x": 6,
        "y": 0,
        "width": 2,
        "height": 3
      }
    },
    {
      "id": 3,
      "definition": {
        "title": "CI Build Success Rate",
        "type": "query_value",
        "requests": [
          {
            "q": "(sum:minivim.ci.success{*}.as_count() / sum:minivim.ci.total{*}.as_count()) * 100",
            "aggregator": "avg"
          }
        ],
        "custom_unit": "%",
        "precision": 1
      },
      "layout": {
        "x": 8,
        "y": 0,
        "width": 2,
        "height": 3
      }
    },
    {
      "id": 4,
      "definition": {
        "title": "Build Time by Architecture",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:minivim.build_duration_seconds{*} by {arch}",
            "display_type": "bars"
          }
        ],
        "yaxis": {
          "label": "Seconds"
        }
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 5,
      "definition": {
        "title": "Memory Usage at Idle",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:minivim.memory_idle_mb{*} by {arch}",
            "display_type": "line"
          }
        ],
        "yaxis": {
          "label": "MB"
        },
        "markers": [
          {
            "value": "y = 512",
            "display_type": "warning dashed",
            "label": "512MB Target"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 3,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 6,
      "definition": {
        "title": "CI Failure Reasons",
        "type": "toplist",
        "requests": [
          {
            "q": "top(sum:minivim.ci.failure{*} by {reason}.as_count(), 10, 'sum', 'desc')"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 6,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 7,
      "definition": {
        "title": "Build Artifacts Size Trend",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:minivim.artifact_size_mb{*} by {arch,kernel_version}",
            "display_type": "area"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 6,
        "width": 6,
        "height": 3
      }
    }
  ],
  "template_variables": [
    {
      "name": "arch",
      "prefix": "arch",
      "available_values": ["x86_64", "arm64", "armv7"],
      "default": "*"
    },
    {
      "name": "environment",
      "prefix": "environment",
      "available_values": ["production", "staging", "ci"],
      "default": "*"
    }
  ],
  "layout_type": "ordered",
  "notify_list": [],
  "reflow_type": "fixed"
}
