#!/bin/busybox sh
# VibeCode Services VM Init Script
# Generated by Ansible

echo "=== Booting {{ vm_hostname }} ==="

/bin/busybox --install -s /bin

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /tmp && mount -t tmpfs tmp /tmp

# Load network modules
insmod /lib/modules/5.15.0-161-generic/kernel/net/core/failover.ko 2>/dev/null || true
insmod /lib/modules/5.15.0-161-generic/kernel/drivers/net/net_failover.ko 2>/dev/null || true
insmod /lib/modules/5.15.0-161-generic/kernel/drivers/net/virtio_net.ko 2>/dev/null || true
sleep 2

# Create directories
mkdir -p /etc /var/log /home /etc/dropbear /root /var/lib/postgresql/data /run/postgresql /var/run/avahi-daemon
echo "127.0.0.1 localhost" > /etc/hosts
echo "{{ vm_hostname }}" > /etc/hostname
hostname {{ vm_hostname }}
chmod 700 /var/lib/postgresql/data

# Create device nodes
mknod -m 666 /dev/null c 1 3 2>/dev/null || true
mknod -m 666 /dev/zero c 1 5 2>/dev/null || true
mknod -m 666 /dev/random c 1 8 2>/dev/null || true
mknod -m 666 /dev/urandom c 1 9 2>/dev/null || true

echo ""
echo "=== Network ==="
ip link set lo up

FOUND_IFACE=""
for iface in enp0s1 eth0 ens3 ens4; do
    if ip link show $iface > /dev/null 2>&1; then
        FOUND_IFACE=$iface
        break
    fi
done

if [ -n "$FOUND_IFACE" ]; then
    echo "Found interface: $FOUND_IFACE"
    ip link set $FOUND_IFACE up
    
    # DHCP script
    cat > /tmp/udhcpc.script << 'DHCPEOF'
#!/bin/sh
case "$1" in
    deconfig)
        ip addr flush dev $interface
        ;;
    bound|renew)
        ip addr add $ip/$mask dev $interface
        if [ -n "$router" ]; then
            ip route add default via $router dev $interface
        fi
        if [ -n "$dns" ]; then
            echo "nameserver $dns" > /etc/resolv.conf
        fi
        ;;
esac
DHCPEOF
    chmod +x /tmp/udhcpc.script
    
    udhcpc -i $FOUND_IFACE -s /tmp/udhcpc.script -q -n 2>/dev/null
    VM_IP=$(ip addr show $FOUND_IFACE | grep 'inet ' | awk '{print $2}' | cut -d/ -f1)
    echo "IP: $VM_IP"
else
    echo "No network interface found"
    VM_IP="unknown"
fi

# Set library path
export LD_LIBRARY_PATH=/lib:/lib/aarch64-linux-gnu:/usr/lib:/usr/lib/aarch64-linux-gnu:/usr/lib/postgresql/{{ services.postgresql.version }}/lib
export HOME=/root
export PS1='{{ vm_hostname }}# '

{% if services.valkey.enabled %}
echo ""
echo "=== Valkey ==="
/bin/valkey-server --bind 0.0.0.0 --port {{ services.valkey.port }} --daemonize no > /tmp/valkey.log 2>&1 &
sleep 2
ps | grep -v grep | grep -q "valkey" && echo "Valkey OK on port {{ services.valkey.port }}" || { echo "Valkey FAIL"; cat /tmp/valkey.log | head -5; }
{% endif %}

{% if services.postgresql.enabled %}
echo ""
echo "=== PostgreSQL ==="
/usr/bin/postgres --version 2>&1 || echo "postgres version check failed"

# Create postgres user if needed
id postgres > /dev/null 2>&1 || {
    echo "postgres:x:999:999:PostgreSQL:/var/lib/postgresql:/bin/sh" >> /etc/passwd
    echo "postgres:x:999:" >> /etc/group
}
chown -R postgres:postgres /var/lib/postgresql /run/postgresql 2>/dev/null || true
chmod 777 /run/postgresql

if [ ! -f /var/lib/postgresql/data/PG_VERSION ]; then
    echo "Initializing DB..."
    su postgres -c "/usr/bin/initdb -D /var/lib/postgresql/data" 2>&1 | tail -3
    echo "host all all 0.0.0.0/0 trust" >> /var/lib/postgresql/data/pg_hba.conf
    echo "listen_addresses = '*'" >> /var/lib/postgresql/data/postgresql.conf
fi

su postgres -c "/usr/bin/postgres -D /var/lib/postgresql/data" > /tmp/postgresql.log 2>&1 &
sleep 3
ps | grep -v grep | grep -q "postgres" && echo "PostgreSQL OK on port {{ services.postgresql.port }}" || { echo "PostgreSQL FAIL"; cat /tmp/postgresql.log | head -10; }
{% endif %}

{% if services.openvscode.enabled %}
echo ""
echo "=== OpenVSCode ==="
mkdir -p /tmp/vscode-data
cd /opt/openvscode
./bin/openvscode-server --host 0.0.0.0 --port {{ services.openvscode.port }} --without-connection-token --accept-server-license-terms --user-data-dir /tmp/vscode-data > /tmp/openvscode.log 2>&1 &
sleep 3
ps | grep -v grep | grep -q "node" && echo "OpenVSCode OK at http://$VM_IP:{{ services.openvscode.port }}" || { echo "OpenVSCode FAIL"; cat /tmp/openvscode.log | head -5; }
{% endif %}

{% if services.ssh.enabled %}
echo ""
echo "=== Dropbear SSH ==="
mkdir -p /etc/dropbear
# Generate host keys if not present
if [ ! -f /etc/dropbear/dropbear_rsa_host_key ]; then
    /usr/bin/dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key 2>/dev/null
fi
if [ ! -f /etc/dropbear/dropbear_ecdsa_host_key ]; then
    /usr/bin/dropbearkey -t ecdsa -f /etc/dropbear/dropbear_ecdsa_host_key 2>/dev/null
fi
# Start dropbear (allow root login without password)
/usr/sbin/dropbear -R -B 2>&1 || echo "Dropbear failed to start"
sleep 1
ps | grep -v grep | grep -q dropbear && echo "SSH OK on port {{ services.ssh.port }} (root login enabled)" || echo "SSH FAIL"
{% endif %}

{% if services.avahi.enabled %}
echo ""
echo "=== Avahi mDNS ==="
/usr/sbin/avahi-daemon -D 2>&1 || echo "Avahi failed to start"
sleep 1
ps | grep -v grep | grep -q avahi && echo "Avahi OK - hostname: {{ vm_hostname }}.local" || echo "Avahi FAIL"
{% endif %}

echo ""
echo "========================================="
echo "  Services:"
{% if services.valkey.enabled %}
echo "    Valkey:     port {{ services.valkey.port }}"
{% endif %}
{% if services.postgresql.enabled %}
echo "    PostgreSQL: port {{ services.postgresql.port }}"
{% endif %}
{% if services.openvscode.enabled %}
echo "    OpenVSCode: port {{ services.openvscode.port }}"
{% endif %}
{% if services.ssh.enabled %}
echo "    SSH:        port {{ services.ssh.port }}"
{% endif %}
echo "  Access:"
echo "    IP:       $VM_IP"
{% if services.avahi.enabled %}
echo "    Hostname: {{ vm_hostname }}.local"
echo "    SSH:      ssh root@{{ vm_hostname }}.local"
{% endif %}
echo "========================================="

while true; do /bin/sh -i 2>&1; sleep 1; done

