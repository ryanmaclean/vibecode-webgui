{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types",
      "./src/types",
      "./types"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@langchain/openai": [
        "./src/lib/ai/stubs/langchain-openai"
      ],
      "@langchain/core/prompts": [
        "./src/lib/ai/stubs/langchain-prompts"
      ],
      "@langchain/core/output_parsers": [
        "./src/lib/ai/stubs/langchain-output-parsers"
      ],
      "@langchain/core/runnables": [
        "./src/lib/ai/stubs/langchain-runnables"
      ],
      "@langchain/core/messages": [
        "./src/lib/ai/stubs/langchain-messages"
      ],
      "@langchain/core/documents": [
        "./src/lib/ai/stubs/langchain-documents"
      ]
    },
    "moduleDetection": "force",
    "types": [
      "node",
      "jest"
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types/**/*.d.ts",
    "types/**/*.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "jest.config.js",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
