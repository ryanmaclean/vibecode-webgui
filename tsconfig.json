{
  "extends": "./config/typescript/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "react-jsx",
    "tsBuildInfoFile": ".next/cache/.tsbuildinfo",
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types",
      "./src/types",
      "./types"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "moduleDetection": "force"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types/**/*.d.ts",
    "types/**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "jest.config.js",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "src/extensions/**/*",
    "extensions/**/*",
    "**/*.stories.tsx",
    "tmp-*/**/*",
    "src/components/terminal/**/*",
    "types/@xterm/**/*",
    ".next/"
  ]
}
