# Datadog Error Tracking Environment Configuration
# Add these variables to your .env.local, .env.production, or Kubernetes secrets

# =============================================================================
# DATADOG ERROR TRACKING CONFIGURATION
# =============================================================================

# Core Datadog Configuration (Required for Error Tracking)
# These are the same variables used for RUM and APM
DATADOG_API_KEY=your-datadog-api-key-here
DD_API_KEY=your-datadog-api-key-here  # Alternative format
DD_APP_KEY=your-datadog-app-key-here
DATADOG_SITE=datadoghq.com
DD_SITE=datadoghq.com

# Service Configuration
DD_SERVICE=vibecode-webgui
DD_ENV=production  # or development, staging, etc.
DD_VERSION=1.0.0   # or your app version

# Frontend Error Tracking (Public variables for browser)
NEXT_PUBLIC_DD_APPLICATION_ID=your-datadog-application-id
NEXT_PUBLIC_DD_CLIENT_TOKEN=your-datadog-client-token
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_DD_SERVICE=vibecode-webgui
NEXT_PUBLIC_DD_ENV=production
NEXT_PUBLIC_DD_VERSION=1.0.0

# Error Tracking Specific Configuration
DD_ERROR_TRACKING_ENABLED=true
DD_ERROR_TRACKING_SAMPLE_RATE=1.0  # 0.0 to 1.0 (100% sampling)
DD_ERROR_TRACKING_SESSION_SAMPLE_RATE=1.0

# Performance Monitoring Integration
DD_PERFORMANCE_MONITORING_ENABLED=true
DD_PERFORMANCE_SAMPLE_RATE=0.1  # 10% sampling for performance

# Database Monitoring (if using DBM)
DD_DATABASE_MONITORING_ENABLED=true
DD_DBM_PROPAGATION_MODE=service

# =============================================================================
# MIGRATION FROM SENTRY (if applicable)
# =============================================================================

# Remove these Sentry variables if migrating from Sentry:
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# ERROR_TRACKING_DSN=  # This was used in AI analytics

# =============================================================================
# ERROR TRACKING FEATURES CONFIGURATION
# =============================================================================

# Enable specific error tracking features
DD_ERROR_TRACKING_USER_SESSIONS=true
DD_ERROR_TRACKING_SESSION_REPLAY=true
DD_ERROR_TRACKING_RESOURCE_TRACKING=true
DD_ERROR_TRACKING_LONG_TASK_TRACKING=true

# Privacy and Security Settings
DD_ERROR_TRACKING_PRIVACY_LEVEL=mask-user-input  # mask-all, mask-user-input, allow
DD_ERROR_TRACKING_MASK_TEXT_SELECTORS=[]  # Additional CSS selectors to mask
DD_ERROR_TRACKING_MASK_INPUT_SELECTORS=[]  # Additional input selectors to mask

# Custom Error Context
DD_ERROR_TRACKING_GLOBAL_CONTEXT_ENABLED=true
DD_ERROR_TRACKING_USER_CONTEXT_ENABLED=true
DD_ERROR_TRACKING_SESSION_CONTEXT_ENABLED=true

# =============================================================================
# DEVELOPMENT vs PRODUCTION SETTINGS
# =============================================================================

# Development Environment (more verbose logging)
# DD_ERROR_TRACKING_SAMPLE_RATE=1.0
# DD_ERROR_TRACKING_SESSION_SAMPLE_RATE=1.0
# DD_ERROR_TRACKING_SESSION_REPLAY_SAMPLE_RATE=1.0
# DD_ERROR_TRACKING_STARTUP_LOGS=true

# Production Environment (optimized sampling)
# DD_ERROR_TRACKING_SAMPLE_RATE=0.1
# DD_ERROR_TRACKING_SESSION_SAMPLE_RATE=0.1
# DD_ERROR_TRACKING_SESSION_REPLAY_SAMPLE_RATE=0.2
# DD_ERROR_TRACKING_STARTUP_LOGS=false

# =============================================================================
# INTEGRATION WITH EXISTING MONITORING
# =============================================================================

# These variables integrate with your existing monitoring setup
DD_RUM_ENABLED=true
DD_RUM_APPLICATION_ID=your-datadog-application-id
DD_RUM_CLIENT_TOKEN=your-datadog-client-token

# APM Integration
DD_TRACE_ENABLED=true
DD_TRACE_SAMPLE_RATE=0.1
DD_TRACE_ANALYTICS_ENABLED=true

# Logs Integration
DD_LOGS_ENABLED=true
DD_LOGS_CLIENT_TOKEN=your-datadog-client-token
DD_LOGS_FORWARD_ERRORS_TO_LOGS=true

# =============================================================================
# KUBERNETES DEPLOYMENT
# =============================================================================

# For Kubernetes deployments, add these to your secrets.yaml:
# apiVersion: v1
# kind: Secret
# metadata:
#   name: datadog-error-tracking
#   namespace: vibecode
# type: Opaque
# data:
#   DD_API_KEY: <base64-encoded-datadog-api-key>
#   DD_APP_KEY: <base64-encoded-datadog-app-key>
#   DD_SERVICE: <base64-encoded-service-name>
#   DD_ENV: <base64-encoded-environment>
#   DD_VERSION: <base64-encoded-version>

# =============================================================================
# VALIDATION AND TESTING
# =============================================================================

# Test Error Tracking Configuration
DD_ERROR_TRACKING_TEST_MODE=false  # Set to true for testing
DD_ERROR_TRACKING_TEST_ENDPOINT=https://intake.datadoghq.com/api/v2/logs

# Debug Configuration
DD_ERROR_TRACKING_DEBUG=false
DD_ERROR_TRACKING_VERBOSE_LOGGING=false

# =============================================================================
# EXAMPLE CONFIGURATION BY ENVIRONMENT
# =============================================================================

# Local Development (.env.local)
# DD_SERVICE=vibecode-webgui
# DD_ENV=development
# DD_VERSION=1.0.0-dev
# DD_ERROR_TRACKING_SAMPLE_RATE=1.0
# DD_ERROR_TRACKING_SESSION_SAMPLE_RATE=1.0

# Staging Environment
# DD_SERVICE=vibecode-webgui
# DD_ENV=staging
# DD_VERSION=1.0.0-staging
# DD_ERROR_TRACKING_SAMPLE_RATE=0.5
# DD_ERROR_TRACKING_SESSION_SAMPLE_RATE=0.5

# Production Environment
# DD_SERVICE=vibecode-webgui
# DD_ENV=production
# DD_VERSION=1.0.0
# DD_ERROR_TRACKING_SAMPLE_RATE=0.1
# DD_ERROR_TRACKING_SESSION_SAMPLE_RATE=0.1

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================

# Error Tracking Alerts (configure in Datadog UI)
# - High error rate alerts
# - New error type alerts
# - Error spike detection
# - Performance degradation alerts

# Integration with existing monitoring
DD_MONITORING_DASHBOARD_ENABLED=true
DD_MONITORING_ALERTS_ENABLED=true

# =============================================================================
# SECURITY CONSIDERATIONS
# =============================================================================

# Never commit real API keys to version control
# Use placeholder values in .env.example files
# Rotate API keys regularly
# Use different keys for each environment
# Monitor for exposed keys in logs/errors

# =============================================================================
# TROUBLESHOOTING
# =============================================================================

# Common Issues:
# 1. Missing DD_API_KEY: Error tracking won't work
# 2. Invalid DD_SITE: Wrong region configuration
# 3. Missing NEXT_PUBLIC_DD_CLIENT_TOKEN: Frontend tracking won't work
# 4. Incorrect DD_SERVICE: Errors will be tagged incorrectly

# Debug Commands:
# curl -X GET "https://api.datadoghq.com/api/v1/validate" \
#   -H "DD-API-KEY: $DD_API_KEY" \
#   -H "DD-APPLICATION-KEY: $DD_APP_KEY"

# Check Error Tracking Status:
# curl -X GET "https://api.datadoghq.com/api/v1/logs/config" \
#   -H "DD-API-KEY: $DD_API_KEY"
