{
  "name": "electron-vibecode",
  "version": "1.0.0",
  "description": "VibeCode - Electron version with Chromium engine for better extension compatibility",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:dmg": "electron-builder --mac --publish=never",
    "dist": "npm run build:dmg",
    "pack": "electron-builder --dir",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["vscode", "code-server", "electron", "development"],
  "author": "VibeCode Team",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.vibecode.electron",
    "productName": "VibeCode Electron",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "../src-tauri/icons/icon.icns"
    },
    "dmg": {
      "title": "VibeCode Electron",
      "icon": "../src-tauri/icons/icon.icns",
      "background": null,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^25.0.0"
  }
}
