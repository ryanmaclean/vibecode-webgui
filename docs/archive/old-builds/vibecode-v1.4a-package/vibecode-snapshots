#!/bin/bash

# VibeCode v1.4a - Advanced Snapshot Management
# Instant environment resets and cloning

ZFS_POOL="vibecode-pool"
ZFS_DATASET="vibecode-pool/vibecode"

case "$1" in
    "create")
        SNAPSHOT_NAME="vibecode-$(date +%Y%m%d-%H%M%S)"
        zfs snapshot "$ZFS_DATASET@$SNAPSHOT_NAME"
        echo "✅ Snapshot created: $SNAPSHOT_NAME"
        ;;
    "list")
        echo "📋 Available Snapshots:"
        zfs list -t snapshot "$ZFS_DATASET"
        ;;
    "rollback")
        if [ -z "$2" ]; then
            echo "Usage: $0 rollback <snapshot-name>"
            echo "Available snapshots:"
            zfs list -t snapshot "$ZFS_DATASET" | tail -n +2 | awk '{print $1}' | sed 's/.*@//'
            exit 1
        fi
        zfs rollback "$ZFS_DATASET@$2"
        echo "✅ Rolled back to: $2"
        ;;
    "clean")
        if zfs list -t snapshot "$ZFS_DATASET@baseline" >/dev/null 2>&1; then
            zfs rollback "$ZFS_DATASET@baseline"
            echo "✅ Rolled back to clean baseline state"
        else
            echo "⚠️  No baseline snapshot found"
            echo "   Create one with: $0 create"
        fi
        ;;
    "clone")
        if [ -z "$2" ] || [ -z "$3" ]; then
            echo "Usage: $0 clone <snapshot-name> <clone-name>"
            echo "Available snapshots:"
            zfs list -t snapshot "$ZFS_DATASET" | tail -n +2 | awk '{print $1}' | sed 's/.*@//'
            exit 1
        fi
        zfs clone "$ZFS_DATASET@$2" "$ZFS_DATASET-clone-$3"
        echo "✅ Clone created: $ZFS_DATASET-clone-$3"
        echo "   Mount point: $(zfs get -H -o value mountpoint "$ZFS_DATASET-clone-$3")"
        ;;
    "destroy")
        if [ -z "$2" ]; then
            echo "Usage: $0 destroy <snapshot-name>"
            echo "Available snapshots:"
            zfs list -t snapshot "$ZFS_DATASET" | tail -n +2 | awk '{print $1}' | sed 's/.*@//'
            exit 1
        fi
        zfs destroy "$ZFS_DATASET@$2"
        echo "✅ Snapshot destroyed: $2"
        ;;
    "backup")
        SNAPSHOT_NAME="backup-$(date +%Y%m%d-%H%M%S)"
        zfs snapshot "$ZFS_DATASET@$SNAPSHOT_NAME"
        echo "✅ Backup snapshot created: $SNAPSHOT_NAME"
        ;;
    "restore")
        if [ -z "$2" ]; then
            echo "Usage: $0 restore <snapshot-name>"
            echo "Available snapshots:"
            zfs list -t snapshot "$ZFS_DATASET" | tail -n +2 | awk '{print $1}' | sed 's/.*@//'
            exit 1
        fi
        zfs rollback "$ZFS_DATASET@$2"
        echo "✅ Restored from: $2"
        ;;
    *)
        echo "Usage: $0 {create|list|rollback|clean|clone|destroy|backup|restore}"
        echo ""
        echo "Commands:"
        echo "  create    - Create new snapshot"
        echo "  list      - List all snapshots"
        echo "  rollback  - Rollback to specific snapshot"
        echo "  clean     - Rollback to clean baseline state"
        echo "  clone     - Clone snapshot to new dataset"
        echo "  destroy   - Destroy specific snapshot"
        echo "  backup    - Create backup snapshot"
        echo "  restore   - Restore from snapshot"
        echo ""
        echo "Examples:"
        echo "  $0 create                    # Create snapshot with timestamp"
        echo "  $0 rollback vibecode-20241225-143022  # Rollback to specific snapshot"
        echo "  $0 clean                     # Rollback to clean state"
        echo "  $0 clone baseline my-project # Clone baseline to new project"
        echo "  $0 backup                    # Create backup snapshot"
        ;;
esac
