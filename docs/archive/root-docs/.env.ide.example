# VibeCode IDE Configuration Example
# Copy to .env.local and customize for your environment

# Default IDE Type (openvscode | code-server | theia)
DEFAULT_IDE_TYPE=openvscode

# OpenVSCode Server Configuration
OPENVSCODE_IMAGE=gitpod/openvscode-server:latest
OPENVSCODE_PORT=3000
OPENVSCODE_WORKSPACE_PATH=/workspace
OPENVSCODE_EXTENSIONS=ms-python.python,dbaeumer.vscode-eslint,esbenp.prettier-vscode

# Code-Server Configuration
CODESERVER_IMAGE=codercom/code-server:latest
CODESERVER_PORT=8080
CODESERVER_WORKSPACE_PATH=/home/coder/project
CODESERVER_AUTH_ENABLED=true
CODESERVER_PASSWORD=changeme
CODESERVER_EXTENSIONS=ms-python.python,dbaeumer.vscode-eslint

# Eclipse Theia Configuration
THEIA_IMAGE=theiaide/theia:latest
THEIA_PORT=3000
THEIA_WORKSPACE_PATH=/home/project
THEIA_PLUGINS=vscode-builtin-typescript,vscode-builtin-git

# Resource Limits (optional)
IDE_MEMORY_LIMIT=1g
IDE_CPU_LIMIT=2
IDE_STORAGE_LIMIT=10g

# Container Runtime (docker | podman | kubernetes)
CONTAINER_RUNTIME=docker

# Session Configuration
IDE_SESSION_TIMEOUT=3600
IDE_MAX_SESSIONS_PER_USER=5
