{
  "title": "Sequential Thinking API Overview",
  "description": "Request volume, latency, and fallback monitoring for /api/ai/sequential-thinking",
  "widgets": [
    {
      "type": "timeseries",
      "title": "Requests per Minute",
      "metric": "trace.mcp.sequential-thinking.request.rate"
    },
    {
      "type": "timeseries",
      "title": "Error Rate",
      "metric": "trace.mcp.sequential-thinking.error.rate",
      "thresholds": [{ "value": 0.1, "status": "warning" }]
    },
    {
      "type": "timeseries",
      "title": "Fallback Percentage",
      "metric": "custom.sequential-thinking.fallback_ratio",
      "thresholds": [{ "value": 0.25, "status": "critical" }]
    },
    {
      "type": "timeseries",
      "title": "p95 Processing Time (ms)",
      "metric": "trace.mcp.sequential-thinking.request.duration.p95",
      "thresholds": [{ "value": 5000, "status": "warning" }]
    }
  ]
}
