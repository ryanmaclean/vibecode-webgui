{
  "title": "Azure PostgreSQL GenAI Monitoring Dashboard",
  "description": "Comprehensive monitoring for Azure PostgreSQL with pgvector for GenAI applications",
  "widgets": [
    {
      "id": "genai_overview_header",
      "title": "GenAI PostgreSQL Performance Overview",
      "type": "note",
      "content": "Key metrics for PostgreSQL serving vector embeddings and similarity search operations",
      "background_color": "vivid_blue",
      "font_size": "18",
      "text_align": "center",
      "width": 12,
      "height": 1
    },
    {
      "id": "connection_pool_status",
      "title": "Connection Pool Status",
      "type": "timeseries",
      "query": "avg:azure_postgres.pool.total{*}, avg:azure_postgres.pool.active{*}, avg:azure_postgres.pool.idle{*}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "vector_query_rate",
      "title": "Vector Query Rate",
      "type": "timeseries",
      "query": "sum:postgres_vector_db.search.success{*}.as_rate(), sum:postgres_vector_db.search.error{*}.as_rate()",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "vector_query_latency",
      "title": "Vector Query Latency (ms)",
      "type": "timeseries",
      "query": "avg:postgres_vector_db.search.duration{*}, avg:postgres_vector_db.query.duration{*}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "embedding_operation_rate",
      "title": "Embedding Operation Rate",
      "type": "timeseries",
      "query": "sum:postgres_vector_db.store_chunks.success{*}.as_rate(), sum:postgres_vector_db.store_chunks.error{*}.as_rate()",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "db_resource_header",
      "title": "Database Resource Utilization",
      "type": "note",
      "content": "CPU, Memory, Disk, and Connection Resource Utilization",
      "background_color": "vivid_green",
      "font_size": "18",
      "text_align": "center",
      "width": 12,
      "height": 1
    },
    {
      "id": "cpu_usage",
      "title": "CPU Usage (%)",
      "type": "timeseries",
      "query": "avg:postgresql.cpu_usage{*}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "memory_usage",
      "title": "Memory Usage",
      "type": "timeseries",
      "query": "avg:postgresql.memory_usage{*}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "disk_usage",
      "title": "Disk Usage and Growth",
      "type": "timeseries",
      "query": "avg:postgresql.disk.used{*}, avg:postgresql.disk.total{*}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "connections",
      "title": "Active Connections",
      "type": "timeseries",
      "query": "avg:database.connections.active{*}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "genai_metrics_header",
      "title": "GenAI Specific Metrics",
      "type": "note",
      "content": "Vector Embeddings, Index Performance, and Similarity Search",
      "background_color": "vivid_purple",
      "font_size": "18",
      "text_align": "center",
      "width": 12,
      "height": 1
    },
    {
      "id": "vector_store_size",
      "title": "Vector Store Size",
      "type": "timeseries",
      "query": "avg:database.vector.embeddings{*}, avg:database.vector.index_size{*}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "similarity_search_latency",
      "title": "Similarity Search Latency (ms)",
      "type": "toplist",
      "query": "top(avg:postgres_vector_db.search.duration{*} by {table}, 10, 'mean', 'desc')",
      "viz": "toplist",
      "width": 6,
      "height": 4
    },
    {
      "id": "embedding_generation_vs_storage",
      "title": "Embedding Generation vs Storage Latency (ms)",
      "type": "timeseries",
      "query": "avg:ai.embedding.generation_time{*}, avg:postgres_vector_db.store_chunks.duration{*}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "cache_hit_rate",
      "title": "Vector Cache Hit Rate (%)",
      "type": "query_value",
      "query": "100 * (sum:postgres_vector_db.search.cache_hit{*}.as_count() / (sum:postgres_vector_db.search.cache_hit{*}.as_count() + sum:postgres_vector_db.search.success{*}.as_count() + 0.001))",
      "viz": "query_value",
      "width": 6,
      "height": 2,
      "precision": 2,
      "text_align": "center",
      "autoscale": true,
      "custom_unit": "%"
    },
    {
      "id": "query_performance_header",
      "title": "Query Performance Analysis",
      "type": "note",
      "content": "Slow Queries, Execution Plans, and Index Usage",
      "background_color": "vivid_orange",
      "font_size": "18",
      "text_align": "center",
      "width": 12,
      "height": 1
    },
    {
      "id": "slow_queries",
      "title": "Top 10 Slow Queries",
      "type": "toplist",
      "query": "top(avg:postgresql.queries.query_time.avg{*} by {query_digest}, 10, 'mean', 'desc')",
      "viz": "toplist",
      "width": 12,
      "height": 4
    },
    {
      "id": "index_usage",
      "title": "Vector Index Usage",
      "type": "timeseries",
      "query": "avg:postgresql.index.scans{*} by {index_name}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "index_size_growth",
      "title": "Vector Index Size Growth",
      "type": "timeseries",
      "query": "avg:postgresql.index.size{*} by {index_name}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "4h"
      }
    },
    {
      "id": "error_tracking_header",
      "title": "Error Tracking and Availability",
      "type": "note",
      "content": "Connection Errors, Query Failures, and Overall Health",
      "background_color": "vivid_red",
      "font_size": "18",
      "text_align": "center",
      "width": 12,
      "height": 1
    },
    {
      "id": "connection_errors",
      "title": "Connection Errors",
      "type": "timeseries",
      "query": "sum:azure_postgres.connection.failure{*}.as_rate()",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "query_errors",
      "title": "Query Errors by Type",
      "type": "timeseries",
      "query": "sum:azure_postgres.query.error{*} by {error_type}.as_rate()",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "vector_operation_availability",
      "title": "Vector Operations Availability (%)",
      "type": "query_value",
      "query": "100 * (sum:postgres_vector_db.search.success{*}.as_count() / (sum:postgres_vector_db.search.success{*}.as_count() + sum:postgres_vector_db.search.error{*}.as_count() + 0.001))",
      "viz": "query_value",
      "width": 6,
      "height": 2,
      "precision": 2,
      "text_align": "center",
      "autoscale": true,
      "custom_unit": "%",
      "conditional_formats": [
        {
          "comparator": "<",
          "value": 99.9,
          "palette": "red"
        },
        {
          "comparator": "<",
          "value": 99.99,
          "palette": "yellow"
        },
        {
          "comparator": ">=",
          "value": 99.99,
          "palette": "green"
        }
      ]
    },
    {
      "id": "recent_errors_list",
      "title": "Recent Database Errors (Last 15 Minutes)",
      "type": "log_stream",
      "query": "source:postgresql error",
      "columns": [
        "timestamp",
        "error_type",
        "operation",
        "message"
      ],
      "width": 12,
      "height": 4,
      "indexes": [
        "main"
      ],
      "sort": {
        "column": "timestamp",
        "order": "desc"
      }
    }
  ],
  "template_variables": [
    {
      "name": "environment",
      "prefix": "env",
      "default": "*"
    },
    {
      "name": "service",
      "prefix": "service",
      "default": "vibecode-webgui"
    },
    {
      "name": "database",
      "prefix": "database",
      "default": "*"
    }
  ],
  "layout_type": "ordered",
  "notify": {
    "on_change": false,
    "include_screenboard": false
  },
  "is_read_only": false
}