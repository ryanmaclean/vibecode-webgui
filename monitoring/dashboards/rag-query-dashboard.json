{
  "title": "RAG Query Performance Dashboard",
  "description": "Monitor and optimize Retrieval-Augmented Generation query performance with PostgreSQL and pgvector",
  "widgets": [
    {
      "id": "rag_overview_header",
      "title": "RAG Query Performance Overview",
      "type": "note",
      "content": "Key performance metrics for RAG retrieval operations",
      "background_color": "vivid_blue",
      "font_size": "18",
      "text_align": "center",
      "width": 12,
      "height": 1
    },
    {
      "id": "rag_query_latency",
      "title": "End-to-End RAG Query Latency (ms)",
      "type": "timeseries",
      "query": "avg:rag.total_latency{*}, avg:rag.vector_search_latency{*}, avg:rag.text_generation_latency{*}",
      "viz": "timeseries",
      "width": 12,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "rag_query_components",
      "title": "RAG Query Component Breakdown (ms)",
      "type": "query_table",
      "query": "avg:rag.embedding_generation_latency{*}, avg:rag.vector_search_latency{*}, avg:rag.result_processing_latency{*}, avg:rag.text_generation_latency{*}",
      "viz": "query_table",
      "width": 12,
      "height": 3
    },
    {
      "id": "retrieval_quality_header",
      "title": "Retrieval Quality Metrics",
      "type": "note",
      "content": "Relevance and quality metrics for vector search results",
      "background_color": "vivid_green",
      "font_size": "18",
      "text_align": "center",
      "width": 12,
      "height": 1
    },
    {
      "id": "chunk_relevance_score",
      "title": "Average Chunk Relevance Score",
      "type": "timeseries",
      "query": "avg:rag.chunk_relevance_score{*}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "chunk_count_distribution",
      "title": "Retrieved Chunk Count Distribution",
      "type": "distribution",
      "query": "avg:rag.retrieved_chunk_count{*} by {query_type}",
      "viz": "distribution",
      "width": 6,
      "height": 3
    },
    {
      "id": "similarity_threshold_impact",
      "title": "Similarity Threshold Impact on Results",
      "type": "heatmap",
      "query": "avg:rag.retrieved_chunk_count{*} by {similarity_threshold}",
      "viz": "heatmap",
      "width": 12,
      "height": 4
    },
    {
      "id": "vector_search_header",
      "title": "Vector Search Performance",
      "type": "note",
      "content": "PostgreSQL pgvector performance for similarity search operations",
      "background_color": "vivid_purple",
      "font_size": "18",
      "text_align": "center",
      "width": 12,
      "height": 1
    },
    {
      "id": "vector_search_latency_detailed",
      "title": "Vector Search Latency by Operation Type (ms)",
      "type": "timeseries",
      "query": "avg:postgres_vector_db.search.duration{*} by {index_type}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "vector_search_throughput",
      "title": "Vector Search Throughput (queries/sec)",
      "type": "timeseries",
      "query": "sum:postgres_vector_db.search.success{*}.as_rate()",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "vector_search_by_index",
      "title": "Vector Search Performance by Index Type",
      "type": "query_table",
      "query": "avg:postgres_vector_db.search.duration{*} by {index_type}",
      "viz": "query_table",
      "width": 12,
      "height": 3
    },
    {
      "id": "vector_search_optimization_header",
      "title": "Vector Search Optimization Metrics",
      "type": "note",
      "content": "Index and query optimization metrics for pgvector",
      "background_color": "vivid_orange",
      "font_size": "18",
      "text_align": "center",
      "width": 12,
      "height": 1
    },
    {
      "id": "index_scan_vs_seq_scan",
      "title": "Index Scans vs Sequential Scans",
      "type": "timeseries",
      "query": "sum:postgresql.index_scans{*}.as_rate(), sum:postgresql.seq_scans{*}.as_rate()",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "query_plan_types",
      "title": "Query Plan Types for Vector Searches",
      "type": "toplist",
      "query": "top(sum:postgresql.query_plans{*} by {plan_type}, 10, 'sum', 'desc')",
      "viz": "toplist",
      "width": 6,
      "height": 4
    },
    {
      "id": "cache_impact",
      "title": "Cache Impact on Vector Search (ms)",
      "type": "timeseries",
      "query": "avg:postgres_vector_db.search.duration{cache:hit}, avg:postgres_vector_db.search.duration{cache:miss}",
      "viz": "timeseries",
      "width": 12,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "llm_integration_header",
      "title": "LLM Integration Metrics",
      "type": "note",
      "content": "Metrics for LLM usage with RAG results",
      "background_color": "vivid_yellow",
      "font_size": "18",
      "text_align": "center",
      "width": 12,
      "height": 1
    },
    {
      "id": "llm_response_time",
      "title": "LLM Response Time with RAG Context (ms)",
      "type": "timeseries",
      "query": "avg:rag.text_generation_latency{*} by {model}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "token_usage",
      "title": "Token Usage by Component",
      "type": "timeseries",
      "query": "avg:rag.prompt_tokens{*}, avg:rag.completion_tokens{*}, avg:rag.retrieved_context_tokens{*}",
      "viz": "timeseries",
      "width": 6,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "user_experience_header",
      "title": "User Experience Metrics",
      "type": "note",
      "content": "End user experience metrics for RAG-powered applications",
      "background_color": "vivid_pink",
      "font_size": "18",
      "text_align": "center",
      "width": 12,
      "height": 1
    },
    {
      "id": "response_time_slo",
      "title": "RAG Response Time SLO",
      "type": "slo",
      "query": {
        "numerator": "sum:rag.total_latency{*} < 2000",
        "denominator": "sum:rag.total_latency{*}"
      },
      "viz": "slo",
      "width": 6,
      "height": 3,
      "time_windows": ["7d", "30d", "90d"],
      "view_type": "both",
      "view_mode": "overall"
    },
    {
      "id": "user_satisfaction",
      "title": "User Satisfaction with RAG Responses",
      "type": "query_value",
      "query": "avg:rag.user_satisfaction{*}",
      "viz": "query_value",
      "width": 6,
      "height": 2,
      "precision": 2,
      "text_align": "center",
      "autoscale": true,
      "conditional_formats": [
        {
          "comparator": "<",
          "value": 3,
          "palette": "red"
        },
        {
          "comparator": "<",
          "value": 4,
          "palette": "yellow"
        },
        {
          "comparator": ">=",
          "value": 4,
          "palette": "green"
        }
      ]
    },
    {
      "id": "rag_errors_header",
      "title": "RAG Query Errors",
      "type": "note",
      "content": "Error tracking and failure analysis for RAG queries",
      "background_color": "vivid_red",
      "font_size": "18",
      "text_align": "center",
      "width": 12,
      "height": 1
    },
    {
      "id": "error_rate_by_component",
      "title": "Error Rate by Component",
      "type": "timeseries",
      "query": "sum:rag.errors{*} by {component}.as_rate()",
      "viz": "timeseries",
      "width": 12,
      "height": 3,
      "time": {
        "live_span": "1h"
      }
    },
    {
      "id": "recent_rag_errors",
      "title": "Recent RAG Errors (Last 15 Minutes)",
      "type": "log_stream",
      "query": "source:rag error",
      "columns": [
        "timestamp",
        "component",
        "error_type",
        "message"
      ],
      "width": 12,
      "height": 4,
      "indexes": [
        "main"
      ],
      "sort": {
        "column": "timestamp",
        "order": "desc"
      }
    }
  ],
  "template_variables": [
    {
      "name": "environment",
      "prefix": "env",
      "default": "*"
    },
    {
      "name": "service",
      "prefix": "service",
      "default": "vibecode-webgui"
    },
    {
      "name": "model",
      "prefix": "model",
      "default": "*"
    },
    {
      "name": "query_type",
      "prefix": "query_type",
      "default": "*"
    }
  ],
  "layout_type": "ordered",
  "notify": {
    "on_change": false,
    "include_screenboard": false
  },
  "is_read_only": false
}