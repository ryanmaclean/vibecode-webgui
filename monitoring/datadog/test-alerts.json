{
  "alerts": [
    {
      "name": "VibeCode Test Pass Rate Low",
      "message": "Test pass rate has dropped below acceptable threshold",
      "query": "avg(last_5m):avg:test.result.pass_rate{service:vibecode-webgui} < 80",
      "thresholds": {
        "critical": 80,
        "warning": 90
      },
      "tags": [
        "service:vibecode-webgui",
        "alert:test_pass_rate"
      ],
      "notify": ["@slack-vibecode-alerts"]
    },
    {
      "name": "VibeCode Test Execution Timeout",
      "message": "Tests are taking too long to execute",
      "query": "avg(last_10m):avg:test.execution.duration{service:vibecode-webgui} > 30000",
      "thresholds": {
        "critical": 30000
      },
      "tags": [
        "service:vibecode-webgui", 
        "alert:test_timeout"
      ],
      "notify": ["@slack-vibecode-alerts"]
    },
    {
      "name": "VibeCode Test Failure Spike",
      "message": "Unusual number of test failures detected",
      "query": "avg(last_5m):sum:test.result.failure_count{service:vibecode-webgui} > 5",
      "thresholds": {
        "critical": 5
      },
      "tags": [
        "service:vibecode-webgui",
        "alert:test_failures"
      ],
      "notify": ["@slack-vibecode-alerts"]
    },
    {
      "name": "VibeCode Infrastructure Tests Failing",
      "message": "Critical infrastructure tests are failing",
      "query": "avg(last_5m):avg:test.category.success_rate{service:vibecode-webgui,test.category:infrastructure} < 50",
      "thresholds": {
        "critical": 50
      },
      "tags": [
        "service:vibecode-webgui",
        "test.category:infrastructure",
        "alert:infrastructure_tests"
      ],
      "notify": ["@slack-vibecode-alerts", "@pagerduty-vibecode"]
    },
    {
      "name": "VibeCode Database Tests Failing", 
      "message": "Database connectivity tests are failing",
      "query": "avg(last_5m):avg:test.category.success_rate{service:vibecode-webgui,test.category:database} < 50",
      "thresholds": {
        "critical": 50
      },
      "tags": [
        "service:vibecode-webgui",
        "test.category:database", 
        "alert:database_tests"
      ],
      "notify": ["@slack-vibecode-alerts", "@pagerduty-vibecode"]
    }
  ],
  "monitors": [
    {
      "name": "VibeCode Test Suite Health",
      "type": "composite",
      "query": "avg(last_10m):avg:test.result.pass_rate{service:vibecode-webgui} * avg(last_10m):avg:test.category.success_rate{service:vibecode-webgui}",
      "message": "Overall test suite health is degraded",
      "thresholds": {
        "critical": 0.6
      },
      "tags": [
        "service:vibecode-webgui",
        "monitor:test_suite_health"
      ]
    }
  ]
}
