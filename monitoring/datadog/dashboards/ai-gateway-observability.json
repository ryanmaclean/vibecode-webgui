{
  "title": "AI Gateway Observability (Provider/Family)",
  "description": "Operational metrics for VibeCode AI Gateway by provider/family",
  "layout_type": "ordered",
  "is_read_only": false,
  "notify_list": [],
  "template_variables": [
    { "name": "env", "prefix": "env", "default": "*" },
    { "name": "service", "prefix": "service", "default": "vibecode-ai-gateway" },
    { "name": "model_provider", "prefix": "model_provider", "default": "*" },
    { "name": "model_family", "prefix": "model_family", "default": "*" },
    { "name": "operation", "prefix": "operation", "default": "*" }
  ],
  "widgets": [
    {
      "definition": {
        "title": "Latency p95 by provider/family (ms)",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "type": "timeseries",
        "requests": [
          {
            "q": "p95:avg:vibecode.ai_gateway.latency_ms{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family,operation:$operation}",
            "display_type": "line",
            "style": { "palette": "dog_classic", "line_type": "solid", "line_width": "normal" },
            "name": "latency_p95"
          }
        ],
        "yaxis": { "scale": "linear", "include_zero": false }
      }
    },
    {
      "definition": {
        "title": "Error count by provider/family",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.error{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family,operation:$operation}.rollup(sum, 60)",
            "display_type": "bars",
            "style": { "palette": "warm", "line_type": "solid", "line_width": "normal" },
            "name": "errors"
          }
        ],
        "yaxis": { "scale": "linear", "include_zero": true }
      }
    },
    {
      "definition": {
        "title": "Selection events by task",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.selection{service:$service,env:$env,task:*}.rollup(sum, 60)",
            "display_type": "line",
            "style": { "palette": "purple", "line_type": "solid", "line_width": "normal" },
            "name": "selections"
          }
        ],
        "yaxis": { "scale": "linear", "include_zero": true }
      }
    },
    {
      "definition": {
        "title": "Tokens and cost (stacked)",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:vibecode.ai_gateway.tokens_total{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family}.rollup(sum,60)",
            "display_type": "area",
            "style": { "palette": "cool", "line_type": "solid", "line_width": "normal" },
            "name": "tokens_total"
          },
          {
            "q": "sum:vibecode.ai_gateway.cost_usd{service:$service,env:$env,model_provider:$model_provider,model_family:$model_family}.rollup(sum,60)",
            "display_type": "line",
            "style": { "palette": "grey", "line_type": "dashed", "line_width": "thin" },
            "name": "cost_usd"
          }
        ],
        "yaxis": { "scale": "linear", "include_zero": true }
      }
    }
  ]
}
