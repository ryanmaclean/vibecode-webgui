{
  "config": {
    "assertions": [
      {
        "operator": "is",
        "type": "statusCode",
        "target": 200
      },
      {
        "operator": "isInMoreThan",
        "type": "certificate",
        "target": 7
      },
      {
        "operator": "lessThan",
        "type": "responseTime",
        "target": 5000
      }
    ],
    "request": {
      "method": "GET",
      "url": "https://app.vibecode.com",
      "headers": {}
    }
  },
  "locations": [
    "aws:us-east-1",
    "aws:us-west-2",
    "aws:eu-west-1",
    "aws:ap-southeast-1"
  ],
  "message": "SSL certificate monitoring for app.vibecode.com. Alerts @slack-vibecode-alerts if certificate expires in less than 7 days or is invalid, which would cause browser warnings and block user access.",
  "name": "SSL Certificate - Expiration Monitor",
  "options": {
    "min_failure_duration": 0,
    "min_location_failed": 1,
    "monitor_options": {
      "renotify_interval": 86400
    },
    "tick_every": 3600
  },
  "public_id": "vib-ecd-ssl-cert",
  "subtype": "ssl",
  "tags": [
    "env:production",
    "team:infrastructure",
    "service:ssl",
    "critical:true"
  ],
  "type": "api"
}
