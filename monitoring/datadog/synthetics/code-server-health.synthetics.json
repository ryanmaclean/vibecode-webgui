{
  "config": {
    "assertions": [
      {
        "operator": "is",
        "type": "statusCode",
        "target": 200
      },
      {
        "operator": "lessThan",
        "type": "responseTime",
        "target": 3000
      },
      {
        "operator": "is",
        "property": "content-type",
        "type": "header",
        "target": "application/json; charset=utf-8"
      },
      {
        "operator": "validates",
        "type": "body",
        "target": {
          "jsonPath": "$.status",
          "operator": "is",
          "value": "healthy"
        }
      },
      {
        "operator": "validates",
        "type": "body",
        "target": {
          "jsonPath": "$.uptime",
          "operator": "isPresent"
        }
      },
      {
        "operator": "validates",
        "type": "body",
        "target": {
          "jsonPath": "$.activeWorkspaces",
          "operator": "isPresent"
        }
      }
    ],
    "request": {
      "method": "GET",
      "url": "https://app.vibecode.com/api/health/code-server",
      "headers": {
        "Accept": "application/json"
      }
    }
  },
  "locations": [
    "aws:us-east-1",
    "aws:us-west-2",
    "aws:eu-west-1",
    "aws:ap-southeast-1"
  ],
  "message": "Monitor code server health and availability. Critical alert to @slack-vibecode-alerts if code server is degraded or unavailable, impacting active development sessions.",
  "name": "Code Server Health - Status Check",
  "options": {
    "min_failure_duration": 30,
    "min_location_failed": 1,
    "monitor_options": {
      "renotify_interval": 0
    },
    "tick_every": 300
  },
  "public_id": "vib-ecd-code-srv-health",
  "subtype": "http",
  "tags": [
    "env:production",
    "team:infrastructure",
    "service:code-server",
    "critical:true"
  ],
  "type": "api"
}
