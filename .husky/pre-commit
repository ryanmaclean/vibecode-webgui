#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running pre-commit quality gates..."

# Secret scanning with gitleaks
echo "1/3 Running secret scanning..."
if command -v gitleaks > /dev/null 2>&1; then
    gitleaks protect --staged --verbose || {
        echo "Secret scanning failed - potential secrets detected"
        echo "Please remove any secrets and use environment variables"
        exit 1
    }
else
    echo "gitleaks not installed - skipping secret scan"
    echo "Install with: brew install gitleaks (macOS) or see https://github.com/gitleaks/gitleaks"
fi

# Run comprehensive pre-commit tests (lint, type-check, tests, additional security)
echo "2/3 Running optimized pre-commit tests..."
if [ -f "./scripts/pre-commit-tests.sh" ]; then
    ./scripts/pre-commit-tests.sh || {
        echo "Pre-commit tests failed"
        exit 1
    }
else
    # Fallback: run optional tests (opt-in via SKIP_TESTS=0)
    echo "Pre-commit script not found - running fallback checks"
    export SKIP_TESTS=${SKIP_TESTS:-1}
    bash "$(dirname "$0")/../scripts/pre-commit-test.sh" || exit 1
fi

echo "All pre-commit checks passed!"
