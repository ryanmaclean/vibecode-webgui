#!/bin/sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-commit checks for VibeCode
echo "🚀 Running pre-commit checks..."

# Block committing JUnit reports and other test artifacts
BLOCKED_FILES=$(git diff --cached --name-only | grep -E '(^|/)test-results/.*\.xml$|(^|/)\.test-results/.*\.xml$|(^|/)junit\.xml$' || true)
if [ ! -z "$BLOCKED_FILES" ]; then
  echo "❌ Blocking commit: test result report files must not be committed:"
  echo "$BLOCKED_FILES" | sed 's/^/ - /'
  echo "Ensure test-results/ and .test-results/ are in .gitignore (already done) and remove these files from staging."
  exit 1
fi

# Documentation validation and auto-fixing
echo "🔍 Validating documentation..."

# Check if documentation files have been modified
DOC_FILES=$(git diff --cached --name-only | grep -E '\.(md|mdx)$' || true)

if [ ! -z "$DOC_FILES" ]; then
  echo "📚 Documentation files modified, running validation..."

  # Auto-update README if package.json or source files changed
  PACKAGE_CHANGED=$(git diff --cached --name-only | grep 'package.json' || true)
  SRC_CHANGED=$(git diff --cached --name-only | grep '^src/' || true)
  
  if [ ! -z "$PACKAGE_CHANGED" ] || [ ! -z "$SRC_CHANGED" ]; then
    echo "📝 Auto-updating README and API docs..."
    npm run docs:generate --silent 2>/dev/null || echo "⚠️ API doc generation skipped"
    npm run docs:update --silent 2>/dev/null || echo "⚠️ README update skipped"
    
    # Stage the updated files if they exist
    [ -f README.md ] && git add README.md
    [ -f docs/API.md ] && git add docs/API.md
  fi
  
  # Quick validation (skip full validation in pre-commit for speed)
  npm run docs:stats --silent 2>/dev/null || echo "⚠️ Doc stats skipped"
  
  echo "✅ Documentation validation complete"
fi

# Security scan for API keys and sensitive data (always run)
echo "🔒 Scanning for API keys and sensitive data..."

# Enhanced API key detection patterns
for file in $(git diff --cached --name-only); do
  # Skip .env files, node_modules, and non-existent files
  if [[ -f "$file" && "$file" != *.env && "$file" != *.env.local && "$file" != *.env.* && "$file" != *node_modules* ]]; then
    # Check for OpenAI/OpenRouter API keys (sk-...)
    if grep -E "sk-[a-zA-Z0-9]{40,}" "$file" > /dev/null 2>&1; then
      echo "❌ ERROR: Potential OpenAI/OpenRouter API key found in $file"
      echo "   Please remove the API key and use environment variables"
      exit 1
    fi

    # Check for Anthropic API keys (sk-ant-...)
    if grep -E "sk-ant-[a-zA-Z0-9]{40,}" "$file" > /dev/null 2>&1; then
      echo "❌ ERROR: Potential Anthropic API key found in $file"
      echo "   Please remove the API key and use environment variables"
      exit 1
    fi

    # Check for GitHub tokens (ghp_, gho_, ghu_, ghs_, ghr_)
    if grep -E "(ghp|gho|ghu|ghs|ghr)_[a-zA-Z0-9]{36}" "$file" > /dev/null 2>&1; then
      echo "❌ ERROR: Potential GitHub token found in $file"
      echo "   Please remove the token and use GitHub secrets"
      exit 1
    fi

    # Check for AWS Access Keys (AKIA...)
    if grep -E "AKIA[0-9A-Z]{16}" "$file" > /dev/null 2>&1; then
      echo "❌ ERROR: Potential AWS Access Key found in $file"
      echo "   Please remove the key and use AWS credentials properly"
      exit 1
    fi

    # Check for Datadog API keys (32 hex characters in context)
    if grep -E "(api.key|datadog|dd_api_key|DD_API_KEY).*[a-f0-9]{32}" "$file" > /dev/null 2>&1; then
      echo "⚠️  WARNING: Potential Datadog API key found in $file"
      echo "   Verify this is not a real API key"
    fi
  fi
done

echo "✅ Security scan passed"

# Lint and type-check staged files
echo "🔍 Running lint checks on staged files..."

STAGED_JS_TS=$(git diff --cached --name-only | grep -E '\.(js|jsx|ts|tsx)$' || true)

if [ ! -z "$STAGED_JS_TS" ]; then
  echo "📝 Linting JavaScript/TypeScript files..."

  # Run ESLint on staged files only
  echo "$STAGED_JS_TS" | grep -E '^(src/app/api/agents|src/app/api/ai/chat)' | xargs -r npx eslint --fix || {
    echo "⚠️ ESLint found issues. Please fix them before committing."
  }

  # Run TypeScript type check
  npm run type-check 2>/dev/null || {
    echo "⚠️ TypeScript type check failed. Please fix type errors before committing."
    echo "💡 Tip: Run 'npm run type-check' to see details"
  }

  echo "✅ Lint checks completed"
fi

# Run quick tests on staged files
echo "🧪 Running pre-commit tests..."

# Only run tests if JS/TS files changed (excluding test files)
STAGED_SRC_FILES=$(git diff --cached --name-only | grep -E '\.(js|jsx|ts|tsx)$' | grep -E '^src/' | grep -v '__tests__' | grep -v '\.test\.' | grep -v '\.spec\.' || true)

if [ ! -z "$STAGED_SRC_FILES" ]; then
  echo "📝 Testing changed files..."

  # Run quick unit tests (skip infrastructure tests, use maxWorkers=2 for speed)
  SKIP_DOCKER_TESTS=1 SKIP_K8S_TESTS=1 npm run quick-test 2>/dev/null || {
    echo "❌ Tests failed. Run 'npm test' to see details."
    echo "💡 Tip: Use 'git commit --no-verify' to skip tests (not recommended)"
    exit 1
  }

  echo "✅ Tests passed"
else
  echo "⏭️  No source files changed, skipping tests"
fi

echo ""
echo "✅ All pre-commit checks passed! Ready to commit."
