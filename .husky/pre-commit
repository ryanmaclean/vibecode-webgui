#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running pre-commit checks..."

# Run linting
echo "1/3 Running ESLint..."
npm run lint || exit 1

# Run format check
echo "2/3 Running Prettier format check..."
npm run format:check || exit 1

# Run TypeScript type check
echo "3/3 Running TypeScript type check..."
npm run type-check || exit 1

# Run optional tests (opt-in)
# To enable tests: unset SKIP_TESTS or SKIP_TESTS=0 git commit -m "message"
# To disable tests: SKIP_TESTS=1 git commit -m "message" (default)
echo "🧪 Optional: Pre-commit tests (set SKIP_TESTS=0 to enable)"
export SKIP_TESTS=${SKIP_TESTS:-1}
bash "$(dirname "$0")/../scripts/pre-commit-test.sh" || exit 1

echo "✓ All pre-commit checks passed!"
