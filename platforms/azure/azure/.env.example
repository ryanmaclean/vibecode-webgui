# =============================================================================
# Environment Variables for OpenVSCode Server Container
# =============================================================================
# Copy this file to .env and fill in your values
# Usage: cp .env.example .env

# -----------------------------------------------------------------------------
# OpenVSCode Server Configuration
# -----------------------------------------------------------------------------
# Port on which OpenVSCode Server will listen
VSCODE_PORT=3000

# Host address to bind (0.0.0.0 for all interfaces)
VSCODE_HOST=0.0.0.0

# Workspace directory inside the container
WORKSPACE_DIR=/workspace

# Node.js environment
NODE_ENV=production

# -----------------------------------------------------------------------------
# Datadog Configuration (Optional)
# -----------------------------------------------------------------------------
# Get your API key from: https://app.datadoghq.com/organization-settings/api-keys
# Leave empty to disable Datadog monitoring
DATADOG_API_KEY=

# Datadog site (default: datadoghq.com)
# Options: datadoghq.com, datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com
DATADOG_SITE=datadoghq.com

# -----------------------------------------------------------------------------
# System Configuration
# -----------------------------------------------------------------------------
# Timezone (default: UTC)
TZ=UTC

# -----------------------------------------------------------------------------
# Git Configuration (Optional)
# -----------------------------------------------------------------------------
# These will be used if you mount your git config
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=your.email@example.com

# -----------------------------------------------------------------------------
# MCP Servers Configuration (Optional)
# -----------------------------------------------------------------------------
# Add any MCP-specific environment variables here
# MCP_SERVER_PORT=8080
# MCP_SERVER_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Resource Limits (Docker Compose)
# -----------------------------------------------------------------------------
# CPU limit (e.g., 2 for 2 cores)
CPU_LIMIT=2

# Memory limit (e.g., 2G for 2 gigabytes)
MEMORY_LIMIT=2G

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Set to true to enable additional security features
# ENABLE_HTTPS=false
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
