# VibeCode Observability Configuration
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and will not be committed

# Datadog API Key (required for OpenTelemetry OTLP traces)
# Get your key from: https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=your-datadog-api-key-here

# Datadog Site (optional, default: datadoghq.com)
# Options: datadoghq.com, datadoghq.eu, us3.datadoghq.com, etc.
DD_SITE=datadoghq.com

# Environment (optional, default: development)
# Options: development, staging, production
ENV=development

# Service Name (optional, default: vibecode-swiftui)
SERVICE_NAME=vibecode-swiftui
