#!/bin/bash
# VibeCode Service Management CLI
# Purpose: Manage VibeCode launchd services and container runtime
# Location: /usr/local/bin/vibecode-service
# Usage: vibecode-service {start|stop|restart|status|logs|health|diagnose}

set -e

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Paths
DAEMON_PLIST="/Library/LaunchDaemons/com.vibecode.containerd.plist"
AGENT_PLIST="$HOME/Library/LaunchAgents/com.vibecode.app.plist"
DAEMON_SOCKET="/var/run/vibecode-containerd.sock"
DAEMON_LOG="/var/log/vibecode/containerd.log"
DAEMON_ERROR_LOG="/var/log/vibecode/containerd.error.log"
CONFIG_FILE="/etc/vibecode/containerd.conf"
DATA_DIR="/var/lib/vibecode"

# Helper functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        log_error "This operation requires root privileges"
        log_info "Try: sudo vibecode-service $1"
        exit 1
    fi
}

is_daemon_loaded() {
    sudo launchctl print system/com.vibecode.containerd &>/dev/null
}

is_daemon_running() {
    is_daemon_loaded && sudo launchctl print system/com.vibecode.containerd | grep -q "state = running"
}

is_agent_loaded() {
    launchctl print gui/$(id -u)/com.vibecode.app &>/dev/null
}

is_agent_running() {
    is_agent_loaded && launchctl print gui/$(id -u)/com.vibecode.app | grep -q "state = running"
}

wait_for_daemon() {
    local timeout=${1:-30}
    local elapsed=0

    log_info "Waiting for daemon to start (timeout: ${timeout}s)..."

    while [ $elapsed -lt $timeout ]; do
        if is_daemon_running; then
            log_success "Daemon started successfully"
            return 0
        fi

        sleep 1
        elapsed=$((elapsed + 1))
    done

    log_error "Daemon failed to start within ${timeout}s"
    return 1
}

# Command implementations
cmd_start() {
    log_info "Starting VibeCode services..."

    # Create log directory
    if [ ! -d "/var/log/vibecode" ]; then
        sudo mkdir -p /var/log/vibecode
        sudo chmod 755 /var/log/vibecode
    fi

    # Create data directory
    if [ ! -d "$DATA_DIR" ]; then
        sudo mkdir -p "$DATA_DIR"
        sudo chmod 755 "$DATA_DIR"
    fi

    # Start daemon
    if is_daemon_running; then
        log_warning "Daemon already running"
    else
        log_info "Loading daemon..."
        sudo launchctl load "$DAEMON_PLIST" 2>/dev/null || {
            log_info "Daemon already loaded, starting..."
            sudo launchctl start com.vibecode.containerd
        }

        wait_for_daemon || exit 1
    fi

    # Start agent (user context)
    if is_agent_running; then
        log_warning "Agent already running"
    else
        if [ -f "$AGENT_PLIST" ]; then
            log_info "Loading agent..."
            launchctl load "$AGENT_PLIST" 2>/dev/null || {
                log_info "Agent already loaded, starting..."
                launchctl start com.vibecode.app
            }
            log_success "Agent started"
        else
            log_warning "Agent plist not found at $AGENT_PLIST"
        fi
    fi

    log_success "VibeCode services started"
    echo ""
    cmd_status
}

cmd_stop() {
    log_info "Stopping VibeCode services..."

    # Stop agent first (graceful)
    if is_agent_loaded; then
        log_info "Stopping agent..."
        launchctl unload "$AGENT_PLIST" 2>/dev/null || {
            launchctl stop com.vibecode.app
        }
        log_success "Agent stopped"
    fi

    # Stop daemon (stops all containers)
    if is_daemon_loaded; then
        log_info "Stopping daemon (containers will be stopped)..."
        sudo launchctl unload "$DAEMON_PLIST" 2>/dev/null || {
            sudo launchctl stop com.vibecode.containerd
        }
        log_success "Daemon stopped"
    fi

    log_success "VibeCode services stopped"
}

cmd_restart() {
    log_info "Restarting VibeCode services..."
    cmd_stop
    sleep 2
    cmd_start
}

cmd_status() {
    echo "=== VibeCode Service Status ==="
    echo ""

    # Daemon status
    echo -e "${BLUE}Daemon (com.vibecode.containerd):${NC}"
    if is_daemon_running; then
        sudo launchctl print system/com.vibecode.containerd | grep -E "state|pid|last exit code" | sed 's/^/  /'

        # Check socket
        if [ -S "$DAEMON_SOCKET" ]; then
            echo -e "  ${GREEN}✓${NC} Socket: $DAEMON_SOCKET"
        else
            echo -e "  ${RED}✗${NC} Socket not found: $DAEMON_SOCKET"
        fi
    else
        echo -e "  ${RED}✗${NC} Not running"
    fi
    echo ""

    # Agent status
    echo -e "${BLUE}Agent (com.vibecode.app):${NC}"
    if is_agent_running; then
        launchctl print gui/$(id -u)/com.vibecode.app | grep -E "state|pid|last exit code" | sed 's/^/  /'
    else
        echo -e "  ${RED}✗${NC} Not running"
    fi
    echo ""

    # Container runtime
    echo -e "${BLUE}Container Runtime:${NC}"
    if command -v container &>/dev/null; then
        container version 2>/dev/null | grep -E "Version|API version" | sed 's/^/  /'
    else
        echo -e "  ${RED}✗${NC} Container CLI not found"
    fi
    echo ""

    # Active containers
    echo -e "${BLUE}Active Containers:${NC}"
    if command -v container &>/dev/null; then
        container ps --filter "label=com.vibecode.managed=true" \
            --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null | sed 's/^/  /'
    else
        echo "  Container CLI not available"
    fi
    echo ""

    # System resources
    echo -e "${BLUE}System Resources:${NC}"
    local cpu_usage=$(top -l 1 -n 0 | grep "CPU usage" | awk '{print $3}')
    local mem_usage=$(top -l 1 -n 0 | grep PhysMem | awk '{print $2}')
    echo "  CPU Usage: $cpu_usage"
    echo "  Memory Usage: $mem_usage"
}

cmd_logs() {
    local lines=${1:-50}
    local follow=${2:-false}

    echo "=== VibeCode Daemon Logs ==="
    echo ""

    if [ ! -f "$DAEMON_LOG" ]; then
        log_error "Log file not found: $DAEMON_LOG"
        exit 1
    fi

    if [ "$follow" = "true" ]; then
        tail -f -n "$lines" "$DAEMON_LOG"
    else
        tail -n "$lines" "$DAEMON_LOG"
    fi
}

cmd_errors() {
    local lines=${1:-50}

    echo "=== VibeCode Daemon Error Logs ==="
    echo ""

    if [ ! -f "$DAEMON_ERROR_LOG" ]; then
        log_warning "Error log file not found: $DAEMON_ERROR_LOG"
        exit 0
    fi

    tail -n "$lines" "$DAEMON_ERROR_LOG"
}

cmd_health() {
    local exit_code=0

    # Check daemon
    if is_daemon_running; then
        log_success "Daemon is running"
    else
        log_error "Daemon is not running"
        exit_code=1
    fi

    # Check socket
    if [ -S "$DAEMON_SOCKET" ]; then
        log_success "Socket is accessible"

        # Try to ping daemon via socket
        if echo '{"command":"ping"}' | nc -U "$DAEMON_SOCKET" -w 1 &>/dev/null; then
            log_success "Daemon is responsive"
        else
            log_warning "Daemon socket exists but not responsive"
            exit_code=1
        fi
    else
        log_error "Socket not found: $DAEMON_SOCKET"
        exit_code=1
    fi

    # Check container runtime
    if command -v container &>/dev/null; then
        if container version &>/dev/null; then
            log_success "Container runtime is healthy"
        else
            log_error "Container runtime is not responding"
            exit_code=1
        fi
    else
        log_error "Container CLI not found"
        exit_code=1
    fi

    # Overall health
    echo ""
    if [ $exit_code -eq 0 ]; then
        log_success "All health checks passed"
    else
        log_error "Some health checks failed"
    fi

    exit $exit_code
}

cmd_diagnose() {
    echo "=== VibeCode System Diagnostics ==="
    echo ""

    # 1. Service Status
    echo -e "${BLUE}1. Service Status:${NC}"
    cmd_status
    echo ""

    # 2. Configuration
    echo -e "${BLUE}2. Configuration:${NC}"
    echo "  Daemon plist: $DAEMON_PLIST"
    if [ -f "$DAEMON_PLIST" ]; then
        echo -e "    ${GREEN}✓${NC} Exists"
    else
        echo -e "    ${RED}✗${NC} Not found"
    fi

    echo "  Agent plist: $AGENT_PLIST"
    if [ -f "$AGENT_PLIST" ]; then
        echo -e "    ${GREEN}✓${NC} Exists"
    else
        echo -e "    ${RED}✗${NC} Not found"
    fi

    echo "  Config file: $CONFIG_FILE"
    if [ -f "$CONFIG_FILE" ]; then
        echo -e "    ${GREEN}✓${NC} Exists"
    else
        echo -e "    ${YELLOW}!${NC} Not found (using defaults)"
    fi
    echo ""

    # 3. Recent Logs
    echo -e "${BLUE}3. Recent Daemon Logs (last 20 lines):${NC}"
    if [ -f "$DAEMON_LOG" ]; then
        sudo tail -20 "$DAEMON_LOG" | sed 's/^/  /'
    else
        echo "  Log file not found"
    fi
    echo ""

    # 4. Recent Errors
    echo -e "${BLUE}4. Recent Errors (last 10 lines):${NC}"
    if [ -f "$DAEMON_ERROR_LOG" ] && [ -s "$DAEMON_ERROR_LOG" ]; then
        sudo tail -10 "$DAEMON_ERROR_LOG" | sed 's/^/  /'
    else
        echo "  No errors logged"
    fi
    echo ""

    # 5. Socket Status
    echo -e "${BLUE}5. Socket Status:${NC}"
    if [ -S "$DAEMON_SOCKET" ]; then
        ls -l "$DAEMON_SOCKET" | sed 's/^/  /'
    else
        echo "  Socket not found"
    fi
    echo ""

    # 6. Container Runtime
    echo -e "${BLUE}6. Container Runtime:${NC}"
    if command -v container &>/dev/null; then
        container version | sed 's/^/  /'
        echo ""
        container info 2>/dev/null | sed 's/^/  /'
    else
        echo "  Container CLI not found"
    fi
    echo ""

    # 7. System Resources
    echo -e "${BLUE}7. System Resources:${NC}"
    top -l 1 -n 0 | grep -E "PhysMem|CPU usage" | sed 's/^/  /'
    echo ""
    df -h / | sed 's/^/  /'
    echo ""

    # 8. Network
    echo -e "${BLUE}8. Network (listening ports):${NC}"
    sudo lsof -iTCP -sTCP:LISTEN | grep -E "vibecode|code-server|8080" | sed 's/^/  /'
    echo ""

    # 9. File Descriptors
    echo -e "${BLUE}9. File Descriptors (open files):${NC}"
    if is_daemon_running; then
        local daemon_pid=$(sudo launchctl print system/com.vibecode.containerd | grep pid | awk '{print $3}')
        if [ -n "$daemon_pid" ]; then
            echo "  Daemon PID: $daemon_pid"
            lsof -p "$daemon_pid" 2>/dev/null | wc -l | sed 's/^/  Open files: /'
        fi
    else
        echo "  Daemon not running"
    fi
}

cmd_reset() {
    log_warning "This will stop all services and remove data"
    read -p "Are you sure? (yes/no): " confirm

    if [ "$confirm" != "yes" ]; then
        log_info "Aborted"
        exit 0
    fi

    log_info "Resetting VibeCode..."

    # Stop services
    cmd_stop

    # Remove data
    if [ -d "$DATA_DIR" ]; then
        log_info "Removing data directory..."
        sudo rm -rf "$DATA_DIR"
    fi

    # Remove logs
    if [ -d "/var/log/vibecode" ]; then
        log_info "Removing logs..."
        sudo rm -rf /var/log/vibecode
    fi

    log_success "Reset complete"
}

cmd_install() {
    check_root

    log_info "Installing VibeCode system services..."

    # Create directories
    sudo mkdir -p /var/log/vibecode
    sudo mkdir -p /var/lib/vibecode
    sudo mkdir -p /etc/vibecode

    # Copy plists (assuming they're in the same directory)
    local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    if [ -f "$script_dir/../launchd/com.vibecode.containerd.plist" ]; then
        sudo cp "$script_dir/../launchd/com.vibecode.containerd.plist" "$DAEMON_PLIST"
        sudo chown root:wheel "$DAEMON_PLIST"
        sudo chmod 644 "$DAEMON_PLIST"
        log_success "Installed daemon plist"
    else
        log_error "Daemon plist not found"
    fi

    if [ -f "$script_dir/../launchd/com.vibecode.app.plist" ]; then
        mkdir -p "$HOME/Library/LaunchAgents"
        cp "$script_dir/../launchd/com.vibecode.app.plist" "$AGENT_PLIST"
        chmod 644 "$AGENT_PLIST"
        log_success "Installed agent plist"
    else
        log_error "Agent plist not found"
    fi

    log_success "Installation complete"
    log_info "Run 'vibecode-service start' to start services"
}

cmd_uninstall() {
    check_root

    log_warning "This will remove VibeCode system services"
    read -p "Are you sure? (yes/no): " confirm

    if [ "$confirm" != "yes" ]; then
        log_info "Aborted"
        exit 0
    fi

    # Stop services
    cmd_stop

    # Remove plists
    if [ -f "$DAEMON_PLIST" ]; then
        sudo rm "$DAEMON_PLIST"
        log_success "Removed daemon plist"
    fi

    if [ -f "$AGENT_PLIST" ]; then
        rm "$AGENT_PLIST"
        log_success "Removed agent plist"
    fi

    # Optionally remove data
    read -p "Remove data directory? (yes/no): " remove_data
    if [ "$remove_data" = "yes" ]; then
        cmd_reset
    fi

    log_success "Uninstallation complete"
}

# Main command dispatcher
case "$1" in
    start)
        cmd_start
        ;;

    stop)
        cmd_stop
        ;;

    restart)
        cmd_restart
        ;;

    status)
        cmd_status
        ;;

    logs)
        cmd_logs "${2:-50}" "false"
        ;;

    logs:follow)
        cmd_logs "${2:-50}" "true"
        ;;

    errors)
        cmd_errors "${2:-50}"
        ;;

    health)
        cmd_health
        ;;

    diagnose)
        cmd_diagnose
        ;;

    reset)
        cmd_reset
        ;;

    install)
        cmd_install
        ;;

    uninstall)
        cmd_uninstall
        ;;

    version)
        echo "VibeCode Service Manager v1.0.0"
        ;;

    *)
        echo "Usage: vibecode-service <command>"
        echo ""
        echo "Commands:"
        echo "  start              Start all VibeCode services"
        echo "  stop               Stop all VibeCode services"
        echo "  restart            Restart all services"
        echo "  status             Show service status"
        echo "  logs [n]           Show last n lines of logs (default: 50)"
        echo "  logs:follow [n]    Follow logs in real-time"
        echo "  errors [n]         Show last n lines of error logs"
        echo "  health             Run health checks"
        echo "  diagnose           Run comprehensive diagnostics"
        echo "  reset              Stop services and remove data"
        echo "  install            Install system services (requires root)"
        echo "  uninstall          Uninstall system services (requires root)"
        echo "  version            Show version information"
        echo ""
        echo "Examples:"
        echo "  vibecode-service start"
        echo "  vibecode-service status"
        echo "  vibecode-service logs 100"
        echo "  vibecode-service diagnose"
        exit 1
        ;;
esac
