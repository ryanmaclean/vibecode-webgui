apiVersion: v1
kind: Pod
metadata:
  name: "{{ include "vibecode-platform.fullname" . }}-test-provisioning"
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "vibecode-platform.labels" . | nindent 4 }}
    app.kubernetes.io/component: test
  annotations:
    "helm.sh/hook": test
    "helm.sh/hook-weight": "2"
    "helm.sh/hook-delete-policy": before-hook-creation,hook-succeeded
spec:
  restartPolicy: Never
  serviceAccountName: {{ include "vibecode-platform.serviceAccountName" . }}
  automountServiceAccountToken: true
  volumes:
  - name: tmp
    emptyDir: {}
  containers:
  - name: test-provisioning
    image: bitnami/kubectl:latest
    command: ['sh', '-c']
    env:
    - name: HOME
      value: "/tmp"
    securityContext:
      runAsNonRoot: true
      runAsUser: 65534
      runAsGroup: 65534
      capabilities:
        drop:
          - ALL
      readOnlyRootFilesystem: false
      allowPrivilegeEscalation: false
    volumeMounts:
    - name: tmp
      mountPath: /tmp
    resources:
      requests:
        cpu: "50m"
        memory: "128Mi"
      limits:
        cpu: "200m"
        memory: "256Mi"
    args:
    - |
      set -e
      # Force kubectl to use in-cluster auth explicitly
      SA_TOKEN_PATH="/var/run/secrets/kubernetes.io/serviceaccount/token"
      SA_CA_PATH="/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
      KCTL="kubectl --server=https://kubernetes.default.svc:443 --certificate-authority=${SA_CA_PATH} --token=$(cat ${SA_TOKEN_PATH}) --request-timeout=30s"
      echo "Waiting for Kubernetes API to become reachable..."
      for i in $(seq 1 120); do
        if ${KCTL} get --raw=/version >/dev/null 2>&1; then
          echo "✓ Kubernetes API reachable"
          break
        fi
        sleep 2
        if [ "$i" -eq 120 ]; then
          echo "❌ Kubernetes API not reachable within timeout" >&2
          exit 1
        fi
      done

      # Simple retry helper: retry <cmd...>
      retry() {
        local n=0
        local max=${RETRY_MAX:-60}
        local delay=${RETRY_DELAY:-3}
        until [ $n -ge $max ]; do
          "$@" && return 0
          n=$((n+1))
          echo "Retry $n/$max: $*" >&2
          sleep $delay
        done
        return 1
      }
      # Quick try helper for non-fatal checks
      try3() {
        for i in 1 2 3; do
          "$@" && return 0
          sleep 2
        done
        return 1
      }
      echo "Testing VibeCode Platform provisioning capabilities..."


      # Skip explicit RBAC can-i checks (can be flaky due to discovery); subsequent operations validate permissions implicitly

      # Best-effort reads (non-fatal)
      echo "Testing ConfigMap access (best-effort)..."
      try3 ${KCTL} get --raw "/api/v1/namespaces/{{ .Values.global.namespace }}/configmaps/{{ include "vibecode-platform.configMapName" . }}" || echo "WARN: ConfigMap read failed (continuing)"

      # Test Secret access
      echo "Testing Secret access (best-effort)..."
      try3 ${KCTL} get --raw "/api/v1/namespaces/{{ .Values.global.namespace }}/secrets/{{ include "vibecode-platform.secretName" . }}" || echo "WARN: Secret read failed (continuing)"

      # Test ServiceAccount
      echo "Testing ServiceAccount (best-effort)..."
      try3 ${KCTL} get --raw "/api/v1/namespaces/{{ .Values.global.namespace }}/serviceaccounts/{{ include "vibecode-platform.serviceAccountName" . }}" || echo "WARN: ServiceAccount read failed (continuing)"

      {{- if .Values.security.rbac.enabled }}
      # Test RBAC resources
      echo "Testing RBAC resources (best-effort)..."
      try3 ${KCTL} get --raw "/apis/rbac.authorization.k8s.io/v1/namespaces/{{ .Values.global.namespace }}/roles/{{ include "vibecode-platform.rbacName" . }}-workspace" || echo "WARN: Role read failed (continuing)"
      try3 ${KCTL} get --raw "/apis/rbac.authorization.k8s.io/v1/namespaces/{{ .Values.global.namespace }}/rolebindings/{{ include "vibecode-platform.rbacName" . }}-workspace" || echo "WARN: RoleBinding read failed (continuing)"
      {{- end }}

      {{- if .Values.codeServer.persistence.enabled }}
      # Test storage class
      echo "Testing storage class (best-effort)..."
      try3 ${KCTL} get --raw "/apis/storage.k8s.io/v1/storageclasses/{{ default .Values.global.storageClass .Values.codeServer.persistence.storageClass }}" || echo "WARN: StorageClass read failed (continuing)"
      {{- end }}

      # RFC1123-safe random suffix generator (avoids $RANDOM which may be empty in POSIX sh)
      gen_suffix() {
        if command -v uuidgen >/dev/null 2>&1; then
          uuidgen | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9' | cut -c1-6
          return
        fi
        if [ -r /proc/sys/kernel/random/uuid ]; then
          cat /proc/sys/kernel/random/uuid | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9' | cut -c1-6
          return
        fi
        if [ -r /dev/urandom ]; then
          LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c6
          return
        fi
        date +%s | tr -cd '0-9' | tail -c6
      }

