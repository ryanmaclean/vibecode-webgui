      "metadata": {
        "role": "polecat",
        "skills": [
          "github-api",
          "issue-sync",
          "pr-sync"
        ],
        "lanes": [
          "standard",
          "experimental"
        ],
        "replicas": 2,
        "kafka_consume": [
          "tundra-work-intake",
          "tundra-polecat-commands"
        ],
        "kafka_produce": [
          "tundra-beads-created",
          "tundra-audit-actions"
        ]
      }
    },
    "topic-tundra-work-intake": {
