    annotations:
      kubectl.kubernetes.io/last-applied-configuration: |
        {"apiVersion":"v1","data":{"requirements.txt":"# OpenLineage provider for Airflow Jobs Monitoring in Datadog\n# For Airflow 2.7+: apache-airflow-providers-openlineage\n# For Airflow 2.5-2.6: openlineage-airflow\napache-airflow-providers-openlineage\u003e=2.7.3\n"},"kind":"ConfigMap","metadata":{"annotations":{},"name":"airflow-openlineage-requirements","namespace":"tundra-dome"}}
    creationTimestamp: "2026-02-03T02:37:04Z"
