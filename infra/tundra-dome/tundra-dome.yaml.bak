            2>/dev/null || true
          image: apache/airflow:2.8.0
          imagePullPolicy: IfNotPresent
          name: copy-dags
          resources: {}
          terminationMessagePath: /dev/termination-log
          terminationMessagePolicy: File
          volumeMounts:
          - mountPath: /dags-source
            name: dags
          - mountPath: /opt/airflow
            name: airflow-home
        - command:
          - sh
          - -c
          - pip install --user apache-airflow-providers-openlineage>=2.7.3 && cp -r
            /root/.local/lib/python3.*/site-packages/* /opt/airflow/ 2>/dev/null ||
            true
          image: apache/airflow:2.8.0
          imagePullPolicy: IfNotPresent
          name: install-openlineage
          resources: {}
          terminationMessagePath: /dev/termination-log
          terminationMessagePolicy: File
          volumeMounts:
          - mountPath: /opt/airflow
            name: airflow-home
        restartPolicy: Always
        schedulerName: default-scheduler
        securityContext: {}
        terminationGracePeriodSeconds: 30
