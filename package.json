{
  "name": "vibecode-webgui",
  "version": "1.5.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0 <25.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node launcher.js",
    "start:vm": "node launcher.js --vm",
    "start:kiosk": "node chromium-kiosk/launcher.js",
    "start:electron": "cd electron-vibecode && npm start",
    "start:next": "cross-env NEXT_TELEMETRY_DISABLED=1 next start",
    "postinstall": "cross-env NEXT_TELEMETRY_DISABLED=1 node scripts/ensure-native-binaries.js",
    "setup": "node scripts/setup-development.js",
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "dev:simple": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start:dd": "cross-env NEXT_TELEMETRY_DISABLED=1 node --require ./src/instrument.ts node_modules/.bin/next start",
    "lint": "eslint --ext .ts,.tsx src/app/api/agents src/app/api/ai/chat src/app/api/ai/chat/enhanced src/app/api/ai/chat/unified src/app/api/ai/chat/stream --ignore-pattern '**/*.js' --ignore-pattern '**/*.cjs'",
    "type-check": "tsc --project tsconfig.lite.json --noEmit",
    "test": "jest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "build:tauri": "cross-env NEXT_TELEMETRY_DISABLED=1 NEXT_CONFIG_FILE=next.config.tauri.js next build --webpack",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPatterns=tests/unit",
    "test:integration": "jest --testPathPatterns=tests/integration",
    "test:ws": "jest --testPathPatterns=tests/integration/websocket",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:production": "BASE_URL=https://vibecode.eastus2.cloudapp.azure.com playwright test --config=playwright.config.production.ts",
    "test:e2e:production:headed": "BASE_URL=https://vibecode.eastus2.cloudapp.azure.com playwright test --config=playwright.config.production.ts --headed",
    "test:integration:production": "BASE_URL=https://vibecode.eastus2.cloudapp.azure.com TEST_MODE=production jest --testPathPatterns=tests/integration --testTimeout=60000",
    "test:production:all": "npm run test:e2e:production && npm run test:integration:production",
    "test:production:smoke": "BASE_URL=https://vibecode.eastus2.cloudapp.azure.com npx playwright test tests/e2e/smoke.test.ts --config=playwright.config.production.ts --project=chromium-production",
    "test:k8s": "jest --testPathPatterns=tests/k8s",
    "test:k8s:quick": "jest --testPathPatterns=tests/k8s/kind-cluster-validation\\.test\\.ts$ --maxWorkers=1",
    "test:k8s:helm": "jest --testPathPatterns=tests/k8s/helm-chart-deployment\\.test\\.ts$ --maxWorkers=1",
    "test:k8s:provisioning": "jest --testPathPatterns=tests/integration/user-provisioning-integration\\.test\\.ts$ --maxWorkers=1",
    "test:monitoring": "jest --testPathPatterns=tests/unit/.*monitoring.*\\.test\\.(ts|js)$ --testPathPatterns=tests/integration/monitoring-api\\.test\\.(ts|js)$",
    "test:monitoring:unit": "jest --testPathPatterns=tests/unit/.*monitoring.*\\.test\\.(ts|js)$",
    "test:monitoring:integration": "jest --testPathPatterns=tests/integration/monitoring-api\\.test\\.(ts|js)$",
    "codex": "node scripts/run-codex-with-config.mjs",
    "test:monitoring:e2e": "playwright test tests/e2e/monitoring-dashboard.test.ts",
    "test:monitoring:k8s": "jest --testPathPatterns=tests/k8s/monitoring-deployment\\.test\\.(ts|js)$",
    "test:monitoring:security": "jest --testPathPatterns=tests/security/monitoring-security\\.test\\.(ts|js)$",
    "test:root": "tsx scripts/run-root-tests.js",
    "test:root:infrastructure": "tsx scripts/run-root-tests.js infrastructure",
    "test:root:database": "tsx scripts/run-root-tests.js database",
    "test:root:credentials": "tsx scripts/run-root-tests.js credentials",
    "test:root:workflow": "tsx scripts/run-root-tests.js workflow",
    "test:root:ai-embedding": "tsx scripts/run-root-tests.js ai-embedding",
    "test:root:azure-embedding": "tsx scripts/run-root-tests.js azure-embedding",
    "test:root:ai": "npm run test:root:ai-embedding",
    "test:root:azure": "npm run test:root:azure-embedding",
    "test:complete": "jest --testPathPatterns=tests/complete",
    "test:pre-commit": "./scripts/pre-commit-tests.sh",
    "test:ab-compare": "tsx tests/performance/run-ab-test.ts",
    "deploy:comparison": "scripts/deploy-comparison-environments.sh",
    "verify:datadog-dbm": "scripts/verify-datadog-dbm.sh",
    "validate:dbm-apm": "scripts/validate-dbm-apm-connection.sh",
    "deploy:dbm-apm:kind": "scripts/deploy-dbm-apm-kind.sh",
    "deploy:dbm-apm:azure": "scripts/deploy-dbm-apm-azure.sh",
    "deploy:dbm-apm:all": "scripts/deploy-dbm-apm-all.sh",
    "db:migrate": "./scripts/deploy-database-migrations.sh",
    "generate:vector-activity": "scripts/generate-vector-activity.sh",
    "generate:chatbot-data": "tsx scripts/generate-chatbot-test-data.ts",
    "demo": "make demo",
    "demo:setup": "make setup",
    "lima:start": "swift run --package-path swift/lima-launcher lima-launcher start --name ide-lima --config vm-assets/ide-lima.yaml",
    "lima:stop": "swift run --package-path swift/lima-launcher lima-launcher stop --name ide-lima",
    "lima:status": "swift run --package-path swift/lima-launcher lima-launcher status",
    "ide:kiosk": "scripts/dev/start-chromium-ide.sh",
    "ide:universal": "scripts/dev/start-ide-universal.sh",
    "test:synthetics": "datadog-ci synthetics run-tests -c datadog-synthetics.json",
    "test:monitoring:production": "jest --testPathPatterns=tests/production/.*monitoring.*\\.test\\.(ts|js)$",
    "test:monitoring:health": "jest --testPathPatterns=tests/unit/health-check.test.ts",
    "test:security": "jest --testPathPatterns=\"tests/security/.*\\.test\\.(ts|tsx|js|jsx)$\"",
    "test:fix": "npm run setup && npm install --legacy-peer-deps",
    "dev:cdn": "./scripts/setup-tailwind-mode.sh cdn && npm run dev",
    "dev:docker": "./scripts/setup-tailwind-mode.sh docker && docker-compose -f docker-compose.dev.yml up --build",
    "dev:docker:detached": "./scripts/setup-tailwind-mode.sh docker && docker-compose -f docker-compose.dev.yml up --build -d",
    "tailwind:cdn": "./scripts/setup-tailwind-mode.sh cdn",
    "tailwind:docker": "./scripts/setup-tailwind-mode.sh docker",
    "tailwind:restore": "./scripts/setup-tailwind-mode.sh restore",
    "monitoring:setup": "npx tsx scripts/setup-datadog-monitoring.ts",
    "monitoring:health": "curl -s http://localhost:3000/api/monitoring/dashboard | jq '.health'",
    "monitoring:metrics": "curl -s http://localhost:3000/api/monitoring/metrics?config=true | jq",
    "monitoring:trace": "python3 scripts/verify-trace-search.py --config configs/trace-search-checks.json",
    "test:performance": "node scripts/run-performance-tests.js",
    "test:performance:jest": "jest --config=jest.performance.config.mjs",
    "test:performance:jest:ci": "jest --config=jest.performance.config.mjs --ci --maxWorkers=2",
    "test:performance:synthetic": "npx @datadog/datadog-ci synthetics run-tests --config datadog-synthetics.json",
    "test:performance:lighthouse": "npx lighthouse-ci autorun",
    "test:performance:ci": "BASE_URL=http://localhost:3000 npm run test:performance",
    "test:performance:all": "npm run test:performance:jest && npm run test:performance",
    "performance:budget": "node scripts/enforce-performance-budget.js",
    "performance:budget:check": "node scripts/enforce-performance-budget.js ./performance-results/metrics.json",
    "performance:synthetic": "BASE_URL=http://localhost:3000 npm run test:performance:synthetic",
    "performance:monitor": "curl -s http://localhost:3000/api/monitoring/dashboard | jq '.performance'",
    "jobs:update-free-models": "node -r dd-trace/init scripts/jobs/update-openrouter-free-models.js",
    "otel:setup": "npx tsx scripts/setup-opentelemetry.ts",
    "otel:config": "curl -s http://localhost:3000/api/monitoring/otel-config | jq",
    "otel:health": "curl -s http://localhost:3000/api/monitoring/otel-config?action=health | jq",
    "otel:metrics": "curl -s http://localhost:9090/metrics",
    "otel:test": "curl -s http://localhost:3000/api/monitoring/otel-config?action=status | jq",
    "docs:validate": "node scripts/validate-documentation.js",
    "docs:stats": "node scripts/validate-documentation.js stats",
    "docs:index": "echo 'Documentation index available at docs/DOCUMENTATION_INDEX.md'",
    "docs:consolidated": "echo 'Consolidated documentation available at docs/CONSOLIDATED_DOCUMENTATION.md'",
    "docs:link-audit": "node scripts/docs-link-audit.js",
    "security:install-hook": "tsx scripts/security/install-hook.ts",
    "security:test": "./scripts/security-test.sh",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "security:migrate-keychain": "bash scripts/security/migrate-secrets-to-keychain.sh",
    "security:validate-keychain": "npx tsx scripts/security/validate-keychain.ts",
    "deps:check": "node scripts/check-dependency-compatibility.mjs",
    "deps:check:ci": "node scripts/check-dependency-compatibility.mjs --skip-phantom",
    "deps:audit": "npm audit --audit-level=moderate",
    "deps:update:check": "npx npm-check-updates",
    "deps:update:patch": "npx npm-check-updates --target patch -u && npm install",
    "deps:update:minor": "npx npm-check-updates --target minor -u && npm install",
    "mcp:dev": "tsx --watch src/mcp/server.ts",
    "mcp:start": "tsx src/mcp/server.ts",
    "verify": "node scripts/verify-monacopilot.js && ./scripts/verify-setup.sh",
    "mcp": "npm run mcp:start",
    "check": "npm run lint && npm run type-check",
    "quick-test": "npm run test:unit -- --maxWorkers=2",
    "test:unit:monaco": "jest --runTestsByPath tests/unit/monaco-monacopilot.test.ts",
    "lint:markdown": "markdownlint-cli2"
  },
