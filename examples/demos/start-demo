#!/bin/bash
# VibeCode pgvector + Datadog DBM Demo
# Single entry point - just run ./start-demo

set -e

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${BLUE}"
cat << 'EOF'
🐘 VibeCode pgvector + Datadog DBM Demo
=====================================
EOF
echo -e "${NC}"

echo -e "${GREEN}Demonstrating: pgvector on PostgreSQL + Kubernetes + Datadog Database Monitoring${NC}"
echo ""

# Check if Go TUI demo exists and is built
if [ -f "bin/vibecode-demo" ]; then
    echo -e "${GREEN}✅ Starting interactive TUI demo...${NC}"
    ./bin/vibecode-demo
    exit 0
fi

# Check if we can build the TUI
if command -v go >/dev/null 2>&1 && command -v make >/dev/null 2>&1; then
    echo -e "${YELLOW}🔨 Building interactive demo...${NC}"
    make build >/dev/null 2>&1
    if [ -f "bin/vibecode-demo" ]; then
        echo -e "${GREEN}✅ Starting interactive TUI demo...${NC}"
        ./bin/vibecode-demo
        exit 0
    fi
fi

# Fallback to direct script execution
echo -e "${YELLOW}⚡ Running direct demo (TUI unavailable)...${NC}"
echo ""

# Check prerequisites
echo -e "${BLUE}🔍 Checking prerequisites...${NC}"

if ! command -v kubectl >/dev/null 2>&1; then
    echo -e "${RED}❌ kubectl not found. Please install kubectl first.${NC}"
    echo "   macOS: brew install kubectl"
    echo "   Linux: https://kubernetes.io/docs/tasks/tools/"
    exit 1
fi

if ! kubectl cluster-info >/dev/null 2>&1; then
    echo -e "${YELLOW}⚠️  No Kubernetes cluster found.${NC}"
    echo "   Start a local cluster:"
    echo "   • Docker Desktop: Enable Kubernetes"
    echo "   • KIND: kind create cluster"
    echo "   • Minikube: minikube start"
    echo ""
    read -p "Continue anyway? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

echo -e "${GREEN}✅ Prerequisites OK${NC}"
echo ""

# Menu
while true; do
    echo -e "${BLUE}📋 Demo Options:${NC}"
    echo "  1) 🔍 Check DBM Status"
    echo "  2) ⚙️  Setup pgvector + Datadog DBM"
    echo "  3) 🎯 Generate Vector Activity"
    echo "  4) 📊 Open Datadog Dashboard"
    echo "  5) ❓ Help & Troubleshooting"
    echo "  6) 🚪 Exit"
    echo ""
    read -p "Choose option (1-6): " choice
    echo ""

    case $choice in
        1)
            echo -e "${BLUE}🔍 Checking DBM status...${NC}"
            ./scripts/verify-datadog-dbm.sh
            ;;
        2)
            echo -e "${BLUE}⚙️ Setting up pgvector + Datadog DBM...${NC}"
            ./scripts/verify-datadog-dbm.sh
            ;;
        3)
            echo -e "${BLUE}🎯 Generating vector activity...${NC}"
            ./scripts/generate-vector-activity.sh
            ;;
        4)
            echo -e "${BLUE}📊 Opening Datadog dashboard...${NC}"
            if command -v open >/dev/null 2>&1; then
                open "https://app.datadoghq.com/databases"
            elif command -v xdg-open >/dev/null 2>&1; then
                xdg-open "https://app.datadoghq.com/databases"
            else
                echo "Please visit: https://app.datadoghq.com/databases"
            fi
            echo "Dashboard opened in browser"
            ;;
        5)
            echo -e "${BLUE}❓ Help & Troubleshooting${NC}"
            echo ""
            echo -e "${GREEN}🎯 Quick Start:${NC}"
            echo "1. Ensure you have a Kubernetes cluster running"
            echo "2. Run option 2 to setup pgvector + Datadog DBM"
            echo "3. Run option 3 to generate vector activity"
            echo "4. Run option 4 to view results in Datadog"
            echo ""
            echo -e "${YELLOW}🔧 Requirements:${NC}"
            echo "• Kubernetes cluster (Docker Desktop, KIND, minikube)"
            echo "• kubectl configured"
            echo "• Optional: Datadog API key for full monitoring"
            echo ""
            echo -e "${RED}🚨 Common Issues:${NC}"
            echo "• No pods found: Run 'kubectl get pods -A' to check cluster"
            echo "• Permission denied: Check kubectl access with 'kubectl auth can-i get pods'"
            echo "• Scripts not executable: Run 'chmod +x scripts/*.sh'"
            echo ""
            ;;
        6)
            echo -e "${GREEN}👋 Thanks for trying the VibeCode pgvector + Datadog DBM demo!${NC}"
            exit 0
            ;;
        *)
            echo -e "${RED}❌ Invalid option. Please choose 1-6.${NC}"
            ;;
    esac
    
    echo ""
    read -p "Press Enter to continue..." -r
    echo ""
done
