-  try {
-    const result = validateQueryParams(request, schema)
-    return result
-  } catch (error) {
-    return {
-      success: false,
-      error: NextResponse.json(
-        {
-          error: 'Invalid query parameters',
-          message: error instanceof Error ? error.message : 'Unknown validation error'
-        },
-        { status: 400 }
-      )
-    }
-  }
-}
-
-/**
