-/**
- * Calculate percentage difference from threshold
- */
-function calculatePercentageDifference(value: number, threshold: number): number {
-  if (threshold === 0) {
-    return value === 0 ? 0 : Infinity
-  }
-  return ((value - threshold) / threshold) * 100
-}
