-  status: number = 500,
-  details?: Record<string, unknown>
-): NextResponse {
-  return NextResponse.json(
-    {
-      error: message,
-      timestamp: new Date().toISOString(),
-      ...details
-    },
-    { status }
-  )
-}
-
-/**
