# VibeCode WebGUI Environment Template
# Copy to `.env.local` (or environment-specific variants) and replace placeholder values.
# Never commit real secrets.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
PORT=3000
VITE_PORT=5173
DOCKER=false
KIND_CLUSTER=false

# -----------------------------------------------------------------------------
# Database & Caching
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://vibecode:password@localhost:5432/vibecode
POSTGRES_URL=postgresql://vibecode:password:5432/vibecode
POSTGRESQL_URL=postgresql://vibecode:password:5432/vibecode
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_ENABLE_DYNAMIC_SIZING=true
DB_POOL_ENABLE_CONNECTION_VALIDATION=true
REDIS_URL=redis://localhost:6379
VALKEY_URL=redis://localhost:6379
CHROMA_DB_URL=http://localhost:8000
COLLABORATION_SERVER_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Primary AI Provider Defaults
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=gpt-3.5-turbo
CLAUDE_API_KEY=
DEFAULT_LLM_MODEL=gpt-4-turbo
DEFAULT_AI_MODEL=gpt-4-turbo
MAX_TOKENS=4000
AI_MAX_TOKENS=4000
TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=30000
ENABLE_AI_ANALYTICS=true
ENABLE_AI_USAGE_TRACKING=false
AI_COST_TRACKING=false

# -----------------------------------------------------------------------------
