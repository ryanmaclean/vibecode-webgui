# Staging Environment Configuration
# Copy this file to .env.staging for staging deployments

# =============================================================================
# DATADOG DBM-APM CONNECTION CONFIGURATION
# =============================================================================

# Core Datadog Configuration (Required for DBM-APM connection)
DD_API_KEY=your-datadog-api-key-here
DD_SITE=datadoghq.com
DD_SERVICE=vibecode-webgui
DD_ENV=staging
DD_VERSION=0.1.0-staging

# Database Monitoring Propagation (Required for DBM-APM connection)
# Docs: https://docs.datadoghq.com/database_monitoring/connect_dbm_and_apm/
DD_DBM_PROPAGATION_MODE=full
DD_DBM_TRACE_INJECTION=true

# APM Configuration
DD_TRACE_ENABLED=true
DD_TRACE_SAMPLE_RATE=0.5
DD_TRACE_ANALYTICS_ENABLED=true

# Database Configuration
DATABASE_URL=postgresql://vibecode:vibecode@postgres-staging:5432/vibecode
POSTGRES_HOST=postgres-staging
POSTGRES_PORT=5432
POSTGRES_DB=vibecode
POSTGRES_USER=vibecode
POSTGRES_PASSWORD=vibecode123

# Application Configuration
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=https://staging.vibecode.com

# AI Service Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_HTTP_REFERER=https://staging.vibecode.com
OPENROUTER_APP_TITLE=VibeCode Staging

# Redis Configuration
REDIS_URL=redis://redis-staging:6379

# =============================================================================
# STAGING-SPECIFIC SETTINGS
# =============================================================================

# Moderate logging for staging
DD_TRACE_DEBUG=false
DD_TRACE_STARTUP_LOGS=true
DD_TRACE_LOG_LEVEL=info

# Enable monitoring features for staging
DD_PROFILING_ENABLED=true
DD_RUNTIME_METRICS_ENABLED=true
DD_LLMOBS_ENABLED=true
DD_LLMOBS_AGENTLESS_ENABLED=true
DD_LLMOBS_ML_APP=vibecode-ai-staging
DD_LOGS_INJECTION=true

# Browser RUM (public) - required for RUM/Session Replay
NEXT_PUBLIC_DD_APPLICATION_ID=your-rum-application-id
NEXT_PUBLIC_DD_CLIENT_TOKEN=your-rum-client-token
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_APP_VERSION=0.1.0-staging

# Staging-specific sampling rates (50% for testing)
DD_TRACE_SAMPLE_RATE=0.5
DD_DBM_SAMPLE_RATE=0.5

# =============================================================================
# KUBERNETES STAGING DEPLOYMENT
# =============================================================================

# For Kubernetes staging deployments, ensure these are set in your Helm values:
# datadog:
#   env:
#     - name: DD_DBM_PROPAGATION_MODE
#       value: "full"
#     - name: DD_SERVICE
#       value: "vibecode-webgui"
#     - name: DD_ENV
#       value: "staging"
#     - name: DD_VERSION
#       value: "0.1.0-staging"

# =============================================================================
# VALIDATION COMMANDS
# =============================================================================

# Test DBM-APM connection:
# curl -X GET "https://api.datadoghq.com/api/v1/validate" \
#   -H "DD-API-KEY: $DD_API_KEY"

# Check staging database connectivity:
# kubectl exec -it postgres-staging-pod -- psql -U vibecode -d vibecode -c "SELECT version();"

# Test staging Redis connectivity:
# kubectl exec -it redis-staging-pod -- redis-cli ping

# =============================================================================
# GAS TOWN / BEADS AUTOMATION
# =============================================================================

# Shared secret for verifying GitHub workflow notifications
GITHUB_WEBHOOK_SECRET=change-me

# Gas Town webhook endpoint for CI failure ingestion
GASTOWN_WEBHOOK_URL=https://gastown.example.com/api/webhooks/github-actions

# Optional bearer token to authenticate with Gas Town
GASTOWN_API_TOKEN=

# Default rig + priority used when creating beads for CI failures
GASTOWN_RIG=vibecode/polecats
GASTOWN_DEFAULT_PRIORITY=P1

# Optional override for webhook timeout (milliseconds)
GASTOWN_TIMEOUT_MS=10000
