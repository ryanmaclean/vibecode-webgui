{
  "$schema": "./mcp-servers.schema.json",
  "version": "1.0",
  "servers": [
    {
      "id": "vibecode-workspace",
      "name": "VibeCode Workspace Tools",
      "description": "MCP server providing workspace management and VM control for VibeCode",
      "enabled": true,
      "transport": "stdio",
      "command": "node",
      "args": [
        "--loader",
        "ts-node/esm",
        "${VIBECODE_ROOT}/src/mcp/server.ts"
      ],
      "env": {
        "NODE_ENV": "production",
        "NEXTAUTH_SECRET": "${NEXTAUTH_SECRET}",
        "DATABASE_URL": "${DATABASE_URL}"
      },
      "capabilities": [
        "tools",
        "resources"
      ],
      "tools": [
        "create_workspace",
        "list_workspaces",
        "delete_workspace",
        "get_workspace_files",
        "execute_in_workspace",
        "create_vm",
        "start_vm",
        "stop_vm",
        "list_vms",
        "get_vm_status"
      ],
      "entitlements": {
        "virtualization": true,
        "hypervisor": true,
        "network": true,
        "fileAccess": "user-selected"
      },
      "setup": {
        "required": [
          "Swift 5.9+ (for VM framework)",
          "Xcode Command Line Tools",
          "Node.js 20+"
        ],
        "build": [
          "cd vz-swift && swift build",
          "bash scripts/sign-mcp-server.sh"
        ],
        "verify": [
          "codesign --display --entitlements - $(which node)"
        ]
      }
    },
    {
      "id": "roundtable-ai",
      "name": "Roundtable Multi-Agent Orchestration",
      "description": "MCP server for coordinating multiple AI agents on complex tasks",
      "enabled": true,
      "transport": "stdio",
      "command": "python",
      "args": [
        "-m",
        "scripts.roundtable-mcp-wrapper"
      ],
      "env": {
        "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}"
      },
      "capabilities": [
        "tools",
        "prompts"
      ],
      "tools": [
        "orchestrate_agents",
        "create_agent",
        "list_agents",
        "get_agent_status",
        "cancel_agent_task"
      ]
    },
    {
      "id": "filesystem",
      "name": "Filesystem Tools",
      "description": "Safe filesystem operations for AI agents",
      "enabled": true,
      "transport": "stdio",
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-filesystem",
        "${WORKSPACE_ROOT}"
      ],
      "env": {},
      "capabilities": [
        "tools",
        "resources"
      ],
      "tools": [
        "read_file",
        "write_file",
        "list_directory",
        "search_files",
        "get_file_info"
      ],
      "permissions": {
        "allowed_directories": [
          "${WORKSPACE_ROOT}",
          "${HOME}/Documents",
          "${HOME}/.vfkit/vms"
        ],
        "denied_patterns": [
          ".git/**",
          "node_modules/**",
          ".env*"
        ]
      }
    }
  ],
  "global_settings": {
    "auto_connect_on_startup": true,
    "reconnect_on_failure": true,
    "max_reconnect_attempts": 3,
    "connection_timeout_ms": 5000,
    "request_timeout_ms": 30000
  },
  "security": {
    "require_confirmation_for": [
      "write_file",
      "delete_file",
      "execute_in_workspace",
      "start_vm",
      "stop_vm"
    ],
    "sandbox_mode": false,
    "allowed_network_hosts": [
      "api.github.com",
      "api.openai.com",
      "api.anthropic.com"
    ]
  },
  "virtualization": {
    "enabled": true,
    "framework": "Apple Virtualization.framework",
    "entitlements_required": [
      "com.apple.security.virtualization",
      "com.apple.security.hypervisor",
      "com.apple.security.network.client",
      "com.apple.security.network.server"
    ],
    "setup_guide": "https://developer.apple.com/documentation/virtualization/adding-the-virtualization-entitlement-to-your-project",
    "vm_types_supported": [
      "linux",
      "linux-gui",
      "windows",
      "macos"
    ]
  }
}
