{
  "title": "Musl libc Build Performance Tracking",
  "description": "Track musl vs glibc build performance over time for BusyBox, Docker images, and kernel builds",
  "widgets": [
    {
      "id": 1,
      "definition": {
        "title": "Build Duration Trends",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": ["avg", "min", "max", "value", "sum"],
        "type": "timeseries",
        "requests": [
          {
            "formulas": [
              {
                "formula": "query1"
              },
              {
                "formula": "query2"
              },
              {
                "formula": "query3"
              }
            ],
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "avg:busybox.build.duration{libc:musl} by {platform}"
              },
              {
                "name": "query2",
                "data_source": "metrics",
                "query": "avg:docker.build.duration{variant:musl}"
              },
              {
                "name": "query3",
                "data_source": "metrics",
                "query": "avg:docker.build.duration{variant:glibc}"
              }
            ],
            "response_format": "timeseries",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            },
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 2,
      "definition": {
        "title": "Image Size Comparison",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": ["avg", "min", "max", "value"],
        "type": "timeseries",
        "requests": [
          {
            "formulas": [
              {
                "formula": "query1 / 1048576",
                "alias": "musl (MB)"
              },
              {
                "formula": "query2 / 1048576",
                "alias": "glibc (MB)"
              },
              {
                "formula": "query3 / 1048576",
                "alias": "BusyBox (MB)"
              }
            ],
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "avg:docker.image.size{variant:musl}"
              },
              {
                "name": "query2",
                "data_source": "metrics",
                "query": "avg:docker.image.size{variant:glibc}"
              },
              {
                "name": "query3",
                "data_source": "metrics",
                "query": "avg:busybox.binary.size{libc:musl}"
              }
            ],
            "response_format": "timeseries",
            "style": {
              "palette": "cool",
              "line_type": "solid",
              "line_width": "normal"
            },
            "display_type": "area"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 0,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 3,
      "definition": {
        "title": "Cold Start Performance",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "formulas": [
              {
                "formula": "query1"
              }
            ],
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "avg:docker.coldstart.duration{variant:musl}",
                "aggregator": "avg"
              }
            ],
            "response_format": "scalar",
            "conditional_formats": [
              {
                "comparator": "<",
                "value": 2,
                "palette": "white_on_green"
              },
              {
                "comparator": ">=",
                "value": 2,
                "palette": "white_on_yellow"
              },
              {
                "comparator": ">=",
                "value": 5,
                "palette": "white_on_red"
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 2,
        "text_align": "center"
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 3,
        "height": 2
      }
    },
    {
      "id": 4,
      "definition": {
        "title": "Size Reduction (musl vs glibc)",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "formulas": [
              {
                "formula": "100 * (1 - query1 / query2)"
              }
            ],
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "avg:docker.image.size{variant:musl}",
                "aggregator": "avg"
              },
              {
                "name": "query2",
                "data_source": "metrics",
                "query": "avg:docker.image.size{variant:glibc}",
                "aggregator": "avg"
              }
            ],
            "response_format": "scalar",
            "conditional_formats": [
              {
                "comparator": ">",
                "value": 50,
                "palette": "white_on_green"
              },
              {
                "comparator": ">",
                "value": 30,
                "palette": "white_on_yellow"
              },
              {
                "comparator": "<=",
                "value": 30,
                "palette": "white_on_red"
              }
            ]
          }
        ],
        "autoscale": false,
        "custom_unit": "%",
        "precision": 1,
        "text_align": "center"
      },
      "layout": {
        "x": 3,
        "y": 3,
        "width": 3,
        "height": 2
      }
    },
    {
      "id": 5,
      "definition": {
        "title": "Memory Usage Comparison",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "type": "timeseries",
        "requests": [
          {
            "formulas": [
              {
                "formula": "query1",
                "alias": "musl"
              },
              {
                "formula": "query2",
                "alias": "glibc"
              }
            ],
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "avg:docker.memory.usage{variant:musl}"
              },
              {
                "name": "query2",
                "data_source": "metrics",
                "query": "avg:docker.memory.usage{variant:glibc}"
              }
            ],
            "response_format": "timeseries",
            "style": {
              "palette": "purple",
              "line_type": "solid",
              "line_width": "normal"
            },
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 3,
        "width": 6,
        "height": 2
      }
    },
    {
      "id": 6,
      "definition": {
        "title": "Build Success Rate (Last 7 Days)",
        "title_size": "16",
        "title_align": "left",
        "type": "query_table",
        "requests": [
          {
            "formulas": [
              {
                "formula": "query1",
                "limit": {
                  "count": 10,
                  "order": "desc"
                },
                "cell_display_mode": "bar",
                "alias": "Build Count"
              },
              {
                "formula": "query2",
                "cell_display_mode": "number",
                "alias": "Avg Duration (s)"
              }
            ],
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "count:docker.build.duration{*} by {variant}.as_count()",
                "aggregator": "sum"
              },
              {
                "name": "query2",
                "data_source": "metrics",
                "query": "avg:docker.build.duration{*} by {variant}",
                "aggregator": "avg"
              }
            ],
            "response_format": "scalar"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 5,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 7,
      "definition": {
        "title": "Kernel Build Time (MiniVim)",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "type": "timeseries",
        "requests": [
          {
            "formulas": [
              {
                "formula": "query1"
              }
            ],
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "avg:kernel.build.duration{*} by {arch,version}"
              }
            ],
            "response_format": "timeseries",
            "style": {
              "palette": "warm",
              "line_type": "solid",
              "line_width": "normal"
            },
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 5,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 8,
      "definition": {
        "title": "Platform Distribution",
        "title_size": "16",
        "title_align": "left",
        "type": "sunburst",
        "requests": [
          {
            "formulas": [
              {
                "formula": "query1"
              }
            ],
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "sum:busybox.build.duration{*} by {platform,libc}.as_count()",
                "aggregator": "sum"
              }
            ],
            "response_format": "scalar"
          }
        ],
        "legend_table": {
          "type": "table"
        },
        "legend_inline": {
          "type": "inline",
          "hide_value": false,
          "hide_percent": false
        }
      },
      "layout": {
        "x": 0,
        "y": 8,
        "width": 4,
        "height": 3
      }
    },
    {
      "id": 9,
      "definition": {
        "title": "Recent Build Events",
        "title_size": "16",
        "title_align": "left",
        "type": "event_stream",
        "query": "source:musl tags:build,benchmark",
        "event_size": "s",
        "tags_execution": "and"
      },
      "layout": {
        "x": 4,
        "y": 8,
        "width": 8,
        "height": 3
      }
    }
  ],
  "template_variables": [
    {
      "name": "variant",
      "prefix": "variant",
      "available_values": ["musl", "glibc"],
      "default": "*"
    },
    {
      "name": "platform",
      "prefix": "platform",
      "available_values": ["linux", "macos"],
      "default": "*"
    },
    {
      "name": "ci",
      "prefix": "ci",
      "available_values": ["true", "false"],
      "default": "*"
    }
  ],
  "layout_type": "ordered",
  "notify_list": [],
  "reflow_type": "fixed"
}
