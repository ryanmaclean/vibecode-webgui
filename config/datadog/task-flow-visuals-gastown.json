    {
      "definition": {
        "type": "wildcard",
        "title": "Task Flow Matrix (Vega-Lite)",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "c_to_ip",
                "query": "sum:gastown.flow.edge{from:created,to:in_progress}"
              },
              {
                "data_source": "metrics",
                "name": "c_to_es",
                "query": "sum:gastown.flow.edge{from:created,to:escalated}"
              },
              {
                "data_source": "metrics",
                "name": "c_to_fa",
                "query": "sum:gastown.flow.edge{from:created,to:failed}"
              },
              {
                "data_source": "metrics",
                "name": "ip_to_do",
                "query": "sum:gastown.flow.edge{from:in_progress,to:done}"
              }
            ]
          }
        ],
        "specification": {
          "type": "vega-lite",
          "contents": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "table1"
            },
            "transform": [
              {
                "fold": [
                  "c_to_ip",
                  "c_to_es",
                  "c_to_fa",
                  "ip_to_do"
                ],
                "as": [
                  "edge",
                  "count"
                ]
              },
              {
                "calculate": "datum.edge == 'c_to_ip' ? 'created' : datum.edge == 'c_to_es' ? 'created' : datum.edge == 'c_to_fa' ? 'created' : 'in_progress'",
                "as": "from"
              },
              {
                "calculate": "datum.edge == 'c_to_ip' ? 'in_progress' : datum.edge == 'c_to_es' ? 'escalated' : datum.edge == 'c_to_fa' ? 'failed' : 'done'",
                "as": "to"
              }
            ],
            "mark": "rect",
            "encoding": {
              "x": {
                "field": "from",
                "type": "nominal",
                "title": "From"
              },
              "y": {
                "field": "to",
                "type": "nominal",
                "title": "To"
              },
              "color": {
                "field": "count",
                "type": "quantitative"
              },
              "tooltip": [
                {
                  "field": "from",
                  "type": "nominal"
                },
                {
                  "field": "to",
                  "type": "nominal"
                },
                {
                  "field": "count",
                  "type": "quantitative"
                }
              ]
            }
          }
        }
      }
    },
