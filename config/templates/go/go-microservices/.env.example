# Application Configuration
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=debug
SERVICE_NAME=go-microservice

# Server Configuration
READ_TIMEOUT=15
WRITE_TIMEOUT=15
IDLE_TIMEOUT=60
SHUTDOWN_TIMEOUT=10

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=8080

# Database (PostgreSQL) - Uncomment to enable
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=microservice_db
# DB_USER=postgres
# DB_PASSWORD=postgres123
# DB_SSL_MODE=disable

# Cache (Redis) - Uncomment to enable
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Feature Flags
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_PROFILING=false

# External Services
# API_KEY=your-api-key-here
# EXTERNAL_SERVICE_URL=https://api.example.com
