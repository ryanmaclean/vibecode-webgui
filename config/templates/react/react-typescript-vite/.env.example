# Application Configuration
VITE_APP_NAME=my-react-app
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# Monitoring Configuration (Datadog)
# Get your API key from https://app.datadoghq.com/account/settings#api
DD_API_KEY=
DD_SITE=datadoghq.com
DD_RUM_APPLICATION_ID=
DD_RUM_CLIENT_TOKEN=
DD_SERVICE=my-react-app
DD_VERSION=1.0.0
DD_ENV=development

# Monitoring Configuration (optional)
SERVICE_NAME=my-react-app
SERVICE_VERSION=1.0.0
SERVICE_NAMESPACE=vibecode
DEPLOYMENT_ENVIRONMENT=development

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=true
VITE_ENABLE_MONITORING=false

# Build Configuration
VITE_BUILD_SOURCEMAP=true
