# Production Environment Configuration
# Copy this file to .env.production for production deployments

# =============================================================================
# DATADOG DBM-APM CONNECTION CONFIGURATION
# =============================================================================

# Core Datadog Configuration (Required for DBM-APM connection)
DD_API_KEY=your-datadog-api-key-here
DD_SITE=datadoghq.com
DD_SERVICE=vibecode-webgui
DD_ENV=production
DD_VERSION=1.0.0

# Database Monitoring Propagation (Required for DBM-APM connection)
# Docs: https://docs.datadoghq.com/database_monitoring/connect_dbm_and_apm/
DD_DBM_PROPAGATION_MODE=full
DD_DBM_TRACE_INJECTION=true

# APM Configuration
DD_TRACE_ENABLED=true
DD_TRACE_SAMPLE_RATE=0.1
DD_TRACE_ANALYTICS_ENABLED=true

# Database Configuration
DATABASE_URL=postgresql://vibecode:vibecode@postgres-production:5432/vibecode
POSTGRES_HOST=postgres-production
POSTGRES_PORT=5432
POSTGRES_DB=vibecode
POSTGRES_USER=vibecode
POSTGRES_PASSWORD=your-secure-production-password

# Application Configuration
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXTAUTH_SECRET=your-secure-nextauth-secret
NEXTAUTH_URL=https://vibecode.com

# AI Service Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_HTTP_REFERER=https://vibecode.com
OPENROUTER_APP_TITLE=VibeCode Production

# Redis Configuration
REDIS_URL=redis://redis-production:6379

# =============================================================================
# PRODUCTION-SPECIFIC SETTINGS
# =============================================================================

# Minimal logging for production
DD_TRACE_DEBUG=false
DD_TRACE_STARTUP_LOGS=false
DD_TRACE_LOG_LEVEL=warn

# Enable monitoring features for production
DD_PROFILING_ENABLED=true
DD_RUNTIME_METRICS_ENABLED=true
DD_LLMOBS_ENABLED=true
DD_LLMOBS_AGENTLESS_ENABLED=true
DD_LLMOBS_ML_APP=vibecode-ai-production

# Production-specific sampling rates (10% for performance)
DD_TRACE_SAMPLE_RATE=0.1
DD_DBM_SAMPLE_RATE=0.1

# =============================================================================
# KUBERNETES PRODUCTION DEPLOYMENT
# =============================================================================

# For Kubernetes production deployments, ensure these are set in your Helm values:
# datadog:
#   env:
#     - name: DD_DBM_PROPAGATION_MODE
#       value: "full"
#     - name: DD_SERVICE
#       value: "vibecode-webgui"
#     - name: DD_ENV
#       value: "production"
#     - name: DD_VERSION
#       value: "1.0.0"

# =============================================================================
# SECURITY CONSIDERATIONS
# =============================================================================

# Production security settings
DD_APPSEC_ENABLED=true
DD_IAST_ENABLED=true
DD_IAST_REQUEST_SAMPLING=0.1

# Rate limiting for production
DD_TRACE_RATE_LIMIT=100

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================

# Enable comprehensive monitoring
DD_LOGS_ENABLED=true
DD_RUM_ENABLED=true
DD_SYNTHETICS_ENABLED=true

# =============================================================================
# VALIDATION COMMANDS
# =============================================================================

# Test DBM-APM connection:
# curl -X GET "https://api.datadoghq.com/api/v1/validate" \
#   -H "DD-API-KEY: $DD_API_KEY"

# Check production database connectivity:
# kubectl exec -it postgres-production-pod -- psql -U vibecode -d vibecode -c "SELECT version();"

# Test production Redis connectivity:
# kubectl exec -it redis-production-pod -- redis-cli ping

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================

# Ensure database backups are configured
# Ensure Redis persistence is enabled
# Test disaster recovery procedures regularly

# =============================================================================
# GAS TOWN / BEADS AUTOMATION
# =============================================================================

# Shared secret for verifying GitHub workflow notifications
GITHUB_WEBHOOK_SECRET=change-me

# Gas Town webhook endpoint for CI failure ingestion
GASTOWN_WEBHOOK_URL=https://gastown.example.com/api/webhooks/github-actions

# Optional bearer token to authenticate with Gas Town
GASTOWN_API_TOKEN=

# Default rig + priority used when creating beads for CI failures
GASTOWN_RIG=vibecode/polecats
GASTOWN_DEFAULT_PRIORITY=P1

# Optional override for webhook timeout (milliseconds)
GASTOWN_TIMEOUT_MS=10000
