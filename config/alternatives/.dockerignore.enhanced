# Enhanced .dockerignore for optimized build context
# Container Team: Minimize build context for faster builds

# ===== DENY BY DEFAULT =====
# Start with deny-all approach for maximum optimization
**

# ===== CORE APPLICATION FILES =====
# Only include essential files for the build
!package.json
!package-lock.json
!yarn.lock
!pnpm-lock.yaml
!bun.lockb

# Configuration files
!next.config.js
!next.config.mjs
!next.config.ts
!tailwind.config.js
!tailwind.config.mjs
!tailwind.config.ts
!postcss.config.js
!postcss.config.mjs
!babel.config.js
!.babelrc
!.babelrc.js
!tsconfig.json
!tsconfig.*.json
!next-env.d.ts
!.npmrc
!.yarnrc.yml

# Source code and assets
!src/**
!public/**
!prisma/**
!instrument.cjs

# Essential scripts (filtered)
!scripts/ensure-native-binaries.js
!scripts/setup-development.js

# ===== PRODUCTION-SPECIFIC INCLUDES =====
# Include enhanced Dockerfiles
!Dockerfile
!Dockerfile.*
!.dockerignore*

# ===== AGGRESSIVE EXCLUSIONS =====
# Large directories that slow down builds
node_modules/**
.next/**
out/**
dist/**
build/**

# Development and testing
.git/**
.github/**
tests/**
test/**
__tests__/**
coverage/**
.nyc_output/**
playwright-report/**
playwright/.cache/**
jest.config.*
playwright.config.*
.eslintrc.*
.eslintignore
.prettierrc*
.prettierignore

# Development caches
.cache/**
__cache__/**
.tmp/**
.temp/**
temp/**
tmp/**
.vscode/**
.idea/**
.vs/**

# Environment and secrets
.env*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
secrets/**
*.key
*.pem
*.p12
*.pfx

# Logs
logs/**
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Documentation (excluded from builds)
docs/**
claudedocs/**
*.md
*.txt
!README.md
LICENSE*
CHANGELOG*
CONTRIBUTING*
CODE_OF_CONDUCT*

# Monitoring and infrastructure (not needed in container)
monitoring/**
infrastructure/**
terraform/**
tofu/**
kubernetes/**
k8s/**
helm/**
charts/**

# Development containers and virtualization
docker-compose.*
vagrant/**
.vagrant/**
Vagrantfile
Dockerfile.dev*
Dockerfile.test*
Dockerfile.debug*

# Package manager artifacts
.npm/**
.yarn/**
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.js
.pnp.cjs

# Runtime data
pids/**
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/**
.coverage/**
test-results/**

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Storybook build outputs
.out
.storybook-out
storybook-static/**

# Temporary folders
.tmp/**
.temp/**

# Editor directories and files
.vscode/**
!.vscode/extensions.json
!.vscode/settings.json
.idea/**
*.swp
*.swo
*~

# Large binary files
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z
*.dmg
*.iso
*.img
*.exe
*.msi
*.deb
*.rpm

# Media files (unless in public/)
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.webm
*.mkv
*.mp3
*.wav
*.flac
*.aac
*.ogg

# AI and ML models (unless specifically needed)
*.model
*.h5
*.pb
*.onnx
*.pkl
*.joblib

# Database files
*.db
*.sqlite
*.sqlite3
*.db3

# Backup files
*.bak
*.backup
*.old
*.orig

# Performance and profiling
*.cpuprofile
*.heapsnapshot
*.heapprofile

# Windows specific
node_modules\.bin\

# ===== SIZE OPTIMIZATION NOTES =====
# This .dockerignore should reduce build context by 70-90%
# Typical reductions:
# - Full repo: ~2-5GB → Build context: ~200-500MB
# - node_modules alone: ~800MB-2GB (excluded)
# - .git directory: ~100-500MB (excluded)
# - Documentation: ~50-100MB (excluded)
# - Tests: ~100-300MB (excluded)

# ===== USAGE INSTRUCTIONS =====
# For production builds:
# docker build -f Dockerfile.production.enhanced .
#
# For development builds:
# docker build -f Dockerfile.dev.enhanced --target development .
#
# For testing:
# docker build -f Dockerfile.dev.enhanced --target testing .
