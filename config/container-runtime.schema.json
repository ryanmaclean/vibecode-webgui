{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Container Runtime Configuration",
  "type": "object",
  "required": ["selectedRuntime", "runtime", "defaults"],
  "properties": {
    "selectedRuntime": {
      "type": "string",
      "enum": ["docker", "podman", "kubernetes", "apple"],
      "description": "The container runtime to use"
    },
    "docker": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "Docker host URL (e.g., tcp://localhost:2375)"
        },
        "socketPath": {
          "type": "string",
          "description": "Path to Docker socket"
        },
        "useDesktop": {
          "type": "boolean",
          "description": "Use Docker Desktop"
        },
        "useColima": {
          "type": "boolean",
          "description": "Use Colima"
        },
        "tlsVerify": {
          "type": "boolean",
          "description": "Enable TLS verification"
        }
      }
    },
    "podman": {
      "type": "object",
      "properties": {
        "machine": {
          "type": "string",
          "description": "Podman machine name (macOS)"
        },
        "socketPath": {
          "type": "string",
          "description": "Path to Podman socket"
        },
        "remoteHost": {
          "type": "string",
          "description": "Remote Podman host"
        },
        "rootless": {
          "type": "boolean",
          "description": "Use rootless mode"
        }
      }
    },
    "kubernetes": {
      "type": "object",
      "properties": {
        "context": {
          "type": "string",
          "description": "Kubernetes context to use"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace for deployments"
        },
        "useKind": {
          "type": "boolean",
          "description": "Use kind for local development"
        },
        "useMinikube": {
          "type": "boolean",
          "description": "Use minikube for local development"
        },
        "useK3s": {
          "type": "boolean",
          "description": "Use k3s for local development"
        },
        "kubeconfig": {
          "type": "string",
          "description": "Path to kubeconfig file"
        }
      }
    },
    "apple": {
      "type": "object",
      "properties": {
        "binaryPath": {
          "type": "string",
          "description": "Path to container binary"
        },
        "isolation": {
          "type": "string",
          "enum": ["process", "vm"],
          "description": "Container isolation mode"
        },
        "enableRosetta": {
          "type": "boolean",
          "description": "Enable Rosetta translation"
        },
        "dataDirectory": {
          "type": "string",
          "description": "Container data directory"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["version", "dataDirectory"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "dataDirectory": {
          "type": "string"
        },
        "imageCacheDirectory": {
          "type": "string"
        },
        "logDirectory": {
          "type": "string"
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "cpuCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "memorySize": {
          "type": "integer",
          "minimum": 536870912,
          "description": "Memory in bytes (minimum 512MB)"
        },
        "startupTimeout": {
          "type": "integer",
          "minimum": 1000,
          "description": "Startup timeout in milliseconds"
        },
        "shutdownTimeout": {
          "type": "integer",
          "minimum": 1000,
          "description": "Shutdown timeout in milliseconds"
        },
        "enableRosetta": {
          "type": "boolean"
        }
      }
    },
    "networking": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["nat", "bridged", "host"]
        },
        "ipRange": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+/\\d+$"
        },
        "enableIPv6": {
          "type": "boolean"
        },
        "dns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "driver": {
          "type": "string",
          "enum": ["virtio", "nvme"]
        },
        "defaultSize": {
          "type": "integer",
          "minimum": 1073741824,
          "description": "Default disk size in bytes (minimum 1GB)"
        },
        "enableCompression": {
          "type": "boolean"
        },
        "snapshotSupport": {
          "type": "boolean"
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "enableSecureBoot": {
          "type": "boolean"
        },
        "allowHostAccess": {
          "type": "boolean"
        },
        "isolationLevel": {
          "type": "string",
          "enum": ["standard", "strict", "minimal"]
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "enableMetrics": {
          "type": "boolean"
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "healthCheckInterval": {
          "type": "integer",
          "minimum": 10
        },
        "enableCrashReports": {
          "type": "boolean"
        }
      }
    },
    "registry": {
      "type": "object",
      "properties": {
        "mirrors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "insecureRegistries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "credentials": {
          "type": "object"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["reference"],
        "properties": {
          "reference": {
            "type": "string"
          },
          "autoUpdate": {
            "type": "boolean"
          },
          "updateInterval": {
            "type": "integer",
            "minimum": 3600
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cpuCount": {
            "type": "integer",
            "minimum": 1
          },
          "memorySize": {
            "type": "integer",
            "minimum": 536870912
          },
          "diskSize": {
            "type": "integer",
            "minimum": 1073741824
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxConcurrentContainers": {
          "type": "integer",
          "minimum": 1
        },
        "maxTotalCpus": {
          "type": "integer",
          "minimum": 1
        },
        "maxTotalMemory": {
          "type": "integer",
          "minimum": 1073741824
        },
        "perContainerCpuLimit": {
          "type": "integer",
          "minimum": 1
        },
        "perContainerMemoryLimit": {
          "type": "integer",
          "minimum": 536870912
        }
      }
    }
  }
}
