+name: PostgreSQL Vector Monitoring Deployment
+
+on:
+  push:
+    branches: [ main ]
+    paths:
+      - 'src/lib/vector-db/**'
+      - 'src/lib/datadog-database.ts'
+      - 'monitoring/**'
+      - 'database/**'
+      - '.github/workflows/db-monitoring-deployment.yml'
+  pull_request:
+    branches: [ main ]
+    paths:
+      - 'src/lib/vector-db/**'
+      - 'src/lib/datadog-database.ts'
+      - 'monitoring/**'
+      - 'database/**'
+      - '.github/workflows/db-monitoring-deployment.yml'
+  workflow_dispatch:
+    inputs:
+      environment:
+        description: 'Environment to deploy to'
+        required: true
+        default: 'staging'
+        type: choice
+        options:
+          - development
+          - staging
+          - production
+
+permissions:
+  contents: read
+
+concurrency:
+  group: db-monitoring-${{ github.ref }}
+  cancel-in-progress: true
+
+env:
+  DD_SITE: "datadoghq.com"
+  ENVIRONMENT: ${{ github.event.inputs.environment || 'staging' }}
+
+jobs:
+  validate-ci-config:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    env:
+      DD_API_KEY: ${{ secrets.DD_API_KEY || secrets.DATADOG_API_KEY || '' }}
+      DD_APP_KEY: ${{ secrets.DD_APP_KEY || secrets.DATADOG_APP_KEY || '' }}
+      POSTGRES_CONNECTION: ${{ secrets.POSTGRES_CONNECTION_STRING || '' }}
+    steps:
+      - name: Check required secrets
+        run: |
+          missing=0
+          for key in DD_API_KEY DD_APP_KEY POSTGRES_CONNECTION; do
+            if [ -z "${!key}" ]; then
+              echo "::warning::Missing secret for $key; related steps will be skipped."
+              missing=1
+            fi
+          done
+          if [ "$missing" -eq 0 ]; then
+            echo "All required secrets present."
+          fi
+
+  validate-database-schema:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    env:
+      POSTGRES_CONNECTION: ${{ secrets.POSTGRES_CONNECTION_STRING || '' }}
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+          cache: 'npm'
+
+      - name: Install dependencies
+        run: npm ci --legacy-peer-deps
+
+      - name: Validate PostgreSQL schema
+        if: ${{ env.POSTGRES_CONNECTION != '' }}
+        run: |
+          echo "PostgreSQL connection available, validating schema..."
+          # Basic connection test
+          node -e "
+          const { Pool } = require('pg');
+          const pool = new Pool({ connectionString: process.env.POSTGRES_CONNECTION });
+          pool.query('SELECT version()').then(res => {
+            console.log('PostgreSQL version:', res.rows[0].version);
+            pool.end();
+          }).catch(err => {
+            console.error('Connection failed:', err);
+            process.exit(1);
+          });
+          "
+        continue-on-error: false
+          
+      - name: Check for pgvector extension
+        if: ${{ env.POSTGRES_CONNECTION != '' }}
+        run: |
+          node -e "
+          const { Pool } = require('pg');
+          const pool = new Pool({
+            connectionString: process.env.POSTGRES_CONNECTION,
+          });
+          
+          async function checkPgVector() {
+            try {
+              const client = await pool.connect();
+              const result = await client.query(\"SELECT * FROM pg_extension WHERE extname = 'vector'\");
+              client.release();
+              
+              if (result.rows.length === 0) {
+                console.error('pgvector extension is not installed!');
+                process.exit(1);
+              } else {
+                console.log('pgvector extension is properly installed');
+              }
+            } catch (err) {
+              console.error('Error checking pgvector extension:', err);
+              process.exit(1);
+            } finally {
+              await pool.end();
+            }
+          }
+          
+          checkPgVector();
+          "
+
+  validate-vector-index:
+    runs-on: ubuntu-latest
+    needs: validate-database-schema
+    timeout-minutes: 10
+    env:
+      POSTGRES_CONNECTION: ${{ secrets.POSTGRES_CONNECTION_STRING || '' }}
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+          cache: 'npm'
+
+      - name: Install dependencies
+        run: npm ci --legacy-peer-deps
+      
+      - name: Check vector indexes
+        if: ${{ env.POSTGRES_CONNECTION != '' }}
+        run: |
+          node -e "
+          const { Pool } = require('pg');
+          const pool = new Pool({
+            connectionString: process.env.POSTGRES_CONNECTION,
+          });
+          
+          async function checkVectorIndexes() {
+            try {
+              const client = await pool.connect();
+              const result = await client.query(\"SELECT indexname, indexdef FROM pg_indexes WHERE indexdef LIKE '%vector%'\");
+              client.release();
+              
+              if (result.rows.length === 0) {
+                console.error('No vector indexes found!');
+                process.exit(1);
+              } else {
+                console.log('Found the following vector indexes:');
+                result.rows.forEach(row => {
+                  console.log(`${row.indexname}: ${row.indexdef}`);
+                });
+              }
+            } catch (err) {
+              console.error('Error checking vector indexes:', err);
+              process.exit(1);
+            } finally {
+              await pool.end();
+            }
+          }
+          
+          checkVectorIndexes();
+          "
+      
+      - name: Validate monitoring dashboards
+        run: |
+          echo "Validating Datadog dashboard definitions..."
+          if [ -d "monitoring/dashboards" ]; then
+            for file in monitoring/dashboards/*.json; do
+              if [ -f "$file" ]; then
+                echo "Validating $file"
+                cat "$file" | jq empty || (echo "Invalid JSON in $file" && exit 1)
+              fi
+            done
+            echo "All dashboard definitions are valid JSON"
+          else
+            echo "Warning: monitoring/dashboards directory not found, skipping validation"
+          fi
+
+  benchmark-vector-performance:
+    runs-on: ubuntu-latest
+    needs: validate-vector-index
+    timeout-minutes: 15
