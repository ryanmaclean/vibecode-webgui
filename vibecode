cmd_build() {
    print_header "Building VibeCode Menubar App"

    # Check prerequisites
    if ! command -v swift &> /dev/null; then
        print_error "Swift not found. Please install Xcode."
        exit 1
    fi

    if ! command -v swiftc &> /dev/null; then
        print_error "swiftc not found. Please install Xcode Command Line Tools."
        exit 1
    fi

    print_info "Swift version: $(swift --version | head -1)"
    echo ""

    # Check build script exists
    if [ ! -f "$BUILD_SCRIPT" ]; then
        print_error "Build script not found: $BUILD_SCRIPT"
        exit 1
    fi

    # Run build script
    print_info "Running build script..."
    cd "$SWIFT_ROOT"

    if bash "$BUILD_SCRIPT"; then
        echo ""
        print_success "Build complete!"
        print_info "App location: $APP_PATH"
        echo ""
        print_info "To start: vibecode start"
    else
        echo ""
        print_error "Build failed!"
        exit 1
    fi
}

cmd_start() {
    print_header "Starting VibeCode"

    if is_vm_running; then
        print_warning "VibeCode is already running (PID: $(get_vm_pid))"
        echo ""
        cmd_status
        return
    fi

    if [ ! -d "$APP_PATH" ]; then
        print_error "App not found: $APP_PATH"
        print_info "Run 'vibecode build' first"
        exit 1
    fi

    print_info "Starting menubar app..."
    open "$APP_PATH"

    echo ""
    print_info "Waiting for VM to boot..."

    # Wait for VM process to start
    local max_wait=10
    local waited=0
    while [ $waited -lt $max_wait ]; do
        if is_vm_running; then
            print_success "VM process started (PID: $(get_vm_pid))"
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done

    if ! is_vm_running; then
        print_error "VM failed to start"
        exit 1
    fi

    echo ""
    print_info "VM is booting... This may take 1-2 minutes."
    print_info "Check status with: vibecode status"
    print_info "Check services with: vibecode check"
}

cmd_stop() {
    print_header "Stopping VibeCode"

    if ! is_vm_running; then
        print_warning "VibeCode is not running"
        return
    fi

    local pid
    pid=$(get_vm_pid)
    print_info "Stopping VibeCode (PID: $pid)..."

    pkill -f "$APP_NAME" || true

    # Wait for process to stop
    sleep 2

    if is_vm_running; then
        print_error "Failed to stop VibeCode"
        exit 1
    else
        print_success "VibeCode stopped"
    fi
}

cmd_restart() {
    print_header "Restarting VibeCode"
    cmd_stop
    sleep 2
    cmd_start
}

cmd_status() {
    print_header "VibeCode Status"

    # VM Status
    if is_vm_running; then
        local pid
        pid=$(get_vm_pid)
        print_success "VM Status: Running (PID: $pid)"

        # Get VM IP
        local vm_ip
        vm_ip=$(get_vm_ip)
        if [ -n "$vm_ip" ]; then
            print_info "VM IP: $vm_ip"
        else
            print_warning "VM IP: Not yet assigned (may still be booting)"
        fi
    else
        print_error "VM Status: Stopped"
        echo ""
        print_info "Start with: vibecode start"
        return
    fi

    echo ""
    print_header "Services Status"

    cmd_check

    echo ""
    print_header "Resource Usage"

    local pid
    pid=$(get_vm_pid)
    if [ -n "$pid" ]; then
        ps -p "$pid" -o rss=,vsz=,%cpu=,%mem= | awk '{
            printf "  RSS:  %d MB\n", $1/1024
            printf "  VSZ:  %d MB\n", $2/1024
            printf "  CPU:  %.1f%%\n", $3
            printf "  MEM:  %.1f%%\n", $4
        }'
    fi
}

cmd_check() {
    if ! is_vm_running; then
        print_error "VM is not running"
        print_info "Start with: vibecode start"
        exit 1
    fi

    print_info "Checking services..."
    echo ""

    local success_count=0
    local total_count=5

    # Check each service
    if check_service "SSH" "localhost" "$SSH_PORT"; then
        success_count=$((success_count + 1))
    fi

    if check_service "Valkey" "localhost" "$VALKEY_PORT"; then
        success_count=$((success_count + 1))
    fi

    if check_service "PostgreSQL" "localhost" "$POSTGRESQL_PORT"; then
        success_count=$((success_count + 1))
    fi

    if check_service "OpenVSCode" "localhost" "$OPENVSCODE_PORT" "http"; then
        success_count=$((success_count + 1))
    fi

    if check_service "Docker" "localhost" "$DOCKER_PORT"; then
        success_count=$((success_count + 1))
    fi

    echo ""

    # IDE Detection
    if check_port localhost "$OPENVSCODE_PORT"; then
        local ide_type
        ide_type=$(detect_ide_type)
        print_info "IDE Type: $ide_type"
    fi

    echo ""

    # Summary
    if [ $success_count -eq $total_count ]; then
        print_success "All services operational ($success_count/$total_count)"
    elif [ $success_count -gt 0 ]; then
        print_warning "Some services available ($success_count/$total_count)"
        print_info "VM may still be booting. Wait 30s and try again."
    else
        print_error "No services available (0/$total_count)"
        print_info "VM may still be booting. Check logs: vibecode logs"
    fi
}

cmd_services() {
    print_header "VibeCode Services"

    cat << EOF
SERVICE       PORT   URL/CONNECTION
─────────────────────────────────────────────────────────────
SSH           2222   ssh root@localhost -p 2222
Valkey        6379   valkey-cli -h localhost -p 6379
PostgreSQL    5432   psql -h localhost -p 5432 -U postgres
OpenVSCode    8080   http://localhost:8080
Docker        2375   export DOCKER_HOST=tcp://localhost:2375

EOF

    if is_vm_running; then
        echo ""
        print_info "Quick connectivity check:"
        echo ""
        cmd_check
    else
        print_warning "VM is not running. Start with: vibecode start"
    fi
}

cmd_ssh() {
    print_header "SSH to VibeCode VM"

    if ! is_vm_running; then
        print_error "VM is not running"
        print_info "Start with: vibecode start"
        exit 1
    fi

    if ! check_port localhost "$SSH_PORT"; then
        print_error "SSH not accessible on localhost:$SSH_PORT"
        print_info "VM may still be booting. Try: vibecode status"
        exit 1
    fi

    print_info "Connecting to root@localhost:$SSH_PORT..."
    print_warning "Default password: vibecode"
    echo ""

    ssh -o "StrictHostKeyChecking=no" -o "UserKnownHostsFile=/dev/null" -p "$SSH_PORT" root@localhost
}

cmd_logs() {
    print_header "VM Console Logs"

    if ! is_vm_running; then
        print_error "VM is not running"
        exit 1
    fi

    local log_file="$HOME/Library/Logs/VibeCode/console.log"

    if [ -f "$log_file" ]; then
        print_info "Showing logs from: $log_file"
        echo ""
        tail -f "$log_file"
    else
        print_warning "Log file not found: $log_file"
        print_info "Logs may not be available for this app version"
    fi
}

cmd_docker() {
    print_header "Docker Status"

    if ! is_vm_running; then
        print_error "VM is not running"
        print_info "Start with: vibecode start"
        exit 1
    fi

    # Set DOCKER_HOST if not already set
    if [ -z "$DOCKER_HOST" ]; then
        export DOCKER_HOST="tcp://localhost:$DOCKER_PORT"
        print_info "Set DOCKER_HOST=$DOCKER_HOST"
        echo ""
    fi

    if ! check_port localhost "$DOCKER_PORT"; then
        print_error "Docker not accessible on localhost:$DOCKER_PORT"
        print_info "VM may still be booting or Docker may not be enabled"
        exit 1
    fi

    print_success "Docker daemon accessible"
    echo ""

    print_info "Docker version:"
    docker version 2>/dev/null || print_error "Failed to get Docker version"

    echo ""
    print_info "Docker info:"
    docker info 2>/dev/null || print_error "Failed to get Docker info"

    echo ""
    print_success "To use Docker, run:"
    print_color "$GREEN" "  export DOCKER_HOST=tcp://localhost:$DOCKER_PORT"
}

cmd_ip() {
    print_header "VM IP Address"

    if ! is_vm_running; then
        print_error "VM is not running"
        exit 1
    fi

    local vm_ip
    vm_ip=$(get_vm_ip)

    if [ -n "$vm_ip" ]; then
        print_success "VM IP: $vm_ip"
        echo ""
        print_info "You can SSH to: ssh root@$vm_ip"
        print_warning "Services are also available on localhost (see: vibecode services)"
    else
        print_error "VM IP not found in ARP table"
        print_info "VM may still be booting. Try again in a moment."
    fi
}

cmd_deploy() {
    # Default values
    local namespace="default"
    local environment=""
    local config_file=""
    local dry_run=false
    local force=false
    local image=""
    local replicas=""
    local show_help=false
    local cleanup=false
    local cluster_name="vibecode-local"
    local one_click_mode=false

    # Parse arguments
    while [ $# -gt 0 ]; do
        case "$1" in
            --help|-h)
                show_help=true
                shift
                ;;
            --cleanup)
                cleanup=true
                one_click_mode=true
                shift
                ;;
            --cluster-name)
                cluster_name="$2"
                one_click_mode=true
                shift 2
                ;;
            --namespace|-n)
                namespace="$2"
                shift 2
                ;;
            --env|-e)
                environment="$2"
                shift 2
                ;;
            --config|-c)
                config_file="$2"
                shift 2
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --force|-f)
                force=true
                shift
                ;;
            --image|-i)
                image="$2"
                shift 2
                ;;
            --replicas|-r)
                replicas="$2"
                shift 2
                ;;
            *)
                print_error "Unknown option: $1"
                echo ""
                show_help=true
                break
                ;;
        esac
    done

    # Show help if requested or on error
    if [ "$show_help" = true ]; then
        cat << 'EOF'
┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
┃  Deploy to Kubernetes                                     ┃
┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

USAGE:
    vibecode deploy [OPTIONS]

ONE-CLICK DEPLOYMENT (KIND cluster with all services):
    vibecode deploy                           # Deploy everything to local KIND cluster
    vibecode deploy --dry-run                 # Preview what will be deployed
    vibecode deploy --cluster-name my-cluster # Use custom cluster name
    vibecode deploy --cleanup                 # Delete KIND cluster and clean up

ADVANCED DEPLOYMENT (kubectl wrapper):
    -c, --config FILE       Path to Kubernetes config file (YAML/JSON)
    -i, --image IMAGE       Docker image to deploy
    -n, --namespace NAME    Kubernetes namespace (default: default)
    -e, --env ENV           Environment: dev, staging, prod
    -r, --replicas NUM      Number of replicas (default: 1)
    --dry-run               Preview deployment without applying
    -f, --force             Force deployment without confirmation

GENERAL OPTIONS:
    -h, --help              Show this help message

EXAMPLES:
    # One-click deployment (creates KIND cluster + all services)
    vibecode deploy
    vibecode deploy --dry-run
    vibecode deploy --cleanup

    # Advanced deployment (kubectl wrapper)
    vibecode deploy --config ./k8s/deployment.yaml
    vibecode deploy --env prod --namespace myapp
    vibecode deploy --image myapp:v1.0.0 --replicas 3
    vibecode deploy --config ./k8s/app.yaml --dry-run

PREREQUISITES:
    One-click mode: Docker, kubectl, KIND
    Advanced mode:  kubectl, valid kubeconfig

NOTES:
    When called without --config or --image, runs one-click deployment.
    This creates a local KIND cluster with all VibeCode services.

    Use --cleanup to delete the KIND cluster when done.

EOF
        return 0
    fi

    # Handle cleanup mode
    if [ "$cleanup" = true ]; then
        print_header "Clean Up KIND Cluster"

        # Check if KIND is installed
        if ! command -v kind &> /dev/null; then
            print_error "KIND not found. Please install KIND."
            print_info "Install: brew install kind"
            exit 1
        fi

        # Check if cluster exists
        if kind get clusters 2>/dev/null | grep -q "^${cluster_name}$"; then
            print_warning "Deleting KIND cluster: $cluster_name"
            echo ""

            if [ "$force" = false ]; then
                echo -n "Are you sure? [y/N] "
                read -r response
                case "$response" in
                    [yY][eE][sS]|[yY])
                        ;;
                    *)
                        print_info "Cleanup cancelled"
                        exit 0
                        ;;
                esac
            fi

            echo ""
            print_info "Deleting cluster..."
            if kind delete cluster --name "$cluster_name"; then
                print_success "Cluster deleted successfully"
            else
                print_error "Failed to delete cluster"
                exit 1
            fi
        else
            print_info "Cluster '$cluster_name' does not exist"
        fi
        return 0
    fi

    # Detect one-click mode: no --config or --image specified
    if [ -z "$config_file" ] && [ -z "$image" ]; then
        one_click_mode=true
    fi

    # Handle one-click deployment mode
    if [ "$one_click_mode" = true ]; then
        print_header "One-Click Kubernetes Deployment"

        # Find the deployment script
        local deploy_script="./scripts/vibecode-k8s-deploy.sh"
        if [ ! -f "$deploy_script" ]; then
            print_error "Deployment script not found: $deploy_script"
            print_info "Make sure you're running this from the project root"
            exit 1
        fi

        # Build arguments for deployment script
        local deploy_args=()
        if [ "$dry_run" = true ]; then
            deploy_args+=("--dry-run")
        fi
        if [ "$cluster_name" != "vibecode-local" ]; then
            deploy_args+=("--cluster-name" "$cluster_name")
        fi

        # Run the deployment script
        print_info "Running one-click deployment..."
        echo ""
        exec bash "$deploy_script" "${deploy_args[@]}"
    fi

    # Advanced mode: kubectl wrapper
    print_header "Deploy to Kubernetes"

    # Check if VM is running (not needed for kubectl wrapper, but kept for compatibility)
    if ! is_vm_running; then
        print_warning "VM is not running (this may be OK if using remote cluster)"
    fi

    # Check kubectl is available
    if ! command -v kubectl &> /dev/null; then
        print_error "kubectl not found. Please install kubectl."
        print_info "Install: brew install kubectl"
        exit 1
    fi

    print_success "kubectl found: $(kubectl version --client --short 2>/dev/null | head -1)"
    echo ""

    # Validate environment if provided
    if [ -n "$environment" ]; then
        case "$environment" in
            dev|development)
                environment="dev"
                print_info "Environment: Development"
                ;;
            staging|stage)
                environment="staging"
                print_info "Environment: Staging"
                ;;
            prod|production)
                environment="prod"
                print_info "Environment: Production"
                ;;
            *)
                print_error "Invalid environment: $environment"
                print_info "Valid options: dev, staging, prod"
                exit 1
                ;;
        esac
    fi

    # Display deployment parameters
    print_info "Namespace: $namespace"
    if [ -n "$image" ]; then
        print_info "Image: $image"
    fi
    if [ -n "$replicas" ]; then
        print_info "Replicas: $replicas"
    fi
    if [ -n "$config_file" ]; then
        print_info "Config file: $config_file"
    fi
    if [ "$dry_run" = true ]; then
        print_warning "Dry-run mode enabled (no changes will be applied)"
    fi
    echo ""

    # Validate config file if provided
    if [ -n "$config_file" ]; then
        if [ ! -f "$config_file" ]; then
            print_error "Config file not found: $config_file"
            exit 1
        fi
        print_success "Config file found: $config_file"
    fi

    # Check kubectl cluster connection
    print_info "Checking cluster connection..."
    if ! kubectl cluster-info &> /dev/null; then
        print_error "Cannot connect to Kubernetes cluster"
        print_info "Check your kubeconfig: kubectl config view"
        exit 1
    fi
    print_success "Connected to cluster"
    echo ""

    # Confirmation prompt (unless --force)
    if [ "$force" = false ] && [ "$dry_run" = false ]; then
        print_warning "Ready to deploy to namespace '$namespace'"
        echo -n "Continue? [y/N] "
        read -r response
        case "$response" in
            [yY][eE][sS]|[yY])
                print_info "Proceeding with deployment..."
                ;;
            *)
                print_info "Deployment cancelled"
                exit 0
                ;;
        esac
        echo ""
    fi

    # Perform deployment
    local kubectl_args=()
    if [ "$dry_run" = true ]; then
        kubectl_args+=("--dry-run=client")
    fi

    if [ -n "$config_file" ]; then
        # Deploy from config file
        print_header "Applying Configuration"
        print_info "Applying $config_file to namespace $namespace..."

        if kubectl apply -f "$config_file" -n "$namespace" "${kubectl_args[@]}"; then
            echo ""
            if [ "$dry_run" = true ]; then
                print_success "Dry-run successful (no changes applied)"
            else
                print_success "Configuration applied successfully"
            fi
        else
            echo ""
            print_error "Failed to apply configuration"
            exit 1
        fi
    elif [ -n "$image" ]; then
        # Create/update deployment from image
        print_header "Deploying Image"
        local deployment_name="app"

        # Extract deployment name from image if possible
        if [[ "$image" =~ ([^/:]+)(:[^:]+)?$ ]]; then
            deployment_name="${BASH_REMATCH[1]}"
        fi

        print_info "Creating deployment '$deployment_name' with image $image..."

        local deploy_cmd="kubectl create deployment $deployment_name --image=$image -n $namespace"
        if [ -n "$replicas" ]; then
            deploy_cmd="$deploy_cmd --replicas=$replicas"
        fi
        if [ "$dry_run" = true ]; then
            deploy_cmd="$deploy_cmd --dry-run=client -o yaml"
        fi

        if eval "$deploy_cmd"; then
            echo ""
            if [ "$dry_run" = true ]; then
                print_success "Dry-run successful (no changes applied)"
            else
                print_success "Deployment created successfully"
                print_info "Check status: kubectl get deployment $deployment_name -n $namespace"
            fi
        else
            # Try to update if creation failed
            if [ "$dry_run" = false ]; then
                print_warning "Deployment may already exist, trying to update..."
                if kubectl set image "deployment/$deployment_name" "$deployment_name=$image" -n "$namespace"; then
                    echo ""
                    print_success "Deployment updated successfully"
                else
                    echo ""
                    print_error "Failed to create or update deployment"
                    exit 1
                fi
            else
                echo ""
                print_error "Dry-run failed"
                exit 1
            fi
        fi
    else
        # No config file or image specified
        print_error "No deployment target specified"
        print_info "Use --config to deploy from a file, or --image to deploy an image"
        print_info "Run 'vibecode deploy --help' for more information"
        exit 1
    fi

    # Show deployment status
    if [ "$dry_run" = false ]; then
        echo ""
        print_header "Deployment Status"
        print_info "Fetching resources in namespace '$namespace'..."
        echo ""
        kubectl get all -n "$namespace" 2>/dev/null || print_warning "No resources found"
    fi

    echo ""
    print_success "Deployment complete!"
    if [ "$dry_run" = false ]; then
        print_info "Monitor with: kubectl get pods -n $namespace"
        print_info "View logs: kubectl logs -f <pod-name> -n $namespace"
    fi
}

# ============================================================================
# MAIN
# ============================================================================

main() {
    if [ $# -eq 0 ]; then
        cmd_help
        exit 0
    fi

    local command=$1
    shift

    case "$command" in
        build)
            cmd_build "$@"
            ;;
        start)
            cmd_start "$@"
            ;;
        stop)
            cmd_stop "$@"
            ;;
        restart)
            cmd_restart "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        check)
            cmd_check "$@"
            ;;
        services|svc)
            cmd_services "$@"
            ;;
        ssh)
            cmd_ssh "$@"
            ;;
        logs)
            cmd_logs "$@"
            ;;
        docker)
            cmd_docker "$@"
            ;;
        deploy)
            cmd_deploy "$@"
            ;;
        ip)
            cmd_ip "$@"
            ;;
        version|--version|-v)
            cmd_version "$@"
            ;;
        help|--help|-h)
            cmd_help "$@"
            ;;
        *)
            print_error "Unknown command: $command"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

# Run main
main "$@"
