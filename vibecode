#!/usr/bin/env bash
#
# vibecode - CLI tool for VibeCode Unified Services
#
# Version: 3.2.0
# Author: VibeCode Team
# Description: Manage VibeCode VM, build app, and check services
#

set -e

# ============================================================================
# CONSTANTS & CONFIGURATION
# ============================================================================

VERSION="3.2.0"
APP_NAME="UnifiedServicesVibeCode"
PROJECT_ROOT="/Users/ryan.maclean/vibecode-webgui"
SWIFT_ROOT="${PROJECT_ROOT}/azure/SwiftUI-Apps"
APP_PATH="${SWIFT_ROOT}/Apps/UnifiedServicesVibeCodeApp.app"
BUILD_SCRIPT="${SWIFT_ROOT}/build-unified-menubar.sh"

# Service ports
SSH_PORT=2222
VALKEY_PORT=6379
POSTGRESQL_PORT=5432
OPENVSCODE_PORT=8080
DOCKER_PORT=2375

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Icons
CHECK_MARK="✓"
CROSS_MARK="✗"
ARROW="→"
BULLET="•"

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

# Print colored output
print_color() {
    local color=$1
    shift
    echo -e "${color}$*${NC}"
}

print_success() {
    print_color "$GREEN" "$CHECK_MARK $*"
}

print_error() {
    print_color "$RED" "$CROSS_MARK $*"
}

print_warning() {
    print_color "$YELLOW" "⚠  $*"
}

print_info() {
    print_color "$CYAN" "$ARROW $*"
}

print_header() {
    echo ""
    print_color "$BOLD$BLUE" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    print_color "$BOLD$BLUE" "  $*"
    print_color "$BOLD$BLUE" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
}

# Check if VM is running
is_vm_running() {
    pgrep -f "$APP_NAME" > /dev/null 2>&1
}

# Get VM PID
get_vm_pid() {
    pgrep -f "$APP_NAME" 2>/dev/null || echo ""
}

# Check if a port is open
check_port() {
    local host=$1
    local port=$2
    local timeout=${3:-1}
    nc -z -w "$timeout" "$host" "$port" > /dev/null 2>&1
}

# Check HTTP endpoint
check_http() {
    local url=$1
    local timeout=${2:-2}
    curl -s -f --connect-timeout "$timeout" "$url" > /dev/null 2>&1
}

# Check service on a port
check_service() {
    local name=$1
    local host=$2
    local port=$3
    local protocol=${4:-tcp}

    if [ "$protocol" = "http" ]; then
        if check_http "http://$host:$port"; then
            print_success "$name: http://$host:$port"
            return 0
        fi
    else
        if check_port "$host" "$port"; then
            print_success "$name: $host:$port"
            return 0
        fi
    fi

    print_error "$name: Not accessible on $host:$port"
    return 1
}

# Get VM IP address from ARP table
get_vm_ip() {
    arp -an | grep -i "192.168.64" | grep -v ".1\|.255" | head -1 | awk '{print $2}' | tr -d '()'
}

# Detect IDE type (code-server vs OpenVSCode Server)
detect_ide_type() {
    if ! check_port localhost "$OPENVSCODE_PORT"; then
        echo "unknown (port not accessible)"
        return
    fi

    local response
    response=$(curl -s --connect-timeout 2 "http://localhost:$OPENVSCODE_PORT" 2>/dev/null || echo "")

    if echo "$response" | grep -q "openvscode-server"; then
        echo "OpenVSCode Server"
    elif echo "$response" | grep -q "code-server"; then
        echo "code-server"
    elif [ -n "$response" ]; then
        echo "VS Code (type unknown)"
    else
        echo "unknown"
    fi
}

# ============================================================================
# COMMAND FUNCTIONS
# ============================================================================

cmd_version() {
    print_header "VibeCode CLI v$VERSION"
    echo "App:     $APP_NAME"
    echo "Project: $PROJECT_ROOT"
    echo "Path:    $APP_PATH"
    echo ""

    if [ -f "$APP_PATH/Contents/Info.plist" ]; then
        local app_version
        app_version=$(/usr/libexec/PlistBuddy -c "Print CFBundleShortVersionString" "$APP_PATH/Contents/Info.plist" 2>/dev/null || echo "unknown")
        echo "App Version: $app_version"
    fi
}

cmd_help() {
    cat << 'EOF'
