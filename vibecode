cmd_build() {
    print_header "Building VibeCode Menubar App"

    # Check prerequisites
    if ! command -v swift &> /dev/null; then
        print_error "Swift not found. Please install Xcode."
        exit 1
    fi

    if ! command -v swiftc &> /dev/null; then
        print_error "swiftc not found. Please install Xcode Command Line Tools."
        exit 1
    fi

    print_info "Swift version: $(swift --version | head -1)"
    echo ""

    # Check build script exists
    if [ ! -f "$BUILD_SCRIPT" ]; then
        print_error "Build script not found: $BUILD_SCRIPT"
        exit 1
    fi

    # Run build script
    print_info "Running build script..."
    cd "$SWIFT_ROOT"

    if bash "$BUILD_SCRIPT"; then
        echo ""
        print_success "Build complete!"
        print_info "App location: $APP_PATH"
        echo ""
        print_info "To start: vibecode start"
    else
        echo ""
        print_error "Build failed!"
        exit 1
    fi
}

cmd_start() {
    print_header "Starting VibeCode"

    if is_vm_running; then
        print_warning "VibeCode is already running (PID: $(get_vm_pid))"
        echo ""
        cmd_status
        return
    fi

    if [ ! -d "$APP_PATH" ]; then
        print_error "App not found: $APP_PATH"
        print_info "Run 'vibecode build' first"
        exit 1
    fi

    print_info "Starting menubar app..."
    open "$APP_PATH"

    echo ""
    print_info "Waiting for VM to boot..."

    # Wait for VM process to start
    local max_wait=10
    local waited=0
    while [ $waited -lt $max_wait ]; do
        if is_vm_running; then
            print_success "VM process started (PID: $(get_vm_pid))"
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done

    if ! is_vm_running; then
        print_error "VM failed to start"
        exit 1
    fi

    echo ""
    print_info "VM is booting... This may take 1-2 minutes."
    print_info "Check status with: vibecode status"
    print_info "Check services with: vibecode check"
}

cmd_stop() {
    print_header "Stopping VibeCode"

    if ! is_vm_running; then
        print_warning "VibeCode is not running"
        return
    fi

    local pid
    pid=$(get_vm_pid)
    print_info "Stopping VibeCode (PID: $pid)..."

    pkill -f "$APP_NAME" || true

    # Wait for process to stop
    sleep 2

    if is_vm_running; then
        print_error "Failed to stop VibeCode"
        exit 1
    else
        print_success "VibeCode stopped"
    fi
}

cmd_restart() {
    print_header "Restarting VibeCode"
    cmd_stop
    sleep 2
    cmd_start
}

cmd_status() {
    print_header "VibeCode Status"

    # VM Status
    if is_vm_running; then
        local pid
        pid=$(get_vm_pid)
        print_success "VM Status: Running (PID: $pid)"

        # Get VM IP
        local vm_ip
        vm_ip=$(get_vm_ip)
        if [ -n "$vm_ip" ]; then
            print_info "VM IP: $vm_ip"
        else
            print_warning "VM IP: Not yet assigned (may still be booting)"
        fi
    else
        print_error "VM Status: Stopped"
        echo ""
        print_info "Start with: vibecode start"
        return
    fi

    echo ""
    print_header "Services Status"

    cmd_check

    echo ""
    print_header "Resource Usage"

    local pid
    pid=$(get_vm_pid)
    if [ -n "$pid" ]; then
        ps -p "$pid" -o rss=,vsz=,%cpu=,%mem= | awk '{
            printf "  RSS:  %d MB\n", $1/1024
            printf "  VSZ:  %d MB\n", $2/1024
            printf "  CPU:  %.1f%%\n", $3
            printf "  MEM:  %.1f%%\n", $4
        }'
    fi
}

cmd_check() {
    if ! is_vm_running; then
        print_error "VM is not running"
        print_info "Start with: vibecode start"
        exit 1
    fi

    print_info "Checking services..."
    echo ""

    local success_count=0
    local total_count=5

    # Check each service
    if check_service "SSH" "localhost" "$SSH_PORT"; then
        success_count=$((success_count + 1))
    fi

    if check_service "Valkey" "localhost" "$VALKEY_PORT"; then
        success_count=$((success_count + 1))
    fi

    if check_service "PostgreSQL" "localhost" "$POSTGRESQL_PORT"; then
        success_count=$((success_count + 1))
    fi

    if check_service "OpenVSCode" "localhost" "$OPENVSCODE_PORT" "http"; then
        success_count=$((success_count + 1))
    fi

    if check_service "Docker" "localhost" "$DOCKER_PORT"; then
        success_count=$((success_count + 1))
    fi

    echo ""

    # IDE Detection
    if check_port localhost "$OPENVSCODE_PORT"; then
        local ide_type
        ide_type=$(detect_ide_type)
        print_info "IDE Type: $ide_type"
    fi

    echo ""

    # Summary
    if [ $success_count -eq $total_count ]; then
        print_success "All services operational ($success_count/$total_count)"
    elif [ $success_count -gt 0 ]; then
        print_warning "Some services available ($success_count/$total_count)"
        print_info "VM may still be booting. Wait 30s and try again."
    else
        print_error "No services available (0/$total_count)"
        print_info "VM may still be booting. Check logs: vibecode logs"
    fi
}

cmd_services() {
    print_header "VibeCode Services"

    cat << EOF
SERVICE       PORT   URL/CONNECTION
─────────────────────────────────────────────────────────────
SSH           2222   ssh root@localhost -p 2222
Valkey        6379   valkey-cli -h localhost -p 6379
PostgreSQL    5432   psql -h localhost -p 5432 -U postgres
OpenVSCode    8080   http://localhost:8080
Docker        2375   export DOCKER_HOST=tcp://localhost:2375

EOF

    if is_vm_running; then
        echo ""
        print_info "Quick connectivity check:"
        echo ""
        cmd_check
    else
        print_warning "VM is not running. Start with: vibecode start"
    fi
}

cmd_ssh() {
    print_header "SSH to VibeCode VM"

    if ! is_vm_running; then
        print_error "VM is not running"
        print_info "Start with: vibecode start"
        exit 1
    fi

    if ! check_port localhost "$SSH_PORT"; then
        print_error "SSH not accessible on localhost:$SSH_PORT"
        print_info "VM may still be booting. Try: vibecode status"
        exit 1
    fi

    print_info "Connecting to root@localhost:$SSH_PORT..."
    print_warning "Default password: vibecode"
    echo ""

    ssh -o "StrictHostKeyChecking=no" -o "UserKnownHostsFile=/dev/null" -p "$SSH_PORT" root@localhost
}

cmd_logs() {
    print_header "VM Console Logs"

    if ! is_vm_running; then
        print_error "VM is not running"
        exit 1
    fi

    local log_file="$HOME/Library/Logs/VibeCode/console.log"

    if [ -f "$log_file" ]; then
        print_info "Showing logs from: $log_file"
        echo ""
        tail -f "$log_file"
    else
        print_warning "Log file not found: $log_file"
        print_info "Logs may not be available for this app version"
    fi
}

cmd_docker() {
    print_header "Docker Status"

    if ! is_vm_running; then
        print_error "VM is not running"
        print_info "Start with: vibecode start"
        exit 1
    fi

    # Set DOCKER_HOST if not already set
    if [ -z "$DOCKER_HOST" ]; then
        export DOCKER_HOST="tcp://localhost:$DOCKER_PORT"
        print_info "Set DOCKER_HOST=$DOCKER_HOST"
        echo ""
    fi

    if ! check_port localhost "$DOCKER_PORT"; then
        print_error "Docker not accessible on localhost:$DOCKER_PORT"
        print_info "VM may still be booting or Docker may not be enabled"
        exit 1
    fi

    print_success "Docker daemon accessible"
    echo ""

    print_info "Docker version:"
    docker version 2>/dev/null || print_error "Failed to get Docker version"

    echo ""
    print_info "Docker info:"
    docker info 2>/dev/null || print_error "Failed to get Docker info"

    echo ""
    print_success "To use Docker, run:"
    print_color "$GREEN" "  export DOCKER_HOST=tcp://localhost:$DOCKER_PORT"
}

cmd_ip() {
    print_header "VM IP Address"

    if ! is_vm_running; then
        print_error "VM is not running"
        exit 1
    fi

    local vm_ip
    vm_ip=$(get_vm_ip)

    if [ -n "$vm_ip" ]; then
        print_success "VM IP: $vm_ip"
        echo ""
        print_info "You can SSH to: ssh root@$vm_ip"
        print_warning "Services are also available on localhost (see: vibecode services)"
    else
        print_error "VM IP not found in ARP table"
        print_info "VM may still be booting. Try again in a moment."
    fi
}

cmd_plugin() {
    local subcommand=${1:-}

    if [ -z "$subcommand" ] || [ "$subcommand" = "--help" ] || [ "$subcommand" = "-h" ] || [ "$subcommand" = "help" ]; then
        print_header "Plugin Management"
        cat << 'EOF'
USAGE:
    vibecode plugin <subcommand> [options]

SUBCOMMANDS:
    list                      List all installed plugins
    install <url>             Install a plugin from URL or path
    uninstall <name>          Uninstall a plugin by name
    help                      Show this help message

EXAMPLES:
    vibecode plugin list
    vibecode plugin install ./plugins/examples/hello-world
    vibecode plugin install https://example.com/plugin.zip
    vibecode plugin uninstall hello-world

EOF
        return 0
    fi

    shift

    case "$subcommand" in
        list)
            cmd_plugin_list "$@"
            ;;
        install)
            cmd_plugin_install "$@"
            ;;
        uninstall)
            cmd_plugin_uninstall "$@"
            ;;
        *)
            print_error "Unknown plugin subcommand: $subcommand"
            echo ""
            cmd_plugin help
            exit 1
            ;;
    esac
}

cmd_plugin_list() {
    print_header "Installed Plugins"

    # Check if curl is available
    if ! command -v curl &> /dev/null; then
        print_error "curl not found. Please install curl."
        exit 1
    fi

    # Call the API endpoint
    local response
    local status

    print_info "Fetching plugin list from API..."
    echo ""

    response=$(curl -s -w "\n%{http_code}" "http://localhost:3000/api/plugins" 2>/dev/null)
    status=$(echo "$response" | tail -n 1)
    local body=$(echo "$response" | head -n -1)

    if [ "$status" != "200" ]; then
        print_error "Failed to fetch plugins (HTTP $status)"
        print_info "Make sure the development server is running: npm run dev"
        exit 1
    fi

    # Check if jq is available for pretty printing
    if command -v jq &> /dev/null; then
        local plugin_count
        plugin_count=$(echo "$body" | jq '.plugins | length' 2>/dev/null || echo "0")

        if [ "$plugin_count" = "0" ]; then
            print_warning "No plugins installed"
            echo ""
            print_info "Install a plugin with: vibecode plugin install <url>"
        else
            print_success "Found $plugin_count plugin(s):"
            echo ""
            echo "$body" | jq -r '.plugins[] | "  \(.name) (\(.version)) - \(.status)\n    \(.description)\n    Author: \(.author // "Unknown")\n    Type: \(.type)\n"'
        fi
    else
        # Fallback to plain output if jq not available
        echo "$body"
        echo ""
        print_info "Install jq for prettier output: brew install jq"
    fi
}

cmd_plugin_install() {
    local source=$1

    if [ -z "$source" ]; then
        print_error "Missing plugin source URL or path"
        echo ""
        print_info "Usage: vibecode plugin install <url-or-path>"
        print_info "Example: vibecode plugin install ./plugins/examples/hello-world"
        exit 1
    fi

    print_header "Installing Plugin"

    # Check if curl is available
    if ! command -v curl &> /dev/null; then
        print_error "curl not found. Please install curl."
        exit 1
    fi

    print_info "Installing from: $source"
    echo ""

    # Determine if source is a file or URL
    if [ -f "$source/plugin.json" ] || [ -d "$source" ]; then
        # Local directory - create a temporary zip file
        print_info "Creating plugin package from local directory..."

        local temp_zip="/tmp/vibecode-plugin-$$.zip"

        if command -v zip &> /dev/null; then
            cd "$source" && zip -r "$temp_zip" . > /dev/null
            cd - > /dev/null

            print_info "Uploading plugin package..."

            local response
            local status
            response=$(curl -s -w "\n%{http_code}" -X POST \
                -F "file=@$temp_zip" \
                -F "autoEnable=true" \
                "http://localhost:3000/api/plugins/install" 2>/dev/null)
            status=$(echo "$response" | tail -n 1)
            local body=$(echo "$response" | head -n -1)

            rm -f "$temp_zip"

            if [ "$status" = "200" ]; then
                print_success "Plugin installed successfully!"
                if command -v jq &> /dev/null; then
                    echo ""
                    echo "$body" | jq -r '"Plugin ID: \(.pluginId)\nName: \(.plugin.name)\nVersion: \(.plugin.version)"'
                fi
            else
                print_error "Failed to install plugin (HTTP $status)"
                if command -v jq &> /dev/null && echo "$body" | jq -e .error > /dev/null 2>&1; then
                    echo ""
                    echo "$body" | jq -r '.error'
                fi
                exit 1
            fi
        else
            print_error "zip command not found. Please install zip utility."
            exit 1
        fi
    else
        # URL - send URL to API
        print_info "Installing from URL..."

        local response
        local status
        response=$(curl -s -w "\n%{http_code}" -X POST \
            -H "Content-Type: application/json" \
            -d "{\"source\":\"$source\",\"autoEnable\":true}" \
            "http://localhost:3000/api/plugins/install" 2>/dev/null)
        status=$(echo "$response" | tail -n 1)
        local body=$(echo "$response" | head -n -1)

        if [ "$status" = "200" ]; then
            print_success "Plugin installed successfully!"
            if command -v jq &> /dev/null; then
                echo ""
                echo "$body" | jq -r '"Plugin ID: \(.pluginId)\nName: \(.plugin.name)\nVersion: \(.plugin.version)"'
            fi
        else
            print_error "Failed to install plugin (HTTP $status)"
            if command -v jq &> /dev/null && echo "$body" | jq -e .error > /dev/null 2>&1; then
                echo ""
                echo "$body" | jq -r '.error'
            fi
            exit 1
        fi
    fi
}

cmd_plugin_uninstall() {
    local plugin_name=$1

    if [ -z "$plugin_name" ]; then
        print_error "Missing plugin name"
        echo ""
        print_info "Usage: vibecode plugin uninstall <name>"
        print_info "Example: vibecode plugin uninstall hello-world"
        exit 1
    fi

    print_header "Uninstalling Plugin"

    # Check if curl is available
    if ! command -v curl &> /dev/null; then
        print_error "curl not found. Please install curl."
        exit 1
    fi

    print_info "Uninstalling: $plugin_name"
    echo ""

    local response
    local status
    response=$(curl -s -w "\n%{http_code}" -X DELETE \
        "http://localhost:3000/api/plugins/$plugin_name" 2>/dev/null)
    status=$(echo "$response" | tail -n 1)
    local body=$(echo "$response" | head -n -1)

    if [ "$status" = "200" ]; then
        print_success "Plugin uninstalled successfully!"
    elif [ "$status" = "404" ]; then
        print_error "Plugin not found: $plugin_name"
        print_info "Run 'vibecode plugin list' to see installed plugins"
        exit 1
    else
        print_error "Failed to uninstall plugin (HTTP $status)"
        if command -v jq &> /dev/null && echo "$body" | jq -e .error > /dev/null 2>&1; then
            echo ""
            echo "$body" | jq -r '.error'
        fi
        exit 1
    fi
}

# ============================================================================
# MAIN
# ============================================================================

main() {
    if [ $# -eq 0 ]; then
        cmd_help
        exit 0
    fi

    local command=$1
    shift

    case "$command" in
        build)
            cmd_build "$@"
            ;;
        start)
            cmd_start "$@"
            ;;
        stop)
            cmd_stop "$@"
            ;;
        restart)
            cmd_restart "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        check)
            cmd_check "$@"
            ;;
        services|svc)
            cmd_services "$@"
            ;;
        ssh)
            cmd_ssh "$@"
            ;;
        logs)
            cmd_logs "$@"
            ;;
        docker)
            cmd_docker "$@"
            ;;
        ip)
            cmd_ip "$@"
            ;;
        plugin)
            cmd_plugin "$@"
            ;;
        version|--version|-v)
            cmd_version "$@"
            ;;
        help|--help|-h)
            cmd_help "$@"
            ;;
        *)
            print_error "Unknown command: $command"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

# Run main
main "$@"
