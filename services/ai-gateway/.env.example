# Environment Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60000
# Optional: Configure headers expected by OpenRouter account
OPENROUTER_REFERRER=https://vibecode.dev
OPENROUTER_TITLE=VibeCode AI Gateway

# Provider Enablement (comma-separated: azure,openai,hf,openrouter,ollama)
PROVIDERS_ENABLED=openrouter

# Azure OpenAI (optional)
# Example: AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
#          AZURE_OPENAI_API_KEY=...
#          AZURE_OPENAI_DEPLOYMENTS={"gpt4o":"gpt-4o","gpt4omini":"gpt-4o-mini"}
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENTS=

# OpenAI (optional)
OPENAI_API_KEY=

# Hugging Face Inference API (optional)
HUGGINGFACE_API_TOKEN=

# Ollama (optional, local/dev)
# Example: OLLAMA_HOST=http://ollama:11434
OLLAMA_HOST=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Optional: Disable Redis for local smoke tests (service will start without Redis)
DISABLE_REDIS=false
# Alternatively, allow startup to continue if Redis connection fails
ALLOW_START_WITHOUT_REDIS=false

# Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRATION=24h
API_KEYS=vbai_dev_key_1,vbai_dev_key_2

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8090,https://*.vibecode.dev

# Caching
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Monitoring
ENABLE_METRICS=true
ENABLE_REQUEST_LOGGING=true

# Model Configuration
DEFAULT_MODEL=anthropic/claude-3-sonnet-20240229
FALLBACK_MODELS=anthropic/claude-3-haiku-20240307,openai/gpt-3.5-turbo
COST_WARNING_THRESHOLD=10.0
COST_LIMIT_THRESHOLD=100.0

# Logging
LOG_LEVEL=info

# Datadog (optional for metrics submission)
# Get an API key from Datadog and set the site (us1: us1.datadoghq.com, eu: datadoghq.eu, etc.)
# Supports DATADOG_API_KEY or DD_API_KEY
DATADOG_API_KEY=
DD_API_KEY=
DATADOG_SITE=us1.datadoghq.com
DD_ENV=development
DD_SERVICE=vibecode-ai-gateway
