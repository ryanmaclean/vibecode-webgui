# Enable to send metrics via DogStatsD instead of HTTP
DD_USE_DOGSTATSD=false
DD_DOGSTATSD_HOST=127.0.0.1
DD_DOGSTATSD_PORT=8125

# Optional: Debug high-cardinality sampling (use sparingly)
# When true, includes full model tag in a small sample of metrics
DD_DEBUG_HIGH_CARDINALITY=false
DD_DEBUG_SAMPLE_RATE=0.001

# OpenTelemetry Tracing (optional)
# Enable to export traces via OTLP HTTP exporter
# If sending to a local OTEL collector/agent, use http://localhost:4318
# For Datadog SaaS, set endpoint to https://otel-intake.<site> (e.g. datadoghq.com, us3.datadoghq.com)
# and include your API key via OTEL_EXPORTER_OTLP_HEADERS=DD-API-KEY=<key>
