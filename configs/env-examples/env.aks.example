# Azure AKS Deployment Environment Configuration
# Copy this file to .env.aks and fill in your actual values

# Azure Configuration (REQUIRED)
export TF_VAR_resource_group_name="vibecode-rg"
export TF_VAR_location="East US 2"

# Datadog Configuration (REQUIRED)
export TF_VAR_datadog_api_key="your-datadog-api-key-here"
export TF_VAR_datadog_app_key="your-datadog-app-key-here"
export TF_VAR_datadog_site="datadoghq.com"
export TF_VAR_llm_observability_enabled="true"
export TF_VAR_llm_observability_agentless="true"
export TF_VAR_llm_observability_ml_app="vibecode-ai"

# Database Configuration (REQUIRED)
export TF_VAR_postgresql_admin_password="your-secure-password-here"

# Application Configuration (REQUIRED)
export TF_VAR_nextauth_secret="your-nextauth-secret-here"

# AI Service Configuration (OPTIONAL)
export TF_VAR_openrouter_api_key=""
export TF_VAR_azure_openai_api_key=""
export TF_VAR_azure_openai_endpoint=""

# For local AI project generation testing
export OPENAI_API_KEY="your-openai-api-key-here"

# Container Registry (AUTO-GENERATED)
export TF_VAR_acr_sku="Premium"

# Ingress Configuration (OPTIONAL - will use default)
export TF_VAR_ingress_hostname="vibecode.eastus2.cloudapp.azure.com"

# Project Configuration (OPTIONAL - will use defaults)
export TF_VAR_project_name="vibecode"
export TF_VAR_environment="dev"

# Application Image (OPTIONAL - will use latest)
export TF_VAR_app_image_tag="latest"

# Azure Service Principal (for CI/CD - OPTIONAL)
export ARM_CLIENT_ID=""
export ARM_CLIENT_SECRET=""
export ARM_SUBSCRIPTION_ID=""
export ARM_TENANT_ID=""

# GitHub Actions Secrets (for CI/CD - OPTIONAL)
# Set these as GitHub repository secrets:
# - AZURE_CREDENTIALS (JSON object with clientId, clientSecret, subscriptionId, tenantId)
# - AZURE_RESOURCE_GROUP
# - AKS_CLUSTER_NAME
# - SLACK_WEBHOOK_URL (for deployment notifications)

# Instructions:
# 1. Copy this file: cp env.aks.example .env.aks
# 2. Fill in your actual values (especially REQUIRED ones)
# 3. Run validation: ./scripts/validate-deployment-readiness.sh
# 4. Deploy to Azure: ./scripts/tofu-aks-deploy.sh
