// swift-tools-version:5.5
// Package.swift template for future migration to opentelemetry-swift SDK
//
// USAGE:
//   1. Rename this file to Package.swift
//   2. Organize Swift files into Sources/ directory
//   3. Run: swift build -c release
//   4. Run: swift run
//
// DIRECTORY STRUCTURE:
//   VibeCode/
//   ├── Package.swift
//   ├── Sources/
//   │   └── VibeCode/
//   │       ├── main.swift (renamed from LiquidGlassVibeCodeApp.swift)
//   │       ├── DatadogLogger.swift
//   │       ├── DogStatsDClient.swift
//   │       ├── VMObservability.swift
//   │       └── DHCPLeaseParser.swift
//   └── Tests/
//       └── VibeCodeTests/
//           └── TracingTests.swift

import PackageDescription

let package = Package(
    name: "VibeCode",
    platforms: [
        .macOS(.v11)  // Minimum macOS version for Virtualization.framework
    ],
    dependencies: [
        // OpenTelemetry Swift SDK
        .package(
            url: "https://github.com/open-telemetry/opentelemetry-swift",
            from: "2.2.0"
        )
    ],
    targets: [
        // Executable target
        .executableTarget(
            name: "VibeCode",
            dependencies: [
                // OpenTelemetry API (for manual instrumentation)
                .product(name: "OpenTelemetryApi", package: "opentelemetry-swift"),

                // OpenTelemetry SDK (for TracerProvider, Resource, etc.)
                .product(name: "OpenTelemetrySdk", package: "opentelemetry-swift"),

                // OTLP Exporter (for exporting to Datadog)
                .product(name: "OpenTelemetryProtocolExporterHTTP", package: "opentelemetry-swift"),

                // Optional: GRPC exporter (production-ready)
                // .product(name: "OpenTelemetryProtocolExporterGrpc", package: "opentelemetry-swift"),

                // Optional: StdoutExporter for debugging
                // .product(name: "StdoutExporter", package: "opentelemetry-swift"),

                // Optional: URLSession instrumentation
                // .product(name: "URLSessionInstrumentation", package: "opentelemetry-swift"),
            ],
            path: "Sources"
        ),

        // Test target
        .testTarget(
            name: "VibeCodeTests",
            dependencies: ["VibeCode"]
        )
    ]
)

/*

MIGRATION STEPS:

1. ORGANIZE FILES:
   mkdir -p Sources/VibeCode
   mv LiquidGlassVibeCodeApp.swift Sources/VibeCode/main.swift
   mv DatadogLogger.swift Sources/VibeCode/
   mv DogStatsDClient.swift Sources/VibeCode/
   mv VMObservability.swift Sources/VibeCode/
   mv DHCPLeaseParser.swift Sources/VibeCode/

2. RENAME Package.swift.template:
   mv Package.swift.template Package.swift

3. INITIALIZE OPENTELEMETRY (in main.swift):

   import OpenTelemetryApi
   import OpenTelemetrySdk
   import OpenTelemetryProtocolExporterHTTP

   // Configure OTLP HTTP exporter
   let config = OtlpConfiguration(
       timeout: 10.0,
       headers: [
           ("dd-api-key", ProcessInfo.processInfo.environment["DD_API_KEY"] ?? "")
       ]
   )

   let exporter = OtlpHttpTraceExporter(
       endpoint: URL(string: "https://api.datadoghq.com/api/intake/otlp/v1/traces")!,
       config: config
   )

   // Register tracer provider
   OpenTelemetry.registerTracerProvider(
       tracerProvider: TracerProviderBuilder()
           .add(spanProcessor: BatchSpanProcessor(spanExporter: exporter))
           .with(resource: Resource(attributes: [
               "service.name": "vibecode-swiftui",
               "service.environment": ProcessInfo.processInfo.environment["ENV"] ?? "development",
               "host.name": Host.current().name ?? "unknown"
           ]))
           .build()
   )

   // Get tracer
   let tracer = OpenTelemetry.instance.tracerProvider.get(
       instrumentationName: "com.vibecode.app",
       instrumentationVersion: "1.0.0"
   )

4. CREATE SPANS (in VMManager):

   // Start span
   let span = tracer.spanBuilder(spanName: "vm.start")
       .setSpanKind(spanKind: .internal)
       .startSpan()

   span.setAttribute(key: "vm.id", value: vmId)
   span.setAttribute(key: "vm.name", value: vmName)

   // Perform operation
   vm?.start { result in
       switch result {
       case .success:
           span.end()
       case .failure(let error):
           span.setAttribute(key: "error.type", value: String(describing: type(of: error)))
           span.setAttribute(key: "error.message", value: error.localizedDescription)
           span.status = .error(description: error.localizedDescription)
           span.end()
       }
   }

5. BUILD:
   swift build -c release

6. RUN:
   .build/release/VibeCode

   Or:
   swift run

7. CREATE APP BUNDLE:
   # Build
   swift build -c release

   # Create bundle structure
   mkdir -p VibeCode.app/Contents/{MacOS,Resources}

   # Copy executable
   cp .build/release/VibeCode VibeCode.app/Contents/MacOS/

   # Copy resources (kernel, initramfs)
   cp vmlinux-raw VibeCode.app/Contents/Resources/
   cp bun-openvscode.cpio.gz VibeCode.app/Contents/Resources/

   # Create Info.plist (see bundle-apps.sh for template)

   # Code sign
   codesign --force --deep --sign - --entitlements entitlements.plist VibeCode.app

BENEFITS OF MIGRATION:

✅ Standards-compliant OTLP implementation
✅ Batch export (more efficient than one-by-one)
✅ Configurable sampling (reduce overhead)
✅ Automatic context propagation
✅ Auto-instrumentation for URLSession, Network, etc.
✅ OTLP metrics and logs export
✅ Community-maintained (bug fixes, updates)
✅ Better integration with OpenTelemetry ecosystem

CONSIDERATIONS:

⚠️ Larger binary size (additional dependencies)
⚠️ Longer build times (SPM dependency resolution)
⚠️ Requires Swift Package Manager (not standalone swiftc)

PERFORMANCE:

- Stub implementation: ~1ms per span, one-by-one export
- SDK implementation: <1ms per span, batched export (10x more efficient)

COMPATIBILITY:

- macOS 11.0+ (Virtualization.framework requirement)
- Swift 5.5+ (async/await support)
- Xcode 13.0+

*/
