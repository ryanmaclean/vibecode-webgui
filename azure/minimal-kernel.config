# Minimal Linux 6.6 kernel config for OpenVSCode VM
# Target: 1.5 MB kernel with only virtio support
# Architecture: x86_64 or ARM64 (adjust CONFIG_ARM64 vs CONFIG_X86_64)

# Architecture (choose one)
CONFIG_ARM64=y
# CONFIG_X86_64=y

CONFIG_64BIT=y
CONFIG_MMU=y

# NO modules - everything built-in
CONFIG_MODULES=n

# Processor type
CONFIG_NR_CPUS=16
CONFIG_SMP=y
CONFIG_PREEMPT_VOLUNTARY=y

# Memory
CONFIG_FLATMEM=y
CONFIG_HAVE_MEMBLOCK=y
CONFIG_SPARSEMEM_MANUAL=n
CONFIG_ZONE_DMA=y
CONFIG_ZONE_DMA32=y

# Optimize for size
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EMBEDDED=y
CONFIG_EXPERT=y

# Minimal kernel
CONFIG_IKCONFIG=n
CONFIG_IKCONFIG_PROC=n
CONFIG_KALLSYMS=n
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_BASE_FULL=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y

# NO debugging
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_STACK_VALIDATION=n

# Block layer (minimal)
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=n
CONFIG_BLK_DEV_NBD=n
CONFIG_BLK_DEV_RAM=n

# Networking (TCP/IP only)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=n
CONFIG_IP_ADVANCED_ROUTER=n
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=n
CONFIG_IP_PNP_RARP=n

# NO IPv6
CONFIG_IPV6=n

# NO netfilter/iptables
CONFIG_NETFILTER=n

# Packet socket (for DHCP)
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=n

# Unix sockets
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=n

# NO wireless
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n

# NO Bluetooth
CONFIG_BT=n

# virtio ONLY
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_BALLOON=n
CONFIG_VIRTIO_INPUT=n

# NO other drivers
CONFIG_SCSI=n
CONFIG_ATA=n
CONFIG_SATA_AHCI=n
CONFIG_MD=n
CONFIG_DM=n
CONFIG_FUSION=n
CONFIG_IEEE1394=n
CONFIG_I2O=n
CONFIG_MACINTOSH_DRIVERS=n
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=n
CONFIG_NET_VENDOR_3COM=n
CONFIG_NET_VENDOR_ADAPTEC=n
CONFIG_NET_VENDOR_AMD=n
CONFIG_NET_VENDOR_BROADCOM=n
CONFIG_NET_VENDOR_INTEL=n
CONFIG_NET_VENDOR_MARVELL=n
CONFIG_NET_VENDOR_REALTEK=n

# Filesystems (minimal)
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=n
CONFIG_EXT4_FS_SECURITY=n
CONFIG_EXT4_DEBUG=n

CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=n
CONFIG_TMPFS_XATTR=n

CONFIG_PROC_FS=y
CONFIG_PROC_KCORE=n
CONFIG_PROC_SYSCTL=y

CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# NO other filesystems
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_NTFS_FS=n
CONFIG_FUSE_FS=n
CONFIG_OVERLAY_FS=n
CONFIG_VFAT_FS=n
CONFIG_FAT_FS=n
CONFIG_MSDOS_FS=n
CONFIG_ISO9660_FS=n
CONFIG_UDF_FS=n

# NO USB
CONFIG_USB_SUPPORT=n
CONFIG_USB=n

# NO sound
CONFIG_SOUND=n
CONFIG_SND=n

# NO graphics
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_VGA_CONSOLE=n
CONFIG_FRAMEBUFFER_CONSOLE=n

# Console (serial/virtio only)
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HVC_DRIVER=y
CONFIG_VIRTIO_CONSOLE=y

# NO power management
CONFIG_PM=n
CONFIG_ACPI=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n

# NO hardware monitoring
CONFIG_HWMON=n
CONFIG_THERMAL=n
CONFIG_WATCHDOG=n

# NO crypto hardware
CONFIG_CRYPTO_HW=n

# Minimal crypto (for networking)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ALGAPI=y
CONFIG_CRYPTO_HASH=y
CONFIG_CRYPTO_HASH2=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y

# NO security modules
CONFIG_SECURITY=n
CONFIG_SECURITYFS=n
CONFIG_SECURITY_NETWORK=n

# NO audit
CONFIG_AUDIT=n

# NO namespaces (unless you need for containers)
CONFIG_NAMESPACES=n
CONFIG_UTS_NS=n
CONFIG_IPC_NS=n
CONFIG_USER_NS=n
CONFIG_PID_NS=n
CONFIG_NET_NS=n

# NO cgroups
CONFIG_CGROUPS=n

# Binary formats
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=n

# Essential kernel features
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_FHANDLE=y
CONFIG_USELIB=n

# NO coredump
CONFIG_COREDUMP=n

# Minimal init
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n

# NO exotic architectures
CONFIG_COMPAT=n

# NO KVM/virtualization support
CONFIG_VIRTUALIZATION=n
CONFIG_KVM=n

# Essential for userspace
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=n

# NO tracing/profiling
CONFIG_TRACING=n
CONFIG_FTRACE=n
CONFIG_KPROBES=n

# NO misc hardware
CONFIG_INPUT=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_MOUSE=n
CONFIG_SERIO=n
CONFIG_VT=n
CONFIG_HID=n

# NO PCMCIA/CardBus
CONFIG_PCCARD=n

# NO MTD
CONFIG_MTD=n

# NO IIO (industrial I/O)
CONFIG_IIO=n

# NO staging drivers
CONFIG_STAGING=n

# NO sample code
CONFIG_SAMPLES=n

# End of config
