{
  "name": "vibecode-electron-prototype",
  "version": "1.0.0",
  "description": "Electron POC for VibeCode - embedding OpenVSCode Server with Chromium",
  "main": "main.js",
  "scripts": {
    "start": "NODE_ENV=development electron .",
    "dev": "NODE_ENV=development electron . --enable-logging",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "package": "electron-builder --dir",
    "clean": "rm -rf dist node_modules"
  },
  "keywords": [
    "electron",
    "vscode",
    "ide",
    "development"
  ],
  "author": "VibeCode",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.vibecode.electron",
    "productName": "VibeCode",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "vscode-server",
        "to": "vscode-server",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
