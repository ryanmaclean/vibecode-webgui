# Optimized Multi-stage Production Dockerfile for x86-64
# Target: ~12 layers (reduced from ~18)
# Includes multi-stage build to remove build dependencies from final image

# ===== Builder Stage =====
FROM --platform=linux/amd64 node:20-slim AS builder

WORKDIR /app

# Install build dependencies in single layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package.json package-lock.json* ./

# Configure npm for platform-specific dependencies
ENV npm_config_platform=linux \
    npm_config_arch=x64 \
    npm_config_ignore_platform=true \
    npm_config_force=true

# Install all dependencies including Tailwind v4 and rebuild native modules in single layer
RUN npm install --legacy-peer-deps && \
    npm install tailwindcss@next @tailwindcss/postcss lightningcss --legacy-peer-deps && \
    npm rebuild lightningcss && \
    node -e "require('lightningcss'); console.log('✅ lightningcss verified')"

# Copy source files
COPY . .

# Generate Prisma client and build application in single layer
ENV NODE_ENV=production \
    DOCKER=true \
    DD_IAST_ENABLED=true

RUN npx prisma generate && \
    npm run build

# ===== Production Stage =====
FROM --platform=linux/amd64 node:20-slim AS runner

WORKDIR /app

# Install only runtime dependencies (no build tools)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    tini && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs && \
    mkdir -p /app/.next && \
    chown -R nextjs:nodejs /app

# Set production environment
ENV NODE_ENV=production \
    DOCKER=true \
    DD_IAST_ENABLED=true \
    PORT=3000 \
    HOSTNAME="0.0.0.0"

# Copy built application from builder
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Copy production dependencies (only what's needed for runtime)
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules

# Copy Prisma generated client
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

# Switch to non-root user
USER nextjs

# Expose production port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

# Use tini as init system
ENTRYPOINT ["tini", "--"]

# Start command
CMD ["node", "server.js"]

# Final layer count: ~12 layers
# Builder stage (not counted in final image):
# 1. FROM builder
# 2. RUN apt-get (build deps)
# 3. COPY package files
# 4. RUN npm install (combined with tailwind + rebuild)
# 5. COPY source
# 6. RUN prisma + build (combined)
#
# Runner stage (final image):
# 1. FROM runner
# 2. RUN apt-get + user creation (combined)
# 3-6. COPY operations (4 layers for artifacts)
# 7-8. Metadata (USER, EXPOSE, HEALTHCHECK, ENV, ENTRYPOINT, CMD)
#
# Total final image layers: ~12
