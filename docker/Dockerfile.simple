# Simple Dockerfile for Apple Container
FROM node:24-alpine

# Install essential packages
RUN apk add --no-cache \
    python3 \
    py3-pip \
    make \
    gcc \
    g++ \
    curl \
    git

# Set AI tools environment variables
ENV ANTHROPIC_API_KEY="" \
    OPENAI_API_KEY="" \
    GOOGLE_API_KEY="" \
    OPENCODE_API_KEY=""

# Install AI coding tools globally
RUN npm install -g @anthropic-ai/claude-code && \
    npm install -g @openai/codex && \
    npm install -g @just-every/code && \
    npm install -g @google/gemini-cli

# Install Python AI tools
RUN pip3 install aider

# Create AI tools verification script
RUN echo '#!/bin/sh' > /usr/local/bin/verify-ai-tools && \
    echo 'echo "=== Verifying AI Coding Tools ==="' >> /usr/local/bin/verify-ai-tools && \
    echo 'for tool in claude codex coder gemini aider; do' >> /usr/local/bin/verify-ai-tools && \
    echo '  if command -v "$tool" >/dev/null 2>&1; then' >> /usr/local/bin/verify-ai-tools && \
    echo '    echo "✅ $tool: $(which $tool)"' >> /usr/local/bin/verify-ai-tools && \
    echo '  else' >> /usr/local/bin/verify-ai-tools && \
    echo '    echo "❌ $tool: Not found"' >> /usr/local/bin/verify-ai-tools && \
    echo '  fi' >> /usr/local/bin/verify-ai-tools && \
    echo 'done' >> /usr/local/bin/verify-ai-tools && \
    echo 'echo "=== Verification Complete ==="' >> /usr/local/bin/verify-ai-tools && \
    chmod +x /usr/local/bin/verify-ai-tools

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Expose port
EXPOSE 3000

# Start the application
CMD ["npm", "start"]