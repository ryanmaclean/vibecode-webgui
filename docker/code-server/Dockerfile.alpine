# VibeCode Code-Server Alpine Linux Experiment
# EXPERIMENTAL: Testing Alpine Linux for reduced image size
# Based on Alpine 3.19 with code-server compiled from source
FROM alpine:3.19 AS builder

ARG TARGETPLATFORM
ARG TARGETARCH
ARG CODE_SERVER_VERSION=4.104.2

# Install build dependencies
RUN apk add --no-cache \
    nodejs npm git python3 make g++ \
    pkgconfig libx11-dev libxkbfile-dev \
    libsecret-dev curl bash

# Build code-server from source (Alpine doesn't have pre-built binaries)
RUN git clone --depth 1 --branch v${CODE_SERVER_VERSION} https://github.com/coder/code-server.git /tmp/code-server && \
    cd /tmp/code-server && \
    npm install --legacy-peer-deps && \
    npm run build && \
    npm run release && \
    npm run release:standalone

# Final stage
FROM alpine:3.19

ARG TARGETPLATFORM
ARG TARGETARCH
ARG LAZYGIT_VERSION=0.55.1
ARG STARSHIP_VERSION=1.23.0
ARG PROFILE=minimal
ARG BUILD_DATE
ARG GIT_COMMIT
ARG VERSION=1.2.0-alpine

LABEL org.opencontainers.image.title="VibeCode Code-Server Alpine" \
      org.opencontainers.image.description="Alpine-based code-server with minimal footprint" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.source="https://github.com/ryanmaclean/vibecode-webgui" \
      org.opencontainers.image.profile="${PROFILE}" \
      org.opencontainers.image.experimental="true"

# Copy code-server from builder
COPY --from=builder /tmp/code-server/release-standalone /usr/lib/code-server

# Layer 1: Install base system and essential tools (Alpine style)
RUN apk add --no-cache \
    # Core utilities
    ca-certificates curl bash bash-completion fish git zsh openssh-client \
    sudo wget gnupg build-base python3 py3-pip jq fzf bat \
    # Modern tools available in Alpine repos
    ripgrep neovim vim fd \
    # Node.js and npm
    nodejs npm \
    # Go language
    go && \
    # Create coder user
    addgroup -g 1000 coder && \
    adduser -u 1000 -G coder -s /bin/bash -D coder && \
    echo "coder ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    # Setup code-server
    ln -s /usr/lib/code-server/bin/code-server /usr/bin/code-server && \
    chmod 755 /usr/bin/code-server

# Layer 2: Install minimal CLI tools (Alpine compatible)
RUN set -eux && \
    case "$TARGETPLATFORM" in \
      "linux/amd64") \
        LAZYGIT_ARCH=Linux_x86_64; \
        STARSHIP_ARCH=x86_64-unknown-linux-musl ;; \
      "linux/arm64") \
        LAZYGIT_ARCH=Linux_arm64; \
        STARSHIP_ARCH=aarch64-unknown-linux-musl ;; \
      *) echo "Unsupported platform: $TARGETPLATFORM"; exit 1 ;; \
    esac && \
    # Install lazygit
    curl -fsSL "https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}/lazygit_${LAZYGIT_VERSION}_${LAZYGIT_ARCH}.tar.gz" -o /tmp/lazygit.tar.gz && \
    tar -xf /tmp/lazygit.tar.gz -C /tmp lazygit && install -m755 /tmp/lazygit /usr/local/bin/lazygit && \
    # Install starship
    curl -fsSL "https://github.com/starship/starship/releases/download/v${STARSHIP_VERSION}/starship-${STARSHIP_ARCH}.tar.gz" -o /tmp/starship.tar.gz && \
    tar -xf /tmp/starship.tar.gz -C /tmp && install -m755 /tmp/starship /usr/local/bin/starship && \
    # Cleanup
    rm -rf /tmp/*

# Layer 3: Install npm packages and Python tools (minimal profile)
USER coder
WORKDIR /home/coder/workspace

RUN npm install -g \
    typescript @types/node prettier eslint \
    typescript-language-server bash-language-server && \
    pip3 install --user --no-cache-dir --break-system-packages \
    'python-lsp-server[all]' pylsp-mypy python-lsp-black

# Layer 4: Install minimal VSCode extensions
RUN mkdir -p /home/coder/.local/share/code-server/User/ && \
    mkdir -p /home/coder/.vscode/extensions/ && \
    # Install only essential extensions for minimal profile
    /usr/bin/code-server --install-extension ms-vscode.vscode-typescript-next || echo "TypeScript failed" && \
    /usr/bin/code-server --install-extension dbaeumer.vscode-eslint || echo "ESLint failed" && \
    /usr/bin/code-server --install-extension esbenp.prettier-vscode || echo "Prettier failed" && \
    /usr/bin/code-server --install-extension PKief.material-icon-theme || echo "Icons failed" && \
    rm -rf /tmp/*

ENV SHELL=/bin/bash
ENV PATH="/home/coder/.local/bin:${PATH}"
ENV NODE_PATH=/usr/local/lib/node_modules

EXPOSE 8765

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8765/healthz || exit 1

CMD ["code-server", "--bind-addr", "0.0.0.0:8765", "--auth", "none", "/home/coder/workspace"]
