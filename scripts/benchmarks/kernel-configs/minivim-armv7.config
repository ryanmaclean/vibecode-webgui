# MiniVim armv7 Configuration (6.17.x)
# Optimized for QEMU virtualization and Raspberry Pi class devices
# Updated for kernel 6.17.x with minimal boot time focus

# ARM architecture
CONFIG_ARM=y
CONFIG_ARCH_MULTI_V7=y

# CPU features
CONFIG_CPU_V7=y
CONFIG_THUMB2_KERNEL=y
CONFIG_ARM_THUMB=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y

# Raspberry Pi support (minimal - primarily for QEMU)
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y

# PSCI (Power State Coordination Interface)
CONFIG_ARM_PSCI=y

# GIC (Generic Interrupt Controller)
CONFIG_ARM_GIC=y

# Serial console for ARM
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_BCM2835AUX=y

# RTC
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y

# Virtio MMIO (essential for QEMU)
# Already in base config, but ensure it's enabled
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y

# MMC/SD support (minimal for Pi compatibility)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y

# GPIO support (minimal)
CONFIG_GPIOLIB=y
CONFIG_GPIO_BCM_VIRT=y

# Raspberry Pi firmware
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y

# ARM specific
CONFIG_AEABI=y
CONFIG_OABI_COMPAT=n
CONFIG_HIGHMEM=y
CONFIG_HIGHPTE=y

# Security hardening (6.17.x features)
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# Memory optimization
CONFIG_KERNEL_LZ4=y
CONFIG_SLUB=y

# Disable unnecessary features for virtualization
CONFIG_CPU_FREQ=n
CONFIG_CPU_IDLE=n
CONFIG_DRM=n
CONFIG_AGP=n
CONFIG_ATA=n
CONFIG_SATA_PMP=n
CONFIG_SATA_AHCI=n
CONFIG_PATA_ACPI=n

# Disable HID devices (not needed in VM)
CONFIG_HID=n
CONFIG_HID_GENERIC=n
CONFIG_USB_HID=n

# Disable input devices (except essential)
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n

# Performance optimization
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_250=y
