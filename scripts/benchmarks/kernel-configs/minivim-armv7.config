# MiniVim armv7 Configuration
# Raspberry Pi and ARMv7 device optimizations

# ARM architecture
CONFIG_ARM=y
CONFIG_ARCH_MULTI_V7=y

# CPU features
CONFIG_CPU_V7=y
CONFIG_THUMB2_KERNEL=y
CONFIG_ARM_THUMB=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y

# Raspberry Pi support
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y

# PSCI (Power State Coordination Interface)
CONFIG_ARM_PSCI=y

# GIC (Generic Interrupt Controller)
CONFIG_ARM_GIC=y

# Serial console for ARM
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_BCM2835AUX=y

# RTC
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y

# MMC/SD support (for Raspberry Pi)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y

# GPIO support (minimal)
CONFIG_GPIOLIB=y
CONFIG_GPIO_BCM_VIRT=y

# Raspberry Pi firmware
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y

# ARM specific
CONFIG_AEABI=y
CONFIG_OABI_COMPAT=n
CONFIG_HIGHMEM=y
CONFIG_HIGHPTE=y

# Disable features not needed for Pi
CONFIG_CPU_FREQ=n
CONFIG_CPU_IDLE=n
CONFIG_STACKPROTECTOR=n
CONFIG_STACKPROTECTOR_STRONG=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_RANDOMIZE_KSTACK_OFFSET=n
CONFIG_VMAP_STACK=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_LTO_NONE=y
CONFIG_LTO_CLANG_THIN=n
CONFIG_LTO_CLANG_FULL=n
CONFIG_LTO=n
CONFIG_KPROBES=n
CONFIG_FTRACE=n
CONFIG_KCSAN=n
CONFIG_KMSAN=n
CONFIG_KFENCE=n
