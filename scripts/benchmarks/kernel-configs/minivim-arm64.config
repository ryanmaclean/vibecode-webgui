# MiniVim arm64 Configuration
# Apple Silicon and ARM64 server optimizations

# ARM64 architecture
CONFIG_ARM64=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y

# CPU features
CONFIG_ARM64_PAN=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_SVE=y

# Apple SoC support
CONFIG_ARCH_APPLE=y

# Apple-specific drivers for M-series processors
CONFIG_APPLE_AIC=y
CONFIG_APPLE_PMGR_PWRSTATE=y

# CPU frequency scaling for Apple Silicon
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y

# Thermal management for Apple Silicon
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y

# Performance and Efficiency core detection
CONFIG_ARM64_PSEUDO_NMI=y

# Virtualization
CONFIG_ARM64_VHE=y
CONFIG_KVM=y
CONFIG_KVM_ARM_HOST=y

# PSCI (Power State Coordination Interface)
CONFIG_ARM_PSCI=y

# GIC (Generic Interrupt Controller)
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y

# ARM64 errata workarounds
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_832075=y
CONFIG_ARM64_ERRATUM_834220=y
CONFIG_ARM64_ERRATUM_845719=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_ERRATUM_1024718=y
CONFIG_ARM64_ERRATUM_1418040=y
CONFIG_ARM64_ERRATUM_1165522=y
CONFIG_ARM64_ERRATUM_1319367=y
CONFIG_ARM64_ERRATUM_1530923=y
CONFIG_ARM64_ERRATUM_1542419=y
CONFIG_CAVIUM_ERRATUM_22375=y
CONFIG_CAVIUM_ERRATUM_23154=y
CONFIG_CAVIUM_ERRATUM_27456=y
CONFIG_CAVIUM_ERRATUM_30115=y

# Serial console for ARM64
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# RTC
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y

# ARM64 specific
CONFIG_COMPAT=n
CONFIG_ARM64_LSE_ATOMICS=y

# Disable unnecessary ARM64 SoC platforms (keeping only Apple)
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BRCMSTB=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_STRATIX10=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n

# Disable unnecessary PCIe controllers (HyperKit/Lima use virtio)
CONFIG_PCIE_ALTERA=n
CONFIG_PCIE_ALTERA_MSI=n
CONFIG_PCI_AARDVARK=n
CONFIG_PCI_HISI=n
CONFIG_PCI_HOST_GENERIC=n
CONFIG_PCI_XGENE=n
CONFIG_PCI_XGENE_MSI=n
CONFIG_PCIE_XILINX_NWL=n

# Disable GPIO controllers not needed for virtualization
CONFIG_GPIO_DWAPB=n
CONFIG_GPIO_PL061=n
CONFIG_GPIO_XGENE=n
CONFIG_GPIO_XGENE_SB=n

# Disable unnecessary PHY drivers
CONFIG_PHY_XGENE=n
CONFIG_PHY_HI6220_USB=n

# Keep kernel optimized for virtualization workloads
CONFIG_HZ_100=y
CONFIG_HZ=100
