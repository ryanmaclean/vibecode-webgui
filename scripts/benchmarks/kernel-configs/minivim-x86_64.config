# MiniVim x86_64 Configuration
# Intel/AMD specific optimizations

# x86_64 architecture
CONFIG_64BIT=y
CONFIG_X86_64=y

# CPU features
CONFIG_X86_INTEL_LPSS=n
CONFIG_X86_AMD_PLATFORM_DEVICE=n
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y

# Intel microcode
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y
CONFIG_MICROCODE_AMD=y

# AVX/XSAVE support
CONFIG_X86_XSAVE=y
CONFIG_X86_AVX=y
CONFIG_X86_AVX2=y

# Virtualization support
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_SPINLOCKS=y

# x2APIC
CONFIG_X86_X2APIC=y

# EFI support
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# SGX (optional, can be disabled if not needed)
CONFIG_X86_SGX=n

# Disable unnecessary x86 features
CONFIG_X86_INTEL_PSTATE=n
CONFIG_X86_INTEL_LPSS=n
CONFIG_X86_PLATFORM_DEVICES=n

# Serial console for x86
CONFIG_SERIAL_8250_PCI=y

# RTC
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
