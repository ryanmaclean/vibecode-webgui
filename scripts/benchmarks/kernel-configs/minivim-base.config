# MiniVim Base Configuration
# Minimal kernel config for fast boot benchmarks
# Shared across all architectures

# Core kernel features
CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=y
CONFIG_RD_LZMA=y
CONFIG_RD_XZ=y
CONFIG_RD_LZO=y
CONFIG_RD_LZ4=y
CONFIG_RD_ZSTD=y

# Essential filesystems
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Virtio support for virtualization
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_MMIO=y

# Network support (minimal)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# Serial console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_TTY=y

# Disable unnecessary subsystems
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_STAGING=n
CONFIG_HAMRADIO=n
CONFIG_CAN=n
CONFIG_PCCARD=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_GPIO_SYSFS=n

# Disable debugging features
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_PROFILING=n
CONFIG_STACKPROTECTOR=n
CONFIG_STACKPROTECTOR_STRONG=n
CONFIG_STACKPROTECTOR_AUTO=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_RANDOMIZE_KSTACK_OFFSET=n
CONFIG_VMAP_STACK=n
CONFIG_LTO_NONE=y
CONFIG_LTO_CLANG_THIN=n
CONFIG_LTO_CLANG_FULL=n
CONFIG_LTO=n
CONFIG_CFI_CLANG=n
CONFIG_AUTOFDO_CLANG=n
CONFIG_KFENCE=n
CONFIG_KCSAN=n
CONFIG_KMSAN=n

# Disable security modules we don't need
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY_SMACK=n
CONFIG_SECURITY_TOMOYO=n
CONFIG_SECURITY_APPARMOR=n

# Essential for boot
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Minimal block device support
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y

# Minimal SCSI support
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Power management (minimal)
CONFIG_PM=y
CONFIG_ACPI=y

# PCI support
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# Printk and console
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
