#!/usr/bin/env bash
# vibecode-tui - Interactive TUI for VibeCode Operations
# Consolidates 285+ shell scripts into an organized menu system

set -euo pipefail

# Determine script location
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export VIBECODE_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Load common functions
source "${SCRIPT_DIR}/vibecode-cli-lib/common.sh"

# Load menu modules
source "${SCRIPT_DIR}/vibecode-cli-lib/menu-development.sh"
source "${SCRIPT_DIR}/vibecode-cli-lib/menu-testing.sh"
source "${SCRIPT_DIR}/vibecode-cli-lib/menu-deployment.sh"
source "${SCRIPT_DIR}/vibecode-cli-lib/menu-vm.sh"
source "${SCRIPT_DIR}/vibecode-cli-lib/menu-security.sh"
source "${SCRIPT_DIR}/vibecode-cli-lib/menu-database.sh"
source "${SCRIPT_DIR}/vibecode-cli-lib/menu-monitoring.sh"

# Display banner
show_banner() {
    clear
    cat << 'EOF'
╔══════════════════════════════════════════════════════════════════╗
║                                                                  ║
║   ██╗   ██╗██╗██████╗ ███████╗ ██████╗ ██████╗ ██████╗ ███████╗ ║
║   ██║   ██║██║██╔══██╗██╔════╝██╔════╝██╔═══██╗██╔══██╗██╔════╝ ║
║   ██║   ██║██║██████╔╝█████╗  ██║     ██║   ██║██║  ██║█████╗   ║
║   ╚██╗ ██╔╝██║██╔══██╗██╔══╝  ██║     ██║   ██║██║  ██║██╔══╝   ║
║    ╚████╔╝ ██║██████╔╝███████╗╚██████╗╚██████╔╝██████╔╝███████╗ ║
║     ╚═══╝  ╚═╝╚═════╝ ╚══════╝ ╚═════╝ ╚═════╝ ╚═════╝ ╚══════╝ ║
║                                                                  ║
║                  Interactive Operations Manager                 ║
║                                                                  ║
╚══════════════════════════════════════════════════════════════════╝

EOF
    echo -e "${CYAN}Version:${NC} 1.0.0"
    echo -e "${CYAN}Location:${NC} ${VIBECODE_ROOT}"
    echo -e "${CYAN}Dialog Tool:${NC} ${DIALOG_TOOL}"
    echo -e "${CYAN}Log File:${NC} ${VIBECODE_CLI_LOG}"
    echo ""
    echo -e "${YELLOW}Press any key to continue...${NC}"
    read -n 1 -s
}

# Main menu
show_main_menu() {
    local breadcrumb="vibecode-tui"

    while true; do
        local choice=$(show_menu "VibeCode TUI - Main Menu" "${breadcrumb}" \
            "1" "Development - Code generation, builds, and dev tools" \
            "2" "Testing & Validation - Test suites and quality checks" \
            "3" "Deployment - Deploy to dev/staging/production" \
            "4" "VM Management - Virtual machine operations" \
            "5" "Security & Compliance - Security scans and audits" \
            "6" "Database Operations - Migrations, backups, queries" \
            "7" "Monitoring & Observability - Logs, metrics, alerts" \
            "8" "View Logs - View vibecode-tui operation logs" \
            "9" "About - Information about this tool" \
            "0" "Exit")

        case $? in
            0)
                case "${choice}" in
                    1)
                        log_info "Entering Development menu"
                        show_development_menu
                        ;;
                    2)
                        log_info "Entering Testing menu"
                        show_testing_menu
                        ;;
                    3)
                        log_info "Entering Deployment menu"
                        show_deployment_menu
                        ;;
                    4)
                        log_info "Entering VM Management menu"
                        show_vm_menu
                        ;;
                    5)
                        log_info "Entering Security menu"
                        show_security_menu
                        ;;
                    6)
                        log_info "Entering Database menu"
                        show_database_menu
                        ;;
                    7)
                        log_info "Entering Monitoring menu"
                        show_monitoring_menu
                        ;;
                    8)
                        show_logs
                        ;;
                    9)
                        show_about
                        ;;
                    0)
                        exit_cli
                        ;;
                esac
                ;;
            *)
                exit_cli
                ;;
        esac
    done
}

# Show logs
show_logs() {
    local breadcrumb="vibecode-tui > Logs"

    if [[ ! -f "${VIBECODE_CLI_LOG}" ]]; then
        show_msgbox "Logs" "No logs available yet.\n\nLogs will be created when you perform operations." 10 60
        return
    fi

    local temp_file=$(mktemp)
    tail -n 100 "${VIBECODE_CLI_LOG}" > "${temp_file}"

    if [[ "${DIALOG_TOOL}" == "dialog" ]]; then
        dialog --clear --title "VibeCode TUI Logs (Last 100 lines)" \
               --backtitle "${breadcrumb}" \
               --textbox "${temp_file}" 20 80
    else
        whiptail --clear --title "VibeCode TUI Logs (Last 100 lines)" \
                 --backtitle "${breadcrumb}" \
                 --textbox "${temp_file}" 20 80
    fi

    rm -f "${temp_file}"
}

# Show about information
show_about() {
    local about_text="VibeCode TUI - Interactive Operations Manager

Version: 1.0.0
Author: VibeCode Team

This TUI (Text User Interface) consolidates 285+ shell scripts
into an organized, easy-to-navigate menu system.

Features:
• 7 main operational categories
• Color-coded output
• Operation logging
• Dialog/Whiptail support
• Breadcrumb navigation
• Error handling

Categories:
1. Development - Code generation, builds, dev tools
2. Testing & Validation - Test suites, quality checks
3. Deployment - Multi-environment deployment
4. VM Management - Virtual machine operations
5. Security & Compliance - Security scans, audits
6. Database Operations - Migrations, backups, queries
7. Monitoring & Observability - Logs, metrics, alerts

Log Location: ${VIBECODE_CLI_LOG}
Repository: ${VIBECODE_ROOT}

For more information, visit the documentation or run:
  ./scripts/vibecode-tui --help"

    show_msgbox "About VibeCode TUI" "${about_text}" 25 70
}

# Exit CLI
exit_cli() {
    if show_yesno "Exit" "Are you sure you want to exit vibecode-tui?" 8 50; then
        log_info "Exiting vibecode-tui"
        clear
        echo -e "${GREEN}Thank you for using VibeCode TUI!${NC}"
        echo -e "${CYAN}Logs saved to: ${VIBECODE_CLI_LOG}${NC}"
        exit 0
    fi
}

# Handle command line arguments
show_help() {
    cat << EOF
VibeCode TUI - Interactive Operations Manager

Usage: vibecode-tui [OPTIONS]

OPTIONS:
    -h, --help          Show this help message
    -v, --version       Show version information
    --no-banner         Skip the startup banner

DESCRIPTION:
    vibecode-tui is an interactive TUI that consolidates 285+ shell
    scripts into an organized menu system with 7 main categories:

    • Development
    • Testing & Validation
    • Deployment
    • VM Management
    • Security & Compliance
    • Database Operations
    • Monitoring & Observability

EXAMPLES:
    # Launch interactive menu
    vibecode-tui

    # Skip banner
    vibecode-tui --no-banner

LOGS:
    All operations are logged to: ${VIBECODE_CLI_LOG}

REQUIREMENTS:
    • dialog or whiptail (for TUI menus)
    • bash 4.0 or higher

EOF
}

# Main entry point
main() {
    local skip_banner=false

    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                echo "vibecode-tui version 1.0.0"
                exit 0
                ;;
            --no-banner)
                skip_banner=true
                shift
                ;;
            *)
                echo "Unknown option: $1"
                echo "Run 'vibecode-tui --help' for usage information."
                exit 1
                ;;
        esac
    done

    # Initialize
    log_info "Starting vibecode-tui"
    log_info "Using dialog tool: ${DIALOG_TOOL}"

    # Show banner unless skipped
    if [[ "${skip_banner}" == false ]]; then
        show_banner
    fi

    # Show main menu
    show_main_menu
}

# Run main function
main "$@"
