FROM ubuntu:22.04

# Install build tools
RUN apt-get update && apt-get install -y \
    cpio \
    gzip \
    file \
    binutils \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy build script
COPY build-initramfs.sh /build/
RUN chmod +x /build/build-initramfs.sh

CMD ["/build/build-initramfs.sh"]
