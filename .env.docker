# Docker Environment Configuration
# Enhanced with values from .env.local for better compatibility

# Application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=vibecode-development-secret-key-change-in-production
NODE_ENV=development
DOCKER=true
NEXT_TELEMETRY_DISABLED=1
PORT=3000
WS_PORT=3001

# Database (Docker service names)
DATABASE_URL=postgresql://vibecode:vibecode123@postgres:5432/vibecode_dev
POSTGRES_PASSWORD=vibecode123

# Redis (Docker service name)
REDIS_URL=redis://redis:6379

# Code Server
CODE_SERVER_PASSWORD=vibecode123

# Datadog (test values to prevent warnings)
NEXT_PUBLIC_DATADOG_APPLICATION_ID=test-app-id
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=test-client-token

# AI Configuration (from .env.local)
OPENROUTER_API_KEY=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
