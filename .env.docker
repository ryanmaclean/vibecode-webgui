# Docker Environment Configuration
# Copy to `.env.docker` when running the stack via Docker Compose. Replace placeholder values.

# Application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-for-docker
NODE_ENV=development
DOCKER=true
PORT=3000
WS_PORT=3001

# Database (Docker service names)
DATABASE_URL=postgresql://vibecode:vibecode_dev_password@postgres:5432/vibecode_dev
POSTGRES_PASSWORD=vibecode_dev_password

# Redis (Docker service name)
REDIS_URL=redis://redis:6379

# Code Server
CODE_SERVER_PASSWORD=please-change-me

# Datadog RUM credentials (browser-exposed)
NEXT_PUBLIC_DD_APPLICATION_ID=datadog-rum-app-id
NEXT_PUBLIC_DD_CLIENT_TOKEN=datadog-rum-client-token
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_ENABLE_RUM_IN_DEV=false
# Legacy fallback variables kept for compatibility with older tooling
NEXT_PUBLIC_DATADOG_APPLICATION_ID=datadog-rum-app-id
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=datadog-rum-client-token
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com
NEXT_PUBLIC_DATADOG_RUM_APPLICATION_ID=datadog-rum-app-id
NEXT_PUBLIC_DATADOG_RUM_CLIENT_TOKEN=datadog-rum-client-token

# AI Configuration
OPENROUTER_API_KEY=your-openrouter-api-key
CLAUDE_API_KEY=your-claude-api-key
OPENAI_API_KEY=your-openai-api-key

# OAuth Providers
GITHUB_ID=github-oauth-client-id
GITHUB_SECRET=github-oauth-client-secret
GOOGLE_CLIENT_ID=google-oauth-client-id
GOOGLE_CLIENT_SECRET=google-oauth-client-secret

# Datadog Backend (keep DD_* and DATADOG_* in sync)
DATADOG_API_KEY=datadog-api-key
DD_API_KEY=datadog-api-key
DD_APP_KEY=datadog-app-key
DATADOG_APP_KEY=datadog-app-key
DD_SITE=datadoghq.com
DD_ENV=development
DD_SERVICE=vibecode-webgui
DD_VERSION=0.0.0

# LLM Observability
DD_LLMOBS_ENABLED=0
DD_LLMOBS_AGENTLESS_ENABLED=0
DD_LLMOBS_ML_APP=vibecode-ai

# Monitoring
ENABLE_DATADOG_INTEGRATION_TESTS=false
MONITORING_HEALTH_CHECK_TIMEOUT=5000
PERFORMANCE_MONITORING_ENABLED=true
